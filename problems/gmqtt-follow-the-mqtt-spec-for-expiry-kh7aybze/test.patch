+func TestRetainedMessageCanBeClearedThroughATopicAliasK4x9(t *testing.T) {
+	addr := startBroker(t, nil)
+	pub, _ := connect(t, addr, v5, "pub", true, nil)
+	pub.publish("alias/ret", 0, true, "v1", 0, &packets.Properties{TopicAlias: u16(2)})
+	pub.publish("", 0, true, "v2", 0, &packets.Properties{TopicAlias: u16(2)})
+	time.Sleep(300 * time.Millisecond)
+
+	first, _ := connect(t, addr, v5, "first", true, nil)
+	subscribeOK(t, first, "alias/ret", 0)
+	got := first.publishes(600 * time.Millisecond)
+	if len(got) != 1 || string(got[0].Payload) != "v2" {
+		t.Fatalf("retained message set through an alias: got %d messages", len(got))
+	}
+
+	pub.publish("", 0, true, "", 0, &packets.Properties{TopicAlias: u16(2)})
+	time.Sleep(300 * time.Millisecond)
+	second, _ := connect(t, addr, v5, "second", true, nil)
+	subscribeOK(t, second, "alias/ret", 0)
+	if n := len(second.publishes(600 * time.Millisecond)); n != 0 {
+		t.Fatalf("an empty retained publish through an alias did not clear the retained message")
+	}
+}
