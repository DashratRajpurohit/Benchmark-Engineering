+func TestWildcardsMustOccupyAWholeLevelK4x9(t *testing.T) {
+	addr := startBroker(t, nil)
+	pub, _ := connect(t, addr, v5, "pub", true, nil)
+	for _, v := range []packets.Version{v5, v31} {
+		for _, f := range []string{"+", "+/a", "a/+", "a/+/b", "#", "a/#"} {
+			c, _ := connect(t, addr, v, fmt.Sprintf("valid%d%s", v, strings.NewReplacer("/", "_", "+", "p", "#", "h").Replace(f)), true, nil)
+			p := c.subscribe(1, topic(f, 0))
+			if sa, ok := p.(*packets.Suback); !ok || sa.Payload[0] >= 0x80 {
+				t.Fatalf("v%d: valid filter %q was refused: %v", v, f, p)
+			}
+		}
+		for _, f := range []string{"+a", "+abc", "a+", "a/b+", "a/+b", "a#", "#/a"} {
+			c, _ := connect(t, addr, v, fmt.Sprintf("bad%d%s", v, strings.NewReplacer("/", "_", "+", "p", "#", "h").Replace(f)), true, nil)
+			p := c.subscribe(1, topic(f, 0))
+			if sa, ok := p.(*packets.Suback); ok && len(sa.Payload) == 1 && sa.Payload[0] < 0x80 {
+				t.Fatalf("v%d: invalid filter %q was accepted", v, f)
+			}
+			pub.publish("xa", 0, false, "m", 0, nil)
+			pub.publish("a/bx", 0, false, "m", 0, nil)
+			if n := len(c.publishes(300 * time.Millisecond)); n != 0 {
+				t.Fatalf("v%d: invalid filter %q delivered %d messages", v, f, n)
+			}
+		}
+	}
+}
