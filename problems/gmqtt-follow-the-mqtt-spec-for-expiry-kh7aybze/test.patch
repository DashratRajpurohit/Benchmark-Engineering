+func TestTakenOverClientIsToldWhyK4x9(t *testing.T) {
+	addr := startBroker(t, nil)
+	for i := 0; i < 6; i++ {
+		id := fmt.Sprintf("takeover-%d", i)
+		old, _ := connect(t, addr, v5, id, true, nil)
+		connect(t, addr, v5, id, true, nil)
+		var code byte
+		var found bool
+		for {
+			p, err := old.recv(2 * time.Second)
+			if err != nil {
+				break
+			}
+			if c, ok := disconnectCode(p); ok {
+				code, found = c, true
+				break
+			}
+		}
+		if !found || code != 0x8e {
+			t.Fatalf("round %d: the first connection was not sent DISCONNECT 0x8e (found=%v code=0x%02x)", i, found, code)
+		}
+	}
+}
+
+// ---------------------------------------------------------------------------
+// Configuration
+
+func TestExpiredSessionsAreCollectedAtTheConfiguredIntervalK4x9(t *testing.T) {
+	mq, base := startBrokerWithAdmin(t, func(c *config.Config) { c.MQTT.SessionExpiryCheckInterval = time.Second })
+	c, _ := connect(t, mq, v5, "short-lived", true, func(p *packets.Connect) { p.Properties.SessionExpiryInterval = u32(1) })
+	listed := func() bool {
+		_, body := httpDo("GET", base+"/v1/clients", "")
+		return strings.Contains(body, "short-lived")
+	}
+	eventually(t, 3*time.Second, "the client is listed", listed)
+	_ = c.c.Close()
+	eventually(t, 8*time.Second, "the expired session is removed with session_expiry_check_interval=1s", func() bool { return !listed() })
+}
+
+func TestEmptyClientIDRefusalUsesTheCodeOfTheProtocolVersionK4x9(t *testing.T) {
+	addr := startBroker(t, func(c *config.Config) { c.MQTT.AllowZeroLenClientID = false })
+	for _, tc := range []struct {
+		v    packets.Version
+		want byte
+	}{{v31, 0x02}} {
+		c := newMQTTConn(t, addr, tc.v)
+		c.send(&packets.Connect{Version: tc.v, ProtocolLevel: tc.v, ProtocolName: []byte("MQTT"), CleanStart: true, KeepAlive: 60, ClientID: []byte{}, Properties: c.props()})
+		p, err := c.recv(3 * time.Second)
+		if err != nil {
+			t.Fatalf("v%d: no answer to a CONNECT with an empty client id (%v)", tc.v, err)
+		}
+		ca, ok := p.(*packets.Connack)
+		if !ok || ca.Code != tc.want {
+			t.Fatalf("v%d: empty client id refused with %v, want CONNACK 0x%02x", tc.v, p, tc.want)
+		}
+	}
+}
+
+// ---------------------------------------------------------------------------
+// Admin API
+
+func freePort(t *testing.T) int {
+	l, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer l.Close()
+	return l.Addr().(*net.TCPAddr).Port
+}
+
+func startBrokerWithAdmin(t *testing.T, mod func(*config.Config)) (mqttAddr, httpBase string) {
+	t.Helper()
+	grpcPort, httpPort := freePort(t), freePort(t)
+	mqttAddr = startBroker(t, func(c *config.Config) {
+		c.API = config.API{
+			GRPC: []*config.Endpoint{{Address: fmt.Sprintf("tcp://127.0.0.1:%d", grpcPort)}},
+			HTTP: []*config.Endpoint{{Address: fmt.Sprintf("tcp://127.0.0.1:%d", httpPort), Map: fmt.Sprintf("tcp://127.0.0.1:%d", grpcPort)}},
+		}
+		if mod != nil {
+			mod(c)
+		}
+	}, mustAdminPlugin(t))
+	httpBase = fmt.Sprintf("http://127.0.0.1:%d", httpPort)
+	eventually(t, 10*time.Second, "admin HTTP API", func() bool {
+		code, _ := httpDo("GET", httpBase+"/v1/clients", "")
+		return code == 200
+	})
+	return mqttAddr, httpBase
+}
+
+func mustAdminPlugin(t *testing.T) server.Plugin {
+	p, err := admin.New(config.DefaultConfig())
+	if err != nil {
+		t.Fatal(err)
+	}
+	return p
+}
+
+func httpDo(method, url, body string) (int, string) {
+	req, _ := http.NewRequest(method, url, bytes.NewBufferString(body))
+	req.Header.Set("Content-Type", "application/json")
+	resp, err := http.DefaultClient.Do(req)
+	if err != nil {
+		return 0, err.Error()
+	}
+	defer resp.Body.Close()
+	b, _ := io.ReadAll(resp.Body)
+	return resp.StatusCode, string(b)
+}
+
+func TestRetainedMessagePublishedThroughTheAdminAPIIsKeptK4x9(t *testing.T) {
+	mq, base := startBrokerWithAdmin(t, nil)
+	code, body := httpDo("POST", base+"/v1/publish", `{"topic_name":"adm/kept","payload":"hello","qos":1,"retained":true}`)
+	if code != 200 {
+		t.Fatalf("publish failed: %d %s", code, body)
+	}
+	code, body = httpDo("POST", base+"/v1/publish", `{"topic_name":"adm/plain","payload":"hello","qos":1}`)
+	if code != 200 {
+		t.Fatalf("publish failed: %d %s", code, body)
+	}
+	late, _ := connect(t, mq, v5, "late", true, nil)
+	subscribeOK(t, late, "adm/#", 1)
+	got := map[string]*packets.Publish{}
+	for _, m := range late.publishes(800 * time.Millisecond) {
+		got[string(m.TopicName)] = m
+	}
+	if got["adm/kept"] == nil || string(got["adm/kept"].Payload) != "hello" {
+		t.Fatalf("a retained message published through the admin API was not delivered to a later subscriber")
+	}
+	if got["adm/plain"] != nil {
+		t.Fatalf("a message published without the retain flag was kept")
+	}
+
+	code, body = httpDo("POST", base+"/v1/publish", `{"topic_name":"adm/kept","payload":"","qos":0,"retained":true}`)
+	if code != 200 {
+		t.Fatalf("publish failed: %d %s", code, body)
+	}
+	after, _ := connect(t, mq, v5, "after", true, nil)
+	subscribeOK(t, after, "adm/#", 1)
+	if n := len(after.publishes(700 * time.Millisecond)); n != 0 {
+		t.Fatalf("an empty retained publish through the admin API did not clear the retained message")
+	}
+}
+
+func TestAdminSubscriptionListFollowsTheSessionK4x9(t *testing.T) {
+	mq, base := startBrokerWithAdmin(t, func(c *config.Config) {
+		c.MQTT.SessionExpiryCheckInterval = time.Second
+	})
+	listed := func(topic string) bool {
+		_, body := httpDo("GET", base+"/v1/subscriptions", "")
+		return strings.Contains(body, topic)
+	}
+
+	live, _ := connect(t, mq, v5, "live", true, nil)
+	subscribeOK(t, live, "adm/live", 1)
+	eventually(t, 3*time.Second, "the subscription of a connected client is listed", func() bool { return listed("adm/live") })
+
+	ended, _ := connect(t, mq, v5, "ended", true, nil)
+	subscribeOK(t, ended, "adm/ended", 1)
+	eventually(t, 3*time.Second, "the subscription is listed", func() bool { return listed("adm/ended") })
+	ended.send(&packets.Disconnect{Version: v5, Properties: ended.props()})
+	_ = ended.c.Close()
+	eventually(t, 5*time.Second, "the subscription of an ended session is no longer listed", func() bool { return !listed("adm/ended") })
+	if !listed("adm/live") {
+		t.Fatalf("the subscription of a connected client disappeared")
+	}
+
+	exp, _ := connect(t, mq, v5, "expiring", true, func(p *packets.Connect) { p.Properties.SessionExpiryInterval = u32(1) })
+	subscribeOK(t, exp, "adm/expiring", 1)
+	eventually(t, 3*time.Second, "the subscription is listed", func() bool { return listed("adm/expiring") })
+	_ = exp.c.Close()
+	eventually(t, 15*time.Second, "the subscription of an expired session is no longer listed", func() bool { return !listed("adm/expiring") })
+}
