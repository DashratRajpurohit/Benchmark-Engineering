+func TestTopicAliasUpToTheAdvertisedMaximumIsAcceptedK4x9(t *testing.T) {
+	addr := startBroker(t, nil)
+	sub, _ := connect(t, addr, v5, "sub", true, nil)
+	subscribeOK(t, sub, "alias/#", 0)
+	pub, ca := connect(t, addr, v5, "pub", true, nil)
+	if ca.Properties == nil || ca.Properties.TopicAliasMaximum == nil {
+		t.Fatalf("CONNACK has no Topic Alias Maximum")
+	}
+	max := *ca.Properties.TopicAliasMaximum
+	pub.publish("alias/x", 0, false, "first", 0, &packets.Properties{TopicAlias: u16(max)})
+	pub.publish("", 0, false, "second", 0, &packets.Properties{TopicAlias: u16(max)})
+	var seen []string
+	for _, m := range sub.publishes(800 * time.Millisecond) {
+		seen = append(seen, string(m.TopicName)+"/"+string(m.Payload))
+	}
+	if got := strings.Join(seen, ","); got != "alias/x/first,alias/x/second" {
+		t.Fatalf("alias %d (the advertised maximum) delivered %q", max, got)
+	}
+}
