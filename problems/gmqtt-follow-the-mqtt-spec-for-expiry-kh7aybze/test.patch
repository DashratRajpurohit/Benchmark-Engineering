+func TestAdvertisedMaximumQoSMatchesConfigK4x9(t *testing.T) {
+	// A server that supports QoS 2 leaves the property out.
+	addr := startBroker(t, nil)
+	_, ca := connect(t, addr, v5, "default", true, nil)
+	if ca.Properties != nil && ca.Properties.MaximumQoS != nil {
+		t.Fatalf("a server supporting QoS 2 advertised Maximum QoS %d", *ca.Properties.MaximumQoS)
+	}
+	for _, max := range []uint8{0, 1} {
+		max := max
+		addr := startBroker(t, func(c *config.Config) { c.MQTT.MaximumQoS = max })
+		_, ca := connect(t, addr, v5, "limited", true, nil)
+		if ca.Properties == nil || ca.Properties.MaximumQoS == nil {
+			t.Fatalf("maximum_qos=%d: no Maximum QoS property in CONNACK", max)
+		}
+		if got := *ca.Properties.MaximumQoS; got != max {
+			t.Fatalf("maximum_qos=%d: CONNACK advertised %d", max, got)
+		}
+	}
+}
+
+func TestSubscriptionsAreGrantedAtMostTheMaximumQoSK4x9(t *testing.T) {
+	addr := startBroker(t, func(c *config.Config) { c.MQTT.MaximumQoS = 1 })
+	for _, v := range []packets.Version{v5, v31} {
+		c, _ := connect(t, addr, v, fmt.Sprintf("sub%d", v), true, nil)
+		for requested, want := range map[uint8]uint8{0: 0, 1: 1, 2: 1} {
+			p := c.subscribe(uint16(requested)+1, topic(fmt.Sprintf("grant/%d", requested), requested))
+			sa, ok := p.(*packets.Suback)
+			if !ok || len(sa.Payload) != 1 {
+				t.Fatalf("v%d: no SUBACK for requested QoS %d: %v", v, requested, p)
+			}
+			if sa.Payload[0] != want {
+				t.Fatalf("v%d: requested QoS %d, granted %d, want %d", v, requested, sa.Payload[0], want)
+			}
+		}
+	}
+}
+
+func TestPublishAboveMaximumQoSIsRejectedK4x9(t *testing.T) {
+	addr := startBroker(t, func(c *config.Config) { c.MQTT.MaximumQoS = 1 })
+	c, _ := connect(t, addr, v5, "pub5", true, nil)
+	c.publish("max/qos", 1, false, "ok", 1, nil)
+	if p, err := c.recv(2 * time.Second); err != nil {
+		t.Fatalf("QoS 1 publish within the maximum was not answered: %v", err)
+	} else if _, ok := p.(*packets.Puback); !ok {
+		t.Fatalf("QoS 1 publish within the maximum: got %T, want PUBACK", p)
+	}
+	c.publish("max/qos", 2, false, "too much", 2, nil)
+	p, err := c.recv(2 * time.Second)
+	if err != nil {
+		t.Fatalf("QoS 2 publish above the maximum: no reaction: %v", err)
+	}
+	if code, ok := disconnectCode(p); !ok || code != 0x9b {
+		t.Fatalf("QoS 2 publish above the maximum: got %v, want DISCONNECT 0x9b", p)
+	}
+
+	c3, _ := connect(t, addr, v31, "pub3", true, nil)
+	c3.publish("max/qos", 2, false, "too much", 3, nil)
+	for {
+		p, err := c3.recv(2 * time.Second)
+		if err != nil {
+			if err.Error() == "timeout" {
+				t.Fatalf("v3.1.1 QoS 2 publish above the maximum: the connection stayed open")
+			}
+			return // the connection was closed
+		}
+		if _, ok := p.(*packets.Pubrec); ok {
+			t.Fatalf("v3.1.1 QoS 2 publish above the maximum was accepted")
+		}
+	}
+}
