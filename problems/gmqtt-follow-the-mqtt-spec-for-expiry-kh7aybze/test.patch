+func TestNoLocalOnASharedSubscriptionIsAProtocolErrorK4x9(t *testing.T) {
+	addr := startBroker(t, nil)
+	c, _ := connect(t, addr, v5, "shared", true, nil)
+	p := c.subscribe(1, packets.Topic{Name: "$share/g/nl/t", SubOptions: packets.SubOptions{Qos: 0, NoLocal: true}})
+	if code, ok := disconnectCode(p); !ok || code != 0x82 {
+		t.Fatalf("no-local on a shared subscription: got %v, want DISCONNECT 0x82", p)
+	}
+	ok1, _ := connect(t, addr, v5, "plainnl", true, nil)
+	if sa, ok := ok1.subscribe(1, packets.Topic{Name: "nl/t", SubOptions: packets.SubOptions{Qos: 0, NoLocal: true}}).(*packets.Suback); !ok || sa.Payload[0] >= 0x80 {
+		t.Fatalf("no-local on a normal subscription was refused")
+	}
+	ok2, _ := connect(t, addr, v5, "plainshared", true, nil)
+	if sa, ok := ok2.subscribe(1, topic("$share/g/nl/t", 0)).(*packets.Suback); !ok || sa.Payload[0] >= 0x80 {
+		t.Fatalf("a shared subscription without no-local was refused")
+	}
+}
