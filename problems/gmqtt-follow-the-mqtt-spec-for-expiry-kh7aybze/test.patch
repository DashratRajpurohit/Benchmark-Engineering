+
+const (
+	v5  = packets.Version5
+	v31 = packets.Version311
+)
+
+type recvItem struct {
+	p   packets.Packet
+	err error
+}
+
+type mqttConn struct {
+	t  *testing.T
+	c  net.Conn
+	w  *packets.Writer
+	ch chan recvItem
+	v  packets.Version
+}
+
+func u16(v uint16) *uint16 { return &v }
+func u32(v uint32) *uint32 { return &v }
+
+// startBroker runs a broker on a loopback listener and returns its address.
+func startBroker(t *testing.T, mod func(*config.Config), plugins ...server.Plugin) string {
+	t.Helper()
+	ln, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	cfg := config.DefaultConfig()
+	if mod != nil {
+		mod(&cfg)
+	}
+	opts := []server.Options{server.WithTCPListener(ln), server.WithConfig(cfg)}
+	for _, p := range plugins {
+		opts = append(opts, server.WithPlugin(p))
+	}
+	srv := server.New(opts...)
+	go func() { _ = srv.Run() }()
+	t.Cleanup(func() {
+		ctx, cancel := context.WithTimeout(context.Background(), 2*time.Second)
+		defer cancel()
+		_ = srv.Stop(ctx)
+	})
+	time.Sleep(300 * time.Millisecond)
+	return ln.Addr().String()
+}
+
+func newMQTTConn(t *testing.T, addr string, v packets.Version) *mqttConn {
+	t.Helper()
+	nc, err := net.Dial("tcp", addr)
+	if err != nil {
+		t.Fatal(err)
+	}
+	c := &mqttConn{t: t, c: nc, w: packets.NewWriter(nc), ch: make(chan recvItem, 1024), v: v}
+	r := packets.NewReader(nc)
+	r.SetVersion(v)
+	go func() {
+		for {
+			p, err := r.ReadPacket()
+			c.ch <- recvItem{p, err}
+			if err != nil {
+				return
+			}
+		}
+	}()
+	t.Cleanup(func() { _ = nc.Close() })
+	return c
+}
+
+func (c *mqttConn) props() *packets.Properties {
+	if c.v == v5 {
+		return &packets.Properties{}
+	}
+	return nil
+}
+
+func (c *mqttConn) send(p packets.Packet) {
+	if err := c.w.WriteAndFlush(p); err != nil {
+		c.t.Logf("write error: %v", err)
+	}
+}
+
+func (c *mqttConn) recv(d time.Duration) (packets.Packet, error) {
+	select {
+	case it := <-c.ch:
+		return it.p, it.err
+	case <-time.After(d):
+		return nil, fmt.Errorf("timeout")
+	}
+}
+
+// publishes returns all PUBLISH packets that arrive until the connection is quiet for the given duration.
+func (c *mqttConn) publishes(quiet time.Duration) []*packets.Publish {
+	var out []*packets.Publish
+	for {
+		p, err := c.recv(quiet)
+		if err != nil {
+			return out
+		}
+		if pub, ok := p.(*packets.Publish); ok {
+			out = append(out, pub)
+		}
+	}
+}
+
+// connect performs the MQTT handshake and returns the CONNACK.
+func connect(t *testing.T, addr string, v packets.Version, id string, clean bool, mod func(*packets.Connect)) (*mqttConn, *packets.Connack) {
+	t.Helper()
+	c := newMQTTConn(t, addr, v)
+	pc := &packets.Connect{Version: v, ProtocolLevel: v, ProtocolName: []byte("MQTT"), CleanStart: clean, KeepAlive: 60, ClientID: []byte(id), Properties: c.props()}
+	if mod != nil {
+		mod(pc)
+	}
+	c.send(pc)
+	p, err := c.recv(3 * time.Second)
+	if err != nil {
+		t.Fatalf("no CONNACK for %q: %v", id, err)
+	}
+	ca, ok := p.(*packets.Connack)
+	if !ok {
+		t.Fatalf("expected CONNACK for %q, got %T", id, p)
+	}
+	return c, ca
+}
+
+func (c *mqttConn) subscribe(pid uint16, topics ...packets.Topic) packets.Packet {
+	c.t.Helper()
+	c.send(&packets.Subscribe{Version: c.v, PacketID: pid, Topics: topics, Properties: c.props()})
+	for {
+		p, err := c.recv(3 * time.Second)
+		if err != nil {
+			return nil
+		}
+		if _, ok := p.(*packets.Publish); ok {
+			continue
+		}
+		return p
+	}
+}
+
+func (c *mqttConn) publish(topic string, qos uint8, retain bool, payload string, pid uint16, pr *packets.Properties) {
+	if pr == nil {
+		pr = c.props()
+	}
+	c.send(&packets.Publish{Version: c.v, Qos: qos, Retain: retain, TopicName: []byte(topic), PacketID: pid, Payload: []byte(payload), Properties: pr})
+}
+
+func topic(name string, qos uint8) packets.Topic {
+	return packets.Topic{Name: name, SubOptions: packets.SubOptions{Qos: qos}}
+}
+
+func subscribeOK(t *testing.T, c *mqttConn, filter string, qos uint8) {
+	t.Helper()
+	p := c.subscribe(1, topic(filter, qos))
+	sa, ok := p.(*packets.Suback)
+	if !ok || len(sa.Payload) != 1 || sa.Payload[0] >= 0x80 {
+		t.Fatalf("subscribe to %q failed: %v", filter, p)
+	}
+}
+
+func disconnectCode(p packets.Packet) (byte, bool) {
+	if d, ok := p.(*packets.Disconnect); ok {
+		return d.Code, true
+	}
+	return 0, false
+}
+
+func eventually(t *testing.T, timeout time.Duration, what string, cond func() bool) {
+	t.Helper()
+	deadline := time.Now().Add(timeout)
+	for time.Now().Before(deadline) {
+		if cond() {
+			return
+		}
+		time.Sleep(100 * time.Millisecond)
+	}
+	t.Fatalf("timed out waiting for: %s", what)
+}
+
+func expiryOf(p *packets.Publish) (uint32, bool) {
+	if p.Properties == nil || p.Properties.MessageExpiry == nil {
+		return 0, false
+	}
+	return *p.Properties.MessageExpiry, true
+}
