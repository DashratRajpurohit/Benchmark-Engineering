+func TestForwardedMessageExpiryIsTheRemainingLifetimeK4x9(t *testing.T) {
+	addr := startBroker(t, nil)
+	sub, _ := connect(t, addr, v5, "sub", true, nil)
+	subscribeOK(t, sub, "fwd/#", 1)
+	pub, _ := connect(t, addr, v5, "pub", true, nil)
+	pub.publish("fwd/with", 0, false, "a", 0, &packets.Properties{MessageExpiry: u32(30)})
+	pub.publish("fwd/without", 0, false, "b", 0, nil)
+	got := map[string]*packets.Publish{}
+	for _, m := range sub.publishes(700 * time.Millisecond) {
+		got[string(m.TopicName)] = m
+	}
+	with, without := got["fwd/with"], got["fwd/without"]
+	if with == nil || without == nil {
+		t.Fatalf("expected both messages, got %d", len(got))
+	}
+	if v, ok := expiryOf(with); !ok || v < 27 || v > 30 {
+		t.Fatalf("forwarded message published with expiry 30 carried %d (present=%v), want 27..30", v, ok)
+	}
+	if v, ok := expiryOf(without); ok {
+		t.Fatalf("message published without an expiry was forwarded with expiry %d", v)
+	}
+}
+
+func TestQueuedMessageExpiryDecreasesWhileWaitingK4x9(t *testing.T) {
+	addr := startBroker(t, nil)
+	persistent := func(p *packets.Connect) { p.Properties.SessionExpiryInterval = u32(120) }
+	off, _ := connect(t, addr, v5, "offline", false, persistent)
+	subscribeOK(t, off, "queued/#", 1)
+	_ = off.c.Close()
+	time.Sleep(300 * time.Millisecond)
+
+	pub, _ := connect(t, addr, v5, "pub", true, nil)
+	pub.publish("queued/long", 1, false, "long", 1, &packets.Properties{MessageExpiry: u32(20)})
+	time.Sleep(3300 * time.Millisecond)
+
+	back, _ := connect(t, addr, v5, "offline", false, persistent)
+	got := map[string]*packets.Publish{}
+	for _, m := range back.publishes(900 * time.Millisecond) {
+		got[string(m.TopicName)] = m
+	}
+	long := got["queued/long"]
+	if long == nil {
+		t.Fatalf("the unexpired queued message was not delivered")
+	}
+	if v, ok := expiryOf(long); !ok || v < 14 || v > 17 {
+		t.Fatalf("queued message with expiry 20 waited about 3s but carried %d (present=%v), want 14..17", v, ok)
+	}
+}
+
+func TestExpiredRetainedMessageIsNotDeliveredK4x9(t *testing.T) {
+	addr := startBroker(t, nil)
+	pub, _ := connect(t, addr, v5, "pub", true, nil)
+	pub.publish("ret/short", 0, true, "short", 0, &packets.Properties{MessageExpiry: u32(2)})
+	pub.publish("ret/long", 0, true, "long", 0, &packets.Properties{MessageExpiry: u32(30)})
+	pub.publish("ret/none", 0, true, "none", 0, nil)
+	time.Sleep(3300 * time.Millisecond)
+
+	sub, _ := connect(t, addr, v5, "sub", true, nil)
+	subscribeOK(t, sub, "ret/#", 0)
+	got := map[string]*packets.Publish{}
+	for _, m := range sub.publishes(700 * time.Millisecond) {
+		got[string(m.TopicName)] = m
+	}
+	if _, ok := got["ret/short"]; ok {
+		t.Fatalf("a retained message was delivered after its Message Expiry Interval had passed")
+	}
+	if got["ret/long"] == nil || got["ret/none"] == nil {
+		t.Fatalf("unexpired retained messages must still be delivered, got %d messages", len(got))
+	}
+}
+
+func TestRetainedMessageExpiryIsTheRemainingLifetimeK4x9(t *testing.T) {
+	addr := startBroker(t, nil)
+	pub, _ := connect(t, addr, v5, "pub", true, nil)
+	pub.publish("rem/a", 0, true, "x", 0, &packets.Properties{MessageExpiry: u32(30)})
+	pub.publish("rem/b", 0, true, "y", 0, nil)
+	time.Sleep(3300 * time.Millisecond)
+
+	sub, _ := connect(t, addr, v5, "sub", true, nil)
+	subscribeOK(t, sub, "rem/#", 0)
+	got := map[string]*packets.Publish{}
+	for _, m := range sub.publishes(700 * time.Millisecond) {
+		got[string(m.TopicName)] = m
+	}
+	a, b := got["rem/a"], got["rem/b"]
+	if a == nil || b == nil {
+		t.Fatalf("expected both retained messages, got %d", len(got))
+	}
+	if v, ok := expiryOf(a); !ok || v < 24 || v > 27 {
+		t.Fatalf("retained message with expiry 30 stored for about 3s carried %d (present=%v), want 24..27", v, ok)
+	}
+	if v, ok := expiryOf(b); ok {
+		t.Fatalf("retained message stored without an expiry carried expiry %d", v)
+	}
+}
