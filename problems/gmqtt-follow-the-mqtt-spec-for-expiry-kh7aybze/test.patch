+func TestWillIsPublishedOnlyWhenTheClientAsksForItK4x9(t *testing.T) {
+	addr := startBroker(t, nil)
+	watch, _ := connect(t, addr, v5, "watch", true, nil)
+	subscribeOK(t, watch, "will/#", 0)
+	withWill := func(topic string) func(*packets.Connect) {
+		return func(p *packets.Connect) {
+			p.WillFlag, p.WillTopic, p.WillMsg = true, []byte(topic), []byte("bye")
+		}
+	}
+	plain, _ := connect(t, addr, v5, "plain", true, withWill("will/normal"))
+	plain.send(&packets.Disconnect{Version: v5, Code: 0x00, Properties: plain.props()})
+	if n := len(watch.publishes(700 * time.Millisecond)); n != 0 {
+		t.Fatalf("a normal DISCONNECT published the will message")
+	}
+	asking, _ := connect(t, addr, v5, "asking", true, withWill("will/asked"))
+	asking.send(&packets.Disconnect{Version: v5, Code: 0x04, Properties: asking.props()})
+	got := watch.publishes(900 * time.Millisecond)
+	if len(got) != 1 || string(got[0].TopicName) != "will/asked" {
+		t.Fatalf("DISCONNECT 0x04 must publish the will message, got %d messages", len(got))
+	}
+}
