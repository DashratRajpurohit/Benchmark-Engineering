+// removeClientSubscriptions removes all subscriptions of the given client.
+func (s *store) removeClientSubscriptions(clientID string) {
+	s.subMu.Lock()
+	defer s.subMu.Unlock()
+	var keys []string
+	s.subIndexer.Iterate(func(elem *list.Element) {
+		if sub := elem.Value.(*Subscription); sub.ClientId == clientID {
+			keys = append(keys, clientID+"_"+sub.TopicName)
+		}
+	}, 0, uint(s.subIndexer.Len()))
+	for _, key := range keys {
+		s.subIndexer.Remove(key)
+	}
+}
+
