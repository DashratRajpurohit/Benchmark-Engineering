+// live returns the retained message with its Message Expiry Interval reduced by the time it has been stored.
+// It returns nil if the node has no message or the message has expired.
+func (t *topicNode) live() *gmqtt.Message {
+	if t.msg == nil || t.msg.MessageExpiry == 0 {
+		return t.msg
+	}
+	stored := uint32(time.Since(t.storedAt).Seconds())
+	if stored >= t.msg.MessageExpiry {
+		return nil
+	}
+	msg := t.msg.Copy()
+	msg.MessageExpiry -= stored
+	return msg
+}
