+			// A genuinely hidden column (for example, a virtual table's
+			// hidden column) that SELECT * does not return.
+			continue
+		}
+		names = append(names, name)
+	}
+	if err := rows.Err(); err != nil {
+		return nil, err
+	}
+	if len(names) == 0 {
+		return nil, fmt.Errorf("no such table: %s", table)
+	}
+	return names, nil
