+			}
+		}
+		if mismatches <= 1 {
+			return append([]int(nil), oldIDs...)
+		}
+	}
+
+	// More changed between these two observations than a single ADD, DROP,
+	// or RENAME can explain. Treating every resulting column as newly
+	// identified is the safe fallback: reconciliation then emits NULL for
+	// it rather than risking another column's surviving value under the
+	// wrong name, which is exactly the failure mode column identity exists
+	// to prevent.
+	ids := make([]int, len(newNames))
+	for i := range ids {
+		ids[i] = *nextID
+		*nextID++
+	}
