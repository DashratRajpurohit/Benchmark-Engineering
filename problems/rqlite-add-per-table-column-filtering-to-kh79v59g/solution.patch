+	case len(newNames) == len(oldNames):
+		// RENAME COLUMN: SQLite renames one column without reordering, so a
+		// same-length change with at most one differing position keeps every
+		// identity, including the renamed column's own -- it is still the
+		// same column under a new name.
+		mismatches := 0
