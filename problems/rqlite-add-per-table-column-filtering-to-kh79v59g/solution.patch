+// remapCDCRow returns a copy of row whose values line up, position for
+// position, with out. row's values are positional in capture -- the
+// identity of the columns the table had when the row was read -- so each
+// output value is matched by column identity: the value whose capture-time
+// column has the same identity as the output column, or an explicit NULL
+// where out names a column whose identity did not exist at capture time.
+// If row is nil, nil is returned.
+//
+// Matching by identity rather than by name or by position is what keeps a
+// schema change made after the row was captured, but before it is
+// reconciled, from re-labelling one column's value as another's -- a
+// rename does not lose the value, since the identity survives even though
+// the name changes, and a column dropped and later recreated under the
+// same name is not mistaken for the column it replaced, since the two
+// never share an identity. A column dropped and never recreated is simply
+// never selected, which is also why an excluded column's value cannot
+// reach the output: out never contains it.
+func remapCDCRow(row *command.CDCRow, capture, out *colLayout) *command.CDCRow {
+	if row == nil {
+		return nil
+	}
+	captureIdx := make(map[int]int, len(capture.ids))
+	for i, id := range capture.ids {
+		captureIdx[id] = i
+	}
+	values := make([]*command.CDCValue, 0, len(out.ids))
+	for _, id := range out.ids {
+		if i, ok := captureIdx[id]; ok && i < len(row.Values) {
+			values = append(values, row.Values[i])
+		} else {
+			values = append(values, &command.CDCValue{})
+		}
+	}
+	return &command.CDCRow{Values: values}
+}
