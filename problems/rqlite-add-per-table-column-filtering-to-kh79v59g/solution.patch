+// diffColumnIdentityOneStep derives newNames' column identity from
+// oldNames' (oldIDs, aligned by position), on the assumption that the two
+// observations are one statement apart -- guaranteed by
+// updateColumnIdentityLocked being invoked at every statement boundary
+// rather than only when some event still needs a layout. SQLite's ALTER
+// TABLE always appends an added column at the end and never reorders
+// columns for a drop or a rename, which is what makes ADD, DROP, and
+// RENAME distinguishable from the resulting name list and its length
+// alone, without parsing the statement itself.
+func diffColumnIdentityOneStep(oldNames []string, oldIDs []int, newNames []string, nextID *int) []int {
+	switch {
+	case len(newNames) == len(oldNames)+1 && slices.Equal(oldNames, newNames[:len(oldNames)]):
+		// ADD COLUMN: everything before it is unchanged, and the appended
+		// column is a genuinely new identity.
+		id := *nextID
