+	var names []string
+	for rows.Next() {
+		var cid, notnull, pk, hidden int64
+		var name, colType string
+		var dflt any
+		if err := rows.Scan(&cid, &name, &colType, &notnull, &dflt, &pk, &hidden); err != nil {
+			return nil, err
+		}
