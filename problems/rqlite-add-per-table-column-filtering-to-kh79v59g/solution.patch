+// way db.ColumnNames does, but through an arbitrary caller-supplied
+// queryer rather than db's own pooled connection.
+func cdcQueryColumnNames(ctx context.Context, q cdcPreCommitQueryer, table string) ([]string, error) {
+	rows, err := q.QueryContext(ctx,
+		fmt.Sprintf(`PRAGMA table_xinfo("%s")`, strings.ReplaceAll(table, `"`, `""`)))
+	if err != nil {
+		return nil, err
+	}
+	defer rows.Close()
