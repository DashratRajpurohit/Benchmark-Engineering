+// Test_CDCColFilter_Streamer_LeadershipInvalidationRequired confirms that
+// InvalidateAll(), which Store calls on Raft leadership transition, makes
+// the first post-transition event correct even when a stale cache's
+// remembered SchemaVersion happens to collide with the current one, so a
+// plain version comparison alone would wrongly trust stale columns.
+func Test_CDCColFilter_Streamer_LeadershipInvalidationRequired(t *testing.T) {
+	ch := make(chan *command.CDCIndexedEventGroup, 10)
+	np := &schemaVersionedProvider{
+		Columns: map[string][]string{"users": {"id", "ssn", "name"}},
+		Version: 5,
+	}
+	streamer, err := NewCDCStreamer(ch, np, map[string][]string{"users": {"ssn"}})
+	if err != nil {
+		t.Fatalf("error creating CDCStreamer: %v", err)
+	}
+
+	streamer.Reset(1)
+	if err := streamer.PreupdateHook(&command.CDCEvent{
+		Table:  "users",
+		Op:     command.CDCEvent_INSERT,
+		NewRow: &command.CDCRow{Values: []*command.CDCValue{cdcColFilterInt(1), cdcColFilterStr("111"), cdcColFilterStr("alice")}},
+	}); err != nil {
+		t.Fatalf("PreupdateHook: %v", err)
+	}
+	streamer.CommitHook()
+	<-ch // drain, cache built at Version 5 with columns [id ssn name]
+
+	// This node was a follower and never processed a commit for "users"
+	// while a schema change happened elsewhere, so its cache is stale.
+	// SchemaVersion() now reports "5" again -- a collision with the stale
+	// cache's remembered version, standing in for a real repeated value
+	// (e.g. after a restore, or an implementation detail of how a given
+	// backend assigns version numbers). The columns underneath disagree
+	// with what was cached: "email" replaces "ssn".
+	np.Columns["users"] = []string{"id", "email", "name"}
+
+	// This node just became leader. Store.selfLeaderChange's caller invokes
+	// exactly this before trusting the streamer for the first time.
+	streamer.InvalidateAll()
+
+	streamer.Reset(2)
+	if err := streamer.PreupdateHook(&command.CDCEvent{
+		Table:  "users",
+		Op:     command.CDCEvent_INSERT,
+		NewRow: &command.CDCRow{Values: []*command.CDCValue{cdcColFilterInt(2), cdcColFilterStr("bob@example.com"), cdcColFilterStr("bob")}},
+	}); err != nil {
+		t.Fatalf("PreupdateHook: %v", err)
+	}
+	streamer.CommitHook()
+
+	select {
+	case group := <-ch:
+		got := group.Events[0]
+		// The filter names "ssn", which no longer exists -- a stale cache
+		// would still exclude index 1 (where "ssn" used to be), silently
+		// dropping the new "email" column's value instead.
+		if !slices.Equal(got.ColumnNames, []string{"id", "email", "name"}) {
+			t.Fatalf("expected fresh column names [id email name] after leadership transition, got %v -- "+
+				"a schema-version collision without the explicit InvalidateAll() call would still trust "+
+				"the stale [id ssn name] cache", got.ColumnNames)
+		}
+		if !reflect.DeepEqual(cdcColFilterRowValuesAsAny(got.NewRow), []any{int64(2), "bob@example.com", "bob"}) {
+			t.Fatalf("expected new row [2 bob@example.com bob], got %v",
+				cdcColFilterRowValuesAsAny(got.NewRow))
+		}
+	case <-time.After(2 * time.Second):
+		t.Fatal("timeout waiting for CDC event")
+	}
+}
