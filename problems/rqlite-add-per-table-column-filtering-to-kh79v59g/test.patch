+// Test_CDCColFilter_Streamer_SchemaVersionErrorFailsSafe confirms that if the
+// ColumnsNameProvider can't report a SchemaVersion, the CDCStreamer treats
+// that as "cache unknown" and re-derives from scratch, rather than trusting
+// (and continuing to serve) whatever it had cached before.
+func Test_CDCColFilter_Streamer_SchemaVersionErrorFailsSafe(t *testing.T) {
+	ch := make(chan *command.CDCIndexedEventGroup, 10)
+	np := &schemaVersionedProvider{
+		Columns: map[string][]string{
+			"users": {"id", "ssn", "name"},
+		},
