+// Test_CDCColFilter_Store_FilterCacheStableAcrossCommits covers a table
+// whose columns are first observed alongside another table in one ordinary
+// commit, then alone in a later, separate commit. Column identity restarts
+// at zero every commit, so the two commits number the same table
+// differently; the cached, name-based retained-column list is safe to
+// reuse across commits, but a numeric identity taken from an earlier
+// commit's cache is not.
+func Test_CDCColFilter_Store_FilterCacheStableAcrossCommits(t *testing.T) {
+	s, ln := mustNewStore(t)
+	defer ln.Close()
+
+	cdcChannel := make(chan *proto.CDCIndexedEventGroup, 100)
+
+	if err := s.Open(); err != nil {
+		t.Fatalf("failed to open single-node store: %s", err.Error())
+	}
+	if err := s.Bootstrap(NewServer(s.ID(), s.Addr(), true)); err != nil {
+		t.Fatalf("failed to bootstrap single-node store: %s", err.Error())
+	}
+	defer s.Close(true)
+	if _, err := s.WaitForLeader(10 * time.Second); err != nil {
+		t.Fatalf("Error waiting for leader: %s", err)
+	}
+
+	// A trigger, not an explicit transaction, is what gets two tables into
+	// one ordinary commit: an explicit transaction refreshes its cache live
+	// through PreCommitRefresh, which would mask exactly the staleness this
+	// test exists to catch.
+	er := executeRequestFromStrings([]string{
+		`CREATE TABLE accounts (id INTEGER NOT NULL PRIMARY KEY, x TEXT)`,
+		`CREATE TABLE users (id INTEGER NOT NULL PRIMARY KEY, ssn TEXT, name TEXT)`,
+		`CREATE TRIGGER seed_user AFTER INSERT ON accounts BEGIN
+			INSERT INTO users(id, ssn, name) VALUES (NEW.id, 'aaa-11-0001', 'alice');
+		END`,
+	}, false, false)
+	if _, _, err := s.Execute(context.Background(), er); err != nil {
+		t.Fatalf("failed to create tables and trigger: %s", err.Error())
+	}
+
+	if err := s.EnableCDC(cdcChannel, nil, false, map[string][]string{"users": {"ssn"}}); err != nil {
+		t.Fatalf("failed to enable CDC: %v", err)
+	}
+
+	// Commit 1: an ordinary (non-explicit-transaction) single statement,
+	// cascading through the trigger into a second table. Both tables'
+	// columns are first observed here, together, so "users" ends up with
+	// identity numbers offset by "accounts" preceding it.
+	er = executeRequestFromString(`INSERT INTO accounts(id, x) VALUES(1, 'a1')`, false, false)
+	if _, _, err := s.Execute(context.Background(), er); err != nil {
+		t.Fatalf("failed to execute commit 1: %s", err.Error())
+	}
+
+	group := drainCDCGroup(t, cdcChannel, 2)
+	var usersEv1 *proto.CDCEvent
+	for _, ev := range group.Events {
+		if ev.Table == "users" {
+			usersEv1 = ev
+		}
+	}
+	if usersEv1 == nil {
+		t.Fatalf("expected a users event in commit 1's group, got %v", group.Events)
+	}
+	if usersEv1.Error != "" {
+		t.Fatalf("unexpected users event error: %s", usersEv1.Error)
+	}
+	if !slices.Equal(usersEv1.ColumnNames, []string{"id", "name"}) {
+		t.Fatalf("expected users column names [id name] with ssn excluded, got %v", usersEv1.ColumnNames)
+	}
+	if usersEv1.NewRow.Values[0].GetI() != 1 || usersEv1.NewRow.Values[1].GetS() != "alice" {
+		t.Fatalf("expected users row (1 \"alice\"), got %v", usersEv1.NewRow.Values)
+	}
+
+	// Commit 2: a separate, later, ordinary commit touching only "users" --
+	// no trigger involved, so this commit's own identity numbering starts
+	// fresh at zero for "users" alone, unlike commit 1's, where "accounts"
+	// went first. The schema has not changed, so this is exactly the
+	// situation in which s.filterCache legitimately reuses what commit 1
+	// cached for "users".
+	er = executeRequestFromString(
+		`INSERT INTO users(id, ssn, name) VALUES(2, 'bbb-22-0002', 'bob')`, false, false)
+	if _, _, err := s.Execute(context.Background(), er); err != nil {
+		t.Fatalf("failed to execute commit 2: %s", err.Error())
+	}
+
+	ev2 := drainCDCEvent(t, cdcChannel)
+	if ev2.Error != "" {
+		t.Fatalf("unexpected users event error: %s", ev2.Error)
+	}
+	if !slices.Equal(ev2.ColumnNames, []string{"id", "name"}) {
+		t.Fatalf("expected users column names [id name] with ssn excluded, got %v", ev2.ColumnNames)
+	}
+	if len(ev2.NewRow.Values) != 2 {
+		t.Fatalf("expected 2 row values, got %d", len(ev2.NewRow.Values))
+	}
+	if ev2.NewRow.Values[0].GetI() != 2 {
+		t.Fatalf("expected the id field to be 2, got %v", ev2.NewRow.Values[0])
+	}
+	if ev2.NewRow.Values[1].GetS() != "bob" {
+		t.Fatalf("expected the name field to be \"bob\", got %v -- a stale cross-commit "+
+			"identity would misroute or drop it", ev2.NewRow.Values[1])
+	}
+	for _, v := range ev2.NewRow.Values {
+		if v.GetS() == "bbb-22-0002" {
+			t.Fatalf("excluded ssn value leaked into a users event: %v", ev2.NewRow.Values)
+		}
+	}
+}
