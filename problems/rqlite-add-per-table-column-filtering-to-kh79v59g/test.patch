+// Test_CDCColFilter_Store_SchemaEvolution_CommentPrefixedDDL confirms that
+// schema-change detection triggers on the database's actual schema, not on
+// the leading keyword of the SQL text. A DDL statement prefixed by a valid
+// SQL line comment still bumps sqlite3's schema-version counter, and the
+// event below must include the new column.
+func Test_CDCColFilter_Store_SchemaEvolution_CommentPrefixedDDL(t *testing.T) {
+	s, ln := mustNewStore(t)
+	defer ln.Close()
+
+	cdcChannel := make(chan *proto.CDCIndexedEventGroup, 100)
+
+	if err := s.Open(); err != nil {
+		t.Fatalf("failed to open single-node store: %s", err.Error())
+	}
+	if err := s.Bootstrap(NewServer(s.ID(), s.Addr(), true)); err != nil {
+		t.Fatalf("failed to bootstrap single-node store: %s", err.Error())
+	}
+	defer s.Close(true)
+	if _, err := s.WaitForLeader(10 * time.Second); err != nil {
+		t.Fatalf("Error waiting for leader: %s", err)
+	}
+
+	er := executeRequestFromString(
+		`CREATE TABLE users (id INTEGER NOT NULL PRIMARY KEY, name TEXT)`, false, false)
+	if _, _, err := s.Execute(context.Background(), er); err != nil {
+		t.Fatalf("failed to create table: %s", err.Error())
+	}
+
+	if err := s.EnableCDC(cdcChannel, nil, false, nil); err != nil {
+		t.Fatalf("failed to enable CDC: %v", err)
+	}
+
+	er = executeRequestFromString(
+		`INSERT INTO users(id, name) VALUES(1, "alice")`, false, false)
+	if _, _, err := s.Execute(context.Background(), er); err != nil {
+		t.Fatalf("failed to execute INSERT: %s", err.Error())
+	}
+	ev := drainCDCEvent(t, cdcChannel)
+	if !slices.Equal(ev.ColumnNames, []string{"id", "name"}) {
+		t.Fatalf("expected column names [id name] before schema change, got %v", ev.ColumnNames)
+	}
+
+	// This ALTER TABLE is preceded by a valid SQL line comment before the
+	// statement keyword. SQLite parses straight through it; the schema
+	// changes exactly as if the comment were absent.
+	er = executeRequestFromString(
+		"-- add an audit column\nALTER TABLE users ADD COLUMN email TEXT", false, false)
+	if _, _, err := s.Execute(context.Background(), er); err != nil {
+		t.Fatalf("failed to add column via comment-prefixed DDL: %s", err.Error())
+	}
+
+	er = executeRequestFromString(
+		`INSERT INTO users(id, name, email) VALUES(2, "bob", "bob@example.com")`, false, false)
+	if _, _, err := s.Execute(context.Background(), er); err != nil {
+		t.Fatalf("failed to execute second INSERT: %s", err.Error())
+	}
+	ev = drainCDCEvent(t, cdcChannel)
+	if ev.Error != "" {
+		t.Fatalf("unexpected event error: %s", ev.Error)
+	}
+	if !slices.Equal(ev.ColumnNames, []string{"id", "name", "email"}) {
+		t.Fatalf("expected column names [id name email] after comment-prefixed ADD COLUMN, got %v -- "+
+			"schema-change detection must not depend on the SQL text's leading keyword", ev.ColumnNames)
+	}
+	if len(ev.NewRow.Values) != 3 {
+		t.Fatalf("expected 3 row values, got %d", len(ev.NewRow.Values))
+	}
+	if ev.NewRow.Values[2].GetS() != "bob@example.com" {
+		t.Fatalf("expected third value to be the new email column, got %v", ev.NewRow.Values[2])
+	}
+}
