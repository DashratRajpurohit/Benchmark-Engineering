+// Test_CDCColFilter_Store_LeadershipTransitionInvalidatesCache confirms that
+// after a node becomes the Raft leader, filtered CDC events it produces
+// reflect the table's current schema rather than anything it may have cached
+// while it was a follower.
+func Test_CDCColFilter_Store_LeadershipTransitionInvalidatesCache(t *testing.T) {
+	s0, ln0 := mustNewStore(t)
+	defer ln0.Close()
+	if err := s0.Open(); err != nil {
+		t.Fatalf("failed to open s0: %s", err.Error())
+	}
+	defer s0.Close(true)
+
+	s1, ln1 := mustNewStore(t)
+	defer ln1.Close()
+	if err := s1.Open(); err != nil {
+		t.Fatalf("failed to open s1: %s", err.Error())
+	}
+	defer s1.Close(true)
+
+	if err := s0.Bootstrap(NewServer(s0.ID(), s0.Addr(), true)); err != nil {
+		t.Fatalf("failed to bootstrap s0: %s", err.Error())
+	}
+	if _, err := s0.WaitForLeader(10 * time.Second); err != nil {
+		t.Fatalf("Error waiting for leader: %s", err)
+	}
+	if err := s0.Join(joinRequest(s1.ID(), s1.Addr(), true)); err != nil {
+		t.Fatalf("failed to join s1 to the cluster: %s", err.Error())
+	}
+	if _, err := s1.WaitForLeader(10 * time.Second); err != nil {
+		t.Fatalf("Error waiting for leader on s1: %s", err)
+	}
+
+	er := executeRequestFromString(
+		`CREATE TABLE users (id INTEGER NOT NULL PRIMARY KEY, ssn TEXT, name TEXT)`, false, false)
+	if _, _, err := s0.Execute(context.Background(), er); err != nil {
+		t.Fatalf("failed to create table: %s", err.Error())
+	}
+
+	// Enable CDC identically on both nodes, as a real deployment streaming
+	// from whichever node is leader would. Both apply every Raft log entry
+	// (that's how the FSM works), so s1's streamer caches "users" columns
+	// too, despite never being leader yet.
+	s0Channel := make(chan *proto.CDCIndexedEventGroup, 100)
+	s1Channel := make(chan *proto.CDCIndexedEventGroup, 100)
+	if err := s0.EnableCDC(s0Channel, nil, false, map[string][]string{"users": {"ssn"}}); err != nil {
+		t.Fatalf("failed to enable CDC on s0: %v", err)
+	}
+	if err := s1.EnableCDC(s1Channel, nil, false, map[string][]string{"users": {"ssn"}}); err != nil {
+		t.Fatalf("failed to enable CDC on s1: %v", err)
+	}
+
+	er = executeRequestFromString(
+		`INSERT INTO users(id, ssn, name) VALUES(1, "111-22-3333", "alice")`, false, false)
+	if _, _, err := s0.Execute(context.Background(), er); err != nil {
+		t.Fatalf("failed to execute INSERT: %s", err.Error())
+	}
+	drainCDCEvent(t, s0Channel) // s0 is leader and actually streams
+	drainCDCEvent(t, s1Channel) // s1 also applies the log entry and caches columns as a follower
+
+	// Change the schema while s0 is still leader.
+	er = executeRequestFromString(`ALTER TABLE users ADD COLUMN email TEXT`, false, false)
+	if _, _, err := s0.Execute(context.Background(), er); err != nil {
+		t.Fatalf("failed to add column: %s", err.Error())
+	}
+	er = executeRequestFromString(
+		`INSERT INTO users(id, ssn, name, email) VALUES(2, "222", "bob", "bob@example.com")`,
+		false, false)
+	if _, _, err := s0.Execute(context.Background(), er); err != nil {
+		t.Fatalf("failed to execute INSERT after ALTER TABLE: %s", err.Error())
+	}
+	drainCDCEvent(t, s0Channel)
+	drainCDCEvent(t, s1Channel) // s1's own SchemaVersion check keeps it correct too, as a control
+
+	// Now make s1 the leader.
+	if err := s0.Stepdown(true, s1.ID()); err != nil {
+		t.Fatalf("leader failed to step down to s1: %s", err.Error())
+	}
+	if _, err := s0.WaitForLeader(10 * time.Second); err != nil {
+		t.Fatalf("Error waiting for new leader: %s", err)
+	}
+	leader, err := s1.Leader()
+	if err != nil || leader.ID != s1.ID() {
+		t.Fatalf("expected s1 to become leader, got %v (err: %v)", leader, err)
+	}
+
+	er = executeRequestFromString(
+		`INSERT INTO users(id, ssn, name, email) VALUES(3, "333", "carol", "carol@example.com")`,
+		false, false)
+	if _, _, err := s1.Execute(context.Background(), er); err != nil {
+		t.Fatalf("failed to execute INSERT on new leader: %s", err.Error())
+	}
+	ev := drainCDCEvent(t, s1Channel)
+	if !slices.Equal(ev.ColumnNames, []string{"id", "name", "email"}) {
+		t.Fatalf("expected column names [id name email] from new leader, got %v", ev.ColumnNames)
+	}
+	if len(ev.NewRow.Values) != 3 {
+		t.Fatalf("expected 3 row values, got %d", len(ev.NewRow.Values))
+	}
+	if ev.NewRow.Values[2].GetS() != "carol@example.com" {
+		t.Fatalf("expected third value to be the email column, got %v", ev.NewRow.Values[2])
+	}
+}
