+// Test_CDCColFilter_Streamer_InvalidateAll confirms that InvalidateAll forces
+// a fresh lookup on the next commit even when SchemaVersion hasn't changed --
+// the case that matters after a database restore (a new file's schema
+// version can coincidentally collide with the cached one) or a leadership
+// transition, neither of which SchemaVersion alone is trusted to catch.
+func Test_CDCColFilter_Streamer_InvalidateAll(t *testing.T) {
+	ch := make(chan *command.CDCIndexedEventGroup, 10)
+	np := &mockColumnNamesProvider{
+		columns: map[string][]string{
+			"users": {"id", "ssn", "name"},
+		},
+	}
+	streamer, err := NewCDCStreamer(ch, np, map[string][]string{"users": {"ssn"}})
+	if err != nil {
+		t.Fatalf("error creating CDCStreamer: %v", err)
+	}
+
+	streamer.Reset(1)
+	if err := streamer.PreupdateHook(&command.CDCEvent{
+		Table:  "users",
+		Op:     command.CDCEvent_INSERT,
+		NewRow: &command.CDCRow{Values: []*command.CDCValue{cdcColFilterInt(1), cdcColFilterStr("111"), cdcColFilterStr("alice")}},
+	}); err != nil {
+		t.Fatalf("PreupdateHook: %v", err)
+	}
+	streamer.CommitHook()
+	<-ch // drain, cache is now populated
+
+	// Simulate a restore to a database whose users table happens to report
+	// the same SchemaVersion (e.g. both are freshly-created single-table
+	// databases) but has a different, incompatible column layout.
+	np.columns["users"] = []string{"id", "name"} // "ssn" column no longer exists at all
+	streamer.InvalidateAll()
+
+	streamer.Reset(2)
+	if err := streamer.PreupdateHook(&command.CDCEvent{
+		Table:  "users",
+		Op:     command.CDCEvent_INSERT,
+		NewRow: &command.CDCRow{Values: []*command.CDCValue{cdcColFilterInt(2), cdcColFilterStr("carol")}},
+	}); err != nil {
+		t.Fatalf("PreupdateHook: %v", err)
+	}
+	streamer.CommitHook()
+
+	select {
+	case group := <-ch:
+		got := group.Events[0]
+		// "ssn" is absent from the post-restore schema entirely, so the
+		// filter has nothing to exclude: both remaining columns pass through.
+		if !slices.Equal(got.ColumnNames, []string{"id", "name"}) {
+			t.Fatalf("expected [id name] after InvalidateAll, got %v", got.ColumnNames)
+		}
+		if !reflect.DeepEqual(cdcColFilterRowValuesAsAny(got.NewRow), []any{int64(2), "carol"}) {
+			t.Fatalf("expected new row [2 carol], got %v", cdcColFilterRowValuesAsAny(got.NewRow))
+		}
+	case <-time.After(2 * time.Second):
+		t.Fatal("timeout waiting for CDC event")
+	}
+}
