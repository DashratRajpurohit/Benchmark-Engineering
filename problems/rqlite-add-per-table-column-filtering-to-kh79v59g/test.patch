+		false, false)
+	if _, _, err := src.Execute(context.Background(), srcEr); err != nil {
+		t.Fatalf("failed to create table on source store: %s", err.Error())
+	}
+	dbBytes, err := src.Database(false)
+	if err != nil {
+		t.Fatalf("failed to serialize source database: %s", err.Error())
+	}
+
+	if _, err := s.ReadFrom(bytes.NewReader(dbBytes)); err != nil {
+		t.Fatalf("failed to ReadFrom: %s", err.Error())
+	}
+
+	er = executeRequestFromString(
+		`INSERT INTO users(id, ssn, name, dept) VALUES(2, "444-55-6666", "bob", "eng")`, false, false)
+	if _, _, err := s.Execute(context.Background(), er); err != nil {
+		t.Fatalf("failed to execute post-ReadFrom INSERT: %s", err.Error())
+	}
+	ev = drainCDCEvent(t, cdcChannel)
+	if !slices.Equal(ev.ColumnNames, []string{"id", "name", "dept"}) {
+		t.Fatalf("expected column names [id name dept] after ReadFrom, got %v -- a stale cache "+
+			"would still report the pre-install [id name] layout", ev.ColumnNames)
+	}
+	if len(ev.NewRow.Values) != 3 {
+		t.Fatalf("expected 3 row values, got %d", len(ev.NewRow.Values))
+	}
+	if ev.NewRow.Values[2].GetS() != "eng" {
+		t.Fatalf("expected third value to be the new dept column, got %v", ev.NewRow.Values[2])
+	}
+}
+
+// Test_CDCColFilter_Store_SchemaEvolution_UpdateWithDDL confirms that an
+// UPDATE combined with schema-changing DDL in one explicit transaction
+// reconciles both the old and new row images against the transaction's
+// final columns. Every other same-transaction test here uses only INSERT,
+// which never has an OldRow.
+func Test_CDCColFilter_Store_SchemaEvolution_UpdateWithDDL(t *testing.T) {
+	s, ln := mustNewStore(t)
+	defer ln.Close()
+
+	cdcChannel := make(chan *proto.CDCIndexedEventGroup, 100)
+
+	if err := s.Open(); err != nil {
+		t.Fatalf("failed to open single-node store: %s", err.Error())
+	}
+	if err := s.Bootstrap(NewServer(s.ID(), s.Addr(), true)); err != nil {
+		t.Fatalf("failed to bootstrap single-node store: %s", err.Error())
+	}
+	defer s.Close(true)
+	if _, err := s.WaitForLeader(10 * time.Second); err != nil {
+		t.Fatalf("Error waiting for leader: %s", err)
+	}
+
+	er := executeRequestFromString(
+		`CREATE TABLE users (id INTEGER NOT NULL PRIMARY KEY, ssn TEXT, name TEXT)`, false, false)
+	if _, _, err := s.Execute(context.Background(), er); err != nil {
+		t.Fatalf("failed to create table: %s", err.Error())
+	}
+	if err := s.EnableCDC(cdcChannel, nil, false, map[string][]string{"users": {"ssn"}}); err != nil {
+		t.Fatalf("failed to enable CDC: %v", err)
+	}
+
+	// A row that exists before the transaction under test, so the UPDATE
+	// below has a real "before" image to carry.
+	er = executeRequestFromString(
+		`INSERT INTO users(id, ssn, name) VALUES(9, "999-99-9999", "erin")`, false, false)
+	if _, _, err := s.Execute(context.Background(), er); err != nil {
+		t.Fatalf("failed to execute INSERT: %s", err.Error())
+	}
+	drainCDCEvent(t, cdcChannel)
+
+	// One explicit transaction: rename the unfiltered "name" column, then
+	// update the row. Final columns are (id, name(=ssn, filtered out),
+	// full_name); both OldRow and NewRow must reflect that layout, with
+	// the pre-transaction value surviving under the renamed column in
+	// OldRow, and the updated value under it in NewRow.
+	er = executeRequestFromStrings([]string{
+		`ALTER TABLE users RENAME COLUMN name TO full_name`,
+		`UPDATE users SET full_name = "erin2" WHERE id = 9`,
+	}, false, true)
+	if _, _, err := s.Execute(context.Background(), er); err != nil {
+		t.Fatalf("failed to execute same-transaction RENAME-then-UPDATE: %s", err.Error())
+	}
+
+	ev := drainCDCEvent(t, cdcChannel)
+	if ev.Error != "" {
+		t.Fatalf("unexpected event error: %s", ev.Error)
+	}
+	if !slices.Equal(ev.ColumnNames, []string{"id", "full_name"}) {
+		t.Fatalf("expected column names [id full_name], got %v", ev.ColumnNames)
+	}
+	if len(ev.OldRow.Values) != 2 || len(ev.NewRow.Values) != 2 {
+		t.Fatalf("expected 2 values in both old and new rows, got old=%d new=%d",
+			len(ev.OldRow.Values), len(ev.NewRow.Values))
+	}
+	if ev.OldRow.Values[0].GetI() != 9 {
+		t.Fatalf("expected old row id 9, got %v", ev.OldRow.Values[0])
+	}
+	if ev.OldRow.Values[1].GetS() != "erin" {
+		t.Fatalf("expected old row's renamed column to carry the pre-update value 'erin', got %v",
+			ev.OldRow.Values[1])
+	}
+	if ev.NewRow.Values[0].GetI() != 9 {
+		t.Fatalf("expected new row id 9, got %v", ev.NewRow.Values[0])
+	}
+	if ev.NewRow.Values[1].GetS() != "erin2" {
+		t.Fatalf("expected new row's renamed column to carry the updated value 'erin2', got %v",
+			ev.NewRow.Values[1])
+	}
+}
diff --git a/system_test/cdc_columnfilter_f3c841_test.go b/system_test/cdc_columnfilter_f3c841_test.go
new file mode 100644
index 00000000..d2002d09
--- /dev/null
+++ b/system_test/cdc_columnfilter_f3c841_test.go
@@ -0,0 +1,100 @@
+//go:build cdccolumnfilter
+
+package system
+
+import (
+	"testing"
+	"time"
+
+	"github.com/rqlite/rqlite/v10/cdc"
+	"github.com/rqlite/rqlite/v10/cdc/cdctest"
+	cdcjson "github.com/rqlite/rqlite/v10/cdc/json"
+)
+
+// Test_CDCColFilter_EndToEnd drives a real single-node cluster, configures CDC with a
+// column filter, and inspects the actual JSON delivered to the webhook endpoint to
+// confirm the filtered column never appears in either the "before" or "after" data,
+// while other columns, and other tables not named in the filter, are delivered as usual.
+func Test_CDCColFilter_EndToEnd(t *testing.T) {
+	node := mustNewLeaderNode("node1")
+	defer node.Deprovision()
+
+	testEndpoint := cdctest.NewHTTPTestServer()
+	testEndpoint.Start()
+	defer testEndpoint.Close()
+
+	cdcCluster := cdc.NewCDCCluster(node.Store, node.Cluster, node.Client)
+	cdcService, err := cdc.NewService(node.ID, node.Dir, cdcCluster, mustCDCConfig(testEndpoint.URL()))
+	if err != nil {
+		t.Fatalf("failed to create CDC service: %s", err.Error())
+	}
+	node.CDC = cdcService
+	node.CDC.Start()
+	node.CDC.SetLeader(true)
+
+	if err := node.Store.EnableCDC(node.CDC.C(), nil, false,
+		map[string][]string{"users": {"ssn"}}); err != nil {
+		t.Fatalf("failed to enable CDC: %v", err)
+	}
+
+	if _, err := node.Execute(
+		`CREATE TABLE users (id INTEGER NOT NULL PRIMARY KEY, ssn TEXT, name TEXT)`); err != nil {
+		t.Fatalf("failed to create users table: %v", err)
+	}
+	if _, err := node.Execute(
+		`CREATE TABLE orders (id INTEGER NOT NULL PRIMARY KEY, total REAL)`); err != nil {
+		t.Fatalf("failed to create orders table: %v", err)
+	}
+	if _, err := node.Execute(
+		`INSERT INTO users (id, ssn, name) VALUES (1, '111-22-3333', 'Alice')`); err != nil {
+		t.Fatalf("failed to insert into users: %v", err)
+	}
+	if _, err := node.Execute(`INSERT INTO orders (id, total) VALUES (1, 42.5)`); err != nil {
+		t.Fatalf("failed to insert into orders: %v", err)
+	}
+
+	testPoll(t, func() (bool, error) {
+		return testEndpoint.GetMessageCount() == 2, nil
+	}, 100*time.Millisecond, 10*time.Second)
+
+	var usersAfter, ordersAfter map[string]any
+	for _, req := range testEndpoint.GetRequests() {
+		var envelope cdcjson.CDCMessagesEnvelope
+		if err := cdcjson.UnmarshalFromEnvelopeJSON(req, &envelope); err != nil {
+			t.Fatalf("failed to unmarshal CDC envelope: %v", err)
+		}
+		for _, msg := range envelope.Payload {
+			for _, ev := range msg.Events {
+				if ev.Error != "" {
+					t.Fatalf("CDC event reported an error: %s", ev.Error)
+				}
+				switch ev.Table {
+				case "users":
+					usersAfter = ev.After
+				case "orders":
+					ordersAfter = ev.After
+				}
+			}
+		}
+	}
+
+	if usersAfter == nil {
+		t.Fatal("never received a CDC event for the users table")
+	}
+	if _, ok := usersAfter["ssn"]; ok {
+		t.Fatalf("filtered column 'ssn' present in delivered payload: %v", usersAfter)
+	}
+	if got, ok := usersAfter["name"]; !ok || got != "Alice" {
+		t.Fatalf("expected name 'Alice' to still be delivered, got %v", usersAfter)
+	}
+	if _, ok := usersAfter["id"]; !ok {
+		t.Fatalf("expected id column to still be delivered, got %v", usersAfter)
+	}
+
+	if ordersAfter == nil {
+		t.Fatal("never received a CDC event for the orders table")
+	}
+	if len(ordersAfter) != 2 {
+		t.Fatalf("expected orders table to be unaffected by the users-only filter, got %v", ordersAfter)
+	}
+}
diff --git a/test.sh b/test.sh
new file mode 100755
index 00000000..391614eb
--- /dev/null
+++ b/test.sh
@@ -0,0 +1,166 @@
+#!/usr/bin/env bash
+# Test runner for the CDC column-filter change.
+#
+# Usage:
+#   ./test.sh [--output_path <junit.xml>] <base|new>
+#
+#   base  runs the existing test suite for the packages this change touches
+#         (cdc, db, store, system_test). Must pass both before and after the
+#         solution patch is applied. Skips two pre-existing tests, unrelated
+#         to this change, that are unreliable in this sandbox (see the
+#         comments at their -skip usage below).
+#   new   runs the new tests added for this change. They're gated behind the
+#         "cdccolumnfilter" build tag, so before the solution patch adds the
+#         APIs they exercise, some of the packages they live in fail to
+#         build -- a legitimate failure for this mode. go-junit-report can't
+#         translate a build failure into individual per-test results, so for
+#         each package that failed to build, this mode replaces that one
+#         package's report with a JUnit failure entry for each new test it
+#         defines, using the compiler output as the failure detail, instead
+#         of leaving the whole package as one opaque, unattributed failure.
+#         Every other package -- including ones that build fine even before
+#         the solution patch, and every package once the patch is applied --
+#         keeps its real, individual per-test results untouched.
+set -uo pipefail
+
+cd /app
+
+OUTPUT_PATH=""
+if [ "${1:-}" = "--output_path" ]; then
+  OUTPUT_PATH="$2"
+  shift 2
+fi
+
+MODE="${1:-new}"
+
+TEST_LOG="$(mktemp)"
+STATUS=0
+
+run_tests() {
+  go test -count=1 -v -timeout 20m "$@" 2>&1 | tee -a "$TEST_LOG"
+  status=${PIPESTATUS[0]}
+  if [ "$status" -ne 0 ]; then
+    STATUS=$status
+  fi
+}
+
+# xml_escape escapes the minimum needed for safe JUnit XML text content.
+xml_escape() {
+  local s="$1"
+  s="${s//&/\&amp;}"
+  s="${s//</\&lt;}"
+  s="${s//>/\&gt;}"
+  printf '%s' "$s"
+}
+
+# write_suite writes one <testsuite> with one failing <testcase> per given
+# test name to $outfile, all sharing $body as their failure detail. Used
+# only for a package that failed to build, where no individual per-test
+# result exists to report instead.
+write_suite() {
+  local outfile="$1" pkg="$2" body="$3"
+  shift 3
+  local names=("$@")
+  local n="${#names[@]}"
+  printf '  <testsuite name="%s" tests="%d" failures="%d" errors="0" skipped="0">\n' "$pkg" "$n" "$n" >> "$outfile"
+  local t
+  for t in "${names[@]}"; do
+    printf '    <testcase classname="%s" name="%s">\n' "$pkg" "$t" >> "$outfile"
+    printf '      <failure message="package failed to build">%s</failure>\n' "$body" >> "$outfile"
+    printf '    </testcase>\n' >> "$outfile"
+  done
+  printf '  </testsuite>\n' >> "$outfile"
+}
+
+# Packages this change adds new tests to, and the exact test names each one
+# defines. Used only to synthesize a per-test failure entry for a package
+# that failed to build -- see merge_build_failures below.
+declare -A NEW_TEST_NAMES=(
+  ["github.com/rqlite/rqlite/v10/cdc"]="Test_CDCColFilter_Config_AbsentByDefault Test_CDCColFilter_Config_Parsed Test_CDCColFilter_Config_RejectsEmptyColumnName Test_CDCColFilter_Config_RejectsEmptyTableName"
+  ["github.com/rqlite/rqlite/v10/db"]="Test_CDCColFilter_DB_SchemaVersionChangesOnDDL Test_CDCColFilter_Streamer_CacheInvalidatedOnSchemaVersionChange Test_CDCColFilter_Streamer_DeleteOnlyOldRow Test_CDCColFilter_Streamer_ExcludesConfiguredColumn Test_CDCColFilter_Streamer_ExcludesMultipleColumns Test_CDCColFilter_Streamer_InvalidateAll Test_CDCColFilter_Streamer_LeadershipInvalidationRequired Test_CDCColFilter_Streamer_MultipleTablesInOneCommit Test_CDCColFilter_Streamer_NilColumnFilterUnaffected Test_CDCColFilter_Streamer_SchemaVersionErrorFailsSafe Test_CDCColFilter_Streamer_SchemaVersionErrorRecoveryReDerives Test_CDCColFilter_Streamer_UnfilteredTableUnaffected Test_CDCColFilter_Streamer_UnknownColumnIsNoOp Test_CDCColFilter_Streamer_UpdateFiltersBothRows"
+  ["github.com/rqlite/rqlite/v10/store"]="Test_CDCColFilter_Store_ExcludesColumn Test_CDCColFilter_Store_ExcludesMultipleColumns Test_CDCColFilter_Store_LeadershipTransitionInvalidatesCache Test_CDCColFilter_Store_RestoreInvalidatesCache Test_CDCColFilter_Store_RowIDsOnlyComposition Test_CDCColFilter_Store_SchemaEvolution_AddColumn Test_CDCColFilter_Store_SchemaEvolution_DropColumn Test_CDCColFilter_Store_SchemaEvolution_RenameColumn Test_CDCColFilter_Store_SchemaEvolution_SameTransaction Test_CDCColFilter_Store_SchemaEvolution_RenameAfterWrite Test_CDCColFilter_Store_SchemaEvolution_RenameWithoutColumnKeyword Test_CDCColFilter_Store_SchemaEvolution_DropAndRecreateSameName Test_CDCColFilter_Store_SchemaEvolution_CommentPrefixedDDL Test_CDCColFilter_Store_SchemaEvolution_UpdateWithDDL Test_CDCColFilter_Store_FilterCacheStableAcrossCommits Test_CDCColFilter_Store_TableFilterComposition Test_CDCColFilter_Store_TableNotInFilterUnaffected Test_CDCColFilter_Store_UnfilteredTable_SameTransactionFinalSchema Test_CDCColFilter_Store_RestoreViaSnapshotInvalidatesCache Test_CDCColFilter_Store_RestoreViaChunkedLoadInvalidatesCache Test_CDCColFilter_Store_RestoreViaReadFromInvalidatesCache"
+  ["github.com/rqlite/rqlite/v10/system_test"]="Test_CDCColFilter_EndToEnd"
+  ["github.com/rqlite/rqlite/v10/cmd/rqlited"]="Test_CDCColFilter_CreateCDC_ProductionWiring"
+)
+
+# merge_build_failures takes go-junit-report's real output (built from the
+# full, mixed-package test log) and, only for a package that failed to
+# build, replaces its single, unattributed "[build failed]" pseudo-testcase
+# with one synthetic failing <testcase> per test that package defines --
+# using the compiler output already captured in that package's own report
+# as the failure detail. Every package that built -- whether or not all its
+# tests passed -- is passed through with its real per-test results intact.
+merge_build_failures() {
+  local raw="$1"
+  local pkg body outfile current next
+  current="$raw"
+  for pkg in "${!NEW_TEST_NAMES[@]}"; do
+    if ! grep -qE "^FAIL[[:space:]]+${pkg}[[:space:]]+\[(build|setup) failed\]" "$TEST_LOG"; then
+      continue
+    fi
+    body="$(xml_escape "$(cat "$TEST_LOG")")"
+    outfile="$(mktemp)"
+    # shellcheck disable=SC2086
+    write_suite "$outfile" "$pkg" "$body" ${NEW_TEST_NAMES[$pkg]}
+    next="$(mktemp)"
+    awk -v pat="<testsuite name=\"${pkg}\"" -v replfile="$outfile" '
+      BEGIN { in_target = 0 }
+      {
+        if (!in_target && index($0, pat) > 0) { in_target = 1; next }
+        if (in_target) {
+          if (index($0, "</testsuite>") > 0) {
+            while ((getline line < replfile) > 0) print line
+            close(replfile)
+            in_target = 0
+          }
+          next
+        }
+        print
+      }
+    ' "$current" > "$next"
+    current="$next"
+  done
+  cat "$current"
+}
+
+case "$MODE" in
+  base)
+    # Test_MultiNodeClusterRaftAdv is skipped: it is a pre-existing test,
+    # untouched by this change, that panics in the repo's own
+    # mustGetLocalIPv4Address() test helper (system_test/helpers.go) when run
+    # in this sandbox -- the helper can't find a non-loopback IPv4 interface
+    # to enumerate here. That panic crashes the whole system_test binary,
+    # which is unrelated to and unaffected by the CDC column-filter feature
+    # under test, so it's excluded to avoid an unrelated environment failure
+    # blocking verification of this change.
+    #
+    # Test_OpenStoreSingleNode_VacuumFullNeeded is skipped for the same
+    # reason: it intermittently crashes the store test binary in this
+    # sandbox with "failed to rename snapshot directory: ... file exists",
+    # a timestamp-collision race in the repo's own snapshot directory
+    # naming that reproduces with zero probability tied to this change --
+    # confirmed by running it, and the full store suite, repeatedly against
+    # the pristine, unpatched repo, where it also fires under load.
+    run_tests -skip '^(Test_MultiNodeClusterRaftAdv|Test_OpenStoreSingleNode_VacuumFullNeeded)$' \
+      ./cdc/... ./cmd/rqlited/... ./db/... ./store/... ./system_test/...
+    ;;
+  new)
+    run_tests -tags cdccolumnfilter -run '^Test_CDCColFilter' ./cdc/... ./cmd/rqlited/... ./db/... ./store/... ./system_test/...
+    ;;
+  *)
+    echo "unknown mode: $MODE (expected base or new)" >&2
+    exit 2
+    ;;
+esac
+
+if [ -n "$OUTPUT_PATH" ]; then
+  RAW_JUNIT="$(mktemp)"
+  go-junit-report -set-exit-code < "$TEST_LOG" > "$RAW_JUNIT" || true
+  if [ "$MODE" = "new" ] && [ "$STATUS" -ne 0 ] && grep -q '\[build failed\]' "$TEST_LOG"; then
+    merge_build_failures "$RAW_JUNIT" > "$OUTPUT_PATH"
+  else
+    cp "$RAW_JUNIT" "$OUTPUT_PATH"
+  fi
+fi
+
+exit "$STATUS"
