+// Test_CDCColFilter_DB_SchemaVersionChangesOnDDL confirms, against a real
+// on-disk database rather than a mock, that (*DB).SchemaVersion() actually
+// changes its return value after ADD, DROP, and RENAME operations. Every
+// other test in this file drives SchemaVersion() through a mock instead.
+func Test_CDCColFilter_DB_SchemaVersionChangesOnDDL(t *testing.T) {
+	path := mustTempPath()
+	defer os.Remove(path)
+	db, err := Open(path, false, false)
+	if err != nil {
+		t.Fatalf("failed to open database: %s", err.Error())
+	}
+	defer db.Close()
+
+	mustExecute(db, "CREATE TABLE users (id INTEGER NOT NULL PRIMARY KEY, ssn TEXT, name TEXT)")
+	v0, err := db.SchemaVersion()
+	if err != nil {
+		t.Fatalf("SchemaVersion after CREATE TABLE: %v", err)
+	}
+
+	mustExecute(db, "ALTER TABLE users ADD COLUMN email TEXT")
+	v1, err := db.SchemaVersion()
+	if err != nil {
+		t.Fatalf("SchemaVersion after ADD COLUMN: %v", err)
+	}
+	if v1 == v0 {
+		t.Fatalf("expected SchemaVersion to change after ADD COLUMN, stayed at %d", v0)
+	}
+
+	mustExecute(db, "ALTER TABLE users DROP COLUMN email")
+	v2, err := db.SchemaVersion()
+	if err != nil {
+		t.Fatalf("SchemaVersion after DROP COLUMN: %v", err)
+	}
+	if v2 == v1 {
+		t.Fatalf("expected SchemaVersion to change after DROP COLUMN, stayed at %d", v1)
+	}
+
+	mustExecute(db, "ALTER TABLE users RENAME COLUMN name TO full_name")
+	v3, err := db.SchemaVersion()
+	if err != nil {
+		t.Fatalf("SchemaVersion after RENAME COLUMN: %v", err)
+	}
+	if v3 == v2 {
+		t.Fatalf("expected SchemaVersion to change after RENAME COLUMN, stayed at %d", v2)
+	}
+}
