+// schemaVersionedProvider is a ColumnsNameProvider defined entirely in this
+// test file, for tests that need to control SchemaVersion directly. It's
+// deliberately separate from mockColumnNamesProvider (defined in
+// cdc_test.go): that type is extended by the implementation under test to
+// add SchemaVersion support, so its internal field names are an
+// implementation detail, not something these tests should assume.
+type schemaVersionedProvider struct {
+	Columns    map[string][]string
+	Version    int64
+	VersionErr error
+}
+
+func (p *schemaVersionedProvider) ColumnNames(table string) ([]string, error) {
+	if cols, ok := p.Columns[table]; ok {
+		return cols, nil
+	}
+	return []string{}, nil
+}
+
+func (p *schemaVersionedProvider) SchemaVersion() (int64, error) {
+	if p.VersionErr != nil {
+		return 0, p.VersionErr
+	}
+	return p.Version, nil
+}
+
+// Test_CDCColFilter_Streamer_CacheInvalidatedOnSchemaVersionChange confirms
+// that once the ColumnsNameProvider's SchemaVersion moves on, the CDCStreamer
+// re-derives both the column-name cache and the filterInfo built from it --
+// including correctly re-deriving keepIdx, the row-value indices to keep,
+// which must track the table's new column layout, not the old one.
+func Test_CDCColFilter_Streamer_CacheInvalidatedOnSchemaVersionChange(t *testing.T) {
+	ch := make(chan *command.CDCIndexedEventGroup, 10)
+	np := &schemaVersionedProvider{
+		Columns: map[string][]string{
+			"users": {"id", "ssn", "name"},
+		},
+	}
+	streamer, err := NewCDCStreamer(ch, np, map[string][]string{"users": {"ssn"}})
+	if err != nil {
+		t.Fatalf("error creating CDCStreamer: %v", err)
+	}
+
+	streamer.Reset(1)
+	if err := streamer.PreupdateHook(&command.CDCEvent{
+		Table:  "users",
+		Op:     command.CDCEvent_INSERT,
+		NewRow: &command.CDCRow{Values: []*command.CDCValue{cdcColFilterInt(1), cdcColFilterStr("111"), cdcColFilterStr("alice")}},
+	}); err != nil {
+		t.Fatalf("PreupdateHook: %v", err)
+	}
+	streamer.CommitHook()
+	select {
+	case group := <-ch:
+		got := group.Events[0]
+		if !slices.Equal(got.ColumnNames, []string{"id", "name"}) {
+			t.Fatalf("expected [id name] on first commit, got %v", got.ColumnNames)
+		}
+	case <-time.After(2 * time.Second):
+		t.Fatal("timeout waiting for CDC event")
+	}
+
+	// Simulate ALTER TABLE users ADD COLUMN email, which in SQLite bumps
+	// schema_version. The new column lands at the end, after "name", so
+	// "ssn"'s index (1) is unchanged, but a stale keepIdx built for a
+	// 3-column table would silently mis-slice a 4-column row.
+	np.Columns["users"] = []string{"id", "ssn", "name", "email"}
+	np.Version++
+
+	streamer.Reset(2)
+	if err := streamer.PreupdateHook(&command.CDCEvent{
+		Table: "users",
+		Op:    command.CDCEvent_INSERT,
+		NewRow: &command.CDCRow{
+			Values: []*command.CDCValue{cdcColFilterInt(2), cdcColFilterStr("222"), cdcColFilterStr("bob"), cdcColFilterStr("bob@example.com")},
+		},
+	}); err != nil {
+		t.Fatalf("PreupdateHook: %v", err)
+	}
+	streamer.CommitHook()
+
+	select {
+	case group := <-ch:
+		got := group.Events[0]
+		if !slices.Equal(got.ColumnNames, []string{"id", "name", "email"}) {
+			t.Fatalf("expected [id name email] after schema change, got %v", got.ColumnNames)
+		}
+		if !reflect.DeepEqual(cdcColFilterRowValuesAsAny(got.NewRow), []any{int64(2), "bob", "bob@example.com"}) {
+			t.Fatalf("expected new row [2 bob bob@example.com], got %v", cdcColFilterRowValuesAsAny(got.NewRow))
+		}
+	case <-time.After(2 * time.Second):
+		t.Fatal("timeout waiting for CDC event")
+	}
+}
