+// Test_CDCColFilter_Store_RestoreViaSnapshotInvalidatesCache confirms that
+// installing a Raft snapshot (FSM.Restore) also discards cached CDC
+// column-name/filter information, independently of the explicit /db/load
+// path Test_CDCColFilter_Store_RestoreInvalidatesCache covers.
+func Test_CDCColFilter_Store_RestoreViaSnapshotInvalidatesCache(t *testing.T) {
+	s, ln := mustNewStore(t)
+	defer ln.Close()
+
+	cdcChannel := make(chan *proto.CDCIndexedEventGroup, 100)
+
+	if err := s.Open(); err != nil {
+		t.Fatalf("failed to open single-node store: %s", err.Error())
+	}
+	if err := s.Bootstrap(NewServer(s.ID(), s.Addr(), true)); err != nil {
+		t.Fatalf("failed to bootstrap single-node store: %s", err.Error())
+	}
+	defer s.Close(true)
+	if _, err := s.WaitForLeader(10 * time.Second); err != nil {
+		t.Fatalf("Error waiting for leader: %s", err)
+	}
+
+	er := executeRequestFromString(
+		`CREATE TABLE users (id INTEGER NOT NULL PRIMARY KEY, ssn TEXT, name TEXT)`, false, false)
+	if _, _, err := s.Execute(context.Background(), er); err != nil {
+		t.Fatalf("failed to create table: %s", err.Error())
+	}
+	if err := s.EnableCDC(cdcChannel, nil, false, map[string][]string{"users": {"ssn"}}); err != nil {
+		t.Fatalf("failed to enable CDC: %v", err)
+	}
+	er = executeRequestFromString(
+		`INSERT INTO users(id, ssn, name) VALUES(1, "111-22-3333", "alice")`, false, false)
+	if _, _, err := s.Execute(context.Background(), er); err != nil {
+		t.Fatalf("failed to execute INSERT: %s", err.Error())
+	}
+	ev := drainCDCEvent(t, cdcChannel)
+	if !slices.Equal(ev.ColumnNames, []string{"id", "name"}) {
+		t.Fatalf("expected column names [id name] before snapshot restore, got %v", ev.ColumnNames)
+	}
+
+	// Build a snapshot, via a completely separate store, of a "users" table
+	// with a different column layout -- exactly as Test_CDCColFilter_Store_
+	// RestoreInvalidatesCache does for the /db/load path -- but persist and
+	// restore it through FSM.Snapshot/FSM.Restore, the same machinery
+	// hashicorp/raft itself drives when installing a snapshot on a node.
+	src, srcLn := mustNewStore(t)
+	defer srcLn.Close()
+	if err := src.Open(); err != nil {
+		t.Fatalf("failed to open source store: %s", err.Error())
+	}
+	if err := src.Bootstrap(NewServer(src.ID(), src.Addr(), true)); err != nil {
+		t.Fatalf("failed to bootstrap source store: %s", err.Error())
+	}
+	defer src.Close(true)
+	if _, err := src.WaitForLeader(10 * time.Second); err != nil {
+		t.Fatalf("Error waiting for leader on source store: %s", err)
+	}
+	srcEr := executeRequestFromString(
+		`CREATE TABLE users (id INTEGER NOT NULL PRIMARY KEY, ssn TEXT, name TEXT, dept TEXT)`,
+		false, false)
+	if _, _, err := src.Execute(context.Background(), srcEr); err != nil {
+		t.Fatalf("failed to create table on source store: %s", err.Error())
+	}
+
+	srcFSM := NewFSM(src)
+	snap, err := srcFSM.Snapshot()
+	if err != nil {
+		t.Fatalf("failed to snapshot source store: %s", err.Error())
+	}
+	snapDir := t.TempDir()
+	snapPath := filepath.Join(snapDir, "snapshot")
+	snapFile, err := os.Create(snapPath)
+	if err != nil {
+		t.Fatalf("failed to create snapshot file: %s", err.Error())
+	}
+	if err := snap.Persist(&mockSnapshotSink{snapFile, nil, nil}); err != nil {
+		t.Fatalf("failed to persist snapshot: %s", err.Error())
+	}
+	snapFile.Close()
+
+	restoreFile, err := os.Open(snapPath)
+	if err != nil {
+		t.Fatalf("failed to reopen snapshot file: %s", err.Error())
+	}
+	if err := NewFSM(s).Restore(restoreFile); err != nil {
+		t.Fatalf("failed to restore snapshot into s: %s", err.Error())
+	}
+
+	er = executeRequestFromString(
+		`INSERT INTO users(id, ssn, name, dept) VALUES(2, "444-55-6666", "bob", "eng")`, false, false)
+	if _, _, err := s.Execute(context.Background(), er); err != nil {
+		t.Fatalf("failed to execute post-restore INSERT: %s", err.Error())
+	}
+	ev = drainCDCEvent(t, cdcChannel)
+	if !slices.Equal(ev.ColumnNames, []string{"id", "name", "dept"}) {
+		t.Fatalf("expected column names [id name dept] after snapshot restore, got %v -- a stale "+
+			"cache would still report the pre-restore [id name] layout", ev.ColumnNames)
+	}
+	if len(ev.NewRow.Values) != 3 {
+		t.Fatalf("expected 3 row values, got %d", len(ev.NewRow.Values))
+	}
+	if ev.NewRow.Values[2].GetS() != "eng" {
+		t.Fatalf("expected third value to be the new dept column, got %v", ev.NewRow.Values[2])
+	}
+}
