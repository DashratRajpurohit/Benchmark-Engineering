+// drainCDCEvent waits up to 5 seconds for exactly one CDC event group on ch
+// and returns its single event, failing the test on timeout or an unexpected
+// event count.
+func drainCDCEvent(t *testing.T, ch <-chan *proto.CDCIndexedEventGroup) *proto.CDCEvent {
+	t.Helper()
+	select {
+	case events := <-ch:
+		if len(events.Events) != 1 {
+			t.Fatalf("expected 1 CDC event, got %d", len(events.Events))
+		}
+		return events.Events[0]
+	case <-time.After(5 * time.Second):
+		t.Fatal("timeout waiting for CDC event")
+		return nil
+	}
+}
+
+// drainCDCGroup waits up to 5 seconds for exactly one CDC event group
+// carrying want events and returns it, failing the test on timeout or an
+// unexpected event count.
+func drainCDCGroup(t *testing.T, ch <-chan *proto.CDCIndexedEventGroup, want int) *proto.CDCIndexedEventGroup {
+	t.Helper()
+	select {
+	case events := <-ch:
+		if len(events.Events) != want {
+			t.Fatalf("expected %d CDC events, got %d", want, len(events.Events))
+		}
+		return events
+	case <-time.After(5 * time.Second):
+		t.Fatal("timeout waiting for CDC event group")
+		return nil
+	}
+}
