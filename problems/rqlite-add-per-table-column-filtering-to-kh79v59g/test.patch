+	}
+	if err := s.Bootstrap(NewServer(s.ID(), s.Addr(), true)); err != nil {
+		t.Fatalf("failed to bootstrap single-node store: %s", err.Error())
+	}
+	defer s.Close(true)
+	if _, err := s.WaitForLeader(10 * time.Second); err != nil {
+		t.Fatalf("Error waiting for leader: %s", err)
+	}
+
+	er := executeRequestFromString(
+		`CREATE TABLE users (id INTEGER NOT NULL PRIMARY KEY, name TEXT)`, false, false)
+	if _, _, err := s.Execute(context.Background(), er); err != nil {
+		t.Fatalf("failed to create table: %s", err.Error())
+	}
+
+	if err := s.EnableCDC(cdcChannel, nil, false, nil); err != nil {
+		t.Fatalf("failed to enable CDC: %v", err)
+	}
+
+	// The row is written with a value in "name". Within the same
+	// transaction, "name" is dropped and a new, unrelated "name" column is
+	// added -- SQLite always appends an added column at the end, so the
+	// recreated "name" is a different physical column from the one the
+	// row's value was written to, and must come back NULL, not "wendy".
+	er = executeRequestFromStrings([]string{
+		`INSERT INTO users(id, name) VALUES(6, "wendy")`,
+		`ALTER TABLE users DROP COLUMN name`,
+		`ALTER TABLE users ADD COLUMN name TEXT`,
+	}, false, true)
+	if _, _, err := s.Execute(context.Background(), er); err != nil {
+		t.Fatalf("failed to execute same-transaction INSERT-then-DROP-then-ADD: %s", err.Error())
+	}
+
+	ev := drainCDCEvent(t, cdcChannel)
+	if ev.Error != "" {
+		t.Fatalf("unexpected event error: %s", ev.Error)
+	}
+	if !slices.Equal(ev.ColumnNames, []string{"id", "name"}) {
+		t.Fatalf("expected column names [id name], got %v", ev.ColumnNames)
+	}
+	if len(ev.NewRow.Values) != 2 {
+		t.Fatalf("expected 2 row values, got %d", len(ev.NewRow.Values))
+	}
+	if ev.NewRow.Values[0].GetI() != 6 {
+		t.Fatalf("expected first value to be id 6, got %v", ev.NewRow.Values[0])
+	}
+	if ev.NewRow.Values[1].Value != nil {
+		t.Fatalf("expected the recreated column to be NULL, not the dropped column's leftover "+
+			"value, got %v", ev.NewRow.Values[1])
+	}
+}
