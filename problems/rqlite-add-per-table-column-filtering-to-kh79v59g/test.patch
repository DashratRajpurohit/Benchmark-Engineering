+//go:build cdccolumnfilter
+
+package cdc
+
+import (
+	"os"
+	"reflect"
+	"testing"
+)
+
+func mustWriteCDCConfigFile(t *testing.T, contents string) string {
+	t.Helper()
+	tmpFile, err := os.CreateTemp("", "cdc_columnfilter_config_*.json")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := tmpFile.WriteString(contents); err != nil {
+		t.Fatal(err)
+	}
+	if err := tmpFile.Close(); err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { os.Remove(tmpFile.Name()) })
+	return tmpFile.Name()
+}
+
+func Test_CDCColFilter_Config_Parsed(t *testing.T) {
+	path := mustWriteCDCConfigFile(t, `{
+		"endpoint": "https://example.com/cdc",
+		"column_filter": {
+			"users": ["ssn", "password"],
+			"orders": ["card_number"]
+		}
+	}`)
+
+	cfg, err := NewConfig(path)
+	if err != nil {
+		t.Fatalf("NewConfig() failed: %v", err)
+	}
+
+	want := map[string][]string{
+		"users":  {"ssn", "password"},
+		"orders": {"card_number"},
+	}
+	if !reflect.DeepEqual(cfg.ColumnFilter, want) {
+		t.Fatalf("expected ColumnFilter %v, got %v", want, cfg.ColumnFilter)
+	}
+}
+
+func Test_CDCColFilter_Config_AbsentByDefault(t *testing.T) {
+	path := mustWriteCDCConfigFile(t, `{"endpoint": "https://example.com/cdc"}`)
+
+	cfg, err := NewConfig(path)
+	if err != nil {
+		t.Fatalf("NewConfig() failed: %v", err)
+	}
+	if len(cfg.ColumnFilter) != 0 {
+		t.Fatalf("expected empty ColumnFilter by default, got %v", cfg.ColumnFilter)
+	}
+
+	// Confirm the simple URL and "stdout" forms, which don't go through file parsing,
+	// also leave ColumnFilter unset.
+	urlCfg, err := NewConfig("https://example.com/cdc")
+	if err != nil {
+		t.Fatalf("NewConfig() failed for URL form: %v", err)
+	}
+	if len(urlCfg.ColumnFilter) != 0 {
+		t.Fatalf("expected empty ColumnFilter for URL form, got %v", urlCfg.ColumnFilter)
+	}
+}
+
+func Test_CDCColFilter_Config_RejectsEmptyTableName(t *testing.T) {
+	path := mustWriteCDCConfigFile(t, `{
+		"endpoint": "https://example.com/cdc",
+		"column_filter": {
+			"": ["ssn"]
+		}
+	}`)
+
+	if _, err := NewConfig(path); err == nil {
+		t.Fatalf("expected NewConfig() to reject an empty table name in column_filter")
+	}
+}
+
+func Test_CDCColFilter_Config_RejectsEmptyColumnName(t *testing.T) {
+	path := mustWriteCDCConfigFile(t, `{
+		"endpoint": "https://example.com/cdc",
+		"column_filter": {
+			"users": ["ssn", ""]
+		}
+	}`)
+
+	if _, err := NewConfig(path); err == nil {
+		t.Fatalf("expected NewConfig() to reject an empty column name in column_filter")
+	}
+}
diff --git a/cmd/rqlited/cdc_columnfilter_wiring_test.go b/cmd/rqlited/cdc_columnfilter_wiring_test.go
new file mode 100644
index 00000000..a13ed0df
--- /dev/null
+++ b/cmd/rqlited/cdc_columnfilter_wiring_test.go
@@ -0,0 +1,158 @@
+//go:build cdccolumnfilter
+
+package main
+
+import (
+	"context"
+	"encoding/json"
+	"net"
+	"os"
+	"path/filepath"
+	"testing"
+	"time"
+
+	"github.com/rqlite/rqlite/v10/cdc/cdctest"
+	cdcjson "github.com/rqlite/rqlite/v10/cdc/json"
+	"github.com/rqlite/rqlite/v10/cluster"
+	"github.com/rqlite/rqlite/v10/command/proto"
+	"github.com/rqlite/rqlite/v10/store"
+	"github.com/rqlite/rqlite/v10/tcp"
+)
+
+// Test_CDCColFilter_CreateCDC_ProductionWiring drives this command's own,
+// unexported createCDC -- the function main() calls to enable CDC on a
+// real node -- through a real, config-file-driven column_filter, instead
+// of calling Store.EnableCDC directly the way an in-process test harness
+// would.
+func Test_CDCColFilter_CreateCDC_ProductionWiring(t *testing.T) {
+	dir := t.TempDir()
+
+	ln, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatalf("failed to listen: %s", err.Error())
+	}
+	mux, err := tcp.NewMux(ln, nil)
+	if err != nil {
+		t.Fatalf("failed to create mux: %s", err.Error())
+	}
+	go mux.Serve()
+
+	raftLn := mux.Listen(cluster.MuxRaftHeader)
+	raftDialer := tcp.NewDialer(cluster.MuxRaftHeader, nil)
+	raftTn := tcp.NewLayer(raftLn, raftDialer)
+
+	cfg := &Config{
+		DataPath:              dir,
+		NodeID:                raftTn.Addr().String(),
+		RaftAddr:              raftTn.Addr().String(),
+		RaftAdv:               raftTn.Addr().String(),
+		HTTPAdv:               "127.0.0.1:0",
+		ClusterConnectTimeout: 30 * time.Second,
+	}
+
+	str, err := createStore(cfg, raftTn, nil)
+	if err != nil {
+		t.Fatalf("failed to create store: %s", err.Error())
+	}
+	defer str.Close(true)
+
+	credStr, err := credentialStore(cfg)
+	if err != nil {
+		t.Fatalf("failed to create credential store: %s", err.Error())
+	}
+	clstrServ, err := clusterService(cfg, mux.Listen(cluster.MuxClusterHeader), str, str, credStr)
+	if err != nil {
+		t.Fatalf("failed to create cluster service: %s", err.Error())
+	}
+	defer clstrServ.Close()
+
+	clstrClient, err := createClusterClient(cfg, clstrServ)
+	if err != nil {
+		t.Fatalf("failed to create cluster client: %s", err.Error())
+	}
+
+	testEndpoint := cdctest.NewHTTPTestServer()
+	testEndpoint.Start()
+	defer testEndpoint.Close()
+
+	// This is the crux of the test: the column_filter comes only from this
+	// on-disk CDC config file, parsed by the real cdc.NewConfig exactly as
+	// production reads it -- never passed to Store.EnableCDC by the test
+	// itself. If createCDC fails to forward it, "ssn" will not be excluded
+	// from the delivered event.
+	cdcCfgPath := filepath.Join(dir, "cdc-config.json")
+	cdcCfgJSON, err := json.Marshal(map[string]any{
+		"endpoint":      testEndpoint.URL(),
+		"column_filter": map[string][]string{"users": {"ssn"}},
+	})
+	if err != nil {
+		t.Fatalf("failed to marshal CDC config: %s", err.Error())
+	}
+	if err := os.WriteFile(cdcCfgPath, cdcCfgJSON, 0644); err != nil {
+		t.Fatalf("failed to write CDC config: %s", err.Error())
+	}
+	cfg.CDCConfig = cdcCfgPath
+
+	cdcServ, err := createCDC(cfg, str, clstrServ, clstrClient)
+	if err != nil {
+		t.Fatalf("createCDC failed: %s", err.Error())
+	}
+	defer cdcServ.Stop()
+
+	if err := str.Open(); err != nil {
+		t.Fatalf("failed to open store: %s", err.Error())
+	}
+	if err := str.Bootstrap(store.NewServer(str.ID(), str.Addr(), true)); err != nil {
+		t.Fatalf("failed to bootstrap store: %s", err.Error())
+	}
+	if _, err := str.WaitForLeader(10 * time.Second); err != nil {
+		t.Fatalf("store never became leader: %s", err.Error())
+	}
+
+	execute := func(sql string) {
+		t.Helper()
+		req := &proto.ExecuteRequest{Request: &proto.Request{Statements: []*proto.Statement{{Sql: sql}}}}
+		if _, _, err := str.Execute(context.Background(), req); err != nil {
+			t.Fatalf("failed to execute %q: %s", sql, err.Error())
+		}
+	}
+	execute(`CREATE TABLE users (id INTEGER NOT NULL PRIMARY KEY, ssn TEXT, name TEXT)`)
+	execute(`INSERT INTO users (id, ssn, name) VALUES (1, '111-22-3333', 'Alice')`)
+
+	deadline := time.Now().Add(10 * time.Second)
+	for testEndpoint.GetMessageCount() == 0 {
+		if time.Now().After(deadline) {
+			t.Fatal("timed out waiting for a CDC event to be delivered")
+		}
+		time.Sleep(50 * time.Millisecond)
+	}
+
+	var usersAfter map[string]any
+	for _, req := range testEndpoint.GetRequests() {
+		var envelope cdcjson.CDCMessagesEnvelope
+		if err := cdcjson.UnmarshalFromEnvelopeJSON(req, &envelope); err != nil {
+			t.Fatalf("failed to unmarshal CDC envelope: %s", err.Error())
+		}
+		for _, msg := range envelope.Payload {
+			for _, ev := range msg.Events {
+				if ev.Error != "" {
+					t.Fatalf("CDC event reported an error: %s", ev.Error)
+				}
+				if ev.Table == "users" {
+					usersAfter = ev.After
+				}
+			}
+		}
+	}
+
+	if usersAfter == nil {
+		t.Fatal("never received a CDC event for the users table")
+	}
+	if _, ok := usersAfter["ssn"]; ok {
+		t.Fatalf("column_filter from the CDC config file was not applied through createCDC's "+
+			"production wiring: 'ssn' present in delivered event: %v", usersAfter)
+	}
+	if usersAfter["name"] != "Alice" {
+		t.Fatalf("expected unfiltered column 'name' to still be delivered, got %v", usersAfter)
+	}
+}
diff --git a/db/cdc_columnfilter_f3c841_test.go b/db/cdc_columnfilter_f3c841_test.go
new file mode 100644
index 00000000..f8717ea7
--- /dev/null
+++ b/db/cdc_columnfilter_f3c841_test.go
@@ -0,0 +1,811 @@
+//go:build cdccolumnfilter
+
+package db
+
+import (
+	"fmt"
+	"os"
+	"reflect"
+	"slices"
+	"testing"
+	"time"
+
+	command "github.com/rqlite/rqlite/v10/command/proto"
+)
+
+// cdcColFilterStr, cdcColFilterInt, and cdcColFilterRowValuesAsAny are
+// deliberately prefixed (rather than the shorter cdcStr/cdcInt/etc.) so they
+// can't collide with a same-named regression-test helper a solution might
+// legitimately add to cdc_test.go in this same package.
+func cdcColFilterStr(v string) *command.CDCValue {
+	return &command.CDCValue{Value: &command.CDCValue_S{S: v}}
+}
+
+func cdcColFilterInt(v int64) *command.CDCValue {
+	return &command.CDCValue{Value: &command.CDCValue_I{I: v}}
+}
+
+func cdcColFilterRowValuesAsAny(r *command.CDCRow) []any {
+	if r == nil {
+		return nil
+	}
+	out := make([]any, len(r.Values))
+	for i, v := range r.Values {
+		switch x := v.Value.(type) {
+		case *command.CDCValue_S:
+			out[i] = x.S
+		case *command.CDCValue_I:
+			out[i] = x.I
+		default:
+			out[i] = nil
+		}
+	}
+	return out
+}
+
+func Test_CDCColFilter_Streamer_ExcludesConfiguredColumn(t *testing.T) {
+	ch := make(chan *command.CDCIndexedEventGroup, 10)
+	np := &mockColumnNamesProvider{
+		columns: map[string][]string{
+			"users": {"id", "ssn", "name"},
+		},
+	}
+	streamer, err := NewCDCStreamer(ch, np, map[string][]string{"users": {"ssn"}})
+	if err != nil {
+		t.Fatalf("error creating CDCStreamer: %v", err)
+	}
+
+	streamer.Reset(1)
+	ev := &command.CDCEvent{
+		Table: "users",
+		Op:    command.CDCEvent_INSERT,
+		NewRow: &command.CDCRow{
+			Values: []*command.CDCValue{cdcColFilterInt(7), cdcColFilterStr("111-22-3333"), cdcColFilterStr("alice")},
+		},
+	}
+	if err := streamer.PreupdateHook(ev); err != nil {
+		t.Fatalf("PreupdateHook: %v", err)
+	}
+	streamer.CommitHook()
+
+	select {
+	case group := <-ch:
+		if len(group.Events) != 1 {
+			t.Fatalf("expected 1 event, got %d", len(group.Events))
+		}
+		got := group.Events[0]
+		if !slices.Equal(got.ColumnNames, []string{"id", "name"}) {
+			t.Fatalf("expected column names [id name], got %v", got.ColumnNames)
+		}
+		if !reflect.DeepEqual(cdcColFilterRowValuesAsAny(got.NewRow), []any{int64(7), "alice"}) {
+			t.Fatalf("expected new row [7 alice], got %v", cdcColFilterRowValuesAsAny(got.NewRow))
+		}
+		if len(got.ColumnNames) != len(got.NewRow.Values) {
+			t.Fatalf("column count %d does not match row value count %d",
+				len(got.ColumnNames), len(got.NewRow.Values))
+		}
+	case <-time.After(2 * time.Second):
+		t.Fatal("timeout waiting for CDC event")
+	}
+}
+
+func Test_CDCColFilter_Streamer_UnfilteredTableUnaffected(t *testing.T) {
+	ch := make(chan *command.CDCIndexedEventGroup, 10)
+	np := &mockColumnNamesProvider{
+		columns: map[string][]string{
+			"users":  {"id", "ssn", "name"},
+			"orders": {"id", "total"},
+		},
+	}
+	streamer, err := NewCDCStreamer(ch, np, map[string][]string{"users": {"ssn"}})
+	if err != nil {
+		t.Fatalf("error creating CDCStreamer: %v", err)
+	}
+
+	streamer.Reset(2)
+	ev := &command.CDCEvent{
+		Table:  "orders",
+		Op:     command.CDCEvent_INSERT,
+		NewRow: &command.CDCRow{Values: []*command.CDCValue{cdcColFilterInt(1), cdcColFilterInt(100)}},
+	}
+	if err := streamer.PreupdateHook(ev); err != nil {
+		t.Fatalf("PreupdateHook: %v", err)
+	}
+	streamer.CommitHook()
+
+	select {
+	case group := <-ch:
+		got := group.Events[0]
+		if !slices.Equal(got.ColumnNames, []string{"id", "total"}) {
+			t.Fatalf("expected unaffected column names [id total], got %v", got.ColumnNames)
+		}
+		if !reflect.DeepEqual(cdcColFilterRowValuesAsAny(got.NewRow), []any{int64(1), int64(100)}) {
+			t.Fatalf("expected unaffected row [1 100], got %v", cdcColFilterRowValuesAsAny(got.NewRow))
+		}
+	case <-time.After(2 * time.Second):
+		t.Fatal("timeout waiting for CDC event")
+	}
+}
+
+func Test_CDCColFilter_Streamer_UpdateFiltersBothRows(t *testing.T) {
+	ch := make(chan *command.CDCIndexedEventGroup, 10)
+	np := &mockColumnNamesProvider{
+		columns: map[string][]string{"users": {"id", "ssn", "name"}},
+	}
+	streamer, err := NewCDCStreamer(ch, np, map[string][]string{"users": {"ssn"}})
+	if err != nil {
+		t.Fatalf("error creating CDCStreamer: %v", err)
+	}
+
+	streamer.Reset(3)
+	ev := &command.CDCEvent{
+		Table:  "users",
+		Op:     command.CDCEvent_UPDATE,
+		OldRow: &command.CDCRow{Values: []*command.CDCValue{cdcColFilterInt(1), cdcColFilterStr("111"), cdcColFilterStr("alice")}},
+		NewRow: &command.CDCRow{Values: []*command.CDCValue{cdcColFilterInt(1), cdcColFilterStr("111"), cdcColFilterStr("alice2")}},
+	}
+	if err := streamer.PreupdateHook(ev); err != nil {
+		t.Fatalf("PreupdateHook: %v", err)
+	}
+	streamer.CommitHook()
+
+	select {
+	case group := <-ch:
+		got := group.Events[0]
+		if !slices.Equal(got.ColumnNames, []string{"id", "name"}) {
+			t.Fatalf("expected column names [id name], got %v", got.ColumnNames)
+		}
+		if !reflect.DeepEqual(cdcColFilterRowValuesAsAny(got.OldRow), []any{int64(1), "alice"}) {
+			t.Fatalf("expected old row [1 alice], got %v", cdcColFilterRowValuesAsAny(got.OldRow))
+		}
+		if !reflect.DeepEqual(cdcColFilterRowValuesAsAny(got.NewRow), []any{int64(1), "alice2"}) {
+			t.Fatalf("expected new row [1 alice2], got %v", cdcColFilterRowValuesAsAny(got.NewRow))
+		}
+		if len(got.ColumnNames) != len(got.OldRow.Values) || len(got.ColumnNames) != len(got.NewRow.Values) {
+			t.Fatalf("column count %d must match both old (%d) and new (%d) row value counts",
+				len(got.ColumnNames), len(got.OldRow.Values), len(got.NewRow.Values))
+		}
+	case <-time.After(2 * time.Second):
+		t.Fatal("timeout waiting for CDC event")
+	}
+}
+
+func Test_CDCColFilter_Streamer_DeleteOnlyOldRow(t *testing.T) {
+	ch := make(chan *command.CDCIndexedEventGroup, 10)
+	np := &mockColumnNamesProvider{
+		columns: map[string][]string{"users": {"id", "ssn", "name"}},
+	}
+	streamer, err := NewCDCStreamer(ch, np, map[string][]string{"users": {"ssn"}})
+	if err != nil {
+		t.Fatalf("error creating CDCStreamer: %v", err)
+	}
+
+	streamer.Reset(4)
+	ev := &command.CDCEvent{
+		Table:  "users",
+		Op:     command.CDCEvent_DELETE,
+		OldRow: &command.CDCRow{Values: []*command.CDCValue{cdcColFilterInt(1), cdcColFilterStr("111"), cdcColFilterStr("alice")}},
+	}
+	if err := streamer.PreupdateHook(ev); err != nil {
+		t.Fatalf("PreupdateHook: %v", err)
+	}
+	streamer.CommitHook()
+
+	select {
+	case group := <-ch:
+		got := group.Events[0]
+		if !slices.Equal(got.ColumnNames, []string{"id", "name"}) {
+			t.Fatalf("expected column names [id name], got %v", got.ColumnNames)
+		}
+		if got.NewRow != nil {
+			t.Fatalf("expected nil new row for DELETE, got %v", got.NewRow)
+		}
+		if !reflect.DeepEqual(cdcColFilterRowValuesAsAny(got.OldRow), []any{int64(1), "alice"}) {
+			t.Fatalf("expected old row [1 alice], got %v", cdcColFilterRowValuesAsAny(got.OldRow))
+		}
+		if len(got.ColumnNames) != len(got.OldRow.Values) {
+			t.Fatalf("column count %d must match old row value count %d",
+				len(got.ColumnNames), len(got.OldRow.Values))
+		}
+	case <-time.After(2 * time.Second):
+		t.Fatal("timeout waiting for CDC event")
+	}
+}
+
+func Test_CDCColFilter_Streamer_UnknownColumnIsNoOp(t *testing.T) {
+	ch := make(chan *command.CDCIndexedEventGroup, 10)
+	np := &mockColumnNamesProvider{
+		columns: map[string][]string{"users": {"id", "name"}},
+	}
+	streamer, err := NewCDCStreamer(ch, np, map[string][]string{"users": {"does_not_exist"}})
+	if err != nil {
+		t.Fatalf("error creating CDCStreamer: %v", err)
+	}
+
+	streamer.Reset(5)
+	ev := &command.CDCEvent{
+		Table:  "users",
+		Op:     command.CDCEvent_INSERT,
+		NewRow: &command.CDCRow{Values: []*command.CDCValue{cdcColFilterInt(1), cdcColFilterStr("alice")}},
+	}
+	if err := streamer.PreupdateHook(ev); err != nil {
+		t.Fatalf("PreupdateHook: %v", err)
+	}
+	streamer.CommitHook()
+
+	select {
+	case group := <-ch:
+		got := group.Events[0]
+		if got.Error != "" {
+			t.Fatalf("unexpected event error: %s", got.Error)
+		}
+		if !slices.Equal(got.ColumnNames, []string{"id", "name"}) {
+			t.Fatalf("expected unaffected column names, got %v", got.ColumnNames)
+		}
+		if !reflect.DeepEqual(cdcColFilterRowValuesAsAny(got.NewRow), []any{int64(1), "alice"}) {
+			t.Fatalf("expected unaffected row [1 alice], got %v", cdcColFilterRowValuesAsAny(got.NewRow))
+		}
+		if len(got.ColumnNames) != len(got.NewRow.Values) {
+			t.Fatalf("column count %d does not match row value count %d",
+				len(got.ColumnNames), len(got.NewRow.Values))
+		}
+	case <-time.After(2 * time.Second):
+		t.Fatal("timeout waiting for CDC event")
+	}
+}
+
+func Test_CDCColFilter_Streamer_MultipleTablesInOneCommit(t *testing.T) {
+	ch := make(chan *command.CDCIndexedEventGroup, 10)
+	np := &mockColumnNamesProvider{
+		columns: map[string][]string{
+			"users":  {"id", "ssn", "name"},
+			"orders": {"id", "card_number", "total"},
+		},
+	}
+	streamer, err := NewCDCStreamer(ch, np, map[string][]string{
+		"users":  {"ssn"},
+		"orders": {"card_number"},
+	})
+	if err != nil {
+		t.Fatalf("error creating CDCStreamer: %v", err)
+	}
+
+	streamer.Reset(6)
+	evUsers := &command.CDCEvent{
+		Table:  "users",
+		Op:     command.CDCEvent_INSERT,
+		NewRow: &command.CDCRow{Values: []*command.CDCValue{cdcColFilterInt(1), cdcColFilterStr("111"), cdcColFilterStr("alice")}},
+	}
+	evOrders := &command.CDCEvent{
+		Table:  "orders",
+		Op:     command.CDCEvent_INSERT,
+		NewRow: &command.CDCRow{Values: []*command.CDCValue{cdcColFilterInt(9), cdcColFilterStr("4111"), cdcColFilterInt(42)}},
+	}
+	if err := streamer.PreupdateHook(evUsers); err != nil {
+		t.Fatalf("PreupdateHook: %v", err)
+	}
+	if err := streamer.PreupdateHook(evOrders); err != nil {
+		t.Fatalf("PreupdateHook: %v", err)
+	}
+	streamer.CommitHook()
+
+	select {
+	case group := <-ch:
+		if len(group.Events) != 2 {
+			t.Fatalf("expected 2 events, got %d", len(group.Events))
+		}
+		u, o := group.Events[0], group.Events[1]
+		if !slices.Equal(u.ColumnNames, []string{"id", "name"}) {
+			t.Fatalf("users: expected [id name], got %v", u.ColumnNames)
+		}
+		if !slices.Equal(o.ColumnNames, []string{"id", "total"}) {
+			t.Fatalf("orders: expected [id total], got %v", o.ColumnNames)
+		}
+		if !reflect.DeepEqual(cdcColFilterRowValuesAsAny(u.NewRow), []any{int64(1), "alice"}) {
+			t.Fatalf("users: unexpected row %v", cdcColFilterRowValuesAsAny(u.NewRow))
+		}
+		if !reflect.DeepEqual(cdcColFilterRowValuesAsAny(o.NewRow), []any{int64(9), int64(42)}) {
+			t.Fatalf("orders: unexpected row %v", cdcColFilterRowValuesAsAny(o.NewRow))
+		}
+	case <-time.After(2 * time.Second):
+		t.Fatal("timeout waiting for CDC event")
+	}
+}
