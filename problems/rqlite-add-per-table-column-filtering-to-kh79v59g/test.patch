+// Test_CDCColFilter_Store_SchemaEvolution_SameTransaction confirms that an
+// ALTER TABLE ADD COLUMN and a row change to the same filtered table, in one
+// explicit transaction, produce an event reflecting the transaction's final
+// schema regardless of statement order, never the excluded column under a
+// stale or wrong name.
+func Test_CDCColFilter_Store_SchemaEvolution_SameTransaction(t *testing.T) {
+	s, ln := mustNewStore(t)
+	defer ln.Close()
+
+	cdcChannel := make(chan *proto.CDCIndexedEventGroup, 100)
+
+	if err := s.Open(); err != nil {
+		t.Fatalf("failed to open single-node store: %s", err.Error())
+	}
+	if err := s.Bootstrap(NewServer(s.ID(), s.Addr(), true)); err != nil {
+		t.Fatalf("failed to bootstrap single-node store: %s", err.Error())
+	}
+	defer s.Close(true)
+	if _, err := s.WaitForLeader(10 * time.Second); err != nil {
+		t.Fatalf("Error waiting for leader: %s", err)
+	}
+
+	er := executeRequestFromString(
+		`CREATE TABLE users (id INTEGER NOT NULL PRIMARY KEY, ssn TEXT, name TEXT)`, false, false)
+	if _, _, err := s.Execute(context.Background(), er); err != nil {
+		t.Fatalf("failed to create table: %s", err.Error())
+	}
+
+	if err := s.EnableCDC(cdcChannel, nil, false, map[string][]string{"users": {"ssn"}}); err != nil {
+		t.Fatalf("failed to enable CDC: %v", err)
+	}
+
+	// DDL before the row change: the INSERT's own preupdate hook already
+	// sees the post-ALTER, 4-column schema, so this exercises schema
+	// resolution against an uncommitted transaction more than row-value
+	// reconciliation.
+	er = executeRequestFromStrings([]string{
+		`ALTER TABLE users ADD COLUMN email TEXT`,
+		`INSERT INTO users(id, ssn, name, email) VALUES(3, "777-88-9999", "carol", "carol@example.com")`,
+	}, false, true)
+	if _, _, err := s.Execute(context.Background(), er); err != nil {
+		t.Fatalf("failed to execute same-transaction ALTER-then-INSERT: %s", err.Error())
+	}
+
+	ev := drainCDCEvent(t, cdcChannel)
+	if ev.Error != "" {
+		t.Fatalf("unexpected event error: %s", ev.Error)
+	}
+	if !slices.Equal(ev.ColumnNames, []string{"id", "name", "email"}) {
+		t.Fatalf("expected column names [id name email], got %v", ev.ColumnNames)
+	}
+	if len(ev.NewRow.Values) != 3 {
+		t.Fatalf("expected 3 row values, got %d", len(ev.NewRow.Values))
+	}
+	if ev.NewRow.Values[0].GetI() != 3 {
+		t.Fatalf("expected first value to be id 3, got %v", ev.NewRow.Values[0])
+	}
+	if ev.NewRow.Values[1].GetS() != "carol" {
+		t.Fatalf("expected second value to be name 'carol', got %v", ev.NewRow.Values[1])
+	}
+	if ev.NewRow.Values[2].GetS() != "carol@example.com" {
+		t.Fatalf("expected third value to be the new email column, got %v", ev.NewRow.Values[2])
+	}
+	for _, v := range ev.NewRow.Values {
+		if v.GetS() == "777-88-9999" {
+			t.Fatalf("excluded ssn value leaked into the event: %v", ev.NewRow.Values)
+		}
+	}
+
+	// Row change before the DDL, in a second, separate same-transaction
+	// request: the INSERT's own preupdate hook captures a 4-column row
+	// under the schema as it stands at that instant, but the ALTER that
+	// follows, still within this same transaction, appends a 5th column
+	// -- exercising row-value reconciliation itself, not just schema
+	// resolution.
+	er = executeRequestFromStrings([]string{
+		`INSERT INTO users(id, ssn, name, email) VALUES(4, "222-33-4444", "dave", "dave@example.com")`,
+		`ALTER TABLE users ADD COLUMN phone TEXT`,
+	}, false, true)
+	if _, _, err := s.Execute(context.Background(), er); err != nil {
+		t.Fatalf("failed to execute same-transaction INSERT-then-ALTER: %s", err.Error())
+	}
+
+	ev = drainCDCEvent(t, cdcChannel)
+	if ev.Error != "" {
+		t.Fatalf("unexpected event error: %s", ev.Error)
+	}
+	if !slices.Equal(ev.ColumnNames, []string{"id", "name", "email", "phone"}) {
+		t.Fatalf("expected column names [id name email phone], got %v", ev.ColumnNames)
+	}
+	if len(ev.NewRow.Values) != 4 {
+		t.Fatalf("expected 4 row values, got %d", len(ev.NewRow.Values))
+	}
+	if ev.NewRow.Values[0].GetI() != 4 {
+		t.Fatalf("expected first value to be id 4, got %v", ev.NewRow.Values[0])
+	}
+	if ev.NewRow.Values[1].GetS() != "dave" {
+		t.Fatalf("expected second value to be name 'dave', got %v", ev.NewRow.Values[1])
+	}
+	if ev.NewRow.Values[2].GetS() != "dave@example.com" {
+		t.Fatalf("expected third value to be email, got %v", ev.NewRow.Values[2])
+	}
+	// phone was added after this row's own INSERT ran; its value isn't
+	// knowable through any supported read, so it must come through as
+	// NULL rather than any guessed or leaked value.
+	if ev.NewRow.Values[3].Value != nil {
+		t.Fatalf("expected phone placeholder to be NULL, got %v", ev.NewRow.Values[3])
+	}
+	for _, v := range ev.NewRow.Values {
+		if v.GetS() == "222-33-4444" {
+			t.Fatalf("excluded ssn value leaked into the event: %v", ev.NewRow.Values)
+		}
+	}
+}
