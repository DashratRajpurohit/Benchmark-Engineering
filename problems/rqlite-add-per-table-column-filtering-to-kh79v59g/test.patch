+
+	streamer.Reset(1)
+	if err := streamer.PreupdateHook(&command.CDCEvent{
+		Table:  "users",
+		Op:     command.CDCEvent_INSERT,
+		NewRow: &command.CDCRow{Values: []*command.CDCValue{cdcColFilterInt(1), cdcColFilterStr("111"), cdcColFilterStr("alice")}},
+	}); err != nil {
+		t.Fatalf("PreupdateHook: %v", err)
+	}
+	streamer.CommitHook()
+	<-ch // drain, cache is now populated
+
+	np.VersionErr = fmt.Errorf("simulated: can't read schema_version")
+	np.Columns["users"] = []string{"id", "name", "ssn"} // column order changed too
+
+	streamer.Reset(2)
+	if err := streamer.PreupdateHook(&command.CDCEvent{
+		Table:  "users",
+		Op:     command.CDCEvent_INSERT,
+		NewRow: &command.CDCRow{Values: []*command.CDCValue{cdcColFilterInt(2), cdcColFilterStr("bob"), cdcColFilterStr("222")}},
+	}); err != nil {
