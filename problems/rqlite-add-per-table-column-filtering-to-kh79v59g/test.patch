+// Test_CDCColFilter_Store_TableFilterComposition confirms that a column_filter
+// composes with the existing table filter: a table excluded by the table
+// filter must produce no CDC events at all, regardless of a column_filter
+// entry naming it, while a table the table filter admits still has its
+// column_filter applied as usual.
+func Test_CDCColFilter_Store_TableFilterComposition(t *testing.T) {
+	s, ln := mustNewStore(t)
+	defer ln.Close()
+
+	cdcChannel := make(chan *proto.CDCIndexedEventGroup, 100)
+
+	if err := s.Open(); err != nil {
+		t.Fatalf("failed to open single-node store: %s", err.Error())
+	}
+	if err := s.Bootstrap(NewServer(s.ID(), s.Addr(), true)); err != nil {
+		t.Fatalf("failed to bootstrap single-node store: %s", err.Error())
+	}
+	defer s.Close(true)
+	if _, err := s.WaitForLeader(10 * time.Second); err != nil {
+		t.Fatalf("Error waiting for leader: %s", err)
+	}
+
+	er := executeRequestFromStrings([]string{
+		`CREATE TABLE users (id INTEGER NOT NULL PRIMARY KEY, ssn TEXT, name TEXT)`,
+		`CREATE TABLE logins (id INTEGER NOT NULL PRIMARY KEY, ssn TEXT, ip TEXT)`,
+	}, false, false)
+	if _, _, err := s.Execute(context.Background(), er); err != nil {
+		t.Fatalf("failed to create tables: %s", err.Error())
+	}
+
+	// The table filter admits only "users"; "logins" also carries a
+	// column_filter entry, but must never produce an event at all.
+	tableRe := regexp.MustCompile(`^users$`)
+	columnFilter := map[string][]string{"users": {"ssn"}, "logins": {"ssn"}}
+	if err := s.EnableCDC(cdcChannel, tableRe, false, columnFilter); err != nil {
+		t.Fatalf("failed to enable CDC: %v", err)
+	}
+
+	er = executeRequestFromStrings([]string{
+		`INSERT INTO logins(id, ssn, ip) VALUES(1, "999-00-1111", "10.0.0.1")`,
+		`INSERT INTO users(id, ssn, name) VALUES(1, "111-22-3333", "alice")`,
+	}, false, false)
+	if _, _, err := s.Execute(context.Background(), er); err != nil {
+		t.Fatalf("failed to execute inserts: %s", err.Error())
+	}
+
+	// Only the "users" INSERT should surface: the "logins" one is excluded
+	// by the table filter before the column filter ever sees it.
+	ev := drainCDCEvent(t, cdcChannel)
+	if ev.Table != "users" {
+		t.Fatalf("expected event for table \"users\" only (\"logins\" is outside the table filter), got table %q", ev.Table)
+	}
+	if !slices.Equal(ev.ColumnNames, []string{"id", "name"}) {
+		t.Fatalf("expected column names [id name], got %v", ev.ColumnNames)
+	}
+	if len(ev.NewRow.Values) != 2 {
+		t.Fatalf("expected 2 row values, got %d", len(ev.NewRow.Values))
+	}
+	if ev.NewRow.Values[1].GetS() != "alice" {
+		t.Fatalf("expected second value to be name 'alice', got %v", ev.NewRow.Values[1])
+	}
+	for _, v := range ev.NewRow.Values {
+		if v.GetS() == "111-22-3333" {
+			t.Fatalf("excluded ssn value leaked into the event: %v", ev.NewRow.Values)
+		}
+	}
+}
