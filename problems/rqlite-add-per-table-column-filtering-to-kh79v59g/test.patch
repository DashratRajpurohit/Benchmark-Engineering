+// Test_CDCColFilter_Streamer_SchemaVersionErrorRecoveryReDerives covers the
+// commit *after* a transient SchemaVersion failure: the streamer holds
+// metadata for which it never confirmed a version, and the columns really
+// did move while the version was unreadable. Trusting that unconfirmed
+// metadata once the version becomes readable again would publish the
+// excluded ssn value under the name column.
+func Test_CDCColFilter_Streamer_SchemaVersionErrorRecoveryReDerives(t *testing.T) {
+	ch := make(chan *command.CDCIndexedEventGroup, 10)
+	np := &schemaVersionedProvider{
+		Columns: map[string][]string{
+			"users": {"id", "ssn", "name"},
+		},
+		Version: 1,
+	}
+	streamer, err := NewCDCStreamer(ch, np, map[string][]string{"users": {"ssn"}})
+	if err != nil {
+		t.Fatalf("error creating CDCStreamer: %v", err)
+	}
+
+	// A first, ordinary commit, so metadata is cached against a version the
+	// streamer was able to read.
+	streamer.Reset(1)
+	if err := streamer.PreupdateHook(&command.CDCEvent{
+		Table:  "users",
+		Op:     command.CDCEvent_INSERT,
+		NewRow: &command.CDCRow{Values: []*command.CDCValue{cdcColFilterInt(1), cdcColFilterStr("111"), cdcColFilterStr("alice")}},
+	}); err != nil {
+		t.Fatalf("PreupdateHook: %v", err)
+	}
+	streamer.CommitHook()
+	<-ch
+
+	// A commit during which the version cannot be read at all.
+	np.VersionErr = fmt.Errorf("simulated: can't read schema_version")
+	streamer.Reset(2)
+	if err := streamer.PreupdateHook(&command.CDCEvent{
+		Table:  "users",
+		Op:     command.CDCEvent_INSERT,
+		NewRow: &command.CDCRow{Values: []*command.CDCValue{cdcColFilterInt(2), cdcColFilterStr("222"), cdcColFilterStr("bob")}},
+	}); err != nil {
+		t.Fatalf("PreupdateHook: %v", err)
+	}
+	streamer.CommitHook()
+	<-ch
+
+	// The version is readable again and has moved, because the table really
+	// was altered while it could not be read: ssn is now last, so a row's
+	// retained positions are no longer the ones the earlier layout implied.
+	np.VersionErr = nil
+	np.Version = 2
+	np.Columns["users"] = []string{"id", "name", "ssn"}
+
+	streamer.Reset(3)
+	if err := streamer.PreupdateHook(&command.CDCEvent{
+		Table:  "users",
+		Op:     command.CDCEvent_INSERT,
+		NewRow: &command.CDCRow{Values: []*command.CDCValue{cdcColFilterInt(3), cdcColFilterStr("carol"), cdcColFilterStr("333-44-5555")}},
+	}); err != nil {
+		t.Fatalf("PreupdateHook: %v", err)
+	}
+	streamer.CommitHook()
+
+	select {
+	case group := <-ch:
+		got := group.Events[0]
+		if got.Error != "" {
+			t.Fatalf("expected the event to be delivered normally once the version was readable "+
+				"again, got Error=%q", got.Error)
+		}
+		if !slices.Equal(got.ColumnNames, []string{"id", "name"}) {
+			t.Fatalf("expected [id name] re-derived once the version was readable again, got %v -- "+
+				"metadata held across a commit whose version was never confirmed must not be reused",
+				got.ColumnNames)
+		}
+		if !reflect.DeepEqual(cdcColFilterRowValuesAsAny(got.NewRow), []any{int64(3), "carol"}) {
+			t.Fatalf("expected new row [3 carol], got %v", cdcColFilterRowValuesAsAny(got.NewRow))
+		}
+		for _, v := range cdcColFilterRowValuesAsAny(got.NewRow) {
+			if v == "333-44-5555" {
+				t.Fatalf("excluded ssn value was published under column names %v: %v",
+					got.ColumnNames, cdcColFilterRowValuesAsAny(got.NewRow))
+			}
+		}
+	case <-time.After(2 * time.Second):
+		t.Fatal("timeout waiting for CDC event")
+	}
+}
