+			t.Fatalf("expected [id name] re-derived after SchemaVersion error, got %v", got.ColumnNames)
+		}
+		if !reflect.DeepEqual(cdcColFilterRowValuesAsAny(got.NewRow), []any{int64(2), "bob"}) {
+			t.Fatalf("expected new row [2 bob], got %v -- a stale cache would have kept the old "+
+				"column order and returned the wrong values", cdcColFilterRowValuesAsAny(got.NewRow))
