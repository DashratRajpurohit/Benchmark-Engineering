+//go:build acctrestrict
+
+package acctrestrict
+
+import (
+	"testing"
+
+	"github.com/pingcap/tidb/pkg/kv"
+	"github.com/pingcap/tidb/pkg/parser/auth"
+	"github.com/pingcap/tidb/pkg/testkit"
+	"github.com/stretchr/testify/require"
+)
+
+func loginAs(t *testing.T, store kv.Storage, user, host string) *testkit.TestKit {
+	tk := testkit.NewTestKit(t, store)
+	require.NoError(t, tk.Session().Auth(&auth.UserIdentity{Username: user, Hostname: host}, nil, nil, nil))
+	return tk
+}
+
+func TestPartialRevokeOfAGlobalPrivilege(t *testing.T) {
+	store := testkit.CreateMockStore(t)
+	root := loginAs(t, store, "root", "%")
+	root.MustExec("create database world")
+	root.MustExec("create table world.city (id int)")
+	root.MustExec("insert into world.city values (1)")
+	root.MustExec("create database other")
+	root.MustExec("create table other.t (id int)")
+	root.MustExec("create user u1")
+	root.MustExec("grant select, insert on *.* to u1")
+
+	// Without partial_revokes a schema level revoke of a global privilege is refused.
+	root.MustQuery("select @@global.partial_revokes").Check(testkit.Rows("0"))
+	require.Error(t, root.ExecToErr("revoke insert on world.* from u1"))
+
+	root.MustExec("set global partial_revokes = on")
+	t.Cleanup(func() {
+		root.MustExec("drop user u1")
+		root.MustExec("set global partial_revokes = off")
+	})
+	root.MustExec("revoke insert on world.* from u1")
+	root.MustQuery("show grants for u1").Check(testkit.Rows(
+		"GRANT SELECT,INSERT ON *.* TO `u1`@`%`",
+		"REVOKE INSERT ON `world`.* FROM `u1`@`%`",
+	))
+
+	u1 := loginAs(t, store, "u1", "localhost")
+	u1.MustQuery("select id from world.city").Check(testkit.Rows("1"))
+	require.ErrorContains(t, u1.ExecToErr("insert into world.city values (2)"), "INSERT command denied")
+	u1.MustExec("insert into other.t values (2)")
+	u1.MustQuery("select id from other.t").Check(testkit.Rows("2"))
+}
diff --git a/test.sh b/test.sh
new file mode 100755
index 0000000000..b8589db457
--- /dev/null
+++ b/test.sh
@@ -0,0 +1,62 @@
+#!/usr/bin/env bash
+# Usage:
+#   ./test.sh [--output_path <junit.xml>] <base|new>
+#
+# base  runs existing tests of the account and privilege code: the
+#       privilege cache package and the grant, revoke, role and privilege
+#       tests of the executor test suites.
+# new   runs the SQL level tests in pkg/executor/test/acctrestrictd9b2ec,
+#       which are compiled only with -tags acctrestrict.
+set -uo pipefail
+
+ORIG_PWD="$(pwd)"
+
+OUTPUT_PATH=""
+if [ "${1:-}" = "--output_path" ]; then
+  OUTPUT_PATH="$2"
+  shift 2
+  case "$OUTPUT_PATH" in
+    /*) : ;;
+    *) OUTPUT_PATH="$ORIG_PWD/$OUTPUT_PATH" ;;
+  esac
+fi
+
+MODE="${1:-new}"
+
+[ -f go.mod ] || cd "$(dirname "$0")"
+
+TEST_LOG="$(mktemp)"
+STATUS=0
+
+run_tests() {
+  go test -count=1 -v "$@" 2>&1 | tee -a "$TEST_LOG"
+  status=${PIPESTATUS[0]}
+  if [ "$status" -ne 0 ]; then
+    STATUS=$status
+  fi
+}
+
+case "$MODE" in
+  base)
+    run_tests -timeout 1200s -tags intest ./pkg/privilege/privileges
+    run_tests -timeout 1200s -tags intest -run 'Grant|Revoke|Role|Privilege' ./pkg/executor/test/simpletest ./pkg/executor/test/showtest
+    ;;
+  new)
+    run_tests -timeout 1200s -tags intest,acctrestrict ./pkg/executor/test/acctrestrictd9b2ec
+    ;;
+  *)
+    echo "unknown mode: $MODE (expected base or new)" >&2
+    exit 2
+    ;;
+esac
+
+if [ -n "$OUTPUT_PATH" ]; then
+  go-junit-report -set-exit-code < "$TEST_LOG" > "$OUTPUT_PATH"
+  junit_status=$?
+  if [ "$junit_status" -ne 0 ] && [ "$STATUS" -eq 0 ]; then
+    echo "go-junit-report failed to convert the test log (exit $junit_status)" >&2
+    STATUS=$junit_status
+  fi
+fi
+
+exit "$STATUS"
