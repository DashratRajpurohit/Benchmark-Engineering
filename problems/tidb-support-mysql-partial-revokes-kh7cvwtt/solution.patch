+
+
+package privileges
+
+import (
+	"encoding/json"
+	"slices"
+	"strings"
+
+	"github.com/pingcap/tidb/pkg/parser/mysql"
+	"github.com/pingcap/tidb/pkg/types"
+)
+
+// SchemaRestriction is one entry of User_attributes->>"$.Restrictions": the
+// globally granted privileges that a partial revoke removed for one schema.
+type SchemaRestriction struct {
+	DB         string
+	Privileges mysql.PrivilegeType
+}
+
+// RestrictionJSON is the stored form of a SchemaRestriction, the same as MySQL's.
+type RestrictionJSON struct {
+	Database   string   `json:"Database"`
+	Privileges []string `json:"Privileges"`
+}
+
+// RestrictablePrivs are the privileges a partial revoke can remove from a schema,
+// in the order they are stored and shown.
+var RestrictablePrivs = slices.Concat(mysql.AllDBPrivs, mysql.Privileges{mysql.GrantPriv})
+
+// RestrictionPrivName returns the name a restriction stores for priv.
+func RestrictionPrivName(priv mysql.PrivilegeType) string {
+	return strings.ToUpper(mysql.Priv2Str[priv])
+}
+
+// EncodeRestrictionPrivs converts privs to the names a restriction stores.
+func EncodeRestrictionPrivs(privs mysql.PrivilegeType) []string {
+	names := make([]string, 0, 4)
+	for _, p := range RestrictablePrivs {
+		if privs&p != 0 {
+			names = append(names, RestrictionPrivName(p))
+		}
+	}
+	return names
+}
+
+// DecodeRestrictionPrivs converts the stored names of a restriction back to privileges.
+func DecodeRestrictionPrivs(names []string) mysql.PrivilegeType {
+	var privs mysql.PrivilegeType
+	for _, name := range names {
+		for _, p := range RestrictablePrivs {
+			if strings.EqualFold(name, RestrictionPrivName(p)) {
+				privs |= p
+			}
+		}
+	}
+	return privs
+}
+
+func decodeRestrictions(bj types.BinaryJSON) ([]SchemaRestriction, error) {
+	pathExpr, err := types.ParseJSONPathExpr("$.Restrictions")
+	if err != nil {
+		return nil, err
+	}
+	rbj, found := bj.Extract([]types.JSONPathExpression{pathExpr})
+	if !found {
+		return nil, nil
+	}
+	var entries []RestrictionJSON
+	if err := json.Unmarshal([]byte(rbj.String()), &entries); err != nil {
+		return nil, err
+	}
+	restrictions := make([]SchemaRestriction, 0, len(entries))
+	for _, entry := range entries {
+		privs := DecodeRestrictionPrivs(entry.Privileges)
+		if privs == 0 {
+			continue
+		}
+		restrictions = append(restrictions, SchemaRestriction{DB: strings.Clone(entry.Database), Privileges: privs})
+	}
+	return restrictions, nil
+}
+
+// restrictedPrivs returns the global privileges of the record that are revoked on db.
+func (record *UserRecord) restrictedPrivs(db string) mysql.PrivilegeType {
+	var privs mysql.PrivilegeType
+	for _, r := range record.Restrictions {
+		if strings.EqualFold(r.DB, db) {
+			privs |= r.Privileges
+		}
+	}
+	return privs
+}
