+)
+
+// revokeOnSchema records a partial revoke: the privileges stay granted
+// globally but no longer apply to the schema dbName.
+func (e *RevokeExec) revokeOnSchema(internalSession sessionctx.Context, user, host, dbName string) error {
+	ctx := kv.WithInternalSourceType(context.Background(), kv.InternalTxnPrivilege)
+	sql := new(strings.Builder)
+	sqlescape.MustFormatSQL(sql, "SELECT User_attributes")
+	for _, p := range privileges.RestrictablePrivs {
+		sqlescape.MustFormatSQL(sql, ", %n", p.ColumnString())
+	}
+	sqlescape.MustFormatSQL(sql, " FROM %n.%n WHERE User=%? AND Host=%? FOR UPDATE", mysql.SystemDB, mysql.UserTable, user, strings.ToLower(host))
+	rs, err := internalSession.GetSQLExecutor().ExecuteInternal(ctx, sql.String())
+	if err != nil {
+		return err
+	}
+	rows, _, err := getRowsAndFields(internalSession, rs)
+	if err != nil {
+		return err
+	}
+	if len(rows) == 0 {
+		return errors.Errorf("There is no such grant defined for user '%s' on host '%s'", user, host)
+	}
+	row := rows[0]
+	var global mysql.PrivilegeType
+	for i, p := range privileges.RestrictablePrivs {
+		if row.GetEnum(i+1).String() == "Y" {
+			global |= p
+		}
+	}
+
+	var privs mysql.PrivilegeType
+	for _, priv := range e.Privs {
+		switch {
+		case priv.Priv == mysql.UsagePriv:
+		case priv.Priv == mysql.AllPriv:
+			privs |= global &^ mysql.GrantPriv
+		case slices.Contains(privileges.RestrictablePrivs, priv.Priv):
+			privs |= priv.Priv
+		default:
+			return exeerrors.ErrWrongUsage.GenWithStackByArgs("DB GRANT", "GLOBAL PRIVILEGES")
+		}
+	}
+	if privs&^global != 0 {
+		return errors.Errorf("There is no such grant defined for user '%s' on host '%s'", user, host)
+	}
+	if privs == 0 {
+		return nil
+	}
+
+	attrs := make(map[string]any)
+	var restrictions []privileges.RestrictionJSON
+	if !row.IsNull(0) {
+		dec := json.NewDecoder(bytes.NewReader([]byte(row.GetJSON(0).String())))
+		dec.UseNumber()
+		if err := dec.Decode(&attrs); err != nil {
+			return err
+		}
+		if stored, ok := attrs["Restrictions"]; ok {
+			b, err := json.Marshal(stored)
+			if err != nil {
+				return err
+			}
+			if err := json.Unmarshal(b, &restrictions); err != nil {
+				return err
+			}
+		}
+	}
+	found := false
+	for i := range restrictions {
+		if restrictions[i].Database == dbName {
+			merged := privileges.DecodeRestrictionPrivs(restrictions[i].Privileges) | privs
+			restrictions[i].Privileges = privileges.EncodeRestrictionPrivs(merged)
+			found = true
+		}
+	}
+	if !found {
+		restrictions = append(restrictions, privileges.RestrictionJSON{Database: dbName, Privileges: privileges.EncodeRestrictionPrivs(privs)})
+	}
+	slices.SortFunc(restrictions, func(a, b privileges.RestrictionJSON) int { return strings.Compare(a.Database, b.Database) })
+	attrs["Restrictions"] = restrictions
+	value, err := json.Marshal(attrs)
+	if err != nil {
+		return err
+	}
+	_, err = internalSession.GetSQLExecutor().ExecuteInternal(ctx, "UPDATE %n.%n SET User_attributes=%? WHERE User=%? AND Host=%?",
+		mysql.SystemDB, mysql.UserTable, string(value), user, strings.ToLower(host))
+	return err
+}
