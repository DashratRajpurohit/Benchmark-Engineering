+// deferUpdate keeps an update Set that did not fit into setBuf until
+// processItems charges its cost. Only the newest update of a key is kept:
+// an older one no longer matches the stored value and would not be charged.
+func (c *Cache[K, V]) deferUpdate(i *Item[V]) {
+	c.deferredMu.Lock()
+	prev, ok := c.deferred[i.Key]
+	if !ok || prev.seq < i.seq {
+		if c.deferred == nil {
+			c.deferred = make(map[uint64]*Item[V])
+		}
+		c.deferred[i.Key] = i
+	}
+	c.deferredMu.Unlock()
+	if ok {
+		// Of the two updates only one is kept, but both updated the value.
+		c.Metrics.add(keyUpdate, i.Key, 1)
+	}
+	select {
+	case c.deferredReady <- struct{}{}:
+	default:
+		// A wake-up is already pending and will see this update.
+	}
+}
+
+// deferTicket keeps the ticket of a queued update that did not fit into
+// setBuf until processItems applies it.
+func (c *Cache[K, V]) deferTicket(i *Item[V]) {
+	c.deferredMu.Lock()
+	c.deferredTickets = append(c.deferredTickets, i)
+	c.deferredMu.Unlock()
+	select {
+	case c.deferredReady <- struct{}{}:
+	default:
+		// A wake-up is already pending and will see this ticket.
+	}
+}
+
+// takeDeferred hands over the work kept by deferUpdate and deferTicket.
+func (c *Cache[K, V]) takeDeferred() (map[uint64]*Item[V], []*Item[V]) {
+	c.deferredMu.Lock()
+	defer c.deferredMu.Unlock()
+	updates, tickets := c.deferred, c.deferredTickets
+	c.deferred, c.deferredTickets = nil, nil
+	return updates, tickets
