+// parkedValue is the value of an item that is deliberately too costly to
+// admit; its rejection is used to hold the cache's background worker still.
+const parkedValue = -1
+
+// exitLog records every value handed to OnExit.
+type exitLog struct {
+	mu     sync.Mutex
+	counts map[int]int
+}
+
+func newExitLog() *exitLog { return &exitLog{counts: map[int]int{}} }
+
+func (l *exitLog) record(v int) {
+	l.mu.Lock()
+	l.counts[v]++
+	l.mu.Unlock()
+}
+
+func (l *exitLog) snapshot() map[int]int {
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	out := make(map[int]int, len(l.counts))
+	for v, n := range l.counts {
+		out[v] = n
+	}
+	return out
+}
+
+// parkOnFirst returns a callback that, on its first invocation, closes parked
+// and then blocks until release is closed. Cache callbacks run on the cache's
+// background worker, so this holds that worker at a known point.
+func parkOnFirst(parked, release chan struct{}) func(*Item[int]) {
+	var once sync.Once
+	return func(*Item[int]) {
+		once.Do(func() {
+			close(parked)
+			select {
+			case <-release:
+			case <-time.After(10 * time.Second):
+			}
+		})
+	}
+}
+
+// holdWorker parks the background worker on each over-capacity item
+// (parkedValue) in turn, like parkInTurn. On every other rejection it lets
+// other goroutines run for a moment before the worker goes on, so calls
+// waiting for room in a full write buffer get to take their next step while
+// the worker is still busy.
+func holdWorker(parked, release []chan struct{}) func(*Item[int]) {
+	park := parkInTurn(parked, release)
+	return func(it *Item[int]) {
+		if it.Value == parkedValue {
+			park(it)
+			return
+		}
+		for i := 0; i < 100; i++ {
+			runtime.Gosched()
+		}
+	}
+}
+
+// holds is how many times the full-buffer tests hold the background worker.
+const holds = 5
+
+func newHolds() (parked, release []chan struct{}) {
+	for i := 0; i < holds; i++ {
+		parked = append(parked, make(chan struct{}))
+		release = append(release, make(chan struct{}))
+	}
+	return parked, release
+}
+
+// releaseHolds lets the worker go one hold at a time, each time only once the
+// calls counted in returned have settled. A cleanup tick is due by the first
+// release (see expiringKey), so whenever the worker picks it up a call is
+// waiting on the cache; a cache that deadlocks then never reaches the next
+// hold, which fails the test.
+func releaseHolds(t *testing.T, c *Cache[uint64, int], parked, release []chan struct{}, returned *int64, total int64) {
+	t.Helper()
+	for i := range release {
+		waitForCallsToSettle(returned, total)
+		if i == 0 {
+			waitExpired(t, c)
+		}
+		close(release[i])
+		if i+1 < len(parked) {
+			waitClosed(t, parked[i+1], "the background worker to reach the next hold")
+		}
+	}
+}
+
+// parkInTurn returns a callback that, on its i-th invocation, closes
+// parked[i] and then blocks until release[i] is closed.
+func parkInTurn(parked, release []chan struct{}) func(*Item[int]) {
+	var n int32
+	return func(*Item[int]) {
+		i := int(atomic.AddInt32(&n, 1)) - 1
+		if i >= len(parked) {
+			return
+		}
+		close(parked[i])
+		select {
+		case <-release[i]:
+		case <-time.After(10 * time.Second):
+		}
+	}
+}
+
+func waitClosed(t *testing.T, ch <-chan struct{}, what string) {
+	t.Helper()
+	select {
+	case <-ch:
+	case <-time.After(10 * time.Second):
+		t.Fatalf("timed out waiting for %s", what)
+	}
+}
+
+// waitForCallsToSettle waits until all total calls counted in returned have
+// returned, or until none has returned for a short while. Calls that are still
+// running by then are waiting on the cache. This only makes the interleaving a
+// test is after likely; the assertions that follow it hold for every
+// interleaving, and a cache that never lets the calls finish fails them.
+func waitForCallsToSettle(returned *int64, total int64) {
+	const quiet = 100 * time.Millisecond
+	tick := time.NewTicker(time.Millisecond)
+	defer tick.Stop()
+	deadline := time.After(5 * time.Second)
+	last, since := atomic.LoadInt64(returned), time.Now()
+	for {
+		n := atomic.LoadInt64(returned)
+		if n == total {
+			return
+		}
+		if n != last {
+			last, since = n, time.Now()
+		} else if time.Since(since) >= quiet {
+			return
+		}
+		select {
+		case <-tick.C:
+		case <-deadline:
+			return
+		}
+	}
+}
+
+func newExitTestCache(t *testing.T, cfg Config[uint64, int]) *Cache[uint64, int] {
+	t.Helper()
+	cfg.NumCounters = 1000
+	cfg.BufferItems = 64
+	cfg.IgnoreInternalCost = true
+	if cfg.MaxCost == 0 {
+		cfg.MaxCost = 100
+	}
+	if cfg.ShouldUpdate == nil {
+		cfg.ShouldUpdate = func(cur, prev int) bool { return false }
+	}
+	c, err := NewCache(&cfg)
+	require.NoError(t, err)
+	return c
+}
