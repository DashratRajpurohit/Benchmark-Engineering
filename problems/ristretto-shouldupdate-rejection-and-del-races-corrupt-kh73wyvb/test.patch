+func TestRejectedUpdatesUnderConcurrencyKeepRemainingCost(t *testing.T) {
+	c := newExitTestCache(t, Config[uint64, int]{})
+	defer c.Close()
+
+	require.True(t, c.Set(1, 111, 10))
+	c.Wait()
+
+	var wg sync.WaitGroup
+	for g := 0; g < 8; g++ {
+		wg.Add(1)
+		go func(g int) {
+			defer wg.Done()
+			for i := 0; i < 200; i++ {
+				c.Set(1, 1000+g*1000+i, int64(11+(g+i)%80))
+				c.Get(1)
+			}
+		}(g)
+	}
+	wg.Wait()
+	c.Wait()
+
+	require.Equal(t, int64(90), c.RemainingCost())
+	v, ok := c.Get(1)
+	require.True(t, ok)
+	require.Equal(t, 111, v)
+}
