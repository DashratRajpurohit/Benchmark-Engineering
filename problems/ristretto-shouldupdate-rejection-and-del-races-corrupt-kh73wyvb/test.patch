+func TestShouldUpdateMonotonicSequence(t *testing.T) {
+	var rejects int64
+	log := newExitLog()
+	c := newExitTestCache(t, Config[uint64, int]{
+		ShouldUpdate: func(cur, prev int) bool { return cur > prev },
+		OnReject:     func(*Item[int]) { atomic.AddInt64(&rejects, 1) },
+		OnExit:       log.record,
+	})
+	defer c.Close()
+
+	steps := []struct {
+		value         int
+		cost          int64
+		wantValue     int
+		wantRemaining int64
+	}{
+		{value: 5, cost: 10, wantValue: 5, wantRemaining: 90},
+		{value: 3, cost: 70, wantValue: 5, wantRemaining: 90},
+		{value: 8, cost: 20, wantValue: 8, wantRemaining: 80},
+		{value: 7, cost: 50, wantValue: 8, wantRemaining: 80},
+	}
+	for _, s := range steps {
+		c.Set(1, s.value, s.cost)
+		c.Wait()
+		v, ok := c.Get(1)
+		require.True(t, ok)
+		require.Equal(t, s.wantValue, v, "after Set(%d, cost %d)", s.value, s.cost)
+		require.Equal(t, s.wantRemaining, c.RemainingCost(), "after Set(%d, cost %d)", s.value, s.cost)
+	}
+	require.Zero(t, atomic.LoadInt64(&rejects))
+	require.Equal(t, map[int]int{5: 1}, log.snapshot())
+}
