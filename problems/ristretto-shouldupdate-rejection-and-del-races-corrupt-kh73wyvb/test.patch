+func TestRejectedUpdateKeepsRemainingCost(t *testing.T) {
+	c := newExitTestCache(t, Config[uint64, int]{})
+	defer c.Close()
+
+	require.True(t, c.Set(1, 111, 10))
+	c.Wait()
+	require.Equal(t, int64(90), c.RemainingCost())
+
+	c.Set(1, 222, 90)
+	c.Wait()
+	require.Equal(t, int64(90), c.RemainingCost(), "rejected update with a larger cost")
+
+	c.Set(1, 333, 1)
+	c.Wait()
+	require.Equal(t, int64(90), c.RemainingCost(), "rejected update with a smaller cost")
+}
