+// Keys whose primary hashes collide are still different keys: a pending Set
+// of one is never decided by ShouldUpdate against a pending Set of the
+// other, while a pending Set of the same key still is, neither key's values
+// reach OnReject or OnExit because of the other key, and RemainingCost keeps
+// reflecting the value that stays stored.
+func TestPendingSetsOfKeysSharingAHashAreNotCompared(t *testing.T) {
+	parked, release := make(chan struct{}), make(chan struct{})
+	var once sync.Once
+	var mu sync.Mutex
+	var mixed [][2]any
+	var rejected []any
+	exited := map[any]int{}
+	c, err := NewCache(&Config[string, any]{
+		NumCounters:        1000,
+		MaxCost:            100,
+		BufferItems:        64,
+		IgnoreInternalCost: true,
+		// "a" and "bb" share the primary hash 7 and differ in the conflict hash.
+		KeyToHash: func(key string) (uint64, uint64) {
+			if key == "parked" {
+				return 5, 5
+			}
+			return 7, uint64(len(key))
+		},
+		ShouldUpdate: func(cur, prev any) bool {
+			cv, curIsInt := cur.(int)
+			pv, prevIsInt := prev.(int)
+			if !curIsInt || !prevIsInt {
+				mu.Lock()
+				mixed = append(mixed, [2]any{cur, prev})
+				mu.Unlock()
+				return false
+			}
+			return cv > pv
+		},
+		OnExit: func(v any) {
+			mu.Lock()
+			exited[v]++
+			mu.Unlock()
+		},
+		OnReject: func(it *Item[any]) {
+			mu.Lock()
+			rejected = append(rejected, it.Value)
+			mu.Unlock()
+			if it.Value == "parked" {
+				once.Do(func() {
+					close(parked)
+					select {
+					case <-release:
+					case <-time.After(10 * time.Second):
+					}
+				})
+			}
+		},
+	})
+	require.NoError(t, err)
+	defer c.Close()
+
+	c.Set("parked", "parked", 101)
+	waitClosed(t, parked, "the background worker to report the over-capacity item")
+
+	c.Set("a", 1, 1)
+	c.Set("a", 2, 1)
+	c.Set("bb", "x", 50)
+	close(release)
+	c.Wait()
+
+	v, ok := c.Get("a")
+	require.True(t, ok)
+	require.Equal(t, 2, v)
+	require.Equal(t, int64(99), c.RemainingCost(), "only the value stored for \"a\" is charged")
+	mu.Lock()
+	defer mu.Unlock()
+	require.Empty(t, mixed, "ShouldUpdate compared the values of different keys")
+	// "bb" may be turned away, since the cache keeps one key per primary
+	// hash, but only ever as itself; "a" only loses 1, to its own Set of 2.
+	require.NotContains(t, rejected, 1)
+	require.NotContains(t, rejected, 2)
+	require.Equal(t, 1, exited[1], "1 is replaced by the Set of 2 to the same key")
+	require.Zero(t, exited[2], "2 is still stored")
+	require.LessOrEqual(t, exited["x"], 1)
+}
+
+// A key whose primary hash collides with a stored key is still an item of
+// its own. If the cache accepts two Sets of it while the first is pending,
+// the second is an update of the first: ShouldUpdate decides it against the
+// first value, never against the stored key's value, and a rejected value
+// reaches neither OnReject nor OnExit. The cache may also turn such Sets away
+// as long as the stored key is left as it was.
+func TestRepeatSetOfKeyCollidingWithStoredKeyIsAnUpdate(t *testing.T) {
+	parked, release := make(chan struct{}), make(chan struct{})
+	var once sync.Once
+	var mu sync.Mutex
+	var compared [][2]any
+	var rejected []any
+	exited := map[any]int{}
+	c, err := NewCache(&Config[string, any]{
+		NumCounters:        1000,
+		MaxCost:            100,
+		BufferItems:        64,
+		IgnoreInternalCost: true,
+		// "a" and "bb" share the primary hash 7 and differ in the conflict hash.
+		KeyToHash: func(key string) (uint64, uint64) {
+			if key == "parked" {
+				return 5, 5
+			}
+			return 7, uint64(len(key))
+		},
+		ShouldUpdate: func(cur, prev any) bool {
+			mu.Lock()
+			compared = append(compared, [2]any{cur, prev})
+			mu.Unlock()
+			return false
+		},
+		OnExit: func(v any) {
+			mu.Lock()
+			exited[v]++
+			mu.Unlock()
+		},
+		OnReject: func(it *Item[any]) {
+			if it.Value == "parked" {
+				once.Do(func() {
+					close(parked)
+					select {
+					case <-release:
+					case <-time.After(10 * time.Second):
+					}
+				})
+				return
+			}
+			mu.Lock()
+			rejected = append(rejected, it.Value)
+			mu.Unlock()
+		},
+	})
+	require.NoError(t, err)
+	defer c.Close()
+
+	require.True(t, c.Set("a", 1, 1))
+	c.Wait()
+	c.Set("parked", "parked", 101)
+	waitClosed(t, parked, "the background worker to report the over-capacity item")
+
+	first := c.Set("bb", 10, 1)
+	second := c.Set("bb", 20, 1)
+	close(release)
+	c.Wait()
+
+	v, ok := c.Get("a")
+	require.True(t, ok)
+	require.Equal(t, 1, v)
+	require.Equal(t, int64(99), c.RemainingCost(), "only the value stored for \"a\" is charged")
+	mu.Lock()
+	defer mu.Unlock()
+	for _, pair := range compared {
+		require.NotContains(t, pair, 1, "ShouldUpdate compared a value of \"bb\" with the stored value of \"a\"")
+	}
+	if first && second {
+		require.Contains(t, compared, [2]any{20, 10}, "the second Set of \"bb\" was not decided against the first")
+		require.NotContains(t, rejected, 20, "a value ShouldUpdate turned down reached OnReject")
+		require.Zero(t, exited[20], "a value ShouldUpdate turned down reached OnExit")
+	}
+}
+
+// collisionLog records what a cache made by newCollidingCache hands to its
+// callbacks.
+type collisionLog struct {
+	mu       sync.Mutex
+	compared [][2]any
+	rejected []any
+	exited   map[any]int
+	evicted  map[any]int
+}
+
+// newCollidingCache returns a cache in which every key but "parked" has the
+// primary hash 7 and its length as the conflict hash, so "a", "bb", "ccc"
+// and so on all collide, with accept as its ShouldUpdate. Setting the over-capacity key "parked" holds the background
+// worker in OnReject until release is closed; parked is closed once it is
+// held.
+func newCollidingCache(t *testing.T, accept func(cur, prev any) bool) (*Cache[string, any], *collisionLog, chan struct{}, chan struct{}) {
+	t.Helper()
+	parked, release := make(chan struct{}), make(chan struct{})
+	log := &collisionLog{exited: map[any]int{}, evicted: map[any]int{}}
+	var once sync.Once
+	c, err := NewCache(&Config[string, any]{
+		NumCounters:        1000,
+		MaxCost:            100,
+		BufferItems:        64,
+		IgnoreInternalCost: true,
+		KeyToHash: func(key string) (uint64, uint64) {
+			if key == "parked" {
+				return 5, 5
+			}
+			return 7, uint64(len(key))
+		},
+		ShouldUpdate: func(cur, prev any) bool {
+			log.mu.Lock()
+			log.compared = append(log.compared, [2]any{cur, prev})
+			log.mu.Unlock()
+			return accept(cur, prev)
+		},
+		OnExit: func(v any) {
+			log.mu.Lock()
+			log.exited[v]++
+			log.mu.Unlock()
+		},
+		OnEvict: func(it *Item[any]) {
+			log.mu.Lock()
+			log.evicted[it.Value]++
+			log.mu.Unlock()
+		},
+		OnReject: func(it *Item[any]) {
+			if it.Value == "parked" {
+				once.Do(func() {
+					close(parked)
+					select {
+					case <-release:
+					case <-time.After(10 * time.Second):
+					}
+				})
+				return
+			}
+			log.mu.Lock()
+			log.rejected = append(log.rejected, it.Value)
+			log.mu.Unlock()
+		},
+	})
+	require.NoError(t, err)
+	return c, log, parked, release
+}
+
+// Pending Sets of one key are decided against each other, also when the
+// Sets of another key sharing their primary hash alternate with them. The
+// values of "a" are below 10 and those of "bb" are not, so a comparison of
+// the two keys shows. As in TestRepeatSetOfKeyCollidingWithStoredKeyIsAnUpdate,
+// the cache may turn the Sets of "bb" away, but only as itself.
+func TestAlternatingPendingSetsOfCollidingKeysAreDecidedPerKey(t *testing.T) {
+	c, log, parked, release := newCollidingCache(t, func(cur, prev any) bool { return false })
+	defer c.Close()
+
+	c.Set("parked", "parked", 101)
+	waitClosed(t, parked, "the background worker to report the over-capacity item")
+	require.True(t, c.Set("a", 1, 1))
+	first := c.Set("bb", 10, 1)
+	c.Set("a", 3, 1)
+	second := c.Set("bb", 30, 1)
+	close(release)
+	c.Wait()
+
+	v, ok := c.Get("a")
+	require.True(t, ok)
+	require.Equal(t, 1, v, "the Set of 3 was not decided against the pending Set of 1")
+	require.Equal(t, int64(99), c.RemainingCost(), "only the value stored for \"a\" is charged")
+	log.mu.Lock()
+	defer log.mu.Unlock()
+	isA := func(v any) bool {
+		n, ok := v.(int)
+		return ok && n < 10
+	}
+	for _, pair := range log.compared {
+		require.Equal(t, isA(pair[0]), isA(pair[1]), "ShouldUpdate compared values of \"a\" and \"bb\": %v", pair)
+	}
+	require.NotContains(t, log.rejected, 1)
+	require.NotContains(t, log.rejected, 3, "a value ShouldUpdate turned down reached OnReject")
+	require.Zero(t, log.exited[3], "a value ShouldUpdate turned down reached OnExit")
+	require.Zero(t, log.exited[1], "1 is still stored")
+	if first && second {
+		require.NotContains(t, log.rejected, 30, "a value ShouldUpdate turned down reached OnReject")
+		require.Zero(t, log.exited[30], "a value ShouldUpdate turned down reached OnExit")
+	}
+}
+
+// A Set of a stored key is decided against the stored value, also while
+// Sets of other keys sharing its primary hash are still pending. A value
+// ShouldUpdate turned down is never reported, not even by a Clear that
+// finds the other Sets still pending.
+func TestRejectedUpdateBesidePendingSetOfCollidingKeyIsNotReported(t *testing.T) {
+	c, log, parked, release := newCollidingCache(t, func(cur, prev any) bool { return false })
+	defer c.Close()
+
+	require.True(t, c.Set("a", 1, 1))
+	c.Wait()
+	c.Set("parked", "parked", 101)
+	waitClosed(t, parked, "the background worker to report the over-capacity item")
+	for _, k := range []string{"bb", "ccc", "dddd", "eeeee"} {
+		c.Set(k, 10, 1)
+	}
+	c.Set("a", 2, 1)
+	v, ok := c.Get("a")
+	require.True(t, ok)
+	require.Equal(t, 1, v, "ShouldUpdate turned the Set of 2 down")
+
+	cleared := make(chan struct{})
+	go func() {
+		c.Clear()
+		close(cleared)
+	}()
+	// Clear cannot finish while the worker is held. Give it a moment to
+	// start waiting for the worker, so that it finds the other Sets still
+	// pending; the assertions below hold however the two interleave.
+	select {
+	case <-cleared:
+	case <-time.After(100 * time.Millisecond):
+	}
+	close(release)
+	waitClosed(t, cleared, "Clear")
+
+	_, ok = c.Get("a")
+	require.False(t, ok, "\"a\" is still cached after Clear")
+	log.mu.Lock()
+	defer log.mu.Unlock()
+	require.NotContains(t, log.rejected, 2, "a value ShouldUpdate turned down reached OnReject")
+	require.Zero(t, log.exited[2], "a value ShouldUpdate turned down reached OnExit")
+	require.Zero(t, log.evicted[2], "a value ShouldUpdate turned down reached OnEvict")
+	require.Equal(t, 1, log.exited[1], "the stored value of \"a\" is reported once")
+}
+
+// A Del of a key that is not present reports nothing, also when the key
+// shares its primary hash with a stored key, and also when a Set of it is
+// still pending. The stored key keeps its value and its cost.
+func TestDelOfKeyCollidingWithStoredKeyLeavesItStored(t *testing.T) {
+	c, log, parked, release := newCollidingCache(t, func(cur, prev any) bool { return true })
+	defer c.Close()
+
+	stays := func(when string) {
+		t.Helper()
+		v, ok := c.Get("a")
+		require.True(t, ok, when)
+		require.Equal(t, 1, v, when)
+		require.Equal(t, int64(90), c.RemainingCost(), "%s: the cost of \"a\" is no longer charged", when)
+		_, ok = c.Get("bb")
+		require.False(t, ok, when)
+	}
+
+	require.True(t, c.Set("a", 1, 10))
+	c.Wait()
+	c.Del("bb")
+	c.Wait()
+	stays("after a Del of \"bb\"")
+
+	c.Set("parked", "parked", 101)
+	waitClosed(t, parked, "the background worker to report the over-capacity item")
+	c.Set("bb", 2, 1)
+	c.Del("bb")
+	close(release)
+	c.Wait()
+	stays("after a Del of \"bb\" behind a pending Set of it")
+
+	log.mu.Lock()
+	defer log.mu.Unlock()
+	require.Zero(t, log.exited[1], "the value of \"a\" was reported")
+	require.Zero(t, log.exited[nil], "OnExit was handed a zero value")
+	require.LessOrEqual(t, log.exited[2], 1, "the value of \"bb\" was reported more than once")
+}
+
+// OnExit may release the value it is handed (see Config.OnExit). An update
+// replaced before the background worker charges its cost must therefore not
+// have the Cost function asked about it afterwards.
+func TestCostIsNotAskedForAReleasedValue(t *testing.T) {
+	parked, release := make(chan struct{}), make(chan struct{})
+	var mu sync.Mutex
+	released := map[int]bool{}
+	var late []int
+	c := newExitTestCache(t, Config[uint64, int]{
+		ShouldUpdate: alwaysReplace,
+		OnReject:     parkOnFirst(parked, release),
+		Cost: func(v int) int64 {
+			mu.Lock()
+			if released[v] {
+				late = append(late, v)
+			}
+			mu.Unlock()
+			return int64(v)
+		},
+		OnExit: func(v int) {
+			mu.Lock()
+			released[v] = true
+			mu.Unlock()
+		},
+	})
+	defer c.Close()
+
+	require.True(t, c.Set(1, 10, 0))
+	c.Wait()
+	c.Set(99, parkedValue, 101)
+	waitClosed(t, parked, "the background worker to report the over-capacity item")
+
+	require.True(t, c.Set(1, 20, 0))
+	require.True(t, c.Set(1, 30, 0))
+	close(release)
+	c.Wait()
+
+	v, ok := c.Get(1)
+	require.True(t, ok)
+	require.Equal(t, 30, v)
+	require.Equal(t, int64(70), c.RemainingCost())
+	mu.Lock()
+	defer mu.Unlock()
+	require.Empty(t, late, "Cost was asked about a value already handed to OnExit")
+}
+
+// Once the cache holds a value, a Set from another goroutine may replace it
+// and OnExit may release it. A value the Cost function is being asked about
+// must not be released while Cost is still using it, whether the cache asks
+// Cost before it stores the value or keeps other writers of the key waiting
+// until Cost returns.
+func TestValueIsNotReleasedWhileCostIsAskedAboutIt(t *testing.T) {
+	var mu sync.Mutex
+	released := map[int]bool{}
+	var late []int
+	overlapped := false
+	other := make(chan struct{})
+	var once sync.Once
+	var c *Cache[uint64, int]
+	c = newExitTestCache(t, Config[uint64, int]{
+		ShouldUpdate: alwaysReplace,
+		Cost: func(v int) int64 {
+			mu.Lock()
+			if released[v] {
+				late = append(late, v)
+			}
+			mu.Unlock()
+			if v == 20 {
+				once.Do(func() {
+					// Another goroutine sets the key while Cost is busy with
+					// 20. Cost goes on only once that Set has returned or is
+					// waiting inside the cache, so a cache that lets it
+					// release 20 now has done so by then.
+					go competingSet(c, other)
+					waitForReturnOrWait(other, "competingSet")
+					mu.Lock()
+					overlapped = released[20]
+					mu.Unlock()
+				})
+			}
+			return int64(v)
+		},
+		OnExit: func(v int) {
+			mu.Lock()
+			released[v] = true
+			mu.Unlock()
+		},
+	})
+	defer c.Close()
+
+	require.True(t, c.Set(1, 10, 5))
+	c.Wait()
+	require.True(t, c.Set(1, 20, 0))
+	waitClosed(t, other, "the other goroutine's Set to return")
+	waitApplied(t, c)
+
+	v, ok := c.Get(1)
+	require.True(t, ok)
+	// Either Set may take effect last.
+	require.Contains(t, []int{20, 30}, v)
+	cost := map[int]int64{20: 20, 30: 5}[v]
+	require.Equal(t, 100-cost, c.RemainingCost())
+	mu.Lock()
+	defer mu.Unlock()
+	require.False(t, overlapped, "20 was handed to OnExit while Cost was asked about it")
+	require.Empty(t, late, "Cost was asked about a value already handed to OnExit")
+	require.True(t, released[10], "10 was replaced")
+	require.Equal(t, v != 20, released[20])
+	require.Equal(t, v != 30, released[30])
+}
+
+// competingSet sets key 1 to 30 and then closes done. It is a named function
+// so waitForReturnOrWait can tell the goroutine running it apart.
+func competingSet(c *Cache[uint64, int], done chan<- struct{}) {
+	c.Set(1, 30, 5)
+	close(done)
+}
+
+// waitForReturnOrWait returns once done is closed, or once the goroutine
+// running fn is parked (on a lock, a channel or the like) in two samples in a
+// row, so it can make no further progress until something else does. The
+// goroutine state is the bracketed status runtime.Stack prints for it. A
+// writer that waits by spinning never parks; after 10 seconds it is taken to
+// be waiting too.
+func waitForReturnOrWait(done <-chan struct{}, fn string) {
+	buf := make([]byte, 1<<20)
+	deadline := time.Now().Add(10 * time.Second)
+	parkedSamples := 0
+	for time.Now().Before(deadline) {
+		select {
+		case <-done:
+			return
+		default:
+		}
+		parked := false
+		for _, g := range strings.Split(string(buf[:runtime.Stack(buf, true)]), "\n\n") {
+			if !strings.Contains(g, "."+fn+"(") {
+				continue
+			}
+			header, _, _ := strings.Cut(g, "\n")
+			_, status, _ := strings.Cut(header, "[")
+			parked = !strings.HasPrefix(status, "running") && !strings.HasPrefix(status, "runnable")
+		}
+		if parked {
+			parkedSamples++
+			if parkedSamples == 2 {
+				return
+			}
+		} else {
+			parkedSamples = 0
+		}
+		runtime.Gosched()
+	}
+}
+
+// clearRounds is how many times TestClearDoesNotAskCostAboutAReportedUpdate
+// repeats its scenario. Whether Clear or the background worker gets to an
+// update left over from a full write buffer first is up to the scheduler; the
+// assertions hold either way, and repeating makes both orders all but certain.
+const clearRounds = 20
+
+// Clear hands every stored value to OnExit, which may release it (see
+// Config.OnExit). An accepted update of a stored key whose cost accounting is
+// still waiting, because the write buffer was full when it was made, must not
+// have the Cost function asked about its value after Clear has reported it.
+func TestClearDoesNotAskCostAboutAReportedUpdate(t *testing.T) {
+	for round := 0; round < clearRounds; round++ {
+		clearWithUpdateCostPending(t, round)
+	}
+}
+
+func clearWithUpdateCostPending(t *testing.T, round int) {
+	t.Helper()
+	parked, release := make(chan struct{}), make(chan struct{})
+	var mu sync.Mutex
+	released := map[int]bool{}
+	var late []int
+	var evicted []Item[int]
+	c := newExitTestCache(t, Config[uint64, int]{
+		ShouldUpdate: alwaysReplace,
+		OnReject:     parkOnFirst(parked, release),
+		Cost: func(v int) int64 {
+			mu.Lock()
+			if released[v] {
+				late = append(late, v)
+			}
+			mu.Unlock()
+			return int64(v)
+		},
+		OnExit: func(v int) {
+			mu.Lock()
+			released[v] = true
+			mu.Unlock()
+		},
+		OnEvict: func(it *Item[int]) {
+			if it.Value == 20 {
+				mu.Lock()
+				evicted = append(evicted, *it)
+				mu.Unlock()
+			}
+		},
+	})
+	defer c.Close()
+
+	require.True(t, c.Set(1, 10, 0))
+	c.Wait()
+	c.Set(99, parkedValue, 101)
+	waitClosed(t, parked, "the background worker to report the over-capacity item")
+	fillWriteBuffer(t, c)
+
+	// The update of stored key 1 does not fit into the write buffer. A cache
+	// may keep its cost accounting for later or make the Set wait for room.
+	updated := make(chan bool, 1)
+	var returned int64
+	go func() {
+		ok := c.Set(1, 20, 0)
+		atomic.AddInt64(&returned, 1)
+		updated <- ok
+	}()
+	waitForCallsToSettle(&returned, 1)
+	waitUpdate := func() {
+		select {
+		case ok := <-updated:
+			require.True(t, ok, "round %d: the update of stored key 1 was dropped", round)
+		case <-time.After(10 * time.Second):
+			t.Fatalf("round %d: timed out waiting for the update of key 1", round)
+		}
+	}
+	cleared := make(chan struct{})
+	if atomic.LoadInt64(&returned) == 1 {
+		// The Set returned with its cost accounting left over: Clear starts
+		// while the background worker is still held.
+		// Clear cannot return while the worker is held, so this only gives
+		// it time to reach the worker before the worker is let go.
+		var clearReturned int64
+		go func() {
+			c.Clear()
+			atomic.AddInt64(&clearReturned, 1)
+			close(cleared)
+		}()
+		waitForCallsToSettle(&clearReturned, 1)
+		close(release)
+		waitUpdate()
+	} else {
+		// The Set waits for room in the write buffer, so it has nothing left
+		// over; Clear runs once it has returned.
+		close(release)
+		waitUpdate()
+		go func() {
+			c.Clear()
+			close(cleared)
+		}()
+	}
+	waitClosed(t, cleared, "Clear to return")
+	waitApplied(t, c)
+
+	_, ok := c.Get(1)
+	require.False(t, ok, "round %d: key 1 was cleared", round)
+	require.Equal(t, int64(100), c.RemainingCost(), "round %d", round)
+	mu.Lock()
+	defer mu.Unlock()
+	require.True(t, released[20], "round %d: Clear reported 20", round)
+	require.Empty(t, late, "round %d: Cost was asked about a value Clear had already handed to OnExit", round)
+	// Clear reports the entry with the cost RemainingCost accounted for it:
+	// 20 once the update has been charged, 10 while its charge is pending.
+	require.Len(t, evicted, 1, "round %d: Clear reports key 1 to OnEvict once", round)
+	require.Contains(t, []int64{10, 20}, evicted[0].Cost, "round %d: cost Clear reported for key 1", round)
+}
+
+// orderTestCache parks the background worker twice, each time on an
+// over-capacity item: first before anything else is applied, then right after
+// the Sets queued ahead of the second over-capacity item.
+func orderTestCache(t *testing.T, shouldUpdate func(cur, prev int) bool) (c *Cache[uint64, int], rejects *int64, log *exitLog, parked, release []chan struct{}) {
+	parked = []chan struct{}{make(chan struct{}), make(chan struct{})}
+	release = []chan struct{}{make(chan struct{}), make(chan struct{})}
+	park := parkInTurn(parked, release)
+	rejects = new(int64)
+	log = newExitLog()
+	c = newExitTestCache(t, Config[uint64, int]{
+		ShouldUpdate: shouldUpdate,
+		OnExit:       log.record,
+		OnReject: func(it *Item[int]) {
+			if it.Value != parkedValue {
+				atomic.AddInt64(rejects, 1)
+				return
+			}
+			park(it)
+		},
+	})
+	c.Set(98, parkedValue, 101)
+	waitClosed(t, parked[0], "the background worker to report the first over-capacity item")
+	return c, rejects, log, parked, release
+}
+
+func alwaysReplace(cur, prev int) bool { return true }
+
+func TestSetsOfOneKeyTakeEffectInIssueOrder(t *testing.T) {
+	c, rejects, _, parked, release := orderTestCache(t, alwaysReplace)
+	defer c.Close()
+
+	c.Set(1, 10, 10)
+	c.Set(97, parkedValue, 101)
+	c.Set(1, 20, 20)
+	close(release[0])
+	// 10 is stored; 20 is still buffered when 30 is issued.
+	waitClosed(t, parked[1], "the background worker to report the second over-capacity item")
+	c.Set(1, 30, 30)
+	close(release[1])
+	c.Wait()
+
+	v, ok := c.Get(1)
+	require.True(t, ok)
+	require.Equal(t, 30, v)
+	require.Equal(t, int64(70), c.RemainingCost())
+	require.Zero(t, atomic.LoadInt64(rejects))
+}
+
+func TestSetsOfOneKeyApplyShouldUpdateInIssueOrder(t *testing.T) {
+	c, rejects, log, parked, release := orderTestCache(t, func(cur, prev int) bool { return cur > prev })
+	defer c.Close()
+
+	c.Set(1, 10, 10)
+	c.Set(97, parkedValue, 101)
+	c.Set(1, 20, 20)
+	close(release[0])
+	// 10 is stored; 20 is still buffered when 15 is issued, so 15 is decided
+	// against 20, not against 10.
+	waitClosed(t, parked[1], "the background worker to report the second over-capacity item")
+	c.Set(1, 15, 15)
+	close(release[1])
+	c.Wait()
+
+	v, ok := c.Get(1)
+	require.True(t, ok)
+	require.Equal(t, 20, v)
+	require.Equal(t, int64(80), c.RemainingCost())
+	require.Zero(t, atomic.LoadInt64(rejects))
+	require.Zero(t, log.snapshot()[15], "OnExit for the declined value")
+}
+
+func TestDelBetweenSetsOfOneKeyKeepsIssueOrder(t *testing.T) {
+	c, rejects, _, parked, release := orderTestCache(t, alwaysReplace)
+	defer c.Close()
+
+	c.Set(1, 10, 10)
+	c.Set(97, parkedValue, 101)
+	c.Del(1)
+	c.Set(1, 20, 20)
+	close(release[0])
+	// 10 is stored; the Del and 20 are still buffered when 30 is issued.
+	waitClosed(t, parked[1], "the background worker to report the second over-capacity item")
+	c.Set(1, 30, 30)
+	close(release[1])
+	c.Wait()
+
+	v, ok := c.Get(1)
+	require.True(t, ok)
+	require.Equal(t, 30, v)
+	require.Equal(t, int64(70), c.RemainingCost())
+	require.Zero(t, atomic.LoadInt64(rejects))
+}
+
+func TestDelAfterBufferedSetOfOneKeyKeepsIssueOrder(t *testing.T) {
+	c, rejects, log, parked, release := orderTestCache(t, func(cur, prev int) bool { return cur > prev })
+	defer c.Close()
+
+	c.Set(1, 10, 10)
+	c.Set(97, parkedValue, 101)
+	c.Set(1, 5, 5)
+	close(release[0])
+	// 10 is stored; 5 is still buffered, and declined against 10, when the
+	// Del is issued.
+	waitClosed(t, parked[1], "the background worker to report the second over-capacity item")
+	c.Del(1)
+	close(release[1])
+	c.Wait()
+
+	_, ok := c.Get(1)
+	require.False(t, ok)
+	require.Equal(t, int64(100), c.RemainingCost())
+	require.Zero(t, atomic.LoadInt64(rejects))
+	got := log.snapshot()
+	require.Equal(t, 1, got[10], "OnExit for the value the Del removed")
+	require.Zero(t, got[5], "OnExit for the declined value")
+}
+
+func TestSetDuringDelOnExitTakesEffectAfterDel(t *testing.T) {
+	entered, release := make(chan struct{}), make(chan struct{})
+	var once sync.Once
+	var rejects int64
+	c := newExitTestCache(t, Config[uint64, int]{
+		OnExit: func(v int) {
+			if v != 10 {
+				return
+			}
+			once.Do(func() {
+				close(entered)
+				select {
+				case <-release:
+				case <-time.After(10 * time.Second):
+				}
+			})
+		},
+		OnReject: func(*Item[int]) { atomic.AddInt64(&rejects, 1) },
+	})
+	defer c.Close()
+
+	require.True(t, c.Set(1, 10, 10))
+	c.Wait()
+
+	deleted := make(chan struct{})
+	go func() {
+		c.Del(1)
+		close(deleted)
+	}()
+	// The Del has removed 10 and is still inside OnExit when 20 is issued.
+	waitClosed(t, entered, "OnExit for the deleted value")
+	require.True(t, c.Set(1, 20, 20))
+	close(release)
+	waitClosed(t, deleted, "Del to return")
+	c.Wait()
+
+	v, ok := c.Get(1)
+	require.True(t, ok)
+	require.Equal(t, 20, v)
+	require.Equal(t, int64(80), c.RemainingCost())
+	require.Zero(t, atomic.LoadInt64(&rejects))
+}
+
+// itemRecorder keeps every Item pointer handed to OnEvict.
+type itemRecorder struct {
+	mu    sync.Mutex
+	items []*Item[int]
+}
+
+func (r *itemRecorder) record(it *Item[int]) {
+	r.mu.Lock()
+	r.items = append(r.items, it)
+	r.mu.Unlock()
+}
+
+func (r *itemRecorder) byValue(t *testing.T) map[int]Item[int] {
+	t.Helper()
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	out := make(map[int]Item[int], len(r.items))
+	for _, it := range r.items {
+		out[it.Value] = *it
+	}
+	require.Len(t, out, len(r.items), "every OnEvict call needs its own Item")
+	return out
+}
+
+type storedEntry struct {
+	value int
+	cost  int64
+	ttl   time.Duration
+}
+
+func requireReported(t *testing.T, got map[int]Item[int], want []storedEntry, before, after time.Time) {
+	t.Helper()
+	require.Len(t, got, len(want))
+	for _, e := range want {
+		it, ok := got[e.value]
+		require.True(t, ok, "value %d was not reported", e.value)
+		require.Equal(t, e.cost, it.Cost, "cost of value %d", e.value)
+		if e.ttl == 0 {
+			require.True(t, it.Expiration.IsZero(), "expiration of value %d", e.value)
+			continue
+		}
+		require.False(t, it.Expiration.Before(before.Add(e.ttl)), "expiration of value %d", e.value)
+		require.False(t, it.Expiration.After(after.Add(e.ttl)), "expiration of value %d", e.value)
+	}
+}
+
+func TestClearReportsEachEntryWithItsOwnItem(t *testing.T) {
+	rec := &itemRecorder{}
+	c := newExitTestCache(t, Config[uint64, int]{MaxCost: 1 << 20, OnEvict: rec.record})
+	defer c.Close()
+
+	// Enough entries that many of them share a part of the cache's storage.
+	var entries []storedEntry
+	for i := 0; i < 1024; i++ {
+		entries = append(entries, storedEntry{1000 + i, int64(3 + i%5), time.Duration(i%3) * time.Hour})
+	}
+	before := time.Now()
+	for i, e := range entries {
+		require.True(t, c.SetWithTTL(uint64(i+1), e.value, e.cost, e.ttl))
+	}
+	after := time.Now()
+	c.Wait()
+
+	c.Clear()
+	requireReported(t, rec.byValue(t), entries, before, after)
+}
+
+// An updated entry is reported with the cost of the value it now holds,
+// including a cost computed by the Cost function.
+func TestClearReportsUpdatedEntryWithItsCost(t *testing.T) {
+	rec := &itemRecorder{}
+	c := newExitTestCache(t, Config[uint64, int]{
+		MaxCost:      1000,
+		Cost:         func(v int) int64 { return int64(v) },
+		ShouldUpdate: func(cur, prev int) bool { return true },
+		OnEvict:      rec.record,
+	})
+	defer c.Close()
+
+	require.True(t, c.Set(1, 10, 0))
+	require.True(t, c.Set(2, 20, 7))
+	c.Wait()
+	require.True(t, c.Set(1, 40, 0))
+	require.True(t, c.Set(2, 50, 9))
+	c.Wait()
+
+	c.Clear()
+	requireReported(t, rec.byValue(t), []storedEntry{{40, 40, 0}, {50, 9, 0}}, time.Time{}, time.Time{})
+}
+
+func TestEvictionReportsTheEvictedEntry(t *testing.T) {
+	rec := &itemRecorder{}
+	c := newExitTestCache(t, Config[uint64, int]{MaxCost: 10, OnEvict: rec.record})
+	defer c.Close()
+
+	entries := []storedEntry{{11, 4, time.Hour}, {22, 6, 2 * time.Hour}}
+	before := time.Now()
+	for i, e := range entries {
+		require.True(t, c.SetWithTTL(uint64(i+1), e.value, e.cost, e.ttl))
+	}
+	after := time.Now()
+	c.Wait()
+
+	// Admitting key 3 needs the whole capacity, so both stored keys are evicted.
+	c.Set(3, 33, 10)
+	c.Wait()
+	requireReported(t, rec.byValue(t), entries, before, after)
+}
+
+// With internal cost accounting on, OnEvict still reports the Cost the entry
+// took from RemainingCost(), whether it is removed by Clear or evicted.
+func TestOnEvictReportsCostIncludingInternalCost(t *testing.T) {
+	const maxCost = 1000
+	newCache := func(onEvict func(*Item[int])) *Cache[uint64, int] {
+		c, err := NewCache(&Config[uint64, int]{
+			NumCounters: 1000,
+			MaxCost:     maxCost,
+			BufferItems: 64,
+			OnEvict:     onEvict,
+		})
+		require.NoError(t, err)
+		return c
+	}
+	// setAll sets each entry and returns it with the cost it took.
+	setAll := func(c *Cache[uint64, int], entries []storedEntry) ([]storedEntry, time.Time, time.Time) {
+		var charged []storedEntry
+		before := time.Now()
+		for i, e := range entries {
+			remaining := c.RemainingCost()
+			require.True(t, c.SetWithTTL(uint64(i+1), e.value, e.cost, e.ttl))
+			c.Wait()
+			charged = append(charged, storedEntry{e.value, remaining - c.RemainingCost(), e.ttl})
+		}
+		return charged, before, time.Now()
+	}
+	entries := []storedEntry{{11, 4, time.Hour}, {22, 6, 0}}
+
+	rec := &itemRecorder{}
+	c := newCache(rec.record)
+	charged, before, after := setAll(c, entries)
+	c.Clear()
+	requireReported(t, rec.byValue(t), charged, before, after)
+	c.Close()
+
+	rec = &itemRecorder{}
+	c = newCache(rec.record)
+	charged, before, after = setAll(c, entries)
+	// Admitting key 3 needs the whole capacity, so both stored keys are evicted.
+	internal := charged[0].cost - entries[0].cost
+	c.Set(3, 33, maxCost-internal)
+	c.Wait()
+	requireReported(t, rec.byValue(t), charged, before, after)
+	c.Close()
+}
