+// Sets issued while Sets waiting ahead of them have filled the cache's write
+// buffer may wait for room, but they must all complete once the background
+// worker is free again. An update of a stored key is never dropped: its value
+// is the one that remains, and RemainingCost() must reflect its cost. A Set of
+// a key whose own first Set is still waiting may be dropped (Set returns
+// false), and then nothing changes; otherwise the same holds for it.
+func TestAcceptedUpdateWithFullWriteBufferChargesItsCost(t *testing.T) {
+	const keys = 32
+	const stored = keys / 2
+	parked, release := newHolds()
+	c := newExitTestCache(t, Config[uint64, int]{
+		ShouldUpdate:           alwaysReplace,
+		OnReject:               holdWorker(parked, release),
+		TtlTickerDurationInSec: 1,
+	})
+
+	for k := uint64(1); k <= stored; k++ {
+		require.True(t, c.Set(k, int(k), 1))
+	}
+	require.True(t, c.SetWithTTL(expiringKey, expiringValue, 0, expiringTTL))
+	c.Wait()
+	for i := uint64(0); i < holds; i++ {
+		c.Set(90+i, parkedValue, 101)
+	}
+	waitClosed(t, parked[0], "the background worker to report the over-capacity item")
+	for k := uint64(stored + 1); k <= keys; k++ {
+		require.True(t, c.Set(k, int(k), 1))
+	}
+	fillWriteBuffer(t, c)
+
+	type result struct {
+		key uint64
+		ok  bool
+	}
+	results := make(chan result, keys)
+	var returned int64
+	for k := uint64(1); k <= keys; k++ {
+		go func(k uint64) {
+			ok := c.Set(k, int(k)*10, 3)
+			atomic.AddInt64(&returned, 1)
+			results <- result{k, ok}
+		}(k)
+	}
+	releaseHolds(t, c, parked, release, &returned, keys)
+	accepted := make(map[uint64]bool, keys)
+	for k := 0; k < keys; k++ {
+		select {
+		case r := <-results:
+			accepted[r.key] = r.ok
+			require.True(t, r.ok || r.key > stored, "update of stored key %d was dropped", r.key)
+		case <-time.After(10 * time.Second):
+			t.Fatal("timed out waiting for the Sets to complete")
+		}
+	}
+	waitApplied(t, c)
+
+	var cost int64
+	for k := uint64(1); k <= keys; k++ {
+		want, wantCost := int(k), int64(1)
+		if accepted[k] {
+			want, wantCost = int(k)*10, 3
+		}
+		v, ok := c.Get(k)
+		require.True(t, ok, "key %d", k)
+		require.Equal(t, want, v, "key %d", k)
+		cost += wantCost
+	}
+	require.Equal(t, 100-cost, c.RemainingCost())
+	c.Close()
+}
