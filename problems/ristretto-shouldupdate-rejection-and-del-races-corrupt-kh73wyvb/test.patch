+	require.True(t, c.Set(1, 222, 40))
+	c.Wait()
+
+	v, ok := c.Get(1)
+	require.True(t, ok)
+	require.Equal(t, 222, v)
+	require.Equal(t, int64(60), c.RemainingCost())
+	require.Equal(t, int64(1), atomic.LoadInt64(&exits))
+}
+
+func TestShouldUpdateRejectedUpdateKeepsValue(t *testing.T) {
+	c, err := NewCache(&Config[uint64, int]{
+		NumCounters:        1000,
+		MaxCost:            100,
+		BufferItems:        64,
+		IgnoreInternalCost: true,
+		ShouldUpdate:       func(cur, prev int) bool { return false },
+	})
+	require.NoError(t, err)
+	defer c.Close()
+
+	require.True(t, c.Set(1, 111, 10))
+	c.Wait()
+
+	c.Set(1, 222, 50)
+	c.Wait()
+
+	v, ok := c.Get(1)
+	require.True(t, ok)
+	require.Equal(t, 111, v)
+}
+
+func TestOverCapacityNewKeyIsRejected(t *testing.T) {
+	var rejects, exits int64
+	c, err := NewCache(&Config[uint64, int]{
+		NumCounters:        1000,
+		MaxCost:            10,
+		BufferItems:        64,
+		IgnoreInternalCost: true,
+		ShouldUpdate:       func(cur, prev int) bool { return false },
+		OnReject:           func(*Item[int]) { atomic.AddInt64(&rejects, 1) },
+		OnExit:             func(int) { atomic.AddInt64(&exits, 1) },
+	})
+	require.NoError(t, err)
+	defer c.Close()
+
+	c.Set(1, 111, 11)
+	c.Wait()
+
+	_, ok := c.Get(1)
+	require.False(t, ok)
+	require.Equal(t, int64(1), atomic.LoadInt64(&rejects))
+	require.Equal(t, int64(1), atomic.LoadInt64(&exits))
+	require.Equal(t, int64(10), c.RemainingCost())
+}
+
+// OnExit may release the value it is handed (see Config.OnExit). A Set that
+// the callback issues for the same key must not be decided by ShouldUpdate
+// against that released value: a Set whose admission was rejected is gone.
+func TestSetFromOnExitIsNotDecidedAgainstReleasedValue(t *testing.T) {
+	var mu sync.Mutex
+	released := map[int]bool{}
+	var compared []int
+	var c *Cache[uint64, int]
+	c, err := NewCache(&Config[uint64, int]{
+		NumCounters:        1000,
+		MaxCost:            100,
+		BufferItems:        64,
+		IgnoreInternalCost: true,
+		ShouldUpdate: func(cur, prev int) bool {
+			mu.Lock()
+			if released[prev] {
+				compared = append(compared, prev)
+			}
+			mu.Unlock()
+			return true
+		},
+		OnExit: func(v int) {
+			mu.Lock()
+			released[v] = true
+			mu.Unlock()
+			if v == 10 {
+				c.Set(1, 20, 1)
+			}
+		},
+	})
+	require.NoError(t, err)
+	defer c.Close()
+
+	// 10 costs more than MaxCost, so it is rejected and handed to OnExit,
+	// which sets the key again.
+	c.Set(1, 10, 101)
+	c.Wait()
+	c.Wait()
+
+	v, ok := c.Get(1)
+	require.True(t, ok)
+	require.Equal(t, 20, v)
+	require.Equal(t, int64(99), c.RemainingCost())
+	mu.Lock()
+	defer mu.Unlock()
+	require.Empty(t, compared, "ShouldUpdate was handed a value already handed to OnExit")
+}
+
+// Clear removes every entry, including the ones whose Set is still in the
+// write buffer, and hands each removed value to OnEvict exactly once. Clear
+// already drains the write buffer and passes each buffered new item to
+// OnEvict before it evicts the stored entries, and that must keep holding.
+func TestClearReportsBufferedSetsToOnEvict(t *testing.T) {
+	const parkedValue = -1
+	parked, release := make(chan struct{}), make(chan struct{})
+	var once sync.Once
+	var mu sync.Mutex
+	evicted := map[int]int{}
+	c, err := NewCache(&Config[uint64, int]{
+		NumCounters:        1000,
+		MaxCost:            1000,
+		BufferItems:        64,
+		IgnoreInternalCost: true,
+		OnEvict: func(it *Item[int]) {
+			mu.Lock()
+			evicted[it.Value]++
+			mu.Unlock()
+		},
+		// The over-capacity item holds the background worker in OnReject,
+		// so the Sets issued meanwhile stay in the write buffer.
+		OnReject: func(it *Item[int]) {
+			if it.Value != parkedValue {
+				return
+			}
+			once.Do(func() {
+				close(parked)
+				select {
+				case <-release:
+				case <-time.After(10 * time.Second):
+				}
+			})
+		},
+	})
+	require.NoError(t, err)
+	defer c.Close()
+
+	require.True(t, c.Set(1, 1, 1))
+	c.Wait()
+	c.Set(99, parkedValue, 1001)
+	select {
+	case <-parked:
+	case <-time.After(10 * time.Second):
+		t.Fatal("timed out waiting for the background worker to report the over-capacity item")
+	}
+	accepted := []int{1}
+	for k := uint64(2); k <= 33; k++ {
+		if c.Set(k, int(k), 1) {
+			accepted = append(accepted, int(k))
+		}
+	}
+
+	cleared := make(chan struct{})
+	go func() {
+		c.Clear()
+		close(cleared)
+	}()
+	// Clear cannot finish while the worker is held. Give it a moment to
+	// start waiting for the worker, so that it finds Sets still buffered;
+	// the assertions below hold however the two interleave.
+	select {
+	case <-cleared:
+	case <-time.After(100 * time.Millisecond):
+	}
+	close(release)
+	select {
+	case <-cleared:
+	case <-time.After(10 * time.Second):
+		t.Fatal("timed out waiting for Clear")
+	}
+
+	for k := uint64(1); k <= 33; k++ {
+		_, ok := c.Get(k)
+		require.False(t, ok, "key %d is still cached after Clear", k)
+	}
+	require.Equal(t, int64(1000), c.RemainingCost())
+	mu.Lock()
+	defer mu.Unlock()
+	for _, v := range accepted {
+		require.Equal(t, 1, evicted[v], "value %d was handed to OnEvict %d times", v, evicted[v])
+	}
+	require.Len(t, evicted, len(accepted))
+}
