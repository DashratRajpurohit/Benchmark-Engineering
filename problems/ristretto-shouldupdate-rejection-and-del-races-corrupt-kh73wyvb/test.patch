+#!/usr/bin/env bash
+# Usage:
+#   ./test.sh [--output_path <junit.xml>] <base|new>
+#
+# base  runs the existing tests of the cache package, the only package this
+#       change touches, plus a small set of regression controls in
+#       cache_update_f4423e_test.go (compiled only with -tags costleak_base) that
+#       already hold on the base commit and must keep holding after any
+#       change. The z, sim and contrib packages are not affected by it and
+#       are left out, so the baseline does not depend on the machine.
+# new   runs the callback and cost-accounting tests in cache_exit_697813_test.go,
+#       which are compiled only with -tags exitcallbacks.
+set -uo pipefail
+
+ORIG_PWD="$(pwd)"
+
+OUTPUT_PATH=""
+if [ "${1:-}" = "--output_path" ]; then
+  OUTPUT_PATH="$2"
+  shift 2
+  case "$OUTPUT_PATH" in
+    /*) : ;;
+    *) OUTPUT_PATH="$ORIG_PWD/$OUTPUT_PATH" ;;
+  esac
+fi
+
+MODE="${1:-new}"
+
+cd /app
+
+TEST_LOG="$(mktemp)"
+STATUS=0
+
+run_tests() {
+  go test -count=1 -v "$@" 2>&1 | tee -a "$TEST_LOG"
+  status=${PIPESTATUS[0]}
+  if [ "$status" -ne 0 ]; then
+    STATUS=$status
+  fi
+}
+
+NEW_TESTS='^(TestRejectedUpdateKeepsRemainingCost|TestRejectedUpdateKeepsRemainingCostWithCostFunction|TestRejectedUpdateFiresNoCallbacks|TestShouldUpdateMonotonicSequence|TestRejectedUpdatesUnderConcurrencyKeepRemainingCost|TestRejectedPendingValueGatesNextSet|TestAcceptedSetAfterRejectedPendingValueIsStored|TestAcceptedUpdateWithFullWriteBufferChargesItsCost|TestUpdateBehindPendingSetWithFullWriteBufferIsKept|TestDelWithFullWriteBufferReportsEachValueOnce|TestDelReportsRemovedValueOnce|TestDelOfMissingKeyReportsNothing|TestDelWhileSetIsBufferedReportsOnce|TestConcurrentSetDelReportEachValueOnce|TestDelDuringEvictionReportsOnce|TestDelDuringExpiryCleanupReportsOnce|TestDelDuringClearReportsOnce|TestRepeatSetBeforeApplyIsAnUpdate|TestRepeatSetBeforeApplyRespectsShouldUpdate|TestRepeatUpdateOfStoredKeyBeforeApplyIsAnUpdate|TestPendingSetsOfKeysSharingAHashAreNotCompared|TestRepeatSetOfKeyCollidingWithStoredKeyIsAnUpdate|TestAlternatingPendingSetsOfCollidingKeysAreDecidedPerKey|TestRejectedUpdateBesidePendingSetOfCollidingKeyIsNotReported|TestDelOfKeyCollidingWithStoredKeyLeavesItStored|TestCostIsNotAskedForAReleasedValue|TestValueIsNotReleasedWhileCostIsAskedAboutIt|TestClearDoesNotAskCostAboutAReportedUpdate|TestSetsOfOneKeyTakeEffectInIssueOrder|TestSetsOfOneKeyApplyShouldUpdateInIssueOrder|TestDelBetweenSetsOfOneKeyKeepsIssueOrder|TestDelAfterBufferedSetOfOneKeyKeepsIssueOrder|TestSetDuringDelOnExitTakesEffectAfterDel|TestClearReportsEachEntryWithItsOwnItem|TestClearReportsUpdatedEntryWithItsCost|TestEvictionReportsTheEvictedEntry|TestOnEvictReportsCostIncludingInternalCost)$'
+
+case "$MODE" in
+  base)
+    run_tests -timeout 900s -tags costleak_base .
+    ;;
+  new)
+    run_tests -timeout 600s -tags exitcallbacks -run "$NEW_TESTS" .
+    ;;
+  *)
+    echo "unknown mode: $MODE (expected base or new)" >&2
+    exit 2
+    ;;
+esac
+
+if [ -n "$OUTPUT_PATH" ]; then
+  go-junit-report -set-exit-code < "$TEST_LOG" > "$OUTPUT_PATH"
+  junit_status=$?
+  if [ "$junit_status" -ne 0 ] && [ "$STATUS" -eq 0 ]; then
+    echo "go-junit-report failed to convert the test log (exit $junit_status)" >&2
+    STATUS=$junit_status
+  fi
+fi
+
+exit "$STATUS"
