+// An update of a stored key is not dropped when the write buffer is full,
+// also while a later Set of that key is still waiting to be applied, and it
+// still takes effect after that Set.
+func TestUpdateBehindPendingSetWithFullWriteBufferIsKept(t *testing.T) {
+	c, _, log, parked, release := orderTestCache(t, alwaysReplace)
+	defer c.Close()
+
+	c.Set(1, 10, 10)
+	c.Set(97, parkedValue, 101)
+	c.Set(1, 20, 20)
+	close(release[0])
+	// 10 is stored; 20 is still buffered when 30 is issued.
+	waitClosed(t, parked[1], "the background worker to report the second over-capacity item")
+	fillWriteBuffer(t, c)
+	require.True(t, c.Set(1, 30, 30))
+	close(release[1])
+	waitApplied(t, c)
+
+	v, ok := c.Get(1)
+	require.True(t, ok)
+	require.Equal(t, 30, v)
+	require.Equal(t, int64(70), c.RemainingCost())
+	got := log.snapshot()
+	for v := range got {
+		if v >= 1000 {
+			delete(got, v) // the buffer filler
+		}
+	}
+	require.Equal(t, map[int]int{10: 1, 20: 1, parkedValue: 2}, got)
+}
+
+// Dels issued while Sets waiting ahead of them have filled the cache's
+// write buffer may wait for room, but each must still remove its value and
+// report it to OnExit exactly once, whether the value was stored or its Set
+// was still waiting.
+func TestDelWithFullWriteBufferReportsEachValueOnce(t *testing.T) {
+	const keys = 64
+	const stored = keys / 2
+	parked, release := newHolds()
+	log := newExitLog()
+	c := newExitTestCache(t, Config[uint64, int]{
+		OnReject:               holdWorker(parked, release),
+		OnExit:                 log.record,
+		TtlTickerDurationInSec: 1,
+	})
+
+	for k := uint64(1); k <= stored; k++ {
+		require.True(t, c.Set(k, int(k)*10, 1))
+	}
+	require.True(t, c.SetWithTTL(expiringKey, expiringValue, 0, expiringTTL))
+	c.Wait()
+	for i := uint64(0); i < holds; i++ {
+		c.Set(90+i, parkedValue, 101)
+	}
+	waitClosed(t, parked[0], "the background worker to report the over-capacity item")
+	for k := uint64(stored + 1); k <= keys; k++ {
+		require.True(t, c.Set(k, int(k)*10, 1))
+	}
+	fillWriteBuffer(t, c)
+
+	deleted := make(chan struct{}, keys)
+	var returned int64
+	for k := uint64(1); k <= keys; k++ {
+		go func(k uint64) {
+			c.Del(k)
+			atomic.AddInt64(&returned, 1)
+			deleted <- struct{}{}
+		}(k)
+	}
+	releaseHolds(t, c, parked, release, &returned, keys)
+	for k := 0; k < keys; k++ {
+		select {
+		case <-deleted:
+		case <-time.After(10 * time.Second):
+			t.Fatal("timed out waiting for the Dels to complete")
+		}
+	}
+	waitApplied(t, c)
+
+	want := map[int]int{parkedValue: holds}
+	for k := uint64(1); k <= keys; k++ {
+		_, ok := c.Get(k)
+		require.False(t, ok, "key %d", k)
+		want[int(k)*10] = 1
+	}
+	got := log.snapshot()
+	for v := range got {
+		if v >= 1000 || v == expiringValue {
+			delete(got, v) // the buffer filler and the expiring entry
+		}
+	}
+	require.Equal(t, want, got)
+	require.Equal(t, int64(100), c.RemainingCost())
+	c.Close()
+}
+
+// expiringKey is stored with expiringTTL, which is longer than one TTL
+// cleanup tick (TtlTickerDurationInSec: 1 ticks every 500ms). Waiting for it
+// to expire while the worker is held makes sure a cleanup is due as soon as
+// the worker resumes, alongside the operations waiting for it.
+const (
+	expiringKey   = uint64(77)
+	expiringValue = 7
+	expiringTTL   = 600 * time.Millisecond
+)
+
+func waitExpired(t *testing.T, c *Cache[uint64, int]) {
+	t.Helper()
+	tick := time.NewTicker(10 * time.Millisecond)
+	defer tick.Stop()
+	deadline := time.After(10 * time.Second)
+	for {
+		if _, ok := c.Get(expiringKey); !ok {
+			return
+		}
+		select {
+		case <-tick.C:
+		case <-deadline:
+			t.Fatal("timed out waiting for the expiring entry to expire")
+		}
+	}
+}
+
+// fillWriteBuffer keeps adding over-capacity items, which the parked worker
+// will reject, until the cache starts dropping Sets.
+func fillWriteBuffer(t *testing.T, c *Cache[uint64, int]) {
+	t.Helper()
+	filled := make(chan struct{})
+	go func() {
+		defer close(filled)
+		for k := uint64(1000); k < 1000+1<<20 && c.Set(k, int(k), 101); k++ {
+		}
+	}()
+	waitClosed(t, filled, "a Set to be dropped")
+}
+
+// waitApplied is Wait with a deadline, so a cache that stops making progress
+// fails the test instead of hanging it.
+func waitApplied(t *testing.T, c *Cache[uint64, int]) {
+	t.Helper()
+	done := make(chan struct{})
+	go func() { c.Wait(); close(done) }()
+	waitClosed(t, done, "the buffered writes to be applied")
+}
+
+// SQ scenario: a pending Set whose own admission later fails must still be
+// the value the next pending Set is decided against, so ShouldUpdate cannot
+// be bypassed just because an earlier link in the chain never gets stored.
+func TestRejectedPendingValueGatesNextSet(t *testing.T) {
+	parked, release := make(chan struct{}), make(chan struct{})
+	park := parkOnFirst(parked, release)
+	log := newExitLog()
+	c := newExitTestCache(t, Config[uint64, int]{
+		ShouldUpdate: func(cur, prev int) bool { return false },
+		OnReject:     park,
+		OnExit:       log.record,
+	})
+	defer c.Close()
+
+	c.Set(99, parkedValue, 101)
+	waitClosed(t, parked, "the background worker to report the over-capacity item")
+
+	c.Set(1, 10, 101)
+	c.Set(1, 20, 1)
+	close(release)
+	c.Wait()
+
+	_, ok := c.Get(1)
+	require.False(t, ok, "neither pending value should have been admitted")
+	require.Equal(t, int64(100), c.RemainingCost())
+	require.Zero(t, log.snapshot()[20], "20 must never be charged or stored")
+}
+
+// The other direction: when ShouldUpdate accepts a Set of a key whose first
+// Set is still pending and is too costly to admit, the accepted value is the
+// one that remains, also when a Del was issued between the two Sets.
+func TestAcceptedSetAfterRejectedPendingValueIsStored(t *testing.T) {
+	parked, release := make(chan struct{}), make(chan struct{})
+	park := parkOnFirst(parked, release)
+	log := newExitLog()
+	var mu sync.Mutex
+	var rejected []int
+	c := newExitTestCache(t, Config[uint64, int]{
+		ShouldUpdate: alwaysReplace,
+		OnReject: func(it *Item[int]) {
+			mu.Lock()
+			rejected = append(rejected, it.Value)
+			mu.Unlock()
+			park(it)
+		},
+		OnExit: log.record,
+	})
+	defer c.Close()
+
+	c.Set(99, parkedValue, 101)
+	waitClosed(t, parked, "the background worker to report the over-capacity item")
+
+	c.Set(1, 10, 101)
+	c.Set(1, 5, 1)
+	c.Set(2, 20, 101)
+	c.Del(2)
+	c.Set(2, 6, 1)
+	close(release)
+	c.Wait()
+
+	v, ok := c.Get(1)
+	require.True(t, ok)
+	require.Equal(t, 5, v)
+	v, ok = c.Get(2)
+	require.True(t, ok)
+	require.Equal(t, 6, v)
+	require.Equal(t, int64(98), c.RemainingCost())
+	mu.Lock()
+	require.NotContains(t, rejected, 5)
+	require.NotContains(t, rejected, 6)
+	mu.Unlock()
+	require.Equal(t, map[int]int{parkedValue: 1, 10: 1, 20: 1}, log.snapshot())
+}
