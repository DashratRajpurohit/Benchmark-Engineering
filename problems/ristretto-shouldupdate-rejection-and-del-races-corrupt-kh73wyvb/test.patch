+func TestDelReportsRemovedValueOnce(t *testing.T) {
+	log := newExitLog()
+	c := newExitTestCache(t, Config[uint64, int]{OnExit: log.record})
+	defer c.Close()
+
+	require.True(t, c.Set(1, 42, 10))
+	// A stored zero value is removed and reported like any other value.
+	require.True(t, c.Set(2, 0, 10))
+	c.Wait()
+
+	c.Del(1)
+	c.Del(2)
+	c.Wait()
+
+	_, ok := c.Get(1)
+	require.False(t, ok)
+	_, ok = c.Get(2)
+	require.False(t, ok)
+	require.Equal(t, map[int]int{42: 1, 0: 1}, log.snapshot())
+}
