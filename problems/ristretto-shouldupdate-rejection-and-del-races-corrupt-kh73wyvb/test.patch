+func TestShouldUpdateAcceptedUpdateAppliesCostDelta(t *testing.T) {
+	var exits int64
+	c, err := NewCache(&Config[uint64, int]{
+		NumCounters:        1000,
+		MaxCost:            100,
+		BufferItems:        64,
+		IgnoreInternalCost: true,
+		ShouldUpdate:       func(cur, prev int) bool { return true },
