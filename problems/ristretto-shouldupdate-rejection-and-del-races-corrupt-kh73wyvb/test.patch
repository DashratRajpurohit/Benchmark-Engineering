+func TestRejectedUpdateFiresNoCallbacks(t *testing.T) {
+	var rejects int64
+	log := newExitLog()
+	c := newExitTestCache(t, Config[uint64, int]{
+		OnReject: func(*Item[int]) { atomic.AddInt64(&rejects, 1) },
