+// sortedErrList builds an ErrList ordered by node address rather than by
+// which goroutine finished first, so the same set of failures always
+// produces the same error text and message ordering.
+func sortedErrList(errs []error) ErrList {
+	out := make([]error, len(errs))
+	copy(out, errs)
+	sort.Slice(out, func(i, j int) bool {
+		return nodeErrAddr(out[i]) < nodeErrAddr(out[j])
+	})
+	return ErrList(out)
+}
+
+func nodeErrAddr(err error) string {
+	var ne NodeErr
+	if errors.As(err, &ne) {
+		return ne.Addr
+	}
+	return ""
+}
+
+// pendingChannelMerge is one node's report of a channel, held until
+// every node has answered so channels can be merged in address order.
+type pendingChannelMerge struct {
+	addr    string
+	channel *ChannelStats
+}
+
+// NodeErr is a failure to get an answer from the nsqd or nsqlookupd at Addr.
+type NodeErr struct {
+	Addr string
+	Err  error
+}
+
+func (e NodeErr) Error() string {
+	return e.Err.Error()
+}
+
+func (e NodeErr) Unwrap() error {
+	return e.Err
+}
+
+// FailedNodes returns the sorted addresses of the nodes that errs report as
+// unreachable.
+func FailedNodes(errs ...error) []string {
+	var addrs []string
+	for _, err := range errs {
+		var pe PartialErr
+		if !errors.As(err, &pe) {
+			continue
+		}
+		for _, e := range pe.Errors() {
+			var ne NodeErr
+			if errors.As(e, &ne) && !slices.Contains(addrs, ne.Addr) {
+				addrs = append(addrs, ne.Addr)
+			}
+		}
+	}
+	sort.Strings(addrs)
+	return addrs
+}
+
+// UnionFailedNodes merges already-extracted failed-node address lists, for
+// example a discovery-stage list and a later stats-stage list, so an error
+// response at any stage still reports every node that failed, not just the
+// ones from the stage that produced the final error.
+func UnionFailedNodes(lists ...[]string) []string {
+	var addrs []string
+	for _, list := range lists {
+		for _, addr := range list {
+			if !slices.Contains(addrs, addr) {
+				addrs = append(addrs, addr)
+			}
+		}
+	}
+	sort.Strings(addrs)
+	return addrs
+}
