+// mergeLookupdProducerCandidates picks one producer record per HTTP address.
+// When lookupds disagree on a producer's metadata, the record from the
+// lexicographically smallest lookupd address wins, so the result does not
+// depend on which lookupd answered first.
+func mergeLookupdProducerCandidates(candidatesByAddr map[string][]lookupdProducerCandidate) Producers {
+	var producers Producers
+	for _, candidates := range candidatesByAddr {
+		sort.Slice(candidates, func(i, j int) bool {
+			return candidates[i].lookupdAddr < candidates[j].lookupdAddr
+		})
