+// TestTopicsMessageOrderIsAddressSortedCl7f3a covers /api/topics when every
+// lookupd is unreachable: the error message joins each node's failure, and
+// that join must not depend on which node's dial failed first.
+// startLookupdErrorGatedCl7f3a serves a distinct, fixed error body for every
+// request. If gate is non-nil, it fixes which of a pair of such lookupds
+// answers first in each round.
+func startLookupdErrorGatedCl7f3a(t *testing.T, body string, gate *phaseGateCl7f3a, id int) string {
+	t.Helper()
+	var mu sync.Mutex
+	round := 0
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if gate != nil {
+			mu.Lock()
+			round++
+			rnd := round
+			mu.Unlock()
+			if !gate.leads(id) {
+				gate.await(rnd)
+			} else {
+				defer gate.done(rnd)
+			}
+		}
+		http.Error(w, body, http.StatusInternalServerError)
+	}))
+	t.Cleanup(srv.Close)
+	return strings.TrimPrefix(srv.URL, "http://")
+}
