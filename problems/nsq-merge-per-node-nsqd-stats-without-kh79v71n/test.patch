+// startLookupdTopicsFakeCl7f3a serves /topics, /lookup, and /channels for an
+// nsqlookupd that knows the given topics but currently has no producer for
+// them. If failQueries is true, /lookup and /channels still succeed for the
+// initial /topics listing but fail every per-topic request with a 500,
+// simulating a lookupd that answers the overall scan but cannot be queried
+// about a specific topic afterward.
+func startLookupdTopicsFakeCl7f3a(t *testing.T, topics []string, channels []string, failQueries bool) string {
+	t.Helper()
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		switch r.URL.Path {
+		case "/topics":
+			b, _ := json.Marshal(struct {
+				Topics []string `json:"topics"`
+			}{topics})
+			w.Header().Set("Content-Type", "application/json")
+			_, _ = w.Write(b)
+		case "/lookup":
+			if failQueries {
+				http.Error(w, "INTERNAL_ERROR", http.StatusInternalServerError)
+				return
+			}
+			_, _ = io.WriteString(w, `{"producers":[]}`)
+		case "/channels":
+			if failQueries {
+				http.Error(w, "INTERNAL_ERROR", http.StatusInternalServerError)
+				return
+			}
+			b, _ := json.Marshal(struct {
+				Channels []string `json:"channels"`
+			}{channels})
+			w.Header().Set("Content-Type", "application/json")
+			_, _ = w.Write(b)
+		default:
+			http.NotFound(w, r)
+		}
+	}))
+	t.Cleanup(srv.Close)
+	return strings.TrimPrefix(srv.URL, "http://")
+}
