+)
+
+const compatTopicCl7f3a = "compat_cl7f3a"
+
+const compatLatencyCl7f3a = `"e2e_processing_latency":{"count":1,"percentiles":[` +
+	`{"quantile":0.99,"value":1,"min":1,"max":1,"average":1,"count":1}]}`
+
+func getJSONCompatCl7f3a(t *testing.T, url string) map[string]interface{} {
+	t.Helper()
+	resp, err := http.DefaultClient.Get(url)
+	test.Nil(t, err)
+	body, _ := io.ReadAll(resp.Body)
+	_ = resp.Body.Close()
+	if resp.StatusCode != 200 {
+		t.Fatalf("GET %s: status %d (body %s)", url, resp.StatusCode, body)
+	}
+	var parsed map[string]interface{}
+	test.Nil(t, json.Unmarshal(body, &parsed))
+	return parsed
+}
+
+// startCompatNodeCl7f3a serves /info with the given topology and /stats with the
+// body stats returns for the nth /stats response.
+func startCompatNodeCl7f3a(t *testing.T, hostname, region, zone string, stats func(n int) string) string {
+	t.Helper()
+	var addr string
+	var mu sync.Mutex
+	responses := 0
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Content-Type", "application/json")
+		if r.URL.Path == "/info" {
+			host, port, _ := net.SplitHostPort(addr)
+			_, _ = fmt.Fprintf(w, `{"version":"1.3.0","broadcast_address":%q,"hostname":%q,`+
+				`"http_port":%s,"tcp_port":4150,"topology_region":%q,"topology_zone":%q}`,
+				host, hostname, port, region, zone)
+			return
+		}
+		mu.Lock()
+		responses++
+		n := responses
+		mu.Unlock()
+		_, _ = io.WriteString(w, stats(n))
+	}))
+	t.Cleanup(srv.Close)
+	addr = srv.Listener.Addr().String()
+	return addr
+}
+
+func TestChannelAPIKeepsClientTopologyOrderCl7f3a(t *testing.T) {
+	client := func(hostname, region, zone string, port int) string {
+		return fmt.Sprintf(`{"client_id":%q,"hostname":%q,"remote_address":"10.0.0.7:%d",`+
+			`"version":"V2","topology_region":%q,"topology_zone":%q}`,
+			hostname, hostname, port, region, zone)
+	}
+	clients := []string{
+		client("a-remote", "r1", "z1", 9001),
+		client("m-region", "r5", "z2", 9002),
+		client("m-region", "r5", "z2", 9003),
+		client("z-local", "r5", "z5", 9004),
+		client("z-local", "r5", "z5", 9005),
+	}
+	tier := map[string]int{"z-local": 0, "m-region": 1, "a-remote": 2}
+	stats := func(n int) string {
+		shuffled := append([]string(nil), clients...)
+		rand.New(rand.NewSource(int64(n))).Shuffle(len(shuffled), func(i, j int) {
+			shuffled[i], shuffled[j] = shuffled[j], shuffled[i]
+		})
+		return fmt.Sprintf(`{"topics":[{"topic_name":%q,"depth":1,%s,"channels":[`+
+			`{"channel_name":"c1","depth":1,%s,"clients":[%s,%s,%s,%s,%s]}]}]}`,
+			compatTopicCl7f3a, compatLatencyCl7f3a, compatLatencyCl7f3a,
+			shuffled[0], shuffled[1], shuffled[2], shuffled[3], shuffled[4])
+	}
+	node := startCompatNodeCl7f3a(t, "node-host", "r5", "z5", stats)
+	admin := startAdminDiscoCl7f3a(t, []string{node})
+
+	read := func() ([]string, []string) {
+		resp := getJSONCompatCl7f3a(t, fmt.Sprintf("http://%s/api/topics/%s/c1",
+			admin.RealHTTPAddr(), compatTopicCl7f3a))
+		list, _ := resp["clients"].([]interface{})
+		hosts := make([]string, 0, len(list))
+		addrs := make([]string, 0, len(list))
+		for _, c := range list {
+			m, _ := c.(map[string]interface{})
+			hostname, _ := m["hostname"].(string)
+			addr, _ := m["remote_address"].(string)
+			hosts = append(hosts, hostname)
+			addrs = append(addrs, addr)
+		}
+		return hosts, addrs
+	}
+
+	hosts, first := read()
+	if len(hosts) != len(clients) {
+		t.Fatalf("expected %d clients, got %v", len(clients), hosts)
+	}
+	for i := 1; i < len(hosts); i++ {
+		if tier[hosts[i]] < tier[hosts[i-1]] {
+			t.Fatalf("clients of a node in region r5 zone z5 are not nearest first: got %v", hosts)
+		}
+	}
+	for i := 2; i <= 5; i++ {
+		if _, got := read(); fmt.Sprint(got) != fmt.Sprint(first) {
+			t.Fatalf("client order changed between calls: read 1 %v, read %d %v", first, i, got)
+		}
+	}
+}
+
+func TestTopicAPIReportsClusterTopicTotalsCl7f3a(t *testing.T) {
+	type counters struct {
+		depth, backend, messages, zone, region, global int64
+	}
+	nodeStats := func(c counters) string {
+		return fmt.Sprintf(`{"topics":[{"topic_name":%q,"depth":%d,"backend_depth":%d,`+
+			`"message_count":%d,"zone_local_msg_count":%d,"region_local_msg_count":%d,`+
+			`"global_msg_count":%d,%s,"channels":[{"channel_name":"c1","depth":%d,%s}]}]}`,
+			compatTopicCl7f3a, c.depth, c.backend, c.messages, c.zone, c.region, c.global,
+			compatLatencyCl7f3a, c.depth, compatLatencyCl7f3a)
+	}
+	a := counters{depth: 5, backend: 2, messages: 50, zone: 4, region: 6, global: 8}
+	b := counters{depth: 7, backend: 3, messages: 70, zone: 5, region: 9, global: 11}
+	admin := startAdminDiscoCl7f3a(t, []string{
+		startCompatNodeCl7f3a(t, "a-host", "", "", func(int) string { return nodeStats(a) }),
+		startCompatNodeCl7f3a(t, "b-host", "", "", func(int) string { return nodeStats(b) }),
+	})
+
+	resp := getJSONCompatCl7f3a(t, fmt.Sprintf("http://%s/api/topics/%s",
+		admin.RealHTTPAddr(), compatTopicCl7f3a))
+
+	expect := func(where string, obj map[string]interface{}, c counters) {
+		t.Helper()
+		want := map[string]int64{
+			"depth":                  c.depth,
+			"backend_depth":          c.backend,
+			"memory_depth":           c.depth - c.backend,
+			"message_count":          c.messages,
+			"zone_local_msg_count":   c.zone,
+			"region_local_msg_count": c.region,
+			"global_msg_count":       c.global,
+			"delivery_msg_count":     c.zone + c.region + c.global,
+		}
+		for field, w := range want {
+			got, _ := obj[field].(float64)
+			if int64(got) != w {
+				t.Errorf("%s %s: got %v, want %d", where, field, obj[field], w)
+			}
+		}
+		channels, _ := obj["channels"].([]interface{})
+		if len(channels) != 1 {
+			t.Errorf("%s: expected channel c1 only, got %v", where, obj["channels"])
+			return
+		}
+		ch, _ := channels[0].(map[string]interface{})
+		if got, _ := ch["depth"].(float64); ch["channel_name"] != "c1" || int64(got) != c.depth {
+			t.Errorf("%s channel c1 depth: got %v, want %d", where, ch["depth"], c.depth)
+		}
+	}
+
+	expect("all-nodes topic", resp, counters{
+		depth: a.depth + b.depth, backend: a.backend + b.backend,
+		messages: a.messages + b.messages, zone: a.zone + b.zone,
+		region: a.region + b.region, global: a.global + b.global,
+	})
+
+	nodes, _ := resp["nodes"].([]interface{})
+	if len(nodes) != 2 {
+		t.Fatalf("expected 2 per-node entries, got %d", len(nodes))
+	}
+	for _, n := range nodes {
+		m, _ := n.(map[string]interface{})
+		switch m["hostname"] {
+		case "a-host":
+			expect("node a-host", m, a)
+		case "b-host":
+			expect("node b-host", m, b)
+		default:
+			t.Errorf("unexpected node %v", m["hostname"])
+		}
+	}
+}
