+	dead := deadAddrDiscoCl7f3a(t)
+	paths := []string{
+		"/api/topics",
+		"/api/topics/" + topicCl7f3a,
+		"/api/topics/" + topicCl7f3a + "/c1",
+		"/api/nodes",
+		"/api/nodes/" + live.addr(),
+	}
+
+	admin := startNSQAdminCl7f3a(t, nil, []string{live.addr(), dead})
+	for _, path := range paths {
+		status, resp := getJSONCl7f3a(t, fmt.Sprintf("http://%s%s", admin.RealHTTPAddr(), path))
+		if status < 200 || status > 299 {
+			t.Fatalf("%s with one node unreachable: got status %d, want a successful response", path, status)
+		}
+		failed := failedNodesCl7f3a(resp)
+		if !listsNodeCl7f3a(failed, dead) {
+			t.Errorf("%s: failed_nodes %v does not list the unreachable node %s", path, failed, dead)
+		}
+		if listsNodeCl7f3a(failed, live.addr()) {
+			t.Errorf("%s: failed_nodes %v lists %s, which answered", path, failed, live.addr())
+		}
+	}
+
+	admin = startNSQAdminCl7f3a(t, nil, []string{live.addr()})
+	for _, path := range paths {
+		status, resp := getJSONCl7f3a(t, fmt.Sprintf("http://%s%s", admin.RealHTTPAddr(), path))
+		if status < 200 || status > 299 {
+			t.Fatalf("%s with every node answering: got status %d, want a successful response", path, status)
