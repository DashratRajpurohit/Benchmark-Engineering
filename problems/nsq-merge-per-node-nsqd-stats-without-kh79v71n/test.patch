+func TestChannelAPINodeClientOrderIsStableCl7f3a(t *testing.T) {
+	node := startShufflingNSQDCl7f3a(t, "a-host", []int{9001, 9002, 9003, 9004})
+	admin := startNSQAdminCl7f3a(t, nil, []string{node})
+	url := fmt.Sprintf("http://%s/api/topics/%s/%s", admin.RealHTTPAddr(), topicCl7f3a, "c1")
+
+	perNode := func() []string {
+		_, resp := getJSONCl7f3a(t, url)
+		nodes, _ := resp["nodes"].([]interface{})
+		if len(nodes) != 1 {
+			t.Fatalf("expected 1 contributor under the channel, got %d", len(nodes))
+		}
+		m, _ := nodes[0].(map[string]interface{})
+		clients, _ := m["clients"].([]interface{})
+		if len(clients) != 4 {
+			t.Fatalf("expected 4 clients on the node, got %d", len(clients))
+		}
+		out := make([]string, 0, len(clients))
+		for _, c := range clients {
+			cm, _ := c.(map[string]interface{})
+			addr, _ := cm["remote_address"].(string)
+			out = append(out, addr)
+		}
+		return out
+	}
+
+	first := perNode()
+	for i := 2; i <= 4; i++ {
+		sameSequenceCl7f3a(t, fmt.Sprintf("clients on the node, read %d", i), first, perNode())
+	}
+}
+
+func TestChannelAPIKeepsErrorWhenAnOwnerCannotBeInspectedCl7f3a(t *testing.T) {
+	ask := func(failFiltered bool) (int, []byte) {
+		ok := startNSQDFakeCl7f3a(t, &nsqdFakeCl7f3a{hostname: "a-host", stats: topicOnlyCl7f3a()})
+		other := startNSQDFakeCl7f3a(t, &nsqdFakeCl7f3a{
+			hostname: "b-host", stats: topicOnlyCl7f3a(), failFiltered: failFiltered})
+		admin := startNSQAdminCl7f3a(t, nil, []string{ok.addr(), other.addr()})
+		return getStatusCl7f3a(t, fmt.Sprintf("http://%s/api/topics/%s/%s",
+			admin.RealHTTPAddr(), topicCl7f3a, "some_channel"))
+	}
+
+	status, body := ask(false)
+	t.Logf("both owners inspected: status=%d body=%s", status, body)
+	if status != 404 {
+		t.Fatalf("both owners answered without the channel: got status %d, want 404 (body %s)",
+			status, body)
+	}
+
+	status, body = ask(true)
+	t.Logf("one owner cannot be inspected: status=%d body=%s", status, body)
+	if status == 404 {
+		t.Fatalf("a node could not be inspected, so absence is unproven: got 404, want an error status (body %s)",
+			body)
+	}
+	if status < 400 {
+		t.Fatalf("a node could not be inspected: got status %d, want an error status (body %s)",
+			status, body)
+	}
+}
+
+// statsBodyWithLatencyCl7f3a renders a /stats body for one topic/channel
+// whose only percentile has the given sample count and value.
+func statsBodyWithLatencyCl7f3a(topic, channel string, count int, value float64) string {
+	return fmt.Sprintf(`{"topics":[{"topic_name":%q,"depth":1,"message_count":10,`+
+		`"channels":[{"channel_name":%q,"depth":1,"message_count":10,"client_count":0,"clients":[],`+
+		`"e2e_processing_latency":{"count":%d,"percentiles":[{"quantile":0.99,"value":%v}]}}]}]}`,
+		topic, channel, count, value)
+}
+
+// TestChannelAPILatencyAverageIsStableAcrossNodeOrderCl7f3a covers merging
+// three nodes' latency into one channel aggregate: the incremental
+// weighted-average update is not exactly associative in floating point, so
+// the nodes must always be merged in the same order, not in whichever order
+// their HTTP responses happen to arrive.
+func TestChannelAPILatencyAverageIsStableAcrossNodeOrderCl7f3a(t *testing.T) {
+	channel := "c1"
+	a := startNSQDFakeCl7f3a(t, &nsqdFakeCl7f3a{hostname: "a-host",
+		stats: statsBodyWithLatencyCl7f3a(topicCl7f3a, channel, 1, 0.1)})
+	b := startNSQDFakeCl7f3a(t, &nsqdFakeCl7f3a{hostname: "b-host",
+		stats: statsBodyWithLatencyCl7f3a(topicCl7f3a, channel, 1, 0.2)})
+	c := startNSQDFakeCl7f3a(t, &nsqdFakeCl7f3a{hostname: "c-host",
+		stats: statsBodyWithLatencyCl7f3a(topicCl7f3a, channel, 1, 0.4)})
+
+	admin := startNSQAdminCl7f3a(t, nil, []string{a.addr(), b.addr(), c.addr()})
+	url := fmt.Sprintf("http://%s/api/topics/%s/%s", admin.RealHTTPAddr(), topicCl7f3a, channel)
+
+	read := func() float64 {
+		status, resp := getJSONCl7f3a(t, url)
+		if status != 200 {
+			t.Fatalf("got status %d, want 200", status)
+		}
+		latency, _ := resp["e2e_processing_latency"].(map[string]interface{})
+		percentiles, _ := latency["percentiles"].([]interface{})
+		if len(percentiles) != 1 {
+			t.Fatalf("expected 1 percentile, got %d: %v", len(percentiles), percentiles)
+		}
+		p, _ := percentiles[0].(map[string]interface{})
+		avg, _ := p["average"].(float64)
+		return avg
+	}
+
+	first := read()
+	for i := 2; i <= 30; i++ {
+		if got := read(); got != first {
+			t.Errorf("read %d: average %.20f, read 1: %.20f (merge order is not deterministic)", i, got, first)
+		}
+	}
+}
