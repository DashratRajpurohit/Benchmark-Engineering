+// phaseGateCl7f3a fixes which fake nsqd answers first in each round of
+// concurrent queries. setLeader applies to every later round.
+type phaseGateCl7f3a struct {
+	mu       sync.Mutex
+	leader   int
+	rounds   map[int]chan struct{}
+	timedOut bool
+}
+
+func newPhaseGateCl7f3a() *phaseGateCl7f3a {
+	return &phaseGateCl7f3a{rounds: map[int]chan struct{}{}}
+}
+
+// stalled reports whether any round gave up waiting.
+func (g *phaseGateCl7f3a) stalled() bool {
+	g.mu.Lock()
+	defer g.mu.Unlock()
+	return g.timedOut
+}
+
+func (g *phaseGateCl7f3a) setLeader(id int) {
+	g.mu.Lock()
+	g.leader = id
+	g.mu.Unlock()
+}
+
+func (g *phaseGateCl7f3a) leads(id int) bool {
+	g.mu.Lock()
+	defer g.mu.Unlock()
+	return g.leader == id
+}
+
+func (g *phaseGateCl7f3a) chanFor(round int) chan struct{} {
+	g.mu.Lock()
+	defer g.mu.Unlock()
+	if _, ok := g.rounds[round]; !ok {
+		g.rounds[round] = make(chan struct{})
+	}
+	return g.rounds[round]
+}
+
+// await blocks a follower until the leader has answered this round, then
+// repeatedly yields the scheduler so nsqadmin's goroutine for the leader's
+// response gets real opportunities to run and record its result, instead of
+// assuming one fixed delay is always long enough under load.
+func (g *phaseGateCl7f3a) await(round int) {
+	select {
+	case <-g.chanFor(round):
+		deadline := time.Now().Add(time.Second)
+		for time.Now().Before(deadline) {
+			runtime.Gosched()
+			time.Sleep(time.Millisecond)
+		}
+	case <-time.After(10 * time.Second):
+		g.mu.Lock()
+		g.timedOut = true
+		g.mu.Unlock()
+	}
+}
+
+// done records that the leader has answered this round.
+func (g *phaseGateCl7f3a) done(round int) {
+	ch := g.chanFor(round)
+	g.mu.Lock()
+	defer g.mu.Unlock()
+	select {
+	case <-ch:
+	default:
+		close(ch)
+	}
+}
+
+// nsqdFakeCl7f3a is one fake nsqd. With failFiltered set, channel-filtered
+// /stats requests fail. With gate set, the gate decides whether this node
+// answers first or second in every round.
+type nsqdFakeCl7f3a struct {
+	hostname     string
+	stats        string
+	failFiltered bool
+	gate         *phaseGateCl7f3a
+	id           int
+	srv          *httptest.Server
+
+	mu    sync.Mutex
+	round int
+}
+
+func startNSQDFakeCl7f3a(t *testing.T, f *nsqdFakeCl7f3a) *nsqdFakeCl7f3a {
+	t.Helper()
+	f.srv = httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if f.gate != nil {
+			f.mu.Lock()
+			f.round++
+			round := f.round
+			f.mu.Unlock()
+			if !f.gate.leads(f.id) {
+				f.gate.await(round)
+			} else {
+				defer f.gate.done(round)
+			}
+		}
+		if strings.HasPrefix(r.URL.Path, "/info") {
+			host, port, _ := net.SplitHostPort(f.addr())
+			w.Header().Set("Content-Type", "application/json")
+			_, _ = fmt.Fprintf(w, `{"version":"1.3.0","broadcast_address":%q,"hostname":%q,`+
+				`"http_port":%s,"tcp_port":4150}`, host, f.hostname, port)
+			return
+		}
+		if f.failFiltered && r.URL.Query().Get("channel") != "" {
+			http.Error(w, "INTERNAL_ERROR", http.StatusInternalServerError)
+			return
+		}
+		w.Header().Set("Content-Type", "application/json")
+		_, _ = io.WriteString(w, f.stats)
+	}))
+	t.Cleanup(f.srv.Close)
+	return f
+}
+
+func (f *nsqdFakeCl7f3a) addr() string { return strings.TrimPrefix(f.srv.URL, "http://") }
+
+// producerJSONCl7f3a renders the entry a nsqlookupd would report for this node.
+func (f *nsqdFakeCl7f3a) producerJSONCl7f3a() string {
+	host, port, _ := net.SplitHostPort(f.addr())
+	return fmt.Sprintf(`{"hostname":%q,"broadcast_address":%q,"tcp_port":4150,`+
+		`"http_port":%s,"version":"1.3.0","topics":[]}`, f.hostname, host, port)
+}
+
+// startLookupdAbsentCl7f3a serves /lookup the way a real nsqlookupd answers for
+// a topic it does not know: 404 TOPIC_NOT_FOUND.
+func startLookupdAbsentCl7f3a(t *testing.T) string {
+	t.Helper()
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		http.Error(w, "TOPIC_NOT_FOUND", http.StatusNotFound)
+	}))
+	t.Cleanup(srv.Close)
+	return strings.TrimPrefix(srv.URL, "http://")
+}
+
+// startLookupdFakeCl7f3a serves /lookup, reporting the given nodes as the
+// producers for the topic.
+func startLookupdFakeCl7f3a(t *testing.T, nodes []*nsqdFakeCl7f3a) string {
+	t.Helper()
+	parts := make([]string, 0, len(nodes))
+	for _, f := range nodes {
+		parts = append(parts, f.producerJSONCl7f3a())
+	}
+	body := `{"producers":[` + strings.Join(parts, ",") + `]}`
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Content-Type", "application/json")
+		_, _ = io.WriteString(w, body)
+	}))
+	t.Cleanup(srv.Close)
+	return strings.TrimPrefix(srv.URL, "http://")
+}
