+// failedNodesCl7f3a reads the failed_nodes list out of a response.
+func failedNodesCl7f3a(resp map[string]interface{}) []string {
+	list, _ := resp["failed_nodes"].([]interface{})
+	out := make([]string, 0, len(list))
+	for _, v := range list {
+		if s, ok := v.(string); ok {
+			out = append(out, s)
+			continue
+		}
+		b, _ := json.Marshal(v)
+		out = append(out, string(b))
+	}
+	return out
+}
+
+func listsNodeCl7f3a(nodes []string, addr string) bool {
+	for _, n := range nodes {
+		if strings.Contains(n, addr) {
+			return true
+		}
+	}
+	return false
+}
