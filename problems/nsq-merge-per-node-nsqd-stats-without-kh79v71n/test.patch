+func TestChannelAPINodeOrderIsStableCl7f3a(t *testing.T) {
+	gate := newPhaseGateCl7f3a()
+	one := startNSQDFakeCl7f3a(t, &nsqdFakeCl7f3a{hostname: "same-host", id: 0,
+		stats: statsBodyCl7f3a(topicCl7f3a, "c1", 5, ""), gate: gate})
+	two := startNSQDFakeCl7f3a(t, &nsqdFakeCl7f3a{hostname: "same-host", id: 1,
+		stats: statsBodyCl7f3a(topicCl7f3a, "c1", 7, ""), gate: gate})
+	admin := startNSQAdminCl7f3a(t, nil, []string{one.addr(), two.addr()})
+	url := fmt.Sprintf("http://%s/api/topics/%s/%s", admin.RealHTTPAddr(), topicCl7f3a, "c1")
+
+	ask := func(leader int) []string {
+		gate.setLeader(leader)
+		status, resp := getJSONCl7f3a(t, url)
+		if status != 200 {
+			t.Fatalf("channel request failed with status %d", status)
+		}
+		nodes, _ := resp["nodes"].([]interface{})
+		out := make([]string, 0, len(nodes))
+		for _, n := range nodes {
+			m, _ := n.(map[string]interface{})
+			depth, _ := m["depth"].(float64)
+			out = append(out, fmt.Sprintf("depth=%v", depth))
+		}
+		return out
+	}
+
+	first, second := ask(0), ask(1)
+	t.Logf("node one answered first -> %v ; node two answered first -> %v", first, second)
+	if gate.stalled() {
+		t.Fatal("the answering order could not be fixed, so the result proves nothing")
+	}
+	if len(first) != 2 {
+		t.Fatalf("expected 2 contributors under the channel, got %v", first)
+	}
+	sameSequenceCl7f3a(t, "channel nodes sharing a hostname", first, second)
+}
