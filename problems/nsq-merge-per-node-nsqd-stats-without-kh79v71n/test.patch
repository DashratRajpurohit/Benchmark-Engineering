+func TestMergedTopicHandlesUnequalChannelMembershipCl7f3a(t *testing.T) {
+	nodeA := &clusterinfo.TopicStats{
+		Node: "A:4151", Hostname: "A", TopicName: "t1", Depth: 5,
+		E2eProcessingLatency: latencyCl7f3a("t1", "A:4151", 10),
+		Channels: []*clusterinfo.ChannelStats{
+			{Node: "A:4151", Hostname: "A", TopicName: "t1", ChannelName: "shared", Depth: 5, MessageCount: 50,
+				E2eProcessingLatency: latencyCl7f3a("t1", "A:4151", 10)},
+			{Node: "A:4151", Hostname: "A", TopicName: "t1", ChannelName: "only-on-a", Depth: 1, MessageCount: 10,
+				E2eProcessingLatency: latencyCl7f3a("t1", "A:4151", 10)},
+		},
+	}
+	nodeB := &clusterinfo.TopicStats{
+		Node: "B:4151", Hostname: "B", TopicName: "t1", Depth: 7,
+		E2eProcessingLatency: latencyCl7f3a("t1", "B:4151", 100),
+		Channels: []*clusterinfo.ChannelStats{
+			{Node: "B:4151", Hostname: "B", TopicName: "t1", ChannelName: "shared", Depth: 7, MessageCount: 70,
+				E2eProcessingLatency: latencyCl7f3a("t1", "B:4151", 100)},
+			{Node: "B:4151", Hostname: "B", TopicName: "t1", ChannelName: "only-on-b", Depth: 3, MessageCount: 30,
+				E2eProcessingLatency: latencyCl7f3a("t1", "B:4151", 100)},
+		},
+	}
+	all := &clusterinfo.TopicStats{TopicName: "t1"}
+	all.Add(nodeA)
+	all.Add(nodeB)
+
+	byName := map[string]*clusterinfo.ChannelStats{}
+	for _, ch := range all.Channels {
+		if _, dup := byName[ch.ChannelName]; dup {
+			t.Fatalf("channel %q merged into more than one entry", ch.ChannelName)
+		}
+		byName[ch.ChannelName] = ch
+	}
+	if len(byName) != 3 {
+		names := make([]string, 0, len(all.Channels))
+		for _, ch := range all.Channels {
+			names = append(names, ch.ChannelName)
+		}
+		t.Fatalf("expected 3 distinct merged channels, got %d: %v", len(byName), names)
+	}
+
+	for _, c := range []struct {
+		name  string
+		depth int64
+		msgs  int64
+	}{
+		{"shared", 12, 120},
+		{"only-on-a", 1, 10},
+		{"only-on-b", 3, 30},
+	} {
+		got, ok := byName[c.name]
+		if !ok {
+			t.Errorf("merged channel %q missing", c.name)
+			continue
+		}
+		if got.Depth != c.depth {
+			t.Errorf("channel %q depth: got %d want %d", c.name, got.Depth, c.depth)
+		}
+		if got.MessageCount != c.msgs {
+			t.Errorf("channel %q message count: got %d want %d", c.name, got.MessageCount, c.msgs)
+		}
+	}
+
+	for _, n := range []struct {
+		node  *clusterinfo.TopicStats
+		depth map[string]int64
+		msgs  map[string]int64
+	}{
+		{nodeA, map[string]int64{"shared": 5, "only-on-a": 1}, map[string]int64{"shared": 50, "only-on-a": 10}},
+		{nodeB, map[string]int64{"shared": 7, "only-on-b": 3}, map[string]int64{"shared": 70, "only-on-b": 30}},
+	} {
+		for _, ch := range n.node.Channels {
+			if ch.Depth != n.depth[ch.ChannelName] {
+				t.Errorf("node %s channel %q depth: got %d want %d",
+					n.node.Hostname, ch.ChannelName, ch.Depth, n.depth[ch.ChannelName])
+			}
+			if ch.MessageCount != n.msgs[ch.ChannelName] {
+				t.Errorf("node %s channel %q message count: got %d want %d",
+					n.node.Hostname, ch.ChannelName, ch.MessageCount, n.msgs[ch.ChannelName])
+			}
+		}
+	}
+}
+
+func TestMergedTopicKeepsPerNodeTopicLatencyCl7f3a(t *testing.T) {
+	nodeA := &clusterinfo.TopicStats{
+		Node: "A:4151", Hostname: "A", TopicName: "t1", Depth: 5,
+		E2eProcessingLatency: latencyNCl7f3a("t1", "A:4151", 10, 1),
+	}
+	nodeB := &clusterinfo.TopicStats{
+		Node: "B:4151", Hostname: "B", TopicName: "t1", Depth: 7,
+		E2eProcessingLatency: latencyNCl7f3a("t1", "B:4151", 100, 3),
+	}
+	all := &clusterinfo.TopicStats{TopicName: "t1"}
+	all.Add(nodeA)
+	all.Add(nodeB)
+
+	if nodeA.E2eProcessingLatency == nil {
+		t.Fatal("node A lost its topic latency aggregate")
+	}
+	a := nodeA.E2eProcessingLatency
+	if a.Addr != "A:4151" {
+		t.Errorf("node A topic latency host: got %q want %q (turned into the cluster total)", a.Addr, "A:4151")
+	}
+	if a.Count != 1 {
+		t.Errorf("node A topic latency count: got %d want 1", a.Count)
+	}
+	if len(a.Percentiles) != 1 {
+		t.Fatalf("node A topic latency percentiles: got %d want 1", len(a.Percentiles))
+	}
+	for key, want := range map[string]float64{"min": 10, "max": 10, "average": 10, "count": 1} {
+		if got := a.Percentiles[0][key]; got != want {
+			t.Errorf("node A topic latency %q: got %v want %v", key, got, want)
+		}
+	}
+
+	if all.E2eProcessingLatency == nil {
+		t.Fatal("merged topic has no latency aggregate")
+	}
+	m := all.E2eProcessingLatency
+	if got := m.Percentiles[0]["max"]; got != 100 {
+		t.Errorf("merged topic latency max: got %v want 100", got)
+	}
+	if got := m.Percentiles[0]["min"]; got != 10 {
+		t.Errorf("merged topic latency min: got %v want 10", got)
+	}
+}
