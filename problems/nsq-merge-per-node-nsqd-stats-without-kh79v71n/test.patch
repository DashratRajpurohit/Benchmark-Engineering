+	healthy := startLookupdHealthyCl7f3a(t, live)
+	dead := deadAddrDiscoCl7f3a(t)
+	paths := []string{
+		"/api/topics",
+		"/api/nodes",
+		"/api/nodes/" + live.addr(),
+	}
+
+	admin := startNSQAdminCl7f3a(t, []string{healthy, dead}, nil)
+	for _, path := range paths {
+		status, resp := getJSONCl7f3a(t, fmt.Sprintf("http://%s%s", admin.RealHTTPAddr(), path))
+		if status < 200 || status > 299 {
+			t.Fatalf("%s with one nsqlookupd unreachable: got status %d, want a successful response",
+				path, status)
+		}
+		failed := failedNodesCl7f3a(resp)
+		if !listsNodeCl7f3a(failed, dead) {
+			t.Errorf("%s: failed_nodes %v does not list the unreachable nsqlookupd %s", path, failed, dead)
+		}
+		if listsNodeCl7f3a(failed, healthy) || listsNodeCl7f3a(failed, live.addr()) {
+			t.Errorf("%s: failed_nodes %v lists a node that answered", path, failed)
+		}
+	}
+
+	admin = startNSQAdminCl7f3a(t, []string{healthy}, nil)
+	for _, path := range paths {
+		status, resp := getJSONCl7f3a(t, fmt.Sprintf("http://%s%s", admin.RealHTTPAddr(), path))
+		if status < 200 || status > 299 {
+			t.Fatalf("%s with every node answering: got status %d, want a successful response", path, status)
+		}
+		if failed := failedNodesCl7f3a(resp); len(failed) != 0 {
+			t.Errorf("%s: every node answered, but failed_nodes is %v", path, failed)
+		}
+	}
+}
diff --git a/nsqd/stats_latency_cl7f3a_test.go b/nsqd/stats_latency_cl7f3a_test.go
new file mode 100644
index 0000000..4f315d9
--- /dev/null
+++ b/nsqd/stats_latency_cl7f3a_test.go
@@ -0,0 +1,138 @@
+//go:build clusteragg
+
+package nsqd
+
+import (
+	"bytes"
+	"fmt"
+	"net"
+	"net/http"
+	"os"
+	"testing"
+	"time"
+
+	"github.com/nsqio/go-nsq"
+	"github.com/nsqio/nsq/internal/http_api"
+	"github.com/nsqio/nsq/internal/test"
+)
+
+func TestStatsTopicLatencyIsStableCl7f3a(t *testing.T) {
+	opts := NewOptions()
+	opts.Logger = test.NewTestLogger(t)
+	opts.E2EProcessingLatencyPercentiles = []float64{0.5, 0.9, 0.99}
+	tcpAddr, httpAddr, nsqd := mustStartNSQD(opts)
+	defer func() { _ = os.RemoveAll(opts.DataPath) }()
+	defer nsqd.Exit()
+
+	topicName := "latency_cl7f3a"
+	const channels, messages = 6, 20
+
+	conns := make([]net.Conn, 0, channels)
+	defer func() {
+		for _, c := range conns {
+			_ = c.Close()
+		}
+	}()
+	for i := 0; i < channels; i++ {
+		conn, err := mustConnectNSQD(tcpAddr)
+		test.Nil(t, err)
+		conns = append(conns, conn)
+		identify(t, conn, nil, frameTypeResponse)
+		sub(t, conn, topicName, fmt.Sprintf("ch%d", i))
+		_, err = nsq.Ready(messages).WriteTo(conn)
+		test.Nil(t, err)
+	}
+
+	for m := 0; m < messages; m++ {
+		resp, err := http.Post(fmt.Sprintf("http://%s/pub?topic=%s", httpAddr, topicName),
+			"application/octet-stream", bytes.NewBufferString("body"))
+		test.Nil(t, err)
+		_ = resp.Body.Close()
+	}
+
+	// Each channel finishes its messages at its own pace, so every channel
+	// reports a different latency distribution.
+	done := make(chan error, channels)
+	for i, conn := range conns {
+		go func(i int, conn net.Conn) {
+			for n := 0; n < messages; n++ {
+				resp, err := nsq.ReadResponse(conn)
+				if err != nil {
+					done <- err
+					return
+				}
+				frameType, data, _ := nsq.UnpackResponse(resp)
+				if frameType != frameTypeMessage {
+					n--
+					continue
+				}
+				msg, err := decodeMessage(data)
+				if err != nil {
+					done <- err
+					return
+				}
+				time.Sleep(time.Duration(i+1) * time.Millisecond * time.Duration(n%4+1))
+				if _, err := nsq.Finish(nsq.MessageID(msg.ID)).WriteTo(conn); err != nil {
+					done <- err
+					return
+				}
+			}
+			done <- nil
+		}(i, conn)
+	}
+	for i := 0; i < channels; i++ {
+		test.Nil(t, <-done)
+	}
+
+	client := http_api.NewClient(nil, ConnectTimeout, RequestTimeout)
+	endpoint := fmt.Sprintf("http://%s/stats?format=json&topic=%s", httpAddr, topicName)
+	type latency struct {
+		Count       int                  `json:"count"`
+		Percentiles []map[string]float64 `json:"percentiles"`
+	}
+	read := func() (latency, []int) {
+		var d struct {
+			Topics []struct {
+				Latency  latency `json:"e2e_processing_latency"`
+				Channels []struct {
+					Latency latency `json:"e2e_processing_latency"`
+				} `json:"channels"`
+			} `json:"topics"`
+		}
+		test.Nil(t, client.GETV1(endpoint, &d))
+		if len(d.Topics) != 1 {
+			t.Fatalf("expected one topic, got %+v", d.Topics)
+		}
+		counts := make([]int, 0, channels)
+		for _, c := range d.Topics[0].Channels {
+			counts = append(counts, c.Latency.Count)
+		}
+		return d.Topics[0].Latency, counts
+	}
+
+	deadline := time.Now().Add(10 * time.Second)
+	for {
+		_, counts := read()
+		finished := len(counts) == channels
+		for _, c := range counts {
+			finished = finished && c == messages
+		}
+		if finished {
+			break
+		}
+		if time.Now().After(deadline) {
+			t.Fatalf("channels never recorded every finished message: %v", counts)
+		}
+		time.Sleep(10 * time.Millisecond)
+	}
+
+	first, _ := read()
+	if len(first.Percentiles) == 0 {
+		t.Fatal("the topic reported no latency percentiles")
+	}
+	for i := 2; i <= 20; i++ {
+		if got, _ := read(); fmt.Sprint(got) != fmt.Sprint(first) {
+			t.Fatalf("read %d reported the topic latency as %v, read 1 as %v", i, got, first)
+		}
+	}
+}
diff --git a/nsqd/stats_order_cl7f3a_test.go b/nsqd/stats_order_cl7f3a_test.go
new file mode 100644
index 0000000..cea0979
--- /dev/null
+++ b/nsqd/stats_order_cl7f3a_test.go
@@ -0,0 +1,72 @@
+//go:build clusteragg
+
+package nsqd
+
+import (
+	"fmt"
+	"net"
+	"os"
+	"testing"
+
+	"github.com/nsqio/nsq/internal/http_api"
+	"github.com/nsqio/nsq/internal/test"
+)
+
+func TestStatsChannelClientOrderIsStableCl7f3a(t *testing.T) {
+	opts := NewOptions()
+	opts.Logger = test.NewTestLogger(t)
+	tcpAddr, httpAddr, nsqd := mustStartNSQD(opts)
+	defer func() { _ = os.RemoveAll(opts.DataPath) }()
+	defer nsqd.Exit()
+
+	topicName := "client_order_cl7f3a"
+	nsqd.GetTopic(topicName)
+
+	const consumers = 8
+	conns := make([]net.Conn, 0, consumers)
+	defer func() {
+		for _, c := range conns {
+			_ = c.Close()
+		}
+	}()
+	for i := 0; i < consumers; i++ {
+		conn, err := mustConnectNSQD(tcpAddr)
+		test.Nil(t, err)
+		conns = append(conns, conn)
+		identify(t, conn, nil, frameTypeResponse)
+		sub(t, conn, topicName, "ch")
+	}
+
+	client := http_api.NewClient(nil, ConnectTimeout, RequestTimeout)
+	endpoint := fmt.Sprintf("http://%s/stats?format=json&topic=%s&channel=ch", httpAddr, topicName)
+	read := func() []string {
+		var d struct {
+			Topics []struct {
+				Channels []struct {
+					Clients []struct {
+						RemoteAddress string `json:"remote_address"`
+					} `json:"clients"`
+				} `json:"channels"`
+			} `json:"topics"`
+		}
+		test.Nil(t, client.GETV1(endpoint, &d))
+		if len(d.Topics) != 1 || len(d.Topics[0].Channels) != 1 {
+			t.Fatalf("expected one topic with one channel, got %+v", d.Topics)
+		}
+		out := make([]string, 0, consumers)
+		for _, c := range d.Topics[0].Channels[0].Clients {
+			out = append(out, c.RemoteAddress)
+		}
+		return out
+	}
+
+	first := read()
+	if len(first) != consumers {
+		t.Fatalf("expected %d clients, got %d: %v", consumers, len(first), first)
+	}
+	for i := 2; i <= 20; i++ {
+		if got := read(); fmt.Sprint(got) != fmt.Sprint(first) {
+			t.Fatalf("read %d listed the clients as %v, read 1 as %v", i, got, first)
+		}
+	}
+}
diff --git a/test.sh b/test.sh
index 5874b6a..4c3b8d9 100755
--- a/test.sh
+++ b/test.sh
@@ -1,6 +1,77 @@
 #!/bin/sh
 set -e
 
+# ./test.sh [--output_path <junit.xml>] base|new runs one test set and exits.
+# base runs the existing tests of the packages listed below; new runs only the
+# tests in files behind the clusteragg build tag. Without arguments the
+# repository's CI checks below run as before.
+if [ "$#" -gt 0 ]; then
+    OUTPUT_PATH=""
+    MODE=""
+    while [ "$#" -gt 0 ]; do
+        case "$1" in
+            --output_path)
+                if [ "$#" -lt 2 ] || [ -z "$2" ]; then
+                    echo "--output_path needs a file path" >&2
+                    exit 2
+                fi
+                OUTPUT_PATH="$2"
+                shift 2
+                ;;
+            base|new)
+                if [ -n "$MODE" ]; then
+                    echo "mode given more than once: $MODE and $1" >&2
+                    exit 2
+                fi
+                MODE="$1"
+                shift
+                ;;
+            *)
+                echo "usage: ./test.sh [--output_path <junit.xml>] [base|new]" >&2
+                exit 2
+                ;;
+        esac
+    done
+    if [ -z "$MODE" ]; then
+        echo "a mode is required: base or new" >&2
+        exit 2
+    fi
+    case "$OUTPUT_PATH" in
+        "" | /*) ;;
+        *) OUTPUT_PATH="$PWD/$OUTPUT_PATH" ;;
+    esac
+    [ -f go.mod ] || cd "$(dirname "$0")"
+
+    case "$MODE" in
+        base)
+            set -- -timeout 600s ./internal/clusterinfo/... ./internal/quantile/... \
+                ./internal/http_api/... ./nsqadmin/... ./nsqlookupd/... ./nsqd/... \
+                ./apps/nsq_stat/... ./apps/nsq_to_file/...
+            ;;
+        new)
+            files=$(grep -rl --include='*_test.go' '^//go:build clusteragg$' .)
+            tests=$(sed -n 's/^func \(Test[A-Za-z0-9_]*\)(t \*testing\.T) {$/\1/p' $files | paste -sd '|' -)
+            set -- -tags clusteragg -timeout 300s -run "^($tests)\$" \
+                $(for f in $files; do dirname "$f"; done | sort -u)
+            ;;
+    esac
+
+    TEST_LOG="$(mktemp)"
+    STATUS=0
+    go test -count=1 -v "$@" >"$TEST_LOG" 2>&1 || STATUS=$?
+    cat "$TEST_LOG"
+
+    if [ -n "$OUTPUT_PATH" ]; then
+        junit_status=0
+        go-junit-report -set-exit-code <"$TEST_LOG" >"$OUTPUT_PATH" || junit_status=$?
+        if [ "$junit_status" -ne 0 ] && [ "$STATUS" -eq 0 ]; then
+            echo "go-junit-report failed to convert the test log (exit $junit_status)" >&2
+            STATUS=$junit_status
+        fi
+    fi
+    exit "$STATUS"
+fi
+
 GOMAXPROCS=1 go test -vet=all -timeout 90s ./...
 
 if [ "$GOARCH" = "amd64" ] || [ "$GOARCH" = "arm64" ]; then
