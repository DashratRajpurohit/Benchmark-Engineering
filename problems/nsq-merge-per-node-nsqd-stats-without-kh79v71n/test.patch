+	first, second := ask(0), ask(1)
+	t.Logf("a answered first -> %v ; z answered first -> %v", first, second)
+	if gate.stalled() {
+		t.Fatal("the answering order could not be fixed, so the result proves nothing")
+	}
+	if len(first) != 2 {
+		t.Fatalf("expected 2 nodes, got %v", first)
+	}
+	sameSequenceCl7f3a(t, "nodes listing", first, second)
+}
