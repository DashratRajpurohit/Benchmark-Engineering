+func TestTopicAPIPercentileLabelsMatchValuesCl7f3a(t *testing.T) {
+	a := startNSQDFakeCl7f3a(t, &nsqdFakeCl7f3a{
+		hostname: "a-host", stats: statsBodyCl7f3a(topicCl7f3a, "c1", 5, "")})
+	b := startNSQDFakeCl7f3a(t, &nsqdFakeCl7f3a{
+		hostname: "b-host", stats: statsBodyCl7f3a(topicCl7f3a, "c1", 7, "")})
+	admin := startNSQAdminCl7f3a(t, nil, []string{a.addr(), b.addr()})
+
+	status, resp := getJSONCl7f3a(t, fmt.Sprintf("http://%s/api/topics/%s",
+		admin.RealHTTPAddr(), topicCl7f3a))
+	if status != 200 {
+		t.Fatalf("topic request failed with status %d", status)
+	}
+
+	wantValue := map[float64]float64{0.99: 900, 0.75: 400, 0.5: 100}
+	checkList := func(where string, latency interface{}) {
+		m, ok := latency.(map[string]interface{})
+		if !ok {
+			t.Errorf("%s: no latency object in the response", where)
+			return
+		}
+		raw, _ := m["percentiles"].([]interface{})
+		if len(raw) != 3 {
+			t.Errorf("%s: expected 3 percentiles, got %d", where, len(raw))
+			return
+		}
+		quantiles := make([]float64, 0, len(raw))
+		for _, p := range raw {
+			pm, _ := p.(map[string]interface{})
+			q, _ := pm["quantile"].(float64)
+			quantiles = append(quantiles, q)
+			want, known := wantValue[q]
+			if !known {
+				t.Errorf("%s: unexpected quantile %v", where, q)
+				continue
+			}
+			for _, key := range []string{"max", "min"} {
+				got, present := pm[key].(float64)
+				if !present {
+					continue
+				}
+				if got != want {
+					t.Errorf("%s: quantile %v carries %s %v, want %v (labels and values are misaligned)",
+						where, q, key, got, want)
+				}
+			}
+		}
+		for i := 1; i < len(quantiles); i++ {
+			if !(quantiles[i-1] > quantiles[i]) {
+				t.Errorf("%s: percentiles not highest-quantile-first: %v", where, quantiles)
+				break
+			}
+		}
+	}
+
+	checkList("all-nodes topic", resp["e2e_processing_latency"])
+	nodes, _ := resp["nodes"].([]interface{})
+	if len(nodes) != 2 {
+		t.Fatalf("expected 2 nodes, got %d", len(nodes))
+	}
+	for i, n := range nodes {
+		nm, _ := n.(map[string]interface{})
+		checkList(fmt.Sprintf("node %d topic", i), nm["e2e_processing_latency"])
+	}
+	channels, _ := resp["channels"].([]interface{})
+	if len(channels) != 1 {
+		t.Fatalf("expected 1 merged channel, got %d", len(channels))
+	}
+	for i, c := range channels {
+		cm, _ := c.(map[string]interface{})
+		checkList(fmt.Sprintf("channel %d", i), cm["e2e_processing_latency"])
+	}
+}
