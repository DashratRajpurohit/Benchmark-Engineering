+// startShufflingNSQDCl7f3a serves a node whose client list comes back in a
+// different order on every /stats response.
+func startShufflingNSQDCl7f3a(t *testing.T, hostname string, ports []int) string {
+	t.Helper()
+	var addr string
+	var mu sync.Mutex
+	responses := 0
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Content-Type", "application/json")
+		if strings.HasPrefix(r.URL.Path, "/info") {
+			host, port, _ := net.SplitHostPort(addr)
+			_, _ = fmt.Fprintf(w, `{"version":"1.3.0","broadcast_address":%q,"hostname":%q,`+
+				`"http_port":%s,"tcp_port":4150}`, host, hostname, port)
+			return
+		}
+		mu.Lock()
+		responses++
+		rng := rand.New(rand.NewSource(int64(responses)))
+		mu.Unlock()
+
+		shuffled := append([]int(nil), ports...)
+		rng.Shuffle(len(shuffled), func(i, j int) {
+			shuffled[i], shuffled[j] = shuffled[j], shuffled[i]
+		})
+		_, _ = io.WriteString(w, statsBodyCl7f3a(topicCl7f3a, "c1", 5,
+			clientsSharingIdentityCl7f3a(shuffled...)))
+	}))
+	t.Cleanup(srv.Close)
+	addr = srv.Listener.Addr().String()
+	return addr
+}
