+//go:build clusteragg
+
+package quantile_test
+
+import (
+	"testing"
+	"time"
+
+	"github.com/nsqio/nsq/internal/quantile"
+)
+
+func TestResultIsHighestQuantileFirstCl7f3a(t *testing.T) {
+	q := quantile.New(time.Minute, []float64{0.75, 0.5, 0.99})
+	for i := 0; i < 100; i++ {
+		q.Insert(time.Now().Add(-time.Duration(i) * time.Millisecond).UnixNano())
+	}
+
+	result := q.Result()
+	if len(result.Percentiles) != 3 {
+		t.Fatalf("expected 3 percentiles, got %d", len(result.Percentiles))
+	}
+	got := make([]float64, 0, 3)
+	for _, p := range result.Percentiles {
+		got = append(got, p["quantile"])
+	}
+	for i := 1; i < len(got); i++ {
+		if !(got[i-1] > got[i]) {
+			t.Fatalf("percentiles not highest-quantile-first: %v", got)
+		}
+	}
+}
