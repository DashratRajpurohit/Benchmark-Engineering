+func TestChannelAPIDiscoveryFailureIsNotAbsenceCl7f3a(t *testing.T) {
+	reachable := startStatsNodeDiscoCl7f3a(t)
+	ask := func(nodes []string) (int, []byte) {
+		admin := startAdminDiscoCl7f3a(t, nodes)
+		url := fmt.Sprintf("http://%s/api/topics/%s/%s", admin.RealHTTPAddr(),
+			"events_cl7f3a", "some_channel")
+		req, err := http.NewRequest("GET", url, nil)
+		test.Nil(t, err)
+		resp, err := http.DefaultClient.Do(req)
+		test.Nil(t, err)
+		body, _ := io.ReadAll(resp.Body)
+		_ = resp.Body.Close()
+		return resp.StatusCode, body
+	}
+
+	status, body := ask([]string{reachable})
+	t.Logf("every node answered: status=%d body=%s", status, body)
+	if status != 404 {
+		t.Fatalf("the only node answered without the channel: got status %d, want 404 (body %s)",
+			status, body)
+	}
+
+	status, body = ask([]string{reachable, deadAddrDiscoCl7f3a(t)})
+	t.Logf("one node unreachable: status=%d body=%s", status, body)
+	if status == 404 {
+		t.Fatalf("a node that could own the channel was never reached, so its absence "+
+			"is unproven: got 404, want an error status (body %s)", body)
+	}
+	if status < 400 {
+		t.Fatalf("discovery was incomplete: got status %d, want an error status (body %s)",
