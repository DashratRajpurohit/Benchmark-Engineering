+// fakeNSQDCl7f3a serves the /info and /stats endpoints the direct-nsqd
+// discovery paths query. If gate is non-nil the responder waits for it, which
+// fixes the order in which the concurrent queries complete.
+func fakeNSQDCl7f3a(t *testing.T, host, ip, topic string, gate <-chan struct{}) *httptest.Server {
+	t.Helper()
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if gate != nil {
+			select {
+			case <-gate:
+			case <-time.After(5 * time.Second):
+			}
+		}
+		if strings.HasPrefix(r.URL.Path, "/info") {
+			_, _ = w.Write([]byte(`{"version":"1.3.0","broadcast_address":"` + ip +
+				`","hostname":"` + host + `","http_port":4151,"tcp_port":4150}`))
+			return
+		}
+		_, _ = w.Write([]byte(`{"topics":[{"topic_name":"` + topic + `"}]}`))
+	}))
+	return srv
+}
+
+func addrOfCl7f3a(srv *httptest.Server) string {
+	return strings.TrimPrefix(srv.URL, "http://")
+}
+
+func ciCl7f3aNew() *clusterinfo.ClusterInfo {
+	return clusterinfo.New(func(lvl lg.LogLevel, f string, args ...interface{}) {},
+		http_api.NewClient(nil, 2*time.Second, 5*time.Second))
+}
+
+func hostsOfCl7f3a(ps clusterinfo.Producers) []string {
+	out := make([]string, 0, len(ps))
+	for _, p := range ps {
+		out = append(out, p.Hostname)
+	}
+	return out
+}
+
+func sameOrderCl7f3a(t *testing.T, what string, first, second []string) {
+	t.Helper()
+	if len(first) != len(second) {
+		t.Fatalf("%s: count changed, %v then %v", what, first, second)
+	}
+	for i := range first {
+		if first[i] != second[i] {
+			t.Fatalf("%s: order depends on which node answered first: %v then %v", what, first, second)
+		}
+	}
+}
+
+// statsNSQDCl7f3a serves a /stats payload whose latency percentiles are not in
+// descending order.
+func statsNSQDCl7f3a(t *testing.T, host string) *httptest.Server {
+	t.Helper()
+	var srv *httptest.Server
+	srv = httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if strings.HasPrefix(r.URL.Path, "/info") {
+			hostPort := strings.Split(addrOfCl7f3a(srv), ":")
+			_, _ = w.Write([]byte(`{"version":"1.3.0","broadcast_address":"` + hostPort[0] +
+				`","hostname":"` + host + `","http_port":` + hostPort[1] + `,"tcp_port":4150}`))
+			return
+		}
+		latency := `{"count":3,"percentiles":[` +
+			`{"quantile":0.75,"value":400},` +
+			`{"quantile":0.5,"value":100},` +
+			`{"quantile":0.99,"value":900}]}`
+		_, _ = w.Write([]byte(`{"topics":[{"topic_name":"events","depth":1,` +
+			`"e2e_processing_latency":` + latency + `,` +
+			`"channels":[{"channel_name":"c1","depth":1,` +
+			`"e2e_processing_latency":` + latency + `}]}]}`))
+	}))
+	return srv
+}
+
+func quantilesOfCl7f3a(e *quantile.E2eProcessingLatencyAggregate) []float64 {
+	if e == nil {
+		return nil
+	}
+	out := make([]float64, 0, len(e.Percentiles))
+	for _, p := range e.Percentiles {
+		out = append(out, p["quantile"])
+	}
+	return out
+}
+
+func assertHighestFirstCl7f3a(t *testing.T, what string, qs []float64) {
+	t.Helper()
+	if len(qs) < 3 {
+		t.Fatalf("%s: expected at least 3 percentiles, got %v", what, qs)
+	}
+	for i := 1; i < len(qs); i++ {
+		if !(qs[i-1] > qs[i]) {
+			t.Errorf("%s: percentiles not highest-quantile-first: %v", what, qs)
+			return
+		}
+	}
+}
+
+func TestPerNodeLatencyPercentileOrderCl7f3a(t *testing.T) {
+	ci := ciCl7f3aNew()
+	a := statsNSQDCl7f3a(t, "a-host")
+	defer a.Close()
+	b := statsNSQDCl7f3a(t, "b-host")
+	defer b.Close()
+
+	producers, err := ci.GetNSQDProducers([]string{addrOfCl7f3a(a), addrOfCl7f3a(b)})
+	if err != nil {
+		t.Fatalf("GetNSQDProducers: %v", err)
+	}
+	if len(producers) != 2 {
+		t.Fatalf("expected 2 producers, got %d", len(producers))
+	}
+
+	topics, channels, err := ci.GetNSQDStats(producers, "events", "", false)
+	if err != nil {
+		t.Fatalf("GetNSQDStats: %v", err)
+	}
+	if len(topics) != 2 {
+		t.Fatalf("expected per-node stats for 2 nodes, got %d", len(topics))
+	}
+
+	for _, node := range topics {
+		assertHighestFirstCl7f3a(t, "node "+node.Hostname+" topic latency",
+			quantilesOfCl7f3a(node.E2eProcessingLatency))
+		if len(node.Channels) != 1 {
+			t.Fatalf("node %s: expected 1 channel, got %d", node.Hostname, len(node.Channels))
+		}
+		assertHighestFirstCl7f3a(t, "node "+node.Hostname+" channel latency",
+			quantilesOfCl7f3a(node.Channels[0].E2eProcessingLatency))
+	}
+
+	merged, ok := channels["c1"]
+	if !ok {
+		t.Fatal(`expected a merged entry for channel "c1"`)
+	}
+	assertHighestFirstCl7f3a(t, "merged channel latency",
+		quantilesOfCl7f3a(merged.E2eProcessingLatency))
+	if len(merged.NodeStats) != 2 {
+		t.Fatalf("expected 2 per-node channel entries, got %d", len(merged.NodeStats))
+	}
+	for _, node := range merged.NodeStats {
+		assertHighestFirstCl7f3a(t, "merged node "+node.Hostname+" channel latency",
+			quantilesOfCl7f3a(node.E2eProcessingLatency))
+	}
+}
+
+// latencyNCl7f3a builds a node's aggregate with an explicit sample count.
+func latencyNCl7f3a(topic, node string, p99, count float64) *quantile.E2eProcessingLatencyAggregate {
+	return &quantile.E2eProcessingLatencyAggregate{
+		Count: int(count),
+		Percentiles: []map[string]float64{
+			{"quantile": 0.99, "value": p99, "min": p99, "max": p99,
+				"average": p99, "count": count},
+		},
+		Topic: topic,
+		Addr:  node,
+	}
+}
