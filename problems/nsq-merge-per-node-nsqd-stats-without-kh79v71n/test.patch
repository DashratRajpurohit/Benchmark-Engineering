+func latencyCl7f3a(topic, node string, p99 float64) *quantile.E2eProcessingLatencyAggregate {
+	return &quantile.E2eProcessingLatencyAggregate{
+		Count: 1,
+		Percentiles: []map[string]float64{
+			{"quantile": 0.99, "value": p99, "min": p99, "max": p99, "average": p99, "count": 1},
+		},
+		Topic: topic,
+		Addr:  node,
+	}
+}
+
+// nodeTopicCl7f3a gives every mutable counter a distinct, node-derived value.
+func nodeTopicCl7f3a(node string, depth int64, p99 float64) *clusterinfo.TopicStats {
+	return &clusterinfo.TopicStats{
+		Node: node, Hostname: node, TopicName: "t1",
+		Depth: depth, MessageCount: depth * 10,
+		BackendDepth: depth * 2, MemoryDepth: depth * 3,
+		E2eProcessingLatency: latencyCl7f3a("t1", node, p99),
+		Channels: []*clusterinfo.ChannelStats{{
+			Node: node, Hostname: node, TopicName: "t1", ChannelName: "c1",
+			Depth: depth, MessageCount: depth * 10,
+			BackendDepth: depth * 2, MemoryDepth: depth * 3,
+			InFlightCount: depth * 4, DeferredCount: depth * 5,
+			RequeueCount: depth * 6, TimeoutCount: depth * 7,
+			ZoneLocalMsgCount: depth * 8, RegionLocalMsgCount: depth * 9,
+			GlobalMsgCount: depth * 11, ClientCount: int(depth),
+			Paused:               depth == 7,
+			E2eProcessingLatency: latencyCl7f3a("t1", node, p99),
+		}},
+	}
+}
+
+func mergeTwoNodesCl7f3a() (all, nodeA *clusterinfo.TopicStats) {
+	nodeA = nodeTopicCl7f3a("A:4151", 5, 10)
+	nodeB := nodeTopicCl7f3a("B:4151", 7, 100)
+	all = &clusterinfo.TopicStats{TopicName: "t1"}
+	all.Add(nodeA)
+	all.Add(nodeB)
+	return all, nodeA
+}
+
+func TestMergedTopicKeepsPerNodeChannelCountsCl7f3a(t *testing.T) {
+	all, nodeA := mergeTwoNodesCl7f3a()
+	if len(all.NodeStats) != 2 {
+		t.Fatalf("expected 2 per-node entries, got %d", len(all.NodeStats))
+	}
+	if len(nodeA.Channels) != 1 {
+		t.Fatalf("expected node A to still have 1 channel, got %d", len(nodeA.Channels))
+	}
+	ch := nodeA.Channels[0]
+	if ch.Node != "A:4151" {
+		t.Errorf("node A channel node: got %q want %q", ch.Node, "A:4151")
+	}
+	if ch.Paused {
+		t.Error("node A channel paused: got true, want false (node B was the paused one)")
+	}
+	if ch.ClientCount != 5 {
+		t.Errorf("node A channel client count: got %d want 5", ch.ClientCount)
+	}
+	for _, f := range []struct {
+		name string
+		got  int64
+		want int64
+	}{
+		{"depth", ch.Depth, 5},
+		{"message count", ch.MessageCount, 50},
+		{"backend depth", ch.BackendDepth, 10},
+		{"memory depth", ch.MemoryDepth, 15},
+		{"in-flight count", ch.InFlightCount, 20},
+		{"deferred count", ch.DeferredCount, 25},
+		{"requeue count", ch.RequeueCount, 30},
+		{"timeout count", ch.TimeoutCount, 35},
+		{"zone-local count", ch.ZoneLocalMsgCount, 40},
+		{"region-local count", ch.RegionLocalMsgCount, 45},
+		{"global count", ch.GlobalMsgCount, 55},
+	} {
+		if f.got != f.want {
+			t.Errorf("node A channel %s: got %d want %d", f.name, f.got, f.want)
+		}
+	}
+
+	if len(all.Channels) != 1 {
+		t.Fatalf("expected 1 merged channel, got %d", len(all.Channels))
+	}
+	merged := all.Channels[0]
+	if !merged.Paused {
+		t.Error("merged channel paused: got false, want true (node B was paused)")
+	}
+	if merged.ClientCount != 12 {
+		t.Errorf("merged channel client count: got %d want 12", merged.ClientCount)
+	}
+	for _, f := range []struct {
+		name string
+		got  int64
+		want int64
+	}{
+		{"depth", merged.Depth, 12},
+		{"message count", merged.MessageCount, 120},
+		{"backend depth", merged.BackendDepth, 24},
+		{"memory depth", merged.MemoryDepth, 36},
+		{"in-flight count", merged.InFlightCount, 48},
+		{"deferred count", merged.DeferredCount, 60},
+		{"requeue count", merged.RequeueCount, 72},
+		{"timeout count", merged.TimeoutCount, 84},
+		{"zone-local count", merged.ZoneLocalMsgCount, 96},
+		{"region-local count", merged.RegionLocalMsgCount, 108},
+		{"global count", merged.GlobalMsgCount, 132},
+	} {
+		if f.got != f.want {
+			t.Errorf("merged channel %s: got %d want %d", f.name, f.got, f.want)
+		}
+	}
+}
+
+func TestMergedTopicKeepsPerNodeChannelLatencyCl7f3a(t *testing.T) {
+	_, nodeA := mergeTwoNodesCl7f3a()
+	e := nodeA.Channels[0].E2eProcessingLatency
+	if e == nil {
+		t.Fatal("node A channel lost its latency aggregate")
+	}
+	if e.Addr != "A:4151" {
+		t.Errorf("node A channel latency host: got %q want %q", e.Addr, "A:4151")
+	}
+	if e.Count != 1 {
+		t.Errorf("node A channel latency count: got %d want 1", e.Count)
+	}
+	if len(e.Percentiles) != 1 {
+		t.Fatalf("node A channel latency percentiles: got %d want 1", len(e.Percentiles))
+	}
+	if got := e.Percentiles[0]["max"]; got != 10 {
+		t.Errorf("node A channel latency max: got %v want 10", got)
+	}
+}
+
+func TestMergedLatencyReportsTrueMinimumCl7f3a(t *testing.T) {
+	cases := []struct {
+		name string
+		vals []float64
+	}{
+		{"min-first", []float64{10, 100}},
+		{"min-middle", []float64{100, 10, 50}},
+		{"min-first-of-three", []float64{10, 50, 100}},
+		{"min-then-higher", []float64{100, 50, 10, 20}},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			agg := &quantile.E2eProcessingLatencyAggregate{Topic: "t1"}
+			for i, v := range c.vals {
+				agg.Add(latencyCl7f3a("t1", string(rune('A'+i)), v))
+			}
+			if len(agg.Percentiles) != 1 {
+				t.Fatalf("expected 1 percentile, got %d", len(agg.Percentiles))
+			}
+			p := agg.Percentiles[0]
+			if p["min"] != 10 {
+				t.Errorf("merged min: got %v want 10", p["min"])
+			}
+			if p["max"] != 100 {
+				t.Errorf("merged max: got %v want 100", p["max"])
+			}
+		})
+	}
+}
+
+func TestMergedLatencyPercentileOrderCl7f3a(t *testing.T) {
+	agg := &quantile.E2eProcessingLatencyAggregate{Topic: "t1"}
+	low := latencyCl7f3a("t1", "A", 10)
+	low.Percentiles[0]["quantile"] = 0.50
+	agg.Add(low)
+	agg.Add(latencyCl7f3a("t1", "B", 20))
+
+	if len(agg.Percentiles) != 2 {
+		t.Fatalf("expected 2 percentiles, got %d", len(agg.Percentiles))
+	}
+	first := agg.Percentiles[0]["quantile"]
+	second := agg.Percentiles[1]["quantile"]
+	if !(first > second) {
+		t.Errorf("percentiles not highest-first: got %v then %v", first, second)
+	}
+}
