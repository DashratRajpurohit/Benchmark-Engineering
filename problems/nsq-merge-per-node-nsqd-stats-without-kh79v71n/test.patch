+func startAdminDiscoCl7f3a(t *testing.T, nsqdAddrs []string) *NSQAdmin {
+	t.Helper()
+	opts := NewOptions()
+	opts.HTTPAddress = "127.0.0.1:0"
+	opts.NSQDHTTPAddresses = nsqdAddrs
+	opts.Logger = test.NewTestLogger(t)
+	admin, err := New(opts)
+	if err != nil {
+		t.Fatalf("nsqadmin.New: %v", err)
+	}
+	go func() { _ = admin.Main() }()
+	t.Cleanup(admin.Exit)
+
+	deadline := time.Now().Add(10 * time.Second)
+	for time.Now().Before(deadline) {
+		if admin.RealHTTPAddr() != nil {
+			c, err := net.DialTimeout("tcp", admin.RealHTTPAddr().String(), 100*time.Millisecond)
+			if err == nil {
+				_ = c.Close()
+				return admin
+			}
+		}
+		time.Sleep(10 * time.Millisecond)
+	}
+	t.Fatal("nsqadmin never started listening")
+	return nil
+}
