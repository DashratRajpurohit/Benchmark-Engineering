+// TestTopicAPIWholeResponseIsStableAcrossFailureOrderCl7f3a covers a topic
+// stats request where one lookupd reports the owner and two others fail with
+// distinct, fixed errors: the whole response must be the same whichever
+// failing lookupd answers first.
+func TestTopicAPIWholeResponseIsStableAcrossFailureOrderCl7f3a(t *testing.T) {
+	owner := startNSQDFakeCl7f3a(t, &nsqdFakeCl7f3a{hostname: "owner-host",
+		stats: statsBodyCl7f3a(topicCl7f3a, "c1", 5, "")})
+	live := startLookupdFakeCl7f3a(t, []*nsqdFakeCl7f3a{owner})
+	gate := newPhaseGateCl7f3a()
+	failA := startLookupdErrorGatedCl7f3a(t, "ERROR_A", gate, 0)
+	failB := startLookupdErrorGatedCl7f3a(t, "ERROR_B", gate, 1)
+
+	read := func(leader int) string {
+		gate.setLeader(leader)
+		admin := startNSQAdminCl7f3a(t, []string{live, failA, failB}, nil)
+		status, body := getStatusCl7f3a(t, fmt.Sprintf("http://%s/api/topics/%s",
+			admin.RealHTTPAddr(), topicCl7f3a))
+		if status != 200 {
+			t.Fatalf("leader %d: one lookupd reported the owner: got status %d, want 200 (body %s)",
+				leader, status, body)
+		}
+		return string(body)
+	}
+
+	aFirst := read(0)
+	if gate.stalled() {
+		t.Fatal("the answering order could not be fixed, so the result proves nothing")
+	}
+	bFirst := read(1)
+	if gate.stalled() {
+		t.Fatal("the answering order could not be fixed, so the result proves nothing")
+	}
+	if aFirst != bFirst {
+		t.Errorf("the topic response depends on which lookupd failed first:\n  A answered first: %s\n  B answered first: %s",
+			aFirst, bFirst)
+	}
+}
