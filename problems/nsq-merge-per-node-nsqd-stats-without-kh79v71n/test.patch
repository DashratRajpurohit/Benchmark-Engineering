+//go:build clusteragg
+
+package clusterinfo_test
+
+import (
+	"testing"
+
+	"github.com/nsqio/nsq/internal/quantile"
+)
+
+// nodeLatencyWeightedCl7f3a builds one node's aggregate with an explicit sample
+// count.
+func nodeLatencyWeightedCl7f3a(min, max, average, count float64) *quantile.E2eProcessingLatencyAggregate {
+	return &quantile.E2eProcessingLatencyAggregate{
+		Count: int(count),
+		Percentiles: []map[string]float64{
+			{"quantile": 0.99, "value": max, "min": min, "max": max,
+				"average": average, "count": count},
+		},
+		Topic: "t1",
+	}
+}
+
+func TestMergedLatencyAverageIsSampleWeightedCl7f3a(t *testing.T) {
+	agg := &quantile.E2eProcessingLatencyAggregate{Topic: "t1"}
+	agg.Add(nodeLatencyWeightedCl7f3a(2, 10, 6, 1))
+	agg.Add(nodeLatencyWeightedCl7f3a(40, 100, 70, 3))
+
+	if len(agg.Percentiles) != 1 {
+		t.Fatalf("expected 1 percentile, got %d", len(agg.Percentiles))
+	}
+	p := agg.Percentiles[0]
+	if got := p["min"]; got != 2 {
+		t.Errorf("merged min: got %v want 2", got)
+	}
+	if got := p["max"]; got != 100 {
+		t.Errorf("merged max: got %v want 100", got)
+	}
+	if got := p["count"]; got != 4 {
+		t.Errorf("merged sample count: got %v want 4", got)
+	}
+	if got := p["average"]; got != 54 {
+		t.Errorf("merged average: got %v want 54 (38 means the counts were ignored)", got)
+	}
+}
