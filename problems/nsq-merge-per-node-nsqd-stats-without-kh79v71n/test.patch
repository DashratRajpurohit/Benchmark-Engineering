+// statsBodyCl7f3a renders a /stats body for one topic with one channel.
+func statsBodyCl7f3a(topic, channel string, depth int64, clients string) string {
+	latency := `{"count":3,"percentiles":[` +
+		`{"quantile":0.75,"value":400},` +
+		`{"quantile":0.5,"value":100},` +
+		`{"quantile":0.99,"value":900}]}`
+	return fmt.Sprintf(`{"topics":[{"topic_name":%q,"depth":%d,"message_count":%d,`+
+		`"e2e_processing_latency":%s,"channels":[{"channel_name":%q,"depth":%d,`+
+		`"message_count":%d,"client_count":%d,"clients":[%s],"e2e_processing_latency":%s}]}]}`,
+		topic, depth, depth*10, latency, channel, depth, depth*10,
+		strings.Count(clients, "{"), clients, latency)
+}
+
+// clientsSharingIdentityCl7f3a renders consumers that differ only in remote
+// address.
+func clientsSharingIdentityCl7f3a(ports ...int) string {
+	parts := make([]string, 0, len(ports))
+	for _, p := range ports {
+		parts = append(parts, fmt.Sprintf(`{"client_id":"consumer","hostname":"worker",`+
+			`"remote_address":"10.0.0.7:%d","version":"V2","user_agent":"go-nsq/1.1.0"}`, p))
+	}
+	return strings.Join(parts, ",")
+}
+
+func getJSONCl7f3a(t *testing.T, url string) (int, map[string]interface{}) {
+	t.Helper()
+	status, body := getStatusCl7f3a(t, url)
+	var parsed map[string]interface{}
+	if len(body) > 0 {
+		_ = json.Unmarshal(body, &parsed)
+	}
+	return status, parsed
+}
+
+// nodeHostnamesCl7f3a reads the per-node breakdown out of a topic response.
+func nodeHostnamesCl7f3a(t *testing.T, resp map[string]interface{}) []string {
+	t.Helper()
+	nodes, _ := resp["nodes"].([]interface{})
+	out := make([]string, 0, len(nodes))
+	for _, n := range nodes {
+		m, _ := n.(map[string]interface{})
+		host, _ := m["hostname"].(string)
+		node, _ := m["node"].(string)
+		out = append(out, host+"|"+node)
+	}
+	return out
+}
+
+// depthsOfNodesCl7f3a identifies nodes by the depth each one reported.
+func depthsOfNodesCl7f3a(resp map[string]interface{}) []string {
+	nodes, _ := resp["nodes"].([]interface{})
+	out := make([]string, 0, len(nodes))
+	for _, n := range nodes {
+		m, _ := n.(map[string]interface{})
+		depth, _ := m["depth"].(float64)
+		out = append(out, fmt.Sprintf("depth=%v", depth))
+	}
+	return out
+}
+
+func sameSequenceCl7f3a(t *testing.T, what string, first, second []string) {
+	t.Helper()
+	if len(first) != len(second) {
+		t.Fatalf("%s: count changed between calls, %v then %v", what, first, second)
+	}
+	for i := range first {
+		if first[i] != second[i] {
+			t.Fatalf("%s: order changed between calls: %v then %v", what, first, second)
+		}
+	}
+}
+
+const topicCl7f3a = "events"
+
+func TestTopicAPINodeOrderIsStableForSameHostnameCl7f3a(t *testing.T) {
+	gate := newPhaseGateCl7f3a()
+	one := startNSQDFakeCl7f3a(t, &nsqdFakeCl7f3a{hostname: "same-host", id: 0,
+		stats: statsBodyCl7f3a(topicCl7f3a, "c1", 5, ""), gate: gate})
+	two := startNSQDFakeCl7f3a(t, &nsqdFakeCl7f3a{hostname: "same-host", id: 1,
+		stats: statsBodyCl7f3a(topicCl7f3a, "c1", 7, ""), gate: gate})
+	lookupd := startLookupdFakeCl7f3a(t, []*nsqdFakeCl7f3a{one, two})
+	admin := startNSQAdminCl7f3a(t, []string{lookupd}, nil)
+	url := fmt.Sprintf("http://%s/api/topics/%s", admin.RealHTTPAddr(), topicCl7f3a)
+
+	ask := func(leader int) []string {
+		gate.setLeader(leader)
+		status, resp := getJSONCl7f3a(t, url)
+		if status != 200 {
+			t.Fatalf("topic request failed with status %d", status)
+		}
+		return depthsOfNodesCl7f3a(resp)
+	}
+
+	first, second := ask(0), ask(1)
+	t.Logf("node one answered first -> %v ; node two answered first -> %v", first, second)
+	if gate.stalled() {
+		t.Fatal("the answering order could not be fixed, so the result proves nothing")
+	}
+	if len(first) != 2 {
+		t.Fatalf("expected 2 nodes sharing a hostname, got %v", first)
+	}
+	sameSequenceCl7f3a(t, "topic nodes sharing a hostname via nsqlookupd", first, second)
+}
