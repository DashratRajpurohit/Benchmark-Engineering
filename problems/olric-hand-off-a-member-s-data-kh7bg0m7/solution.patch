+// Leave asks the cluster coordinator to stop assigning partitions to a member
+// because it is leaving the cluster. MemberID tells this run of the member apart
+// from a later one that has the same name.
+type Leave struct {
+	Name     string
+	MemberID uint64
+}
+
+func NewLeave(name string, memberID uint64) *Leave {
+	return &Leave{
+		Name:     name,
+		MemberID: memberID,
+	}
+}
+
+func (l *Leave) Command(ctx context.Context) *redis.StatusCmd {
+	var args []interface{}
+	args = append(args, Internal.Leave)
+	args = append(args, l.Name)
+	args = append(args, l.MemberID)
+	return redis.NewStatusCmd(ctx, args...)
+}
+
+func ParseLeaveCommand(cmd redcon.Command) (*Leave, error) {
+	if len(cmd.Args) < 3 {
+		return nil, errWrongNumber(cmd.Args)
+	}
+	memberID, err := strconv.ParseUint(util.BytesToString(cmd.Args[2]), 10, 64)
+	if err != nil {
+		return nil, err
+	}
+
+	return NewLeave(util.BytesToString(cmd.Args[1]), memberID), nil
+}
+
