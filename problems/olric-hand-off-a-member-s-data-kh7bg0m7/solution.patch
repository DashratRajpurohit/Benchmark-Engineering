+// limitations under the License.
+
+package routingtable
+
+import (
+	"context"
+	"errors"
+	"time"
+
+	"github.com/olric-data/olric/internal/protocol"
+	"github.com/redis/go-redis/v9"
+	"github.com/tidwall/redcon"
+)
+
+var (
+	// ErrNotCoordinator is returned when a request that only the cluster coordinator
+	// can serve reaches another member.
+	ErrNotCoordinator = errors.New("this member is not the cluster coordinator")
+
+	// ErrLastMember is returned when a member asks to leave, but no other member is
+	// left to take over its partitions.
+	ErrLastMember = errors.New("no other member can take over the partitions")
+)
+
+func (r *RoutingTable) markLeaving(name string, memberID uint64) error {
+	r.leavingMtx.Lock()
+	defer r.leavingMtx.Unlock()
+
+	// The hash ring must never be empty, someone has to own the partitions.
+	var taker bool
+	for _, member := range r.consistent.GetMembers() {
+		if member.String() != name {
+			taker = true
+			break
+		}
+	}
+	if !taker {
+		return ErrLastMember
+	}
+
+	r.leaving[memberID] = struct{}{}
+	r.consistent.Remove(name)
+	return nil
+}
+
+// forgetLeaving drops the leaving mark of a member that is gone, so a member that
+// restarts with the same name gets partitions again.
+func (r *RoutingTable) forgetLeaving(memberID uint64) {
+	r.leavingMtx.Lock()
+	defer r.leavingMtx.Unlock()
+
+	delete(r.leaving, memberID)
+}
+
+// unmarkLeaving puts a member that is still in the cluster back into the
+// partition distribution.
+func (r *RoutingTable) unmarkLeaving(memberID uint64) {
+	r.forgetLeaving(memberID)
+
+	r.Members().RLock()
+	defer r.Members().RUnlock()
+
+	member, err := r.Members().Get(memberID)
+	if err != nil {
+		// The member is already gone.
+		return
+	}
+	r.consistent.Add(member)
+}
+
+// keepLeavingMembers puts the leaving members back into the hash ring, after all
+// the other members are gone. The caller must hold the lock of the members list.
+func (r *RoutingTable) keepLeavingMembers() {
+	r.leavingMtx.Lock()
+	defer r.leavingMtx.Unlock()
+
+	for memberID := range r.leaving {
+		if member, err := r.Members().Get(memberID); err == nil {
+			r.consistent.Add(member)
+		}
+		delete(r.leaving, memberID)
+	}
+}
+
+func (r *RoutingTable) isLeaving(memberID uint64) bool {
+	r.leavingMtx.Lock()
+	defer r.leavingMtx.Unlock()
+
+	_, ok := r.leaving[memberID]
+	return ok
+}
+
+func (r *RoutingTable) leaveCommandHandler(conn redcon.Conn, cmd redcon.Command) {
+	// The command handlers of the routing table service should wait for the cluster join event.
+	<-r.joined
+
+	leaveCmd, err := protocol.ParseLeaveCommand(cmd)
+	if err != nil {
+		protocol.WriteError(conn, err)
+		return
+	}
+
+	if !r.discovery.IsCoordinator() {
+		protocol.WriteError(conn, ErrNotCoordinator)
+		return
+	}
+
+	if err := r.markLeaving(leaveCmd.Name, leaveCmd.MemberID); err != nil {
+		protocol.WriteError(conn, err)
+		return
+	}
+	r.log.V(2).Printf("[INFO] %s is leaving the cluster", leaveCmd.Name)
+	r.updateRouting()
+	conn.WriteString(protocol.StatusOK)
+}
+
+func (r *RoutingTable) cancelLeaveCommandHandler(conn redcon.Conn, cmd redcon.Command) {
+	// The command handlers of the routing table service should wait for the cluster join event.
+	<-r.joined
+
+	cancelLeaveCmd, err := protocol.ParseCancelLeaveCommand(cmd)
+	if err != nil {
+		protocol.WriteError(conn, err)
+		return
+	}
+
+	if !r.discovery.IsCoordinator() {
+		protocol.WriteError(conn, ErrNotCoordinator)
+		return
+	}
+
+	r.log.V(2).Printf("[INFO] Member %d stays in the cluster", cancelLeaveCmd.MemberID)
+	r.unmarkLeaving(cancelLeaveCmd.MemberID)
+	r.updateRouting()
+	conn.WriteString(protocol.StatusOK)
+}
+
+// onCoordinator runs local if this member is the cluster coordinator. Otherwise,
+// it sends the command that newCmd builds to the coordinator. The coordinator may
+// be leaving at the same time, so it is looked up again at each attempt.
+func (r *RoutingTable) onCoordinator(ctx context.Context, local func() error, newCmd func() *redis.StatusCmd) error {
+	for {
+		if err := ctx.Err(); err != nil {
+			return err
+		}
+
+		err := r.tryOnCoordinator(ctx, local, newCmd)
+		if err == nil || errors.Is(err, ErrLastMember) {
+			return err
+		}
+		r.log.V(3).Printf("[DEBUG] Failed to reach the cluster coordinator: %v", err)
+
+		select {
+		case <-ctx.Done():
+		case <-time.After(100 * time.Millisecond):
+		}
+	}
+}
+
+func (r *RoutingTable) tryOnCoordinator(ctx context.Context, local func() error, newCmd func() *redis.StatusCmd) error {
+	if r.discovery.IsCoordinator() {
+		return local()
+	}
+
+	// Wait for the command sent before, also if its caller stopped waiting for
+	// the reply, so the coordinator can't get a Leave after the CancelLeave that
+	// follows it.
+	select {
+	case r.leaveCmds <- struct{}{}:
+	case <-ctx.Done():
+		return ctx.Err()
+	}
+
+	// The client keeps reading the reply until its own read timeout, even when
+	// ctx is done, so the command runs in its own goroutine.
+	errCh := make(chan error, 1)
+	go func() {
+		defer func() { <-r.leaveCmds }()
+
+		cmd := newCmd()
+		rc := r.client.Get(r.discovery.GetCoordinator().String())
+		if err := rc.Process(ctx, cmd); err != nil {
+			errCh <- protocol.ConvertError(err)
+			return
+		}
+		errCh <- protocol.ConvertError(cmd.Err())
+	}()
+
+	select {
+	case err := <-errCh:
+		return err
+	case <-ctx.Done():
+		return ctx.Err()
+	}
+}
+
+// updateRoutingContext works like updateRouting, but it returns the error of ctx
+// if ctx is done first. The update goes on then. It computes the routing table
+// from the members when it runs, so it can't bring back a state that a later
+// change replaced.
+func (r *RoutingTable) updateRoutingContext(ctx context.Context) error {
+	done := make(chan struct{})
+	r.wg.Add(1)
+	go func() {
+		defer r.wg.Done()
+		defer close(done)
+
+		r.updateRouting()
+	}()
+
+	select {
+	case <-done:
+		return nil
+	case <-ctx.Done():
+		return ctx.Err()
+	}
+}
+
+// Leave takes this member out of the partition distribution. The coordinator
+// assigns its partitions to the other members and pushes the new routing table,
+// so the balancer can hand the data off before the member stops. It returns
+// ErrLastMember if no other member can take over the partitions.
+func (r *RoutingTable) Leave(ctx context.Context) error {
+	return r.onCoordinator(ctx, func() error {
+		if err := r.markLeaving(r.this.Name, r.this.ID); err != nil {
+			return err
+		}
+		return r.updateRoutingContext(ctx)
+	}, func() *redis.StatusCmd {
+		return protocol.NewLeave(r.this.Name, r.this.ID).Command(ctx)
+	})
+}
+
+// CancelLeave puts this member back into the partition distribution after Leave,
+// so it keeps serving the data it couldn't hand off.
+func (r *RoutingTable) CancelLeave(ctx context.Context) error {
+	return r.onCoordinator(ctx, func() error {
+		r.unmarkLeaving(r.this.ID)
+		return r.updateRoutingContext(ctx)
+	}, func() *redis.StatusCmd {
+		return protocol.NewCancelLeave(r.this.ID).Command(ctx)
+	})
+}
