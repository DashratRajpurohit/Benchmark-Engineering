+// onOwner runs an operation that reads a key and writes it back on the owner of
+// the partition of the key: local when this member is the owner, remote on the
+// owner otherwise. When the partition is given to another member while the
+// operation runs, it fails with errPartitionMoved and the whole operation runs
+// again on the new owner. Sending only the value it has already computed there
+// would overwrite the changes the new owner has made in the meantime.
+func (dm *DMap) onOwner(key string, local func() error, remote func(owner discovery.Member) error) error {
+	hkey := partitions.HKey(dm.name, key)
+	for {
+		owner := dm.s.primary.PartitionByHKey(hkey).Owner()
+		var err error
+		if owner.CompareByName(dm.s.rt.This()) {
+			err = local()
+		} else {
+			err = remote(owner)
+		}
+		if !errors.Is(err, errPartitionMoved) {
+			return err
+		}
+	}
+}
+
+// getForUpdate reads the key for an operation that writes it back afterwards.
+// It runs on the partition owner, and fails with errPartitionMoved if this
+// member doesn't own the partition anymore.
+func (dm *DMap) getForUpdate(e *env) (storage.Entry, error) {
+	e.hkey = partitions.HKey(e.dmap, e.key)
+	this := dm.s.rt.This()
+	if !dm.s.primary.PartitionByHKey(e.hkey).Owner().CompareByName(this) {
+		return nil, errPartitionMoved
+	}
+	// The value is computed from what is read now, so the entry gets a newer
+	// timestamp than the one read.
+	e.timestamp = time.Now().UnixNano()
+	return dm.getOnOwner(e.ctx, e.hkey, e.key, this)
+}
+
+// putForUpdate writes the value that an operation computed from what
+// getForUpdate read. It writes on this member only, and fails with
