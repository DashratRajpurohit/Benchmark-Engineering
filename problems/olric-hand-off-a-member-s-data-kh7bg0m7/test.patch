+#!/usr/bin/env bash
+# Usage:
+#   ./test.sh [--output_path <junit.xml>] <base|new>
+#
+# base  runs the existing tests of every package, one package at a time like
+#       `make test` does, because the cluster tests bind local ports. It
+#       leaves out the tests that need a non-loopback network interface, the
+#       timing sensitive integration tests, the timing sensitive tests of
+#       unexported cluster client helpers, and two checks whose result depends
+#       on how fast other cluster members start or stop under load.
+# new   runs the cluster membership tests in graceful_leave_ea098b_test.go,
+#       which are compiled only with -tags gracefulleave.
+set -uo pipefail
+
+ORIG_PWD="$(pwd)"
+
+OUTPUT_PATH=""
+if [ "${1:-}" = "--output_path" ]; then
+  OUTPUT_PATH="$2"
+  shift 2
+  case "$OUTPUT_PATH" in
+    /*) : ;;
+    *) OUTPUT_PATH="$ORIG_PWD/$OUTPUT_PATH" ;;
+  esac
+fi
+
+MODE="${1:-new}"
+
+[ -f go.mod ] || cd "$(dirname "$0")"
+
+TEST_LOG="$(mktemp)"
+STATUS=0
+
+run_tests() {
+  go test -count=1 -v "$@" 2>&1 | tee -a "$TEST_LOG"
+  status=${PIPESTATUS[0]}
+  if [ "$status" -ne 0 ]; then
+    STATUS=$status
+  fi
+}
+
+case "$MODE" in
+  base)
+    # Package paths have no spaces, so splitting the list on words is safe.
+    internal_pkgs="$(go list ./internal/... | grep -v '/internal/cluster/routingtable$')"
+    # shellcheck disable=SC2086
+    run_tests -p 1 -timeout 1800s ./events/... $internal_pkgs ./pkg/... ./stats/...
+    run_tests -timeout 600s -run '^Test(Members_|RoutingTable_([a-z]|[A-KM-Z]))' ./internal/cluster/routingtable
+    run_tests -timeout 600s -run '^Test(Config(_DMap|_Initialize)?|Engine_.*)$' ./config
+    run_tests -timeout 1800s -run '^Test(EmbeddedClient_[A-HJ-Z]|ClusterClient_[A-Z]|DMap|Olric|PubSub|Stats|AuthCommandHandler|Future)' .
+    ;;
+  new)
+    run_tests -timeout 600s -tags gracefulleave -run 'GracefulLeave' .
+    ;;
+  *)
+    echo "unknown mode: $MODE (expected base or new)" >&2
+    exit 2
+    ;;
+esac
+
+if [ -n "$OUTPUT_PATH" ]; then
+  go-junit-report -set-exit-code < "$TEST_LOG" > "$OUTPUT_PATH"
+  junit_status=$?
+  if [ "$junit_status" -ne 0 ] && [ "$STATUS" -eq 0 ]; then
+    echo "go-junit-report failed to convert the test log (exit $junit_status)" >&2
+    STATUS=$junit_status
+  fi
+fi
+
+exit "$STATUS"
