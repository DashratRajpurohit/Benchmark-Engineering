+// TestGitIndexIncrementalSkipDoesNotDropUnchangedSibling covers a
+// consequence of merging inputs under a shared name that only shows up
+// with -incremental: a repository whose content hasn't changed between
+// runs would, on its own, decide to skip reindexing entirely. If that
+// were still allowed for a name shared with another, changed repository,
+// the changed repository's Finish would replace all of the shared name's
+// shards, permanently losing the skipped repository's content, which was
+// never re-added because it decided there was nothing to do.
+func TestGitIndexIncrementalSkipDoesNotDropUnchangedSibling(t *testing.T) {
+	root := t.TempDir()
+	staticDir := filepath.Join(root, "static")
+	initGitRepoEe2808(t, staticDir, "static.txt", "staticneedle\n")
+
+	indexDir := t.TempDir()
+	metaFile := filepath.Join(indexDir, "repo.meta")
+	if err := os.WriteFile(metaFile, []byte(`{"Name":"incremental-shared"}`), 0o644); err != nil {
+		t.Fatal(err)
+	}
+
+	// Index only staticDir first, so the shard's recorded state reflects
+	// staticDir specifically, and a later incremental run against
+	// staticDir alone would decide to skip it.
+	if out, err := runZoektGitIndexEe2808(t, "-index", indexDir, "-disable_ctags", "-meta", metaFile, staticDir); err != nil {
+		t.Fatalf("zoekt-git-index (first run): %v\noutput:\n%s", err, out)
+	}
+	if got := searchNamesEe2808(t, indexDir, "staticneedle"); len(got) != 1 {
+		t.Fatalf("staticneedle should be searchable after the first run, got matches: %v", got)
+	}
+
+	changingDir := filepath.Join(root, "changing")
+	initGitRepoEe2808(t, changingDir, "changing.txt", "changingneedle\n")
+
+	out, err := runZoektGitIndexEe2808(t, "-index", indexDir, "-disable_ctags", "-meta", metaFile, staticDir, changingDir)
+	if err != nil {
+		t.Fatalf("zoekt-git-index (second run): %v\noutput:\n%s", err, out)
+	}
+
+	if got := searchNamesEe2808(t, indexDir, "staticneedle"); len(got) != 1 {
+		t.Errorf("staticneedle should still be searchable after reindexing its unchanged sibling under a shared name, got matches: %v", got)
+	}
+	if got := searchNamesEe2808(t, indexDir, "changingneedle"); len(got) != 1 {
+		t.Errorf("changingneedle should be searchable after being added under the shared name, got matches: %v", got)
+	}
+}
