+// TestGitIndexRepoWithSubmoduleMergesWithPlainSibling covers the group's
+// interaction with submodule metadata: when a repository with its own
+// submodule is merged under a shared name with a sibling repository,
+// reusing the builder created for whichever repository came first must
+// still end up with the submodule known to it, regardless of which of the
+// two repositories that turns out to be - otherwise the submodule's
+// documents would be rejected as referring to an unknown subrepo path
+// when the builder wasn't the one that originally discovered it.
+//
+// This deliberately merges a submoduled repository with a *plain* sibling
+// (no submodule of its own), rather than with a second, independently
+// submoduled repository: two repositories that each have any submodule
+// both have a .gitmodules file at their root, which is a genuine
+// duplicate-path conflict under the group's own duplicate-path policy,
+// not a submodule-metadata bug - that combination is correctly rejected
+// before it could reach this code at all.
+func TestGitIndexRepoWithSubmoduleMergesWithPlainSibling(t *testing.T) {
+	root := t.TempDir()
+	superADir := filepath.Join(root, "superA")
+	plainDir := filepath.Join(root, "plain")
+	createSubmoduleSuperRepoEe2808(t, superADir, "supera.txt", "supera-content\n", "asub-mount", "asub.txt", "asub-content\n")
+	initGitRepoEe2808(t, plainDir, "plain.txt", "plain-content\n")
+
+	indexDir := t.TempDir()
+	metaFile := filepath.Join(indexDir, "repo.meta")
+	if err := os.WriteFile(metaFile, []byte(`{"Name":"submodule-shared"}`), 0o644); err != nil {
+		t.Fatal(err)
+	}
+
+	out, err := runZoektGitIndexEe2808(t, "-index", indexDir, "-disable_ctags", "-meta", metaFile, superADir, plainDir)
+	if err != nil {
+		t.Fatalf("zoekt-git-index: %v\noutput:\n%s", err, out)
+	}
+
+	for _, needle := range []string{"supera-content", "asub-content", "plain-content"} {
+		if got := searchNamesEe2808(t, indexDir, needle); len(got) != 1 {
+			t.Errorf("%s should be searchable, got matches: %v", needle, got)
+		}
+	}
+}
