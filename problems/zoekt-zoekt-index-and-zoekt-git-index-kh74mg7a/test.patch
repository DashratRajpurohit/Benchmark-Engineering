+func TestGitIndexDistinctReposWithoutMetaGetOwnNames(t *testing.T) {
+	root := t.TempDir()
+	alphaDir := filepath.Join(root, "alpha-repo")
+	betaDir := filepath.Join(root, "beta-repo")
+	initGitRepoEe2808(t, alphaDir, "alpha.txt", "alphaneedle\n")
+	initGitRepoEe2808(t, betaDir, "beta.txt", "betaneedle\n")
+
+	indexDir := t.TempDir()
+	out, err := runZoektGitIndexEe2808(t, "-index", indexDir, "-disable_ctags", alphaDir, betaDir)
+	if err != nil {
+		t.Fatalf("zoekt-git-index: %v\noutput:\n%s", err, out)
+	}
+
+	if got := searchNamesEe2808(t, indexDir, "alphaneedle"); len(got) != 1 {
+		t.Errorf("alpha.txt should be searchable under its own repository name, got matches: %v", got)
+	}
+	if got := searchNamesEe2808(t, indexDir, "betaneedle"); len(got) != 1 {
+		t.Errorf("beta.txt should be searchable under its own repository name, got matches: %v", got)
+	}
+
+	// Being findable at all is not enough: each repository's content must
+	// be indexed under that repository's OWN name. Folding both
+	// repositories into whichever name happened to be derived first would
+	// still leave every needle searchable, so only checking the repository
+	// each match belongs to actually distinguishes the two.
+	if got := searchRepoNamesEe2808(t, indexDir, "alphaneedle"); len(got) != 1 || got[0] != "alpha-repo" {
+		t.Errorf("alphaneedle should be indexed under repository %q, got repositories: %v", "alpha-repo", got)
+	}
+	if got := searchRepoNamesEe2808(t, indexDir, "betaneedle"); len(got) != 1 || got[0] != "beta-repo" {
+		t.Errorf("betaneedle should be indexed under repository %q, got repositories: %v", "beta-repo", got)
+	}
+}
