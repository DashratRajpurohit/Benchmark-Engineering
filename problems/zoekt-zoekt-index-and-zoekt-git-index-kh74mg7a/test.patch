+// TestIndexArgDuplicatePathAcrossMergedDirectoriesRejected covers the
+// duplicate relative-path policy: when two directories merged under one
+// repository name both produce a document at the same relative path, the
+// whole group is rejected rather than silently keeping one version of the
+// file and dropping the other, or silently indexing both under the same
+// path.
+func TestIndexArgDuplicatePathAcrossMergedDirectoriesRejected(t *testing.T) {
+	// The collision is exercised at a root path and at a nested one, so a
+	// fix cannot special-case a single well-known filename.
+	for _, collidingPath := range []string{"shared.txt", "nested/collision.go"} {
+		t.Run(collidingPath, func(t *testing.T) {
+			indexDir := t.TempDir()
+			metaFile := filepath.Join(indexDir, "repo.meta")
+			if err := os.WriteFile(metaFile, []byte(`{"Name":"dup-repo","Branches":[{"Name":"main","Version":"0123456789abcdef0123456789abcdef01234567"}]}`), 0o644); err != nil {
+				t.Fatal(err)
+			}
+
+			firstDir := t.TempDir()
+			secondDir := t.TempDir()
+			for dir, content := range map[string]string{firstDir: "firstcontent\n", secondDir: "secondcontent\n"} {
+				full := filepath.Join(dir, filepath.FromSlash(collidingPath))
+				if err := os.MkdirAll(filepath.Dir(full), 0o755); err != nil {
+					t.Fatal(err)
+				}
+				if err := os.WriteFile(full, []byte(content), 0o644); err != nil {
+					t.Fatal(err)
+				}
+			}
+
+			out, err := runZoektIndexAllowError09e2ba(t, "-index", indexDir, "-disable_ctags", "-meta", metaFile, firstDir, secondDir)
+			if err == nil {
+				t.Fatalf("expected zoekt-index to fail when two merged directories both write %s, output:\n%s", collidingPath, out)
+			}
+
+			for _, needle := range []string{"firstcontent", "secondcontent"} {
+				if got := searchNames09e2ba(t, indexDir, needle); len(got) != 0 {
+					t.Errorf("%s should not be searchable: the whole group was rejected on the duplicate path, got matches: %v", needle, got)
+				}
+			}
+
+			// Control: remove the collision and change nothing else. The
+			// same invocation must now succeed and publish both inputs,
+			// which ties the rejection above to the duplicate relative
+			// path itself rather than to any incidental failure, without
+			// constraining how it is reported.
+			renamed := filepath.Join(secondDir, filepath.FromSlash(path.Dir(collidingPath)), "distinct"+path.Ext(collidingPath))
+			if err := os.Rename(filepath.Join(secondDir, filepath.FromSlash(collidingPath)), renamed); err != nil {
+				t.Fatal(err)
+			}
+			controlOut, err := runZoektIndexAllowError09e2ba(t, "-index", indexDir, "-disable_ctags", "-meta", metaFile, firstDir, secondDir)
+			if err != nil {
+				t.Fatalf("once the duplicate path is gone the same invocation must succeed, got %v, output:\n%s", err, controlOut)
+			}
+			for _, needle := range []string{"firstcontent", "secondcontent"} {
+				if got := searchNames09e2ba(t, indexDir, needle); len(got) == 0 {
+					t.Errorf("%s should be searchable after the collision was removed, output:\n%s", needle, controlOut)
+				}
+			}
+		})
+	}
+}
