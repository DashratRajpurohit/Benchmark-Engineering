+// TestGitIndexUnrelatedNameStillFinishesWhenSharedGroupFails covers the
+// blast radius of a partial failure: when one name's inputs fail and that
+// whole name is rolled back, an unrelated name indexed in the same
+// invocation must still be finished and published, rather than being
+// dragged down with it.
+func TestGitIndexUnrelatedNameStillFinishesWhenSharedGroupFails(t *testing.T) {
+	root := t.TempDir()
+
+	// Two inputs whose derived names both come out as "dup": one real,
+	// and one that doesn't exist, so that name's group fails partway.
+	dupOK := filepath.Join(root, "a", "dup")
+	initGitRepoEe2808(t, dupOK, "dup.txt", "dupneedle\n")
+	dupMissing := filepath.Join(root, "b", "dup")
+
+	// A third input whose name collides with nothing, which must survive
+	// the failure above untouched.
+	soloDir := filepath.Join(root, "solo")
+	initGitRepoEe2808(t, soloDir, "solo.txt", "soloneedle\n")
+
+	indexDir := t.TempDir()
+	out, err := runZoektGitIndexEe2808(t, "-index", indexDir, "-disable_ctags", dupOK, dupMissing, soloDir)
+	if err == nil {
+		t.Fatalf("expected zoekt-git-index to report the missing repository, output:\n%s", out)
+	}
+
+	if got := searchNamesEe2808(t, indexDir, "dupneedle"); len(got) != 0 {
+		t.Errorf("dupneedle should NOT be published: its name had a failing sibling input, got matches: %v", got)
+	}
+	if got := searchNamesEe2808(t, indexDir, "soloneedle"); len(got) != 1 {
+		t.Errorf("soloneedle should still be indexed: an unrelated name in the same invocation must still finish, got matches: %v", got)
+	}
+	if got := searchRepoNamesEe2808(t, indexDir, "soloneedle"); len(got) != 1 || got[0] != "solo" {
+		t.Errorf("soloneedle should be indexed under repository %q, got repositories: %v", "solo", got)
+	}
+}
+
+// TestGitIndexPartialFailureLeavesOldSharedShardIntact covers the group's
+// partial-failure/error-cleanup semantics for zoekt-git-index: if one of
+// several repositories sharing a name fails partway through (here, because
+// it doesn't exist), none of that name's repositories from the current
+// invocation should end up published, and whatever previously existed
+// under that name from an earlier successful run must be left completely
+// untouched.
+func TestGitIndexPartialFailureLeavesOldSharedShardIntact(t *testing.T) {
+	root := t.TempDir()
+	origDir := filepath.Join(root, "orig")
+	initGitRepoEe2808(t, origDir, "orig.txt", "origneedle\n")
+
+	indexDir := t.TempDir()
+	metaFile := filepath.Join(indexDir, "repo.meta")
+	if err := os.WriteFile(metaFile, []byte(`{"Name":"mixed-git-repo"}`), 0o644); err != nil {
+		t.Fatal(err)
+	}
+
+	if out, err := runZoektGitIndexEe2808(t, "-index", indexDir, "-disable_ctags", "-meta", metaFile, origDir); err != nil {
+		t.Fatalf("zoekt-git-index (first run): %v\noutput:\n%s", err, out)
+	}
+	if got := searchNamesEe2808(t, indexDir, "origneedle"); len(got) != 1 {
+		t.Fatalf("origneedle should be searchable after the first run, got matches: %v", got)
+	}
+
+	before := shardSnapshotEe2808(t, indexDir)
+
+	newDir := filepath.Join(root, "new")
+	initGitRepoEe2808(t, newDir, "new.txt", "newneedle\n")
+	missingDir := filepath.Join(root, "does-not-exist")
+
+	out, err := runZoektGitIndexEe2808(t, "-index", indexDir, "-disable_ctags", "-meta", metaFile, newDir, missingDir)
+	if err == nil {
+		t.Fatalf("expected zoekt-git-index to fail when one of the merged repositories doesn't exist, output:\n%s", out)
+	}
+
+	if got := searchNamesEe2808(t, indexDir, "origneedle"); len(got) != 1 {
+		t.Errorf("origneedle should still be searchable after the failed second run (old shard must be untouched), got matches: %v", got)
+	}
+	if got := searchNamesEe2808(t, indexDir, "newneedle"); len(got) != 0 {
+		t.Errorf("newneedle should NOT be searchable: the whole name-group must not be published when a sibling input failed, got matches: %v", got)
+	}
+	if after := shardSnapshotEe2808(t, indexDir); !reflect.DeepEqual(before, after) {
+		t.Errorf("the shards published by the earlier successful run must be left completely untouched by the failed run: before %v, after %v", before, after)
+	}
+}
