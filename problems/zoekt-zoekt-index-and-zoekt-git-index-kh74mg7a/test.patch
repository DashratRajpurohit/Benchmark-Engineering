+
+	out, err := runZoektIndexAllowError09e2ba(t, "-index", indexDir, "-disable_ctags", "-meta", metaFile, firstDir, secondDir)
+	if err == nil {
+		t.Fatalf("two merged directories both writing shared.txt must be an explicit conflict for that name even when the two files hold identical bytes, output:\n%s", out)
+	}
+	if got := searchNames09e2ba(t, indexDir, "identicalcollisionneedle"); len(got) != 0 {
+		t.Errorf("a name group rejected on a duplicate relative path must publish none of its inputs, got matches: %v\noutput:\n%s", got, out)
+	}
+}
+
+// TestIndexArgRepeatedPositionalInputWithSiblingLosesNothing is the
+// zoekt-index mirror of the git command's repeated-input case: one
+// directory listed twice alongside a second directory resolving to the
+// same name. Each positional argument is its own input, so the repeated
+// occurrence writes the same relative paths under the name a second time
+// and must be an explicit conflict for it, not a silent collapse.
+func TestIndexArgRepeatedPositionalInputWithSiblingLosesNothing(t *testing.T) {
+	root := t.TempDir()
+	repeatedDir := filepath.Join(root, "a", "shared")
+	siblingDir := filepath.Join(root, "b", "shared")
+	for dir, content := range map[string]string{repeatedDir: "repeatalphaneedle\n", siblingDir: "repeatbetaneedle\n"} {
+		if err := os.MkdirAll(dir, 0o755); err != nil {
+			t.Fatal(err)
+		}
+		name := "alpha.txt"
+		if dir == siblingDir {
+			name = "beta.txt"
+		}
+		if err := os.WriteFile(filepath.Join(dir, name), []byte(content), 0o644); err != nil {
+			t.Fatal(err)
+		}
+	}
+
+	indexDir := t.TempDir()
+	out, err := runZoektIndexAllowError09e2ba(t, "-index", indexDir, "-disable_ctags", repeatedDir, repeatedDir, siblingDir)
+
+	alpha := len(searchNames09e2ba(t, indexDir, "repeatalphaneedle"))
+	beta := len(searchNames09e2ba(t, indexDir, "repeatbetaneedle"))
+
+	if err == nil {
+		t.Fatalf("listing the same input twice writes every one of its relative paths under the name a second time, which must be reported as an explicit conflict rather than silently collapsed, output:\n%s", out)
+	}
+	if alpha != 0 || beta != 0 {
+		t.Errorf("a name group rejected on a duplicate relative path must publish none of its inputs, got repeatalphaneedle=%d repeatbetaneedle=%d\noutput:\n%s", alpha, beta, out)
+	}
+}
