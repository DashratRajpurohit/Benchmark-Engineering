+// TestGitIndexDuplicatePathAcrossMergedReposRejected covers the group's
+// duplicate relative-path policy for zoekt-git-index: if two repositories
+// merged under the same name both produce a file at the same relative
+// path, that must be an explicit, reported conflict, not a silent pick of
+// one side.
+func TestGitIndexDuplicatePathAcrossMergedReposRejected(t *testing.T) {
+	// The collision is exercised at a root path and at a nested one, so a
+	// fix cannot special-case a single well-known filename.
+	for _, collidingPath := range []string{"shared.txt", "nested/collision.go"} {
+		t.Run(collidingPath, func(t *testing.T) {
+			root := t.TempDir()
+			oneDir := filepath.Join(root, "one")
+			twoDir := filepath.Join(root, "two")
+			initGitRepoAtPathEe2808(t, oneDir, collidingPath, "firstcontent\n")
+			initGitRepoAtPathEe2808(t, twoDir, collidingPath, "secondcontent\n")
+
+			indexDir := t.TempDir()
+			metaFile := filepath.Join(indexDir, "repo.meta")
+			if err := os.WriteFile(metaFile, []byte(`{"Name":"dup-path-shared"}`), 0o644); err != nil {
+				t.Fatal(err)
+			}
+
+			out, err := runZoektGitIndexEe2808(t, "-index", indexDir, "-disable_ctags", "-meta", metaFile, oneDir, twoDir)
+			if err == nil {
+				t.Fatalf("expected zoekt-git-index to reject two merged repositories both writing %s, output:\n%s", collidingPath, out)
+			}
+
+			for _, needle := range []string{"firstcontent", "secondcontent"} {
+				if got := searchNamesEe2808(t, indexDir, needle); len(got) != 0 {
+					t.Errorf("%s should NOT be searchable: a duplicate path across merged inputs must reject the whole group, got matches: %v", needle, got)
+				}
+			}
+
+			// Control: the same merge with no colliding relative path must
+			// succeed and publish both inputs. This ties the rejection
+			// above to the duplicate relative path itself rather than to
+			// any incidental failure, without constraining how the
+			// conflict is reported.
+			threeDir := filepath.Join(root, "three")
+			initGitRepoAtPathEe2808(t, threeDir, path.Join(path.Dir(collidingPath), "distinct"+path.Ext(collidingPath)), "secondcontent\n")
+			controlOut, err := runZoektGitIndexEe2808(t, "-index", indexDir, "-disable_ctags", "-meta", metaFile, oneDir, threeDir)
+			if err != nil {
+				t.Fatalf("once the duplicate path is gone the same merge must succeed, got %v, output:\n%s", err, controlOut)
+			}
+			for _, needle := range []string{"firstcontent", "secondcontent"} {
+				if got := searchNamesEe2808(t, indexDir, needle); len(got) == 0 {
+					t.Errorf("%s should be searchable after the collision was removed, output:\n%s", needle, controlOut)
+				}
+			}
+		})
+	}
+}
