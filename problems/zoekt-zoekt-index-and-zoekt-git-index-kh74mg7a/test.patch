+// TestIndexArgPartialFailureLeavesOldShardIntact covers the partial-failure
+// policy for a shared-name group: if one of several directories merged
+// under one repository name fails (here, because it does not exist), the
+// whole group must not be finished with only a partial result, and any
+// shard that already existed for that name from an earlier, successful
+// run must be left completely untouched rather than replaced by a
+// half-indexed one.
+func TestIndexArgPartialFailureLeavesOldShardIntact(t *testing.T) {
+	indexDir := t.TempDir()
+	metaFile := filepath.Join(indexDir, "repo.meta")
+	if err := os.WriteFile(metaFile, []byte(`{"Name":"mixed-repo","Branches":[{"Name":"main","Version":"0123456789abcdef0123456789abcdef01234567"}]}`), 0o644); err != nil {
+		t.Fatal(err)
+	}
+
+	// First, a normal successful run establishes a real shard for
+	// "mixed-repo".
+	originalDir := t.TempDir()
+	if err := os.WriteFile(filepath.Join(originalDir, "original.txt"), []byte("originalneedle\n"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	runZoektIndex09e2ba(t, "-index", indexDir, "-disable_ctags", "-meta", metaFile, originalDir)
+	if got := searchNames09e2ba(t, indexDir, "originalneedle"); len(got) != 1 {
+		t.Fatalf("original.txt should be searchable after the first run, got matches: %v", got)
+	}
+
+	// Now re-index "mixed-repo" from two directories, one of which does not
+	// exist: this should fail, and the fact that the OTHER directory in
+	// the same invocation indexed successfully before the failure must not
+	// cause a partial replacement of the existing shard.
+	before := shardSnapshot09e2ba(t, indexDir)
+
+	newDir := t.TempDir()
+	if err := os.WriteFile(filepath.Join(newDir, "new.txt"), []byte("newneedle\n"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	missingDir := filepath.Join(t.TempDir(), "does-not-exist")
+
+	out, err := runZoektIndexAllowError09e2ba(t, "-index", indexDir, "-disable_ctags", "-meta", metaFile, newDir, missingDir)
+	if err == nil {
+		t.Fatalf("expected zoekt-index to fail when one of the merged directories does not exist, output:\n%s", out)
+	}
+
+	if got := searchNames09e2ba(t, indexDir, "originalneedle"); len(got) != 1 {
+		t.Errorf("original.txt from the earlier successful run should still be searchable after the failed re-index, got matches: %v", got)
+	}
+	if got := searchNames09e2ba(t, indexDir, "newneedle"); len(got) != 0 {
+		t.Errorf("new.txt should NOT be searchable: its group was never finished because a sibling directory in the same invocation failed, got matches: %v", got)
+	}
+	if after := shardSnapshot09e2ba(t, indexDir); !reflect.DeepEqual(before, after) {
+		t.Errorf("the shards published by the earlier successful run must be left completely untouched by the failed run: before %v, after %v", before, after)
+	}
+}
