+// createSubmoduleSuperRepoEe2808 creates a git repository at dir containing
+// mainFile, plus a submodule checked out at subPath pointing at a
+// separately created repository containing subFile. It mirrors the
+// no-repo-cache submodule setup already exercised by
+// gitindex.TestSubmoduleIndexWithoutRepocache, so a relative-path
+// submodule resolves without needing -repo_cache.
+func createSubmoduleSuperRepoEe2808(t *testing.T, dir, mainFile, mainContent, subPath, subFile, subContent string) {
+	t.Helper()
+	subDir := dir + "-sub"
+	initGitRepoEe2808(t, subDir, subFile, subContent)
+
+	if err := os.MkdirAll(dir, 0o755); err != nil {
+		t.Fatal(err)
+	}
+	runGitEe2808(t, dir, "init", "-b", "main")
+	if err := os.WriteFile(filepath.Join(dir, mainFile), []byte(mainContent), 0o644); err != nil {
+		t.Fatal(err)
+	}
+
+	cmd := exec.Command("git", "-c", "protocol.file.allow=always", "submodule", "add", "--name", subPath, "--", "../"+filepath.Base(subDir), subPath)
+	cmd.Dir = dir
+	cmd.Env = gitTestEnvEe2808()
+	if out, err := cmd.CombinedOutput(); err != nil {
+		t.Fatalf("git submodule add: %v\noutput:\n%s", err, out)
+	}
+
+	runGitEe2808(t, dir, "add", ".")
+	runGitEe2808(t, dir, "commit", "-m", "add submodule")
+}
