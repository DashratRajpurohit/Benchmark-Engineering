+func searchNamesEe2808(t *testing.T, indexDir string, pattern string) []string {
+	t.Helper()
+	searcher, err := search.NewDirectorySearcher(indexDir)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer searcher.Close()
+
+	result, err := searcher.Search(
+		context.Background(),
+		&query.Substring{Pattern: pattern, Content: true},
+		&zoekt.SearchOptions{},
+	)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var names []string
+	for _, f := range result.Files {
+		names = append(names, f.FileName)
+	}
+	return names
+}
+
+// searchRepoNamesEe2808 is searchNamesEe2808's counterpart for the
+// repository a match was indexed under, rather than the file it was found
+// in: it returns the (sorted, deduplicated) repository names of every
+// match for pattern. Asserting on these, and not just on whether content
+// is findable somewhere, is what distinguishes content that stayed
+// searchable under its own intended name from content that survived only
+// because it was quietly folded into some other repository's name.
+func searchRepoNamesEe2808(t *testing.T, indexDir string, pattern string) []string {
+	t.Helper()
+	searcher, err := search.NewDirectorySearcher(indexDir)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer searcher.Close()
+
+	result, err := searcher.Search(
+		context.Background(),
+		&query.Substring{Pattern: pattern, Content: true},
+		&zoekt.SearchOptions{},
+	)
+	if err != nil {
+		t.Fatal(err)
+	}
+	seen := map[string]bool{}
+	var repos []string
+	for _, f := range result.Files {
+		if !seen[f.Repository] {
+			seen[f.Repository] = true
+			repos = append(repos, f.Repository)
+		}
+	}
+	sort.Strings(repos)
+	return repos
+}
