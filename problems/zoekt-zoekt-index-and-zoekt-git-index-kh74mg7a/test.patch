+// TestIndexArgUnrelatedNameStillFinishesWhenSharedGroupFails covers the
+// blast radius of a partial failure for zoekt-index: when one name's
+// directories fail and that whole name is rolled back, an unrelated name
+// indexed later in the same invocation must still be finished and
+// published, rather than being dragged down with it or never being
+// reached at all.
+func TestIndexArgUnrelatedNameStillFinishesWhenSharedGroupFails(t *testing.T) {
+	root := t.TempDir()
+
+	// Two directories whose derived names both come out as "dup": one
+	// real, and one that doesn't exist, so that name's group fails
+	// partway through.
+	dupOK := filepath.Join(root, "a", "dup")
+	if err := os.MkdirAll(dupOK, 0o755); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(dupOK, "dup.txt"), []byte("dupneedle\n"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	dupMissing := filepath.Join(root, "b", "dup")
+
+	// A third directory whose name collides with nothing, listed after
+	// the failing one, which must survive the failure untouched.
+	soloDir := filepath.Join(root, "solo")
+	if err := os.MkdirAll(soloDir, 0o755); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(soloDir, "solo.txt"), []byte("soloneedle\n"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+
+	indexDir := t.TempDir()
+	out, err := runZoektIndexAllowError09e2ba(t, "-index", indexDir, "-disable_ctags", dupOK, dupMissing, soloDir)
+	if err == nil {
+		t.Fatalf("expected zoekt-index to report the missing directory, output:\n%s", out)
+	}
+
+	if got := searchNames09e2ba(t, indexDir, "dupneedle"); len(got) != 0 {
+		t.Errorf("dupneedle should NOT be published: its name had a failing sibling directory, got matches: %v", got)
+	}
+	if got := searchNames09e2ba(t, indexDir, "soloneedle"); len(got) != 1 {
+		t.Errorf("soloneedle should still be indexed: an unrelated name in the same invocation must still finish, got matches: %v", got)
+	}
+	if got := searchRepoNames09e2ba(t, indexDir, "soloneedle"); len(got) != 1 || got[0] != "solo" {
+		t.Errorf("soloneedle should be indexed under repository %q, got repositories: %v", "solo", got)
+	}
+}
