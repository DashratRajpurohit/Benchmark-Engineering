+// TestIndexArgDefaultNameCollisionMergesDirectories covers the no -meta
+// variant from the same issue: two directories that happen to share a
+// basename (so both fall back to the same default repository name) must
+// also both remain searchable, not just the last one indexed.
+func TestIndexArgDefaultNameCollisionMergesDirectories(t *testing.T) {
+	root := t.TempDir()
+	firstParent := filepath.Join(root, "first")
+	secondParent := filepath.Join(root, "second")
+	if err := os.MkdirAll(firstParent, 0o755); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.MkdirAll(secondParent, 0o755); err != nil {
+		t.Fatal(err)
+	}
+
+	// Both directories are named "src", so zoekt-index's default naming
+	// (filepath.Base(dir)) collides even without an explicit -meta name.
+	firstSrc := filepath.Join(firstParent, "src")
+	secondSrc := filepath.Join(secondParent, "src")
+	if err := os.Mkdir(firstSrc, 0o755); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Mkdir(secondSrc, 0o755); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(firstSrc, "one.txt"), []byte("oneneedle\n"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(secondSrc, "two.txt"), []byte("twoneedle\n"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+
+	indexDir := t.TempDir()
+	runZoektIndex09e2ba(t, "-index", indexDir, "-disable_ctags", firstSrc, secondSrc)
+
+	if got := searchNames09e2ba(t, indexDir, "oneneedle"); len(got) != 1 {
+		t.Errorf("one.txt from the first \"src\" directory should still be searchable, got matches: %v", got)
+	}
+	if got := searchNames09e2ba(t, indexDir, "twoneedle"); len(got) != 1 {
+		t.Errorf("two.txt from the second \"src\" directory should be searchable, got matches: %v", got)
+	}
+	// Surviving somewhere is not enough: both directories derive the name
+	// "src", so both must be searchable under exactly that name. Content
+	// preserved under some other name would still be lost to anyone
+	// querying the repository it belongs to.
+	for _, needle := range []string{"oneneedle", "twoneedle"} {
+		if got := searchRepoNames09e2ba(t, indexDir, needle); len(got) != 1 || got[0] != "src" {
+			t.Errorf("%s should be indexed under repository %q, got repositories: %v", needle, "src", got)
+		}
+	}
+}
