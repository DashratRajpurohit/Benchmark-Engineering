+// TestGitIndexDeltaRequestedWithDistinctConfigNamesBothIndexed guards
+// against a false collision: two repositories can share the same derived
+// basename (for example, both are checked out as a directory literally
+// named "src") while their own git config resolves them to two distinct,
+// non-colliding repository names. Since they don't actually end up
+// sharing a name, -delta must not reject either of them - only inputs
+// that really are merged under one shared name are restricted that way.
+func TestGitIndexDeltaRequestedWithDistinctConfigNamesBothIndexed(t *testing.T) {
+	root := t.TempDir()
+	aDir := filepath.Join(root, "groupA", "src")
+	bDir := filepath.Join(root, "groupB", "src")
+	initGitRepoEe2808(t, aDir, "a.txt", "aneedle\n")
+	initGitRepoEe2808(t, bDir, "b.txt", "bneedle\n")
+	runGitEe2808(t, aDir, "config", "zoekt.name", "repo-a")
+	runGitEe2808(t, bDir, "config", "zoekt.name", "repo-b")
+
+	indexDir := t.TempDir()
+	out, err := runZoektGitIndexEe2808(t, "-index", indexDir, "-disable_ctags", "-delta", aDir, bDir)
+	if err != nil {
+		t.Fatalf("zoekt-git-index: %v\noutput:\n%s", err, out)
+	}
+
+	if got := searchNamesEe2808(t, indexDir, "aneedle"); len(got) != 1 {
+		t.Errorf("aneedle should be searchable, got matches: %v", got)
+	}
+	if got := searchNamesEe2808(t, indexDir, "bneedle"); len(got) != 1 {
+		t.Errorf("bneedle should be searchable: two repositories sharing only a provisional derived basename, with distinct config-resolved names, must both be indexed even under -delta, got matches: %v", got)
+	}
+	// Each repository must land under the name its own git config
+	// resolves to, not under the shared provisional basename.
+	for needle, want := range map[string]string{"aneedle": "repo-a", "bneedle": "repo-b"} {
+		if got := searchRepoNamesEe2808(t, indexDir, needle); len(got) != 1 || got[0] != want {
+			t.Errorf("%s should be indexed under repository %q, got repositories: %v", needle, want, got)
+		}
+	}
+}
