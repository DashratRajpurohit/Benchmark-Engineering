+)
+
+// TestMain lets this test binary re-exec itself as the zoekt-index CLI, so
+// the tests below drive the real command-line entry point (main) rather
+// than reaching into its internals. The registered flags (including those
+// index.Options.Flags adds via the cmd package's init) are untouched; we
+// only rewrite os.Args so main()'s own flag.Parse() sees the simulated
+// zoekt-index command line instead of the test binary's own flags.
+func TestMain(m *testing.M) {
+	if os.Getenv("ZOEKT_INDEX_TEST_HELPER") == "1" {
+		args := os.Args
+		for i, a := range args {
+			if a == "--" {
+				os.Args = append([]string{args[0]}, args[i+1:]...)
+				break
+			}
+		}
+		main()
+		os.Exit(0)
+	}
+	os.Exit(m.Run())
+}
+
+// runZoektIndex09e2ba runs the zoekt-index command (as main() would see it) with
+// the given arguments, by re-executing this test binary as a subprocess.
+func runZoektIndex09e2ba(t *testing.T, args ...string) {
+	t.Helper()
+	if out, err := runZoektIndexAllowError09e2ba(t, args...); err != nil {
+		t.Fatalf("zoekt-index %v: %v\noutput:\n%s", args, err, out)
+	}
+}
+
+// runZoektIndexAllowError09e2ba is like runZoektIndex09e2ba, but returns the command's
+// combined output and error instead of failing the test, for callers that
+// expect (and want to inspect) a non-zero exit.
+func runZoektIndexAllowError09e2ba(t *testing.T, args ...string) ([]byte, error) {
+	t.Helper()
+	cmdArgs := append([]string{"--"}, args...)
+	cmd := exec.Command(os.Args[0], cmdArgs...)
+	cmd.Env = append(os.Environ(), "ZOEKT_INDEX_TEST_HELPER=1")
+	return cmd.CombinedOutput()
+}
+
+func searchNames09e2ba(t *testing.T, indexDir string, pattern string) []string {
+	t.Helper()
+	searcher, err := search.NewDirectorySearcher(indexDir)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer searcher.Close()
+
+	result, err := searcher.Search(
+		context.Background(),
+		&query.Substring{Pattern: pattern, Content: true},
+		&zoekt.SearchOptions{},
+	)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var names []string
+	for _, f := range result.Files {
+		names = append(names, f.FileName)
+	}
+	return names
+}
+
+// searchRepoNames09e2ba is searchNames09e2ba's counterpart for the
+// repository a match was indexed under, rather than the file it was found
+// in: it returns the sorted, deduplicated repository names of every match
+// for pattern. Asserting on these, and not just on whether content is
+// findable somewhere, is what distinguishes content that stayed
+// searchable under its own intended name from content that survived only
+// because it was quietly folded into some other repository's name.
+func searchRepoNames09e2ba(t *testing.T, indexDir string, pattern string) []string {
+	t.Helper()
+	searcher, err := search.NewDirectorySearcher(indexDir)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer searcher.Close()
+
+	result, err := searcher.Search(
+		context.Background(),
+		&query.Substring{Pattern: pattern, Content: true},
+		&zoekt.SearchOptions{},
+	)
+	if err != nil {
+		t.Fatal(err)
+	}
+	seen := map[string]bool{}
+	var repos []string
+	for _, f := range result.Files {
+		if !seen[f.Repository] {
+			seen[f.Repository] = true
+			repos = append(repos, f.Repository)
+		}
+	}
+	sort.Strings(repos)
+	return repos
+}
