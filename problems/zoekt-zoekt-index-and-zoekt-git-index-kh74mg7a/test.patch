+// initGitRepoEe2808 creates dir and a git repository in it, on branch "main",
+// containing one committed file named filename with the given content.
+// initGitRepoAtPathEe2808 is initGitRepoEe2808 for a relative path that may
+// contain directories.
+func initGitRepoAtPathEe2808(t *testing.T, dir, relPath, content string) {
+	t.Helper()
+	full := filepath.Join(dir, filepath.FromSlash(relPath))
+	if err := os.MkdirAll(filepath.Dir(full), 0o755); err != nil {
+		t.Fatal(err)
+	}
+	runGitEe2808(t, dir, "init", "-b", "main")
+	if err := os.WriteFile(full, []byte(content), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	runGitEe2808(t, dir, "add", ".")
+	runGitEe2808(t, dir, "commit", "-m", "initial commit")
+}
+
+func initGitRepoEe2808(t *testing.T, dir, filename, content string) {
+	t.Helper()
+	if err := os.MkdirAll(dir, 0o755); err != nil {
+		t.Fatal(err)
+	}
+	runGitEe2808(t, dir, "init", "-b", "main")
+	if err := os.WriteFile(filepath.Join(dir, filename), []byte(content), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	runGitEe2808(t, dir, "add", ".")
+	runGitEe2808(t, dir, "commit", "-m", "initial commit")
+}
