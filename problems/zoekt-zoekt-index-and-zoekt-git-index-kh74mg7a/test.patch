+// TestGitIndexMultiBranchRepoMergedWithSiblingKeepsAllContent covers the
+// boundary of the duplicate relative-path policy: the conflict it
+// describes is between two DIFFERENT inputs merged under one name, so a
+// single input that legitimately produces the same relative path more
+// than once - a repository indexing one file on two branches, with
+// different content on each - must not be mistaken for that conflict just
+// because it is being merged with a sibling input.
+//
+// This is the merged counterpart to
+// TestGitIndexMultiBranchSamePathWithinOneRepoNotRejected: checking the
+// unmerged case alone does not catch an implementation that only compares
+// paths once merging is actually in play, and treats one input's own
+// repeated path as a conflict with itself - which rejects, and so drops,
+// every input sharing that name. Both repositories here carry the same
+// two branches, so no branch is missing for either input and the only
+// thing under test is the repeated path.
+func TestGitIndexMultiBranchRepoMergedWithSiblingKeepsAllContent(t *testing.T) {
+	root := t.TempDir()
+	multiDir := filepath.Join(root, "multi")
+	siblingDir := filepath.Join(root, "sibling")
+
+	// multiDir writes the same relative path (alpha.txt) on both of its
+	// branches with different content on each, so this one input alone
+	// contributes two documents at that path.
+	initGitRepoEe2808(t, multiDir, "alpha.txt", "mainalphaneedle\n")
+	runGitEe2808(t, multiDir, "checkout", "-b", "dev")
+	if err := os.WriteFile(filepath.Join(multiDir, "alpha.txt"), []byte("devalphaneedle\n"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	runGitEe2808(t, multiDir, "commit", "-am", "dev change")
+	runGitEe2808(t, multiDir, "checkout", "main")
+
+	// siblingDir carries the same branches but its own distinct relative
+	// path, so there is no genuine cross-input duplicate path here.
+	initGitRepoEe2808(t, siblingDir, "beta.txt", "mainbetaneedle\n")
+	runGitEe2808(t, siblingDir, "checkout", "-b", "dev")
+	if err := os.WriteFile(filepath.Join(siblingDir, "beta.txt"), []byte("devbetaneedle\n"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	runGitEe2808(t, siblingDir, "commit", "-am", "dev change")
+	runGitEe2808(t, siblingDir, "checkout", "main")
+
+	indexDir := t.TempDir()
+	metaFile := filepath.Join(indexDir, "repo.meta")
+	if err := os.WriteFile(metaFile, []byte(`{"Name":"multibranch-shared"}`), 0o644); err != nil {
+		t.Fatal(err)
+	}
+
+	out, err := runZoektGitIndexEe2808(t, "-index", indexDir, "-disable_ctags", "-branches", "main,dev", "-meta", metaFile, multiDir, siblingDir)
+	if err != nil {
+		t.Fatalf("zoekt-git-index should merge a multi-branch repository with a sibling under one name: %v\noutput:\n%s", err, out)
+	}
+
+	for _, needle := range []string{"mainalphaneedle", "devalphaneedle", "mainbetaneedle", "devbetaneedle"} {
+		if got := searchNamesEe2808(t, indexDir, needle); len(got) != 1 {
+			t.Errorf("%s should be searchable: one input repeating its own relative path across branches is not a cross-input duplicate, got matches: %v", needle, got)
+		}
+		if got := searchRepoNamesEe2808(t, indexDir, needle); len(got) != 1 || got[0] != "multibranch-shared" {
+			t.Errorf("%s should be indexed under repository %q, got repositories: %v", needle, "multibranch-shared", got)
+		}
+	}
+}
