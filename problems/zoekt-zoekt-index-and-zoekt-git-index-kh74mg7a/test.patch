+// TestGitIndexSubmoduleInputMergedAfterPlainSiblingKeepsSubmodule covers
+// the ordering half of the submodule-metadata requirement: a repository
+// carrying a submodule must contribute that submodule's content whether
+// it is the first input processed under a shared name or a later one.
+//
+// This matters because the submodule paths a merged name has to recognize
+// are only known once the repository carrying them has been examined. An
+// implementation that settles that set from whichever input happened to
+// come first, and then keeps reusing it, works when the submodule-bearing
+// repository leads and rejects that repository's own submodule documents
+// as an unrecognized path when it follows instead - failing the whole
+// invocation on nothing more than argument order.
+//
+// TestGitIndexRepoWithSubmoduleMergesWithPlainSibling lists the
+// submodule-bearing repository first and this one lists it last, so between
+// them both argument orders are covered. An implementation that settles the
+// recognized set from whichever input it examines first therefore fails at
+// least one of the pair, whatever order it examines arguments in.
+func TestGitIndexSubmoduleInputMergedAfterPlainSiblingKeepsSubmodule(t *testing.T) {
+	root := t.TempDir()
+	plainDir := filepath.Join(root, "plain")
+	superDir := filepath.Join(root, "super")
+	initGitRepoEe2808(t, plainDir, "plain.txt", "plain-content\n")
+	createSubmoduleSuperRepoEe2808(t, superDir, "super.txt", "super-content\n", "sub-mount", "sub.txt", "sub-content\n")
+
+	indexDir := t.TempDir()
+	metaFile := filepath.Join(indexDir, "repo.meta")
+	if err := os.WriteFile(metaFile, []byte(`{"Name":"submodule-trailing-shared"}`), 0o644); err != nil {
+		t.Fatal(err)
+	}
+
+	// The plain repository is deliberately listed first, so the
+	// submodule-bearing one is merged into a name that was already
+	// established without any submodule of its own.
+	out, err := runZoektGitIndexEe2808(t, "-index", indexDir, "-disable_ctags", "-submodules", "-meta", metaFile, plainDir, superDir)
+	if err != nil {
+		t.Fatalf("zoekt-git-index should merge a submodule-bearing repository listed after a plain sibling: %v\noutput:\n%s", err, out)
+	}
+
+	for _, needle := range []string{"plain-content", "super-content", "sub-content"} {
+		if got := searchNamesEe2808(t, indexDir, needle); len(got) != 1 {
+			t.Errorf("%s should be searchable, got matches: %v", needle, got)
+		}
+		if got := searchRepoNamesEe2808(t, indexDir, needle); len(got) != 1 || got[0] != "submodule-trailing-shared" {
+			t.Errorf("%s should be indexed under repository %q, got repositories: %v", needle, "submodule-trailing-shared", got)
+		}
+	}
+}
