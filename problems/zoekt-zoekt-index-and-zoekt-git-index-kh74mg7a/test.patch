+// TestIndexArgSharedNameMergesDirectories reproduces
+// https://github.com/sourcegraph/zoekt/issues/1133: indexing two
+// directories in one zoekt-index invocation under an explicitly shared
+// repository name (as -meta produces) must leave both directories' files
+// searchable afterward, instead of the later directory's shard build
+// silently deleting the earlier directory's shard.
+// shardSnapshot09e2ba records every shard file in indexDir by name and
+// content hash. "Completely untouched" is a statement about the files on
+// disk, not merely about what a query still returns: deleting a shard and
+// rebuilding an equivalent one would satisfy a search-only check while
+// having replaced the very artifact the earlier run published.
+func shardSnapshot09e2ba(t *testing.T, indexDir string) map[string]string {
+	t.Helper()
+	entries, err := os.ReadDir(indexDir)
+	if err != nil {
+		t.Fatal(err)
+	}
+	snapshot := map[string]string{}
+	for _, entry := range entries {
+		// A published index is the shard plus its .zoekt.meta sidecar
+		// (see index/read.go's IndexFilePaths), so "completely untouched"
+		// has to cover both; hashing only the shard would let metadata
+		// change unnoticed.
+		if entry.IsDir() || (filepath.Ext(entry.Name()) != ".zoekt" && !strings.HasSuffix(entry.Name(), ".zoekt.meta")) {
+			continue
+		}
+		content, err := os.ReadFile(filepath.Join(indexDir, entry.Name()))
+		if err != nil {
+			t.Fatal(err)
+		}
+		digest := sha256.Sum256(content)
+		snapshot[entry.Name()] = hex.EncodeToString(digest[:])
+	}
+	if len(snapshot) == 0 {
+		t.Fatalf("expected at least one shard in %s", indexDir)
+	}
+	return snapshot
+}
+
+func TestIndexArgSharedNameMergesDirectories(t *testing.T) {
+	alphaDir := t.TempDir()
+	betaDir := t.TempDir()
+	indexDir := t.TempDir()
+
+	if err := os.WriteFile(filepath.Join(alphaDir, "alpha.txt"), []byte("alphaneedle\n"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(betaDir, "beta.txt"), []byte("betaneedle\n"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+
+	metaFile := filepath.Join(indexDir, "repo.meta")
+	if err := os.WriteFile(metaFile, []byte(`{"Name":"shared-repo","Branches":[{"Name":"main","Version":"0123456789abcdef0123456789abcdef01234567"}]}`), 0o644); err != nil {
+		t.Fatal(err)
+	}
+
+	runZoektIndex09e2ba(t, "-index", indexDir, "-disable_ctags", "-meta", metaFile, alphaDir, betaDir)
+
+	if got := searchNames09e2ba(t, indexDir, "alphaneedle"); len(got) != 1 {
+		t.Errorf("alpha.txt from the first directory should still be searchable after indexing a second directory under the same name, got matches: %v", got)
+	}
