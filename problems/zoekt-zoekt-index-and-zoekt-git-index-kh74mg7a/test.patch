+// TestGitIndexSharedMetaNameMergesBothRepos covers the direct issue #1133
+// equivalent for zoekt-git-index: two different repositories deliberately
+// given the SAME name via -meta (a supported way to attach one logical
+// repository name to content assembled from more than one place) must
+// both remain searchable afterward, instead of the second repository's
+// Finish call deleting the first repository's shard.
+func TestGitIndexSharedMetaNameMergesBothRepos(t *testing.T) {
+	root := t.TempDir()
+	oneDir := filepath.Join(root, "one")
+	twoDir := filepath.Join(root, "two")
+	initGitRepoEe2808(t, oneDir, "one.txt", "oneneedle\n")
+	initGitRepoEe2808(t, twoDir, "two.txt", "twoneedle\n")
+
+	indexDir := t.TempDir()
+	metaFile := filepath.Join(indexDir, "repo.meta")
+	if err := os.WriteFile(metaFile, []byte(`{"Name":"shared-git-repo"}`), 0o644); err != nil {
+		t.Fatal(err)
+	}
+
+	out, err := runZoektGitIndexEe2808(t, "-index", indexDir, "-disable_ctags", "-meta", metaFile, oneDir, twoDir)
+	if err != nil {
+		t.Fatalf("zoekt-git-index: %v\noutput:\n%s", err, out)
+	}
+
+	if got := searchNamesEe2808(t, indexDir, "oneneedle"); len(got) != 1 {
+		t.Errorf("one.txt should still be searchable after indexing a second repository under the same name, got matches: %v", got)
+	}
+	if got := searchNamesEe2808(t, indexDir, "twoneedle"); len(got) != 1 {
+		t.Errorf("two.txt should be searchable, got matches: %v", got)
+	}
+
+	// Both repositories' content must be searchable under the one name
+	// they were deliberately given, not merely searchable somewhere.
+	for _, needle := range []string{"oneneedle", "twoneedle"} {
+		if got := searchRepoNamesEe2808(t, indexDir, needle); len(got) != 1 || got[0] != "shared-git-repo" {
+			t.Errorf("%s should be indexed under repository %q, got repositories: %v", needle, "shared-git-repo", got)
+		}
+	}
+}
