+	// Both directories' content must be attributed to the one name they
+	// were deliberately given, not merely be findable somewhere.
+	for _, needle := range []string{"alphaneedle", "betaneedle"} {
+		if got := searchRepoNames09e2ba(t, indexDir, needle); len(got) != 1 || got[0] != "shared-repo" {
+			t.Errorf("%s should be indexed under repository %q, got repositories: %v", needle, "shared-repo", got)
+		}
+	}
