+// TestGitIndexDivergentBranchSetsNeverSilentlyLoseData covers two inputs
+// merged under one repository name when the requested branch list is only
+// partly available in each: one input carries both branches, the other only
+// the default branch, indexed with -allow_missing_branches.
+//
+// How differing branch sets should be reconciled is a design choice, so this
+// accepts either faithful resolution - publishing every input's content, or
+// refusing the whole group and leaving the earlier successful publication
+// alone. What it rules out is the one outcome the task exists to prevent:
+// reporting success while quietly dropping one of the inputs.
+func TestGitIndexDivergentBranchSetsNeverSilentlyLoseData(t *testing.T) {
+	root := t.TempDir()
+	oldDir := filepath.Join(root, "old")
+	bothDir := filepath.Join(root, "both")
+	mainOnlyDir := filepath.Join(root, "mainonly")
+
+	initGitRepoEe2808(t, oldDir, "old.txt", "priorbranchneedle\n")
+
+	// bothDir has main and dev; dev carries a file of its own.
+	initGitRepoEe2808(t, bothDir, "alpha.txt", "mainalphabranchneedle\n")
+	runGitEe2808(t, bothDir, "checkout", "-b", "dev")
+	if err := os.WriteFile(filepath.Join(bothDir, "devonly.txt"), []byte("devalphabranchneedle\n"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	runGitEe2808(t, bothDir, "add", "-A")
+	runGitEe2808(t, bothDir, "commit", "-m", "dev only file")
+	runGitEe2808(t, bothDir, "checkout", "main")
+
+	// mainOnlyDir never grows a dev branch, so the two inputs resolve to
+	// different branch sets for the same requested list.
+	initGitRepoEe2808(t, mainOnlyDir, "beta.txt", "mainbetabranchneedle\n")
+
+	indexDir := t.TempDir()
+	metaFile := filepath.Join(indexDir, "repo.meta")
+	if err := os.WriteFile(metaFile, []byte(`{"Name":"divergent-shared"}`), 0o644); err != nil {
+		t.Fatal(err)
+	}
+
+	// Establish a prior successful publication under the shared name.
+	if out, err := runZoektGitIndexEe2808(t, "-index", indexDir, "-disable_ctags", "-meta", metaFile, oldDir); err != nil {
+		t.Fatalf("seeding the shared name should succeed: %v\noutput:\n%s", err, out)
+	}
+
+	out, err := runZoektGitIndexEe2808(t, "-index", indexDir, "-disable_ctags", "-branches", "main,dev", "-allow_missing_branches", "-meta", metaFile, bothDir, mainOnlyDir)
+
+	newNeedles := []string{"mainalphabranchneedle", "devalphabranchneedle", "mainbetabranchneedle"}
+	if err == nil {
+		// Reported success, so every input must have survived it.
+		for _, needle := range newNeedles {
+			if got := searchNamesEe2808(t, indexDir, needle); len(got) == 0 {
+				t.Errorf("%s is not searchable even though the invocation reported success: inputs merged under one name must not be dropped, output:\n%s", needle, out)
+				continue
+			}
+			// Surviving somewhere is not enough: reconciling the two
+			// branch sets must still leave every input searchable under
+			// the name it was given, not under some other one.
+			if got := searchRepoNamesEe2808(t, indexDir, needle); len(got) != 1 || got[0] != "divergent-shared" {
+				t.Errorf("%s should be indexed under repository %q, got repositories: %v\noutput:\n%s", needle, "divergent-shared", got, out)
+			}
+		}
+		return
+	}
+
+	// Refused the group, so nothing new may be published and the earlier
+	// successful publication must be left alone.
+	for _, needle := range newNeedles {
+		if got := searchNamesEe2808(t, indexDir, needle); len(got) != 0 {
+			t.Errorf("%s must not be published when the shared-name group was refused, got matches: %v", needle, got)
+		}
+	}
+	if got := searchNamesEe2808(t, indexDir, "priorbranchneedle"); len(got) == 0 {
+		t.Errorf("the earlier successful publication under this name must survive a refused merge, output:\n%s", out)
+	}
+}
+
+// TestGitIndexConflictRollsBackAndUnrelatedNameStillPublishes drives a
+// duplicate-path conflict against a name that already has a published shard,
+// in an invocation that also carries an unrelated name. The earlier
+// publication must survive byte for byte - shard and .zoekt.meta sidecar
+// alike - nothing new may appear under the failed name, and the unrelated
+// name must still finish.
+func TestGitIndexConflictRollsBackAndUnrelatedNameStillPublishes(t *testing.T) {
+	root := t.TempDir()
+	indexDir := t.TempDir()
+
+	priorDir := filepath.Join(root, "prior", "conflict-repo")
+	initGitRepoEe2808(t, priorDir, "prior.txt", "priorconflictneedle\n")
+	if out, err := runZoektGitIndexEe2808(t, "-index", indexDir, "-disable_ctags", priorDir); err != nil {
+		t.Fatalf("seeding the shared name should succeed: %v\noutput:\n%s", err, out)
+	}
+	before := shardSnapshotEe2808(t, indexDir)
+
+	oneDir := filepath.Join(root, "one", "conflict-repo")
+	twoDir := filepath.Join(root, "two", "conflict-repo")
+	soloDir := filepath.Join(root, "three", "conflict-solo")
+	initGitRepoEe2808(t, oneDir, "same.txt", "conflictoneneedle\n")
+	initGitRepoEe2808(t, twoDir, "same.txt", "conflicttwoneedle\n")
+	initGitRepoEe2808(t, soloDir, "solo.txt", "conflictsoloneedle\n")
+
+	out, err := runZoektGitIndexEe2808(t, "-index", indexDir, "-disable_ctags", oneDir, twoDir, soloDir)
+	if err == nil {
+		t.Fatalf("a duplicate relative path across merged inputs must fail the invocation, output:\n%s", out)
+	}
+
+	for _, needle := range []string{"conflictoneneedle", "conflicttwoneedle"} {
+		if got := searchNamesEe2808(t, indexDir, needle); len(got) != 0 {
+			t.Errorf("%s must not be published: its name group was rejected on a duplicate path, got matches: %v", needle, got)
+		}
+	}
+	if got := searchNamesEe2808(t, indexDir, "priorconflictneedle"); len(got) != 1 {
+		t.Errorf("the earlier publication under the failed name must survive, got matches: %v", got)
+	}
+	if after := shardSnapshotEe2808(t, indexDir); !mapsContainEe2808(after, before) {
+		t.Errorf("every artifact of the earlier publication must be byte-for-byte untouched by the failed run: before %v, after %v", before, after)
+	}
+	if got := searchNamesEe2808(t, indexDir, "conflictsoloneedle"); len(got) != 1 {
+		t.Errorf("an unrelated name in the same invocation must still finish even though another name failed on a duplicate path, got matches: %v", got)
+	}
+}
+
+// mapsContainEe2808 reports whether every entry of want is present in got
+// with the same value. The failed run may legitimately add artifacts for the
+// unrelated name, so the earlier publication's entries are required to
+// survive unchanged rather than requiring the directory to be identical.
+func mapsContainEe2808(got, want map[string]string) bool {
+	for k, v := range want {
+		if got[k] != v {
+			return false
+		}
+	}
+	return true
+}
+
+// TestGitIndexFailedFirstSharedGroupPublishesNothingLater lists the failing
+// input ahead of its valid same-name sibling. The required outcome does not
+// depend on which of the two the command happens to examine first: in either
+// order, a failure anywhere in the group must leave the later sibling
+// unpublished. Listing the failure first exercises the direction a partial
+// fix is most likely to miss - one that only declines to finish a group it
+// has already begun, and so still publishes a sibling when nothing was
+// started before it. The earlier publication for that name must also survive
+// the failed run byte for byte, while an unrelated name in the same
+// invocation still finishes.
+func TestGitIndexFailedFirstSharedGroupPublishesNothingLater(t *testing.T) {
+	root := t.TempDir()
+	indexDir := t.TempDir()
+
+	priorDir := filepath.Join(root, "prior", "failfirst")
+	initGitRepoEe2808(t, priorDir, "prior.txt", "failfirstpriorneedle\n")
+	if out, err := runZoektGitIndexEe2808(t, "-index", indexDir, "-disable_ctags", priorDir); err != nil {
+		t.Fatalf("seeding the shared name should succeed: %v\noutput:\n%s", err, out)
+	}
+	before := shardSnapshotEe2808(t, indexDir)
+
+	missingDir := filepath.Join(root, "missing", "failfirst")
+	validDir := filepath.Join(root, "valid", "failfirst")
+	soloDir := filepath.Join(root, "solo", "failfirst-solo")
+	initGitRepoEe2808(t, validDir, "valid.txt", "failfirstvalidneedle\n")
+	initGitRepoEe2808(t, soloDir, "solo.txt", "failfirstsoloneedle\n")
+
+	out, err := runZoektGitIndexEe2808(t, "-index", indexDir, "-disable_ctags", missingDir, validDir, soloDir)
+	if err == nil {
+		t.Fatalf("expected zoekt-git-index to fail when the first input of a shared name does not exist, output:\n%s", out)
+	}
+
+	if got := searchNamesEe2808(t, indexDir, "failfirstvalidneedle"); len(got) != 0 {
+		t.Errorf("the later sibling must not be published: its name group already failed on an earlier input, got matches: %v", got)
+	}
+	if got := searchNamesEe2808(t, indexDir, "failfirstpriorneedle"); len(got) != 1 {
+		t.Errorf("the earlier publication under the failed name must survive, got matches: %v", got)
+	}
+	if after := shardSnapshotEe2808(t, indexDir); !mapsContainEe2808(after, before) {
+		t.Errorf("every artifact of the earlier publication must be byte-for-byte untouched: before %v, after %v", before, after)
+	}
+	if got := searchNamesEe2808(t, indexDir, "failfirstsoloneedle"); len(got) != 1 {
+		t.Errorf("an unrelated name must still finish even though another name failed on its first input, got matches: %v", got)
+	}
+}
+
+// TestGitIndexIdenticalContentDuplicatePathRejected covers the duplicate
+// relative path rule for the case where the two merged repositories write
+// byte-identical files at that path. What the requirement turns on is the
+// path two merged inputs would each write, not whether their bytes happen
+// to agree: an implementation that only reports a conflict when the
+// contents differ still lets one input's file silently stand in for the
+// other's, which is exactly the substitution the explicit conflict exists
+// to prevent.
+func TestGitIndexIdenticalContentDuplicatePathRejected(t *testing.T) {
+	root := t.TempDir()
+	oneDir := filepath.Join(root, "one")
+	twoDir := filepath.Join(root, "two")
+	initGitRepoAtPathEe2808(t, oneDir, "shared.txt", "identicalcollisionneedle\n")
+	initGitRepoAtPathEe2808(t, twoDir, "shared.txt", "identicalcollisionneedle\n")
+
+	indexDir := t.TempDir()
+	metaFile := filepath.Join(indexDir, "repo.meta")
+	if err := os.WriteFile(metaFile, []byte(`{"Name":"identical-dup-shared"}`), 0o644); err != nil {
+		t.Fatal(err)
+	}
+
+	out, err := runZoektGitIndexEe2808(t, "-index", indexDir, "-disable_ctags", "-meta", metaFile, oneDir, twoDir)
+	if err == nil {
+		t.Fatalf("two merged repositories both writing shared.txt must be an explicit conflict for that name even when the two files hold identical bytes, output:\n%s", out)
+	}
+	if got := searchNamesEe2808(t, indexDir, "identicalcollisionneedle"); len(got) != 0 {
+		t.Errorf("a name group rejected on a duplicate relative path must publish none of its inputs, got matches: %v\noutput:\n%s", got, out)
+	}
+}
+
+// TestGitIndexDeltaWithMergedInputsAndNoPriorShardDoesNotLoseData exercises
+// a -delta build of several same-name inputs into an empty index directory.
+// TestGitIndexRequestedDeltaWithMergedInputsDoesNotLoseData always seeds an
+// earlier shard first, so an implementation could enforce the restriction
+// only as a side effect of inspecting previously published state and still
+// pass it. With nothing published yet there is no such state to consult,
+// and the outcome must be the same: either the invocation is refused and
+// publishes nothing, or it succeeds with every input searchable under the
+// shared name.
+func TestGitIndexDeltaWithMergedInputsAndNoPriorShardDoesNotLoseData(t *testing.T) {
+	root := t.TempDir()
+	oneDir := filepath.Join(root, "one")
+	twoDir := filepath.Join(root, "two")
+	initGitRepoEe2808(t, oneDir, "one.txt", "freshdeltaoneneedle\n")
+	initGitRepoEe2808(t, twoDir, "two.txt", "freshdeltatwoneedle\n")
+
+	indexDir := t.TempDir()
+	metaFile := filepath.Join(indexDir, "repo.meta")
+	if err := os.WriteFile(metaFile, []byte(`{"Name":"fresh-delta-shared"}`), 0o644); err != nil {
+		t.Fatal(err)
+	}
+
+	out, err := runZoektGitIndexEe2808(t, "-index", indexDir, "-disable_ctags", "-delta", "-meta", metaFile, oneDir, twoDir)
+
+	needles := []string{"freshdeltaoneneedle", "freshdeltatwoneedle"}
+	if err != nil {
+		// Refused the group, so none of it may reach the index.
+		for _, needle := range needles {
+			if got := searchNamesEe2808(t, indexDir, needle); len(got) != 0 {
+				t.Errorf("%s must not be published by a refused -delta invocation, got matches: %v\noutput:\n%s", needle, got, out)
+			}
+		}
+		return
+	}
+
+	// Reported success, so it must have built something that holds both
+	// inputs under the one name they were given.
+	for _, needle := range needles {
+		if got := searchNamesEe2808(t, indexDir, needle); len(got) != 1 {
+			t.Errorf("%s should be searchable after a -delta invocation that reported success for two inputs sharing a name, got matches: %v\noutput:\n%s", needle, got, out)
+			continue
+		}
+		if got := searchRepoNamesEe2808(t, indexDir, needle); len(got) != 1 || got[0] != "fresh-delta-shared" {
+			t.Errorf("%s should be indexed under repository %q, got repositories: %v\noutput:\n%s", needle, "fresh-delta-shared", got, out)
+		}
+	}
+}
+
+// TestGitIndexMergedSubmoduleBranchMetadataStaysSearchable merges a
+// repository whose only branch is dev with a submodule-bearing repository
+// whose only branch is main, under one name, with -allow_missing_branches.
+//
+// A match is reported by looking up the document's branch position in the
+// merged name's branch list and reading the entry at that same position
+// from the subrepository the document belongs to. Merging inputs that
+// contribute different branch sets is exactly what makes those two lists
+// disagree: the submodule arrives knowing only its own branch, while the
+// merged name ends up carrying both, so the submodule's own documents sit
+// at a position its metadata never grew an entry for. Searching then
+// reads past the end of that list, which is why this asserts on results
+// obtained from a real search rather than on the shard's mere existence.
+func TestGitIndexMergedSubmoduleBranchMetadataStaysSearchable(t *testing.T) {
+	root := t.TempDir()
+	devOnlyDir := filepath.Join(root, "devonly")
+	superDir := filepath.Join(root, "super")
+
+	// devOnlyDir carries dev and nothing else.
+	initGitRepoEe2808(t, devOnlyDir, "plain.txt", "devplainbranchneedle\n")
+	runGitEe2808(t, devOnlyDir, "branch", "-m", "dev")
+
+	// superDir carries main and nothing else, and owns a submodule.
+	createSubmoduleSuperRepoEe2808(t, superDir, "super.txt", "mainsuperbranchneedle\n", "vendor/lib", "lib.txt", "mainsubmodulebranchneedle\n")
+
+	indexDir := t.TempDir()
+	metaFile := filepath.Join(indexDir, "repo.meta")
+	if err := os.WriteFile(metaFile, []byte(`{"Name":"submodule-branch-shared"}`), 0o644); err != nil {
+		t.Fatal(err)
+	}
+
+	out, err := runZoektGitIndexEe2808(t, "-index", indexDir, "-disable_ctags", "-branches", "dev,main", "-allow_missing_branches", "-meta", metaFile, devOnlyDir, superDir)
+
+	needles := []string{"devplainbranchneedle", "mainsuperbranchneedle", "mainsubmodulebranchneedle"}
+	if err != nil {
+		// Refused the group, so none of it may be published.
+		for _, needle := range needles {
+			if got := searchNamesEe2808(t, indexDir, needle); len(got) != 0 {
+				t.Errorf("%s must not be published when the shared-name group was refused, got matches: %v\noutput:\n%s", needle, got, out)
+			}
+		}
+		return
+	}
+
+	// Reported success, so every input must be searchable under the one
+	// name they share - the submodule's own file included.
+	for _, needle := range needles {
+		if got := searchNamesEe2808(t, indexDir, needle); len(got) == 0 {
+			t.Errorf("%s is not searchable even though the invocation reported success, output:\n%s", needle, out)
+			continue
+		}
+		if got := searchRepoNamesEe2808(t, indexDir, needle); len(got) != 1 || got[0] != "submodule-branch-shared" {
+			t.Errorf("%s should be indexed under repository %q, got repositories: %v\noutput:\n%s", needle, "submodule-branch-shared", got, out)
+		}
+	}
+}
+
+// TestGitIndexDeltaEligibleSharedNameDoesNotStackOnOldShard exercises the
+// -delta restriction in the configuration where a delta build is actually
+// eligible rather than rejected for an unrelated reason: submodule
+// recursion off, an earlier shard already published for the name under the
+// same branches and options, and only the repository's contents changed
+// since. TestGitIndexRequestedDeltaWithMergedInputsDoesNotLoseData reaches
+// its conclusion from a build that was never delta-eligible in the first
+// place, so it cannot show what happens once the restriction is the only
+// thing standing between the invocation and a real delta build. Content
+// deleted from the repository after the seeded shard was written is what
+// separates the outcomes here: a full rebuild can no longer find it,
+// while a delta stacked on that shard still returns it.
+func TestGitIndexDeltaEligibleSharedNameDoesNotStackOnOldShard(t *testing.T) {
+	root := t.TempDir()
+	oneDir := filepath.Join(root, "one")
+	twoDir := filepath.Join(root, "two")
+	initGitRepoEe2808(t, oneDir, "one.txt", "deltaeligibleoneneedle\n")
+	initGitRepoEe2808(t, twoDir, "two.txt", "deltaeligibletwoneedle\n")
+
+	// Seeded into the first shard and deleted before the -delta run, so a
+	// genuine rebuild can no longer find it while a stack still would.
+	if err := os.WriteFile(filepath.Join(oneDir, "stale.txt"), []byte("deltaeligiblestaleneedle\n"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	runGitEe2808(t, oneDir, "add", "-A")
+	runGitEe2808(t, oneDir, "commit", "-m", "add stale file")
+
+	indexDir := t.TempDir()
+	metaFile := filepath.Join(indexDir, "repo.meta")
+	if err := os.WriteFile(metaFile, []byte(`{"Name":"delta-eligible-shared"}`), 0o644); err != nil {
+		t.Fatal(err)
+	}
+
+	if out, err := runZoektGitIndexEe2808(t, "-index", indexDir, "-disable_ctags", "-submodules=false", "-meta", metaFile, oneDir); err != nil {
+		t.Fatalf("seeding the shared name should succeed: %v\noutput:\n%s", err, out)
+	}
+
+	if err := os.Remove(filepath.Join(oneDir, "stale.txt")); err != nil {
+		t.Fatal(err)
+	}
+	runGitEe2808(t, oneDir, "add", "-A")
+	runGitEe2808(t, oneDir, "commit", "-m", "remove stale file")
+
+	out, err := runZoektGitIndexEe2808(t, "-index", indexDir, "-disable_ctags", "-submodules=false", "-delta", "-meta", metaFile, oneDir, twoDir)
+
+	one := len(searchNamesEe2808(t, indexDir, "deltaeligibleoneneedle"))
+	two := len(searchNamesEe2808(t, indexDir, "deltaeligibletwoneedle"))
+	stale := len(searchNamesEe2808(t, indexDir, "deltaeligiblestaleneedle"))
+
+	if err != nil {
+		// Refused, so the seeded shard must be exactly as it was and
+		// nothing from this invocation may appear.
+		if one != 1 || stale != 1 {
+			t.Errorf("the seeded shard must survive a refused -delta merge untouched, got deltaeligibleoneneedle=%d deltaeligiblestaleneedle=%d\noutput:\n%s", one, stale, out)
+		}
+		if two != 0 {
+			t.Errorf("deltaeligibletwoneedle must not be published by a refused invocation, got %d matches\noutput:\n%s", two, out)
+		}
+		return
+	}
+
+	// Reported success, so both inputs must be present under the name and
+	// the content deleted since the seeded shard must be gone.
+	if one != 1 || two != 1 {
+		t.Errorf("a -delta invocation that reported success for two inputs sharing a name must leave both searchable, got deltaeligibleoneneedle=%d deltaeligibletwoneedle=%d\noutput:\n%s", one, two, out)
+	}
+	if stale != 0 {
+		t.Errorf("deltaeligiblestaleneedle was deleted before this invocation, so a successful shared-name build must have replaced the seeded shard rather than stacked on it, got %d matches\noutput:\n%s", stale, out)
+	}
+
+	// Both inputs must also be attributed to the name they were given: a
+	// build that kept them searchable under some other name would satisfy
+	// the counts above while still losing them from the name that was
+	// asked for.
+	for _, needle := range []string{"deltaeligibleoneneedle", "deltaeligibletwoneedle"} {
+		if got := searchRepoNamesEe2808(t, indexDir, needle); len(got) != 1 || got[0] != "delta-eligible-shared" {
+			t.Errorf("%s should be indexed under repository %q, got repositories: %v\noutput:\n%s", needle, "delta-eligible-shared", got, out)
+		}
+	}
+}
+
+// TestGitIndexRepeatedPositionalInputWithSiblingLosesNothing lists one
+// repository twice alongside a second repository resolving to the same
+// name. Each positional argument is its own input, so the repeat writes
+// every one of that repository's relative paths under the name a second
+// time, and two inputs writing the same relative path is an explicit
+// conflict for that name. Collapsing the repeat instead would let a
+// repeated argument quietly escape the rule every other pair of inputs
+// is held to.
+func TestGitIndexRepeatedPositionalInputWithSiblingLosesNothing(t *testing.T) {
+	root := t.TempDir()
+	repeatedDir := filepath.Join(root, "a", "shared")
+	siblingDir := filepath.Join(root, "b", "shared")
+	initGitRepoEe2808(t, repeatedDir, "alpha.txt", "repeatalphaneedle\n")
+	initGitRepoEe2808(t, siblingDir, "beta.txt", "repeatbetaneedle\n")
+
+	indexDir := t.TempDir()
+	out, err := runZoektGitIndexEe2808(t, "-index", indexDir, "-disable_ctags", repeatedDir, repeatedDir, siblingDir)
+
+	alpha := len(searchNamesEe2808(t, indexDir, "repeatalphaneedle"))
+	beta := len(searchNamesEe2808(t, indexDir, "repeatbetaneedle"))
+
+	if err == nil {
+		t.Fatalf("listing the same input twice writes every one of its relative paths under the name a second time, which must be reported as an explicit conflict rather than silently collapsed, output:\n%s", out)
+	}
+	if alpha != 0 || beta != 0 {
+		t.Errorf("a name group rejected on a duplicate relative path must publish none of its inputs, got repeatalphaneedle=%d repeatbetaneedle=%d\noutput:\n%s", alpha, beta, out)
+	}
+}
