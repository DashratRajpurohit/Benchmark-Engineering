+// TestGitIndexRequestedDeltaWithMergedInputsDoesNotLoseData covers the
+// delta/compound-shard compatibility requirement: a delta build stacks
+// incremental changes onto one specific repository's shard, so a single
+// invocation must never end up merging more than one repository under a
+// shared name as a delta build.
+//
+// More than one resolution satisfies that, and this test accepts either.
+// The command may refuse the invocation, publishing nothing new and
+// leaving the shard from the earlier run exactly as it was; or it may
+// fall back to a normal, non-delta build, which this repository already
+// does for delta builds whose preconditions aren't met - but then that
+// full build has to genuinely index both inputs. What is not acceptable
+// is the outcome in between: reporting success while only one of the two
+// inputs survives.
+func TestGitIndexRequestedDeltaWithMergedInputsDoesNotLoseData(t *testing.T) {
+	root := t.TempDir()
+	oneDir := filepath.Join(root, "one")
+	twoDir := filepath.Join(root, "two")
+	initGitRepoEe2808(t, oneDir, "one.txt", "oneneedle\n")
+	initGitRepoEe2808(t, twoDir, "two.txt", "twoneedle\n")
+
+	// staleneedle exists only in oneDir's first commit and is deleted
+	// before the second invocation. A full replacement therefore drops it,
+	// while a build that stacked a delta on top of the earlier shard would
+	// still return it - which is what makes the success branch below able
+	// to tell those two outcomes apart.
+	if err := os.WriteFile(filepath.Join(oneDir, "stale.txt"), []byte("staleneedle\n"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	runGitEe2808(t, oneDir, "add", "-A")
+	runGitEe2808(t, oneDir, "commit", "-m", "add stale file")
+
+	indexDir := t.TempDir()
+	metaFile := filepath.Join(indexDir, "repo.meta")
+	if err := os.WriteFile(metaFile, []byte(`{"Name":"delta-shared"}`), 0o644); err != nil {
+		t.Fatal(err)
+	}
+
+	if out, err := runZoektGitIndexEe2808(t, "-index", indexDir, "-disable_ctags", "-meta", metaFile, oneDir); err != nil {
+		t.Fatalf("zoekt-git-index (first run): %v\noutput:\n%s", err, out)
+	}
+
+	// Remove the seeded file, so a genuine full rebuild can no longer find
+	// it while a delta stack still would.
+	if err := os.Remove(filepath.Join(oneDir, "stale.txt")); err != nil {
+		t.Fatal(err)
+	}
+	runGitEe2808(t, oneDir, "add", "-A")
+	runGitEe2808(t, oneDir, "commit", "-m", "remove stale file")
+
+	out, err := runZoektGitIndexEe2808(t, "-index", indexDir, "-disable_ctags", "-delta", "-meta", metaFile, oneDir, twoDir)
+
+	one := len(searchNamesEe2808(t, indexDir, "oneneedle"))
+	two := len(searchNamesEe2808(t, indexDir, "twoneedle"))
+	stale := len(searchNamesEe2808(t, indexDir, "staleneedle"))
+
+	if err != nil {
+		// Refused the invocation. Nothing from it may be published, and
+		// the shard the first run wrote must be left untouched.
+		if one != 1 {
+			t.Errorf("oneneedle should still be searchable after the refused delta merge (the earlier run's shard must be untouched), got %d matches\noutput:\n%s", one, out)
+		}
+		if two != 0 {
+			t.Errorf("twoneedle should NOT be searchable: a refused invocation must not publish any of its content, got %d matches\noutput:\n%s", two, out)
+		}
+		if stale != 1 {
+			t.Errorf("staleneedle should still be searchable after the refused delta merge: the earlier run's shard must be left exactly as it was, got %d matches\noutput:\n%s", stale, out)
+		}
+		return
+	}
+
+	// Reported success, so it must have fallen back to a full build that
+	// actually indexed both inputs under the shared name.
+	if one != 1 || two != 1 {
+		t.Errorf("zoekt-git-index reported success for a -delta invocation spanning two repositories under one name, so it must have fallen back to a build that indexes both; got oneneedle=%d twoneedle=%d\noutput:\n%s", one, two, out)
+	}
+	// A successful shared-name invocation must be a full replacement, not
+	// a delta stacked on the earlier shard: content deleted from the
+	// repository since that shard was written must be gone.
+	if stale != 0 {
+		t.Errorf("staleneedle was deleted from the repository before this invocation, so a successful shared-name build must have fully replaced the earlier shard rather than stacking a delta on it; got %d matches\noutput:\n%s", stale, out)
+	}
+}
