+// TestMain lets this test binary re-exec itself as the zoekt-git-index CLI,
+// so the tests below drive the real command-line entry point (main) rather
+// than reaching into its internals.
+func TestMain(m *testing.M) {
+	if os.Getenv("ZOEKT_GIT_INDEX_TEST_HELPER") == "1" {
+		args := os.Args
+		for i, a := range args {
+			if a == "--" {
+				os.Args = append([]string{args[0]}, args[i+1:]...)
+				break
+			}
+		}
+		main()
+		os.Exit(0)
+	}
+	os.Exit(m.Run())
+}
+
+// runZoektGitIndexEe2808 runs the zoekt-git-index command (as main() would see
+// it) with the given arguments, by re-executing this test binary as a
+// subprocess, and returns its combined output and error without failing
+// the test (callers decide whether a given invocation is expected to
+// succeed).
+func runZoektGitIndexEe2808(t *testing.T, args ...string) ([]byte, error) {
+	t.Helper()
+	cmdArgs := append([]string{"--"}, args...)
+	cmd := exec.Command(os.Args[0], cmdArgs...)
+	cmd.Env = append(os.Environ(), "ZOEKT_GIT_INDEX_TEST_HELPER=1")
+	return cmd.CombinedOutput()
+}
+
+func gitTestEnvEe2808() []string {
+	return append(os.Environ(),
+		"GIT_CONFIG_GLOBAL=",
+		"GIT_CONFIG_SYSTEM=",
+		"GIT_COMMITTER_NAME=Test",
+		"GIT_COMMITTER_EMAIL=test@example.com",
+		"GIT_AUTHOR_NAME=Test",
+		"GIT_AUTHOR_EMAIL=test@example.com",
+	)
+}
+
+func runGitEe2808(t *testing.T, cwd string, args ...string) {
+	t.Helper()
+	cmd := exec.Command("git", args...)
+	cmd.Dir = cwd
+	cmd.Env = gitTestEnvEe2808()
+	if out, err := cmd.CombinedOutput(); err != nil {
+		t.Fatalf("git %v: %v\noutput:\n%s", args, err, out)
+	}
+}
