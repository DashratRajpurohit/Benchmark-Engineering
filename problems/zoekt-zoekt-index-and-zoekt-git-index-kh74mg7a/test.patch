+// TestGitIndexDistinctReposWithoutMetaGetOwnNames reproduces a repository
+// name aliasing bug in zoekt-git-index: indexing more than one git
+// repository in a single invocation, without -meta, used to make every
+// repository after the first silently reuse whichever repository's name
+// happened to be derived first (map iteration order over multiple
+// positional repositories is unspecified), because the shared
+// *index.Options pointer's RepositoryDescription.Name field was only ever
+// set once, on whichever repository was processed first. Combined with
+// each repository getting its own builder, the second repository's Finish
+// call would then delete the first repository's freshly written shard -
+// the same data loss as issue #1133, but reachable even when the two
+// repositories' own names don't collide with each other at all.
+// shardSnapshotEe2808 records every shard file in indexDir by name and
+// content hash. "Completely untouched" is a statement about the files on
+// disk, not merely about what a query still returns: deleting a shard and
+// rebuilding an equivalent one would satisfy a search-only check while
+// having replaced the very artifact the earlier run published.
+func shardSnapshotEe2808(t *testing.T, indexDir string) map[string]string {
+	t.Helper()
+	entries, err := os.ReadDir(indexDir)
+	if err != nil {
+		t.Fatal(err)
+	}
+	snapshot := map[string]string{}
+	for _, entry := range entries {
+		// A published index is the shard plus its .zoekt.meta sidecar
+		// (see index/read.go's IndexFilePaths), so "completely untouched"
+		// has to cover both; hashing only the shard would let metadata
+		// change unnoticed.
+		if entry.IsDir() || (filepath.Ext(entry.Name()) != ".zoekt" && !strings.HasSuffix(entry.Name(), ".zoekt.meta")) {
+			continue
+		}
+		content, err := os.ReadFile(filepath.Join(indexDir, entry.Name()))
+		if err != nil {
+			t.Fatal(err)
+		}
+		digest := sha256.Sum256(content)
+		snapshot[entry.Name()] = hex.EncodeToString(digest[:])
+	}
+	if len(snapshot) == 0 {
+		t.Fatalf("expected at least one shard in %s", indexDir)
+	}
+	return snapshot
+}
