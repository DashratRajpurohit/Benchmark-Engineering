--- /dev/null
+++ b/test.sh
@@ -0,0 +1,84 @@
+#!/usr/bin/env bash
+# Test runner for zoekt-index and zoekt-git-index shard-loss and
+# repository-name collision regressions.
+#
+# Usage:
+#   ./test.sh [--output_path <junit.xml>] <base|new>
+#
+# base  runs the pre-existing regression suites for the areas this change
+#       touches (cmd/zoekt-index's own tests, plus the full gitindex and
+#       index package suites, since this change also touches production
+#       code there).
+# new   runs the regression tests for shared-name merging: partial failure
+#       and rollback, unrelated-name continuation, incremental skipping,
+#       delta rejection, duplicate paths, repeated invocations, submodule
+#       metadata, and per-repository name resolution, for both commands.
+set -uo pipefail
+
+cd /app
+
+OUTPUT_PATH=""
+if [ "${1:-}" = "--output_path" ]; then
+  OUTPUT_PATH="$2"
+  shift 2
+fi
+
+MODE="${1:-new}"
+
+TEST_LOG="$(mktemp)"
+STATUS=0
+
+run_tests() {
+  regex="$1"
+  shift
+  go test -count=1 -v -run "$regex" "$@" 2>&1 | tee -a "$TEST_LOG"
+  status=${PIPESTATUS[0]}
+  if [ "$status" -ne 0 ]; then
+    STATUS=$status
+  fi
+}
+
+case "$MODE" in
+  base)
+    run_tests '^(TestIndexArgAttachesConfiguredBranches|TestIndexArgIndexesSymlinkTarget)$' ./cmd/zoekt-index/...
+    # TestGitIndexMultiBranchSamePathWithinOneRepoNotRejected,
+    # TestGitIndexDeltaRequestedWithDistinctConfigNamesBothIndexed, and
+    # TestGitIndexDeltaWithExplicitMetaStillHonorsConfigResolvedNames are
+    # regression guards, not new-behavior tests: a single repository
+    # indexing the same path with different content on two branches, and
+    # two repositories that share only a provisional derived basename (or
+    # even an explicit -meta name) while their own git config resolves
+    # them to distinct names, are all pre-existing, unchanged-outcome
+    # scenarios that must keep working - these pass both before and after
+    # this change.
+    run_tests '^(TestGitIndexMultiBranchSamePathWithinOneRepoNotRejected|TestGitIndexDeltaRequestedWithDistinctConfigNamesBothIndexed|TestGitIndexDeltaWithExplicitMetaStillHonorsConfigResolvedNames)$' ./cmd/zoekt-git-index/...
+    run_tests '.*' ./gitindex/...
+    run_tests '.*' ./index/...
+    ;;
+  new)
+    run_tests '^(TestIndexArgSharedNameMergesDirectories|TestIndexArgDefaultNameCollisionMergesDirectories|TestIndexArgPartialFailureLeavesOldShardIntact|TestIndexArgDuplicatePathAcrossMergedDirectoriesRejected|TestIndexArgUnrelatedNameStillFinishesWhenSharedGroupFails|TestIndexArgConflictRollsBackAndUnrelatedNameStillPublishes|TestIndexArgFailedFirstSharedGroupPublishesNothingLater|TestIndexArgRepeatedSharedNameInvocationKeepsBothDirectories|TestIndexArgIdenticalContentDuplicatePathRejected|TestIndexArgRepeatedPositionalInputWithSiblingLosesNothing)$' ./cmd/zoekt-index/...
+    run_tests '^(TestGitIndexDistinctReposWithoutMetaGetOwnNames|TestGitIndexSharedMetaNameMergesBothRepos|TestGitIndexPartialFailureLeavesOldSharedShardIntact|TestGitIndexIncrementalSkipDoesNotDropUnchangedSibling|TestGitIndexRequestedDeltaWithMergedInputsDoesNotLoseData|TestGitIndexDuplicatePathAcrossMergedReposRejected|TestGitIndexRepoWithSubmoduleMergesWithPlainSibling|TestGitIndexMultiBranchRepoMergedWithSiblingKeepsAllContent|TestGitIndexUnrelatedNameStillFinishesWhenSharedGroupFails|TestGitIndexRepeatedSharedNameInvocationKeepsBothRepos|TestGitIndexSubmoduleInputMergedAfterPlainSiblingKeepsSubmodule|TestGitIndexDivergentBranchSetsNeverSilentlyLoseData|TestGitIndexConflictRollsBackAndUnrelatedNameStillPublishes|TestGitIndexFailedFirstSharedGroupPublishesNothingLater|TestGitIndexIdenticalContentDuplicatePathRejected|TestGitIndexDeltaWithMergedInputsAndNoPriorShardDoesNotLoseData|TestGitIndexMergedSubmoduleBranchMetadataStaysSearchable|TestGitIndexDeltaEligibleSharedNameDoesNotStackOnOldShard|TestGitIndexRepeatedPositionalInputWithSiblingLosesNothing)$' ./cmd/zoekt-git-index/...
+    ;;
+  *)
+    echo "unknown mode: $MODE (expected base or new)" >&2
+    exit 2
+    ;;
+esac
+
+if [ -n "$OUTPUT_PATH" ]; then
+  # Fail closed: if the JUnit report can't be produced, that's a real
+  # failure of this run, not something to swallow - a caller relying on
+  # $OUTPUT_PATH would otherwise read a missing or truncated report as
+  # "no failures".
+  go-junit-report -set-exit-code < "$TEST_LOG" > "$OUTPUT_PATH"
+  junit_status=$?
+  # -set-exit-code also reports non-zero when the log itself contains test
+  # failures, which STATUS has already recorded; only a conversion failure
+  # on an otherwise green run is new information.
+  if [ "$junit_status" -ne 0 ] && [ "$STATUS" -eq 0 ]; then
+    echo "go-junit-report failed to convert the test log (exit $junit_status)" >&2
+    STATUS=$junit_status
+  fi
+fi
+
+exit "$STATUS"
