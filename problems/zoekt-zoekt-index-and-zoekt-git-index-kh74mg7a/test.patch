+// TestGitIndexRepeatedSharedNameInvocationKeepsBothRepos covers running
+// the very same shared-name invocation twice: re-indexing the same inputs
+// under the same name must leave every one of them searchable afterward,
+// exactly as the first run did, since re-indexing is the normal steady
+// state rather than a one-off.
+//
+// Publishing a merged result is not necessarily a single filesystem
+// operation, and an implementation that replaces what a previous run left
+// behind in more than one step can leave those steps inconsistent with
+// each other - retiring the old result while only partly installing the
+// new one, so that a second, apparently successful run reports no error
+// but silently hides everything under that name, including the content
+// the first run had already published.
+func TestGitIndexRepeatedSharedNameInvocationKeepsBothRepos(t *testing.T) {
+	root := t.TempDir()
+	oneDir := filepath.Join(root, "one")
+	twoDir := filepath.Join(root, "two")
+	initGitRepoEe2808(t, oneDir, "one.txt", "repeatoneneedle\n")
+	initGitRepoEe2808(t, twoDir, "two.txt", "repeattwoneedle\n")
+
+	indexDir := t.TempDir()
+	metaFile := filepath.Join(indexDir, "repo.meta")
+	if err := os.WriteFile(metaFile, []byte(`{"Name":"repeat-shared"}`), 0o644); err != nil {
+		t.Fatal(err)
+	}
+
+	for run := 1; run <= 2; run++ {
+		out, err := runZoektGitIndexEe2808(t, "-index", indexDir, "-disable_ctags", "-meta", metaFile, oneDir, twoDir)
+		if err != nil {
+			t.Fatalf("zoekt-git-index (run %d): %v\noutput:\n%s", run, err, out)
+		}
+		for _, needle := range []string{"repeatoneneedle", "repeattwoneedle"} {
+			if got := searchNamesEe2808(t, indexDir, needle); len(got) != 1 {
+				t.Errorf("run %d: %s should be searchable after re-indexing the same inputs under the same name, got matches: %v", run, needle, got)
+			}
+			if got := searchRepoNamesEe2808(t, indexDir, needle); len(got) != 1 || got[0] != "repeat-shared" {
+				t.Errorf("run %d: %s should be indexed under repository %q, got repositories: %v", run, needle, "repeat-shared", got)
+			}
+		}
+	}
+}
