+		t.Errorf("metabneedle should be searchable: an explicit -meta name shared by two repositories whose own config resolves them to distinct names must not be treated as a delta collision, got matches: %v", got)
+	}
+	// A repository's own git config outranks the caller-supplied -meta
+	// name, so neither input may be published under that shared name.
+	for needle, want := range map[string]string{"metaaneedle": "meta-repo-a", "metabneedle": "meta-repo-b"} {
