+// TestIndexArgConflictRollsBackAndUnrelatedNameStillPublishes drives a
+// duplicate-path conflict against a name that already has a published shard,
+// alongside an unrelated name in the same invocation. The earlier
+// publication must survive byte for byte (shard and .zoekt.meta sidecar),
+// nothing new may appear under the failed name, and the unrelated name must
+// still finish.
+func TestIndexArgConflictRollsBackAndUnrelatedNameStillPublishes(t *testing.T) {
+	root := t.TempDir()
+	indexDir := t.TempDir()
+
+	write := func(dir, name, content string) {
+		if err := os.MkdirAll(dir, 0o755); err != nil {
+			t.Fatal(err)
+		}
+		if err := os.WriteFile(filepath.Join(dir, name), []byte(content), 0o644); err != nil {
+			t.Fatal(err)
+		}
+	}
+
+	priorDir := filepath.Join(root, "prior", "conflict-repo")
+	write(priorDir, "prior.txt", "priorconflictneedle\n")
+	if out, err := runZoektIndexAllowError09e2ba(t, "-index", indexDir, "-disable_ctags", priorDir); err != nil {
+		t.Fatalf("seeding the shared name should succeed: %v\noutput:\n%s", err, out)
+	}
+	before := shardSnapshot09e2ba(t, indexDir)
+
+	oneDir := filepath.Join(root, "one", "conflict-repo")
+	twoDir := filepath.Join(root, "two", "conflict-repo")
+	soloDir := filepath.Join(root, "three", "conflict-solo")
+	write(oneDir, "same.txt", "conflictoneneedle\n")
+	write(twoDir, "same.txt", "conflicttwoneedle\n")
+	write(soloDir, "solo.txt", "conflictsoloneedle\n")
+
+	out, err := runZoektIndexAllowError09e2ba(t, "-index", indexDir, "-disable_ctags", oneDir, twoDir, soloDir)
+	if err == nil {
+		t.Fatalf("a duplicate relative path across merged inputs must fail the invocation, output:\n%s", out)
+	}
+
+	for _, needle := range []string{"conflictoneneedle", "conflicttwoneedle"} {
+		if got := searchNames09e2ba(t, indexDir, needle); len(got) != 0 {
+			t.Errorf("%s must not be published: its name group was rejected on a duplicate path, got matches: %v", needle, got)
+		}
+	}
+	if got := searchNames09e2ba(t, indexDir, "priorconflictneedle"); len(got) != 1 {
+		t.Errorf("the earlier publication under the failed name must survive, got matches: %v", got)
+	}
+	if after := shardSnapshot09e2ba(t, indexDir); !mapsContain09e2ba(after, before) {
+		t.Errorf("every artifact of the earlier publication must be byte-for-byte untouched by the failed run: before %v, after %v", before, after)
+	}
+	if got := searchNames09e2ba(t, indexDir, "conflictsoloneedle"); len(got) != 1 {
+		t.Errorf("an unrelated name in the same invocation must still finish even though another name failed on a duplicate path, got matches: %v", got)
+	}
+}
+
+// mapsContain09e2ba reports whether every entry of want survives unchanged in
+// got. The failed run may legitimately add artifacts for the unrelated name.
+func mapsContain09e2ba(got, want map[string]string) bool {
+	for k, v := range want {
+		if got[k] != v {
+			return false
+		}
+	}
+	return true
+}
