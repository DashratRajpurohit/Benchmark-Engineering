new file mode 100644
index 00000000..4ef442b4
--- /dev/null
+++ b/buildgroup/buildgroup.go
@@ -0,0 +1,272 @@
+// Package buildgroup provides Group, a way to safely index several inputs
+// that may resolve to the same zoekt repository name into one
+// index.Builder per name, finishing (or abandoning) each builder exactly
+// once.
+//
+// It exists because index.Builder.Finish deletes every existing
+// (non-delta) shard for its repository name before writing new ones:
+// giving each input its own Builder for a shared name means the second
+// builder's Finish call destroys the first builder's freshly written
+// shard, silently losing that input's files. See
+// https://github.com/sourcegraph/zoekt/issues/1133.
+//
+// Group is used by both cmd/zoekt-index (whose positional directories can
+// collide on name, explicitly via -meta or implicitly via a shared
+// basename) and cmd/zoekt-git-index (whose repository arguments can
+// collide the same way).
+package buildgroup
+
+import (
+	"errors"
+	"fmt"
+
+	"github.com/sourcegraph/zoekt/index"
+)
+
+// Group indexes multiple inputs that may share a repository name into one
+// Builder per name.
+//
+// The zero value is not usable; construct one with New.
+type Group struct {
+	entries map[string]*entry
+}
+
+type entry struct {
+	builder        *index.Builder
+	requestedDelta bool
+	abandoned      bool
+	// declared counts the inputs a caller promised, up front, that it
+	// will process under this name (see Declare). reserved counts the
+	// inputs that have actually reached Reserve (or Builder) so far.
+	// They are tracked separately because Declare deliberately runs
+	// before any input is processed, and must not by itself look like a
+	// reservation - otherwise a single-input delta build would be
+	// rejected as colliding with its own declaration.
+	declared int
+	reserved int
+	// pathOwner maps a relative path already added under this name to the
+	// inputID that added it, so that CheckPath can tell a path repeated by
+	// the same input (allowed - for example the same git repository
+	// indexing the same path on two branches) from a path contributed by
+	// two different inputs merged under this name (a conflict).
+	pathOwner map[string]string
+}
+
+// New returns an empty Group.
+func New() *Group {
+	return &Group{entries: map[string]*entry{}}
+}
+
+// Reserve declares that a new input is about to be processed for name,
+// before any fallible per-input work happens (opening a directory,
+// opening a git repository, and so on). Callers should call Reserve for
+// every input before doing that fallible work, so that a failure which
+// happens before a Builder even exists can still be rolled back with
+// Abandon instead of leaving a previous input's builder to be finished
+// (and published) on its own with only a partial result.
+//
+// requestedDelta records whether this particular input was asked to run
+// as a delta build, before any internal fallback (for example, a delta
+// build whose preconditions aren't met and so runs as a normal build
+// instead) can change that. A delta build stacks incremental changes
+// onto one specific existing repository's shards, so it can never be
+// merged with another input under the same name - Reserve returns an
+// error if name already has an input in this group and either that
+// input or this one requested a delta build, even if a later fallback
+// would otherwise have made this particular input non-delta.
+//
+// Reserve also returns an error if name was already abandoned (see
+// Abandon) in this group.
+func (g *Group) Reserve(name string, requestedDelta bool) error {
+	e, ok := g.entries[name]
+	if !ok {
+		g.entries[name] = &entry{requestedDelta: requestedDelta, reserved: 1}
+		return nil
+	}
+	if e.abandoned {
+		return fmt.Errorf("buildgroup: %q was already abandoned in this group", name)
+	}
+	// Only an input that actually reached Reserve counts as a collision;
+	// a name that merely exists because it was Declare'd has no input
+	// behind it yet.
+	if e.reserved > 0 && (e.requestedDelta || requestedDelta) {
+		return fmt.Errorf("buildgroup: %q has more than one input in a delta build; delta builds cannot merge multiple inputs under one repository name", name)
+	}
+	e.reserved++
+	if requestedDelta {
+		e.requestedDelta = true
+	}
+	return nil
+}
+
+// Declare tells the group, before any input is processed, that the caller
+// intends to process one more input under name. Callers that can know
+// their full set of names up front should Declare every one of them
+// before indexing anything, which is what lets MayIncrementallySkip give
+// a safe answer.
+//
+// Declare is purely informational: it never reserves an input, never
+// conflicts with a delta build, and a caller that skips it entirely still
+// gets correct (merely more conservative) behavior.
+func (g *Group) Declare(name string) {
+	e, ok := g.entries[name]
+	if !ok {
+		e = &entry{}
+		g.entries[name] = e
+	}
+	e.declared++
+}
+
+// MayIncrementallySkip reports whether an input under name may safely
+// decide, on its own, that it has nothing to do and skip indexing
+// entirely.
+//
+// That is only safe when name has exactly one input in this group. If a
+// name has several, a skipped input contributes nothing to the shared
+// builder, while a changed sibling still finishes it - and because that
+// Finish replaces every shard for the name, the skipped input's content
+// is permanently lost even though nothing failed and nothing was
+// reported.
+//
+// The answer is deliberately conservative: a name the group was never
+// told about returns false, so a caller that passes a Group without
+// declaring its names gets no incremental skipping rather than silent
+// data loss. Skipping is a performance optimization; losing a shard is
+// not a tradeoff worth making by default.
+func (g *Group) MayIncrementallySkip(name string) bool {
+	e, ok := g.entries[name]
+	return ok && e.declared == 1
+}
+
+// Builder returns the Builder registered under
+// opts.RepositoryDescription.Name in g, creating it with
+// index.NewBuilder(opts) on first use. Later calls for the same name
+// return the same Builder; opts.SubRepositories and
+// opts.RepositoryDescription.Branches from every call are merged into
+// the builder so that submodules and branches discovered by a later
+// input are represented too, but other per-input differences (source,
+// and so on) belong on the data passed to Builder.Add, not on opts.
+//
+// Callers should call Reserve for name before Builder, so that a delta
+// collision or an abandoned name is caught before this call does any
+// work; Builder itself no longer decides whether a delta build may be
+// merged with another input, since by the time Builder runs a delta
+// build may already have silently fallen back to a normal build.
+func (g *Group) Builder(opts index.Options) (*index.Builder, error) {
+	name := opts.RepositoryDescription.Name
+	e, ok := g.entries[name]
+	if !ok {
+		// The caller skipped Reserve; there is nothing yet to collide
+		// with, so just reserve now.
+		e = &entry{requestedDelta: opts.IsDelta, reserved: 1}
+		g.entries[name] = e
+	}
+	if e.abandoned {
+		return nil, fmt.Errorf("buildgroup: %q was already abandoned in this group", name)
+	}
+	if e.builder == nil {
+		b, err := index.NewBuilder(opts)
+		if err != nil {
+			return nil, err
+		}
+		e.builder = b
+		return b, nil
+	}
+	if err := e.builder.MergeSubRepositories(opts.SubRepositories); err != nil {
+		return nil, err
+	}
+	if err := e.builder.MergeBranches(opts.RepositoryDescription.Branches); err != nil {
+		return nil, err
+	}
+	return e.builder, nil
+}
+
+// CheckPath records that path is about to be added as a document under
+// name by inputID, and returns an error if a document at the same
+// relative path was already recorded for name by a different inputID.
+// This is the group's duplicate relative-path policy for merged inputs:
+// two different inputs that resolve to the same repository name but
+// write to the same relative path (for example, both have a README.md at
+// their root) are treated as a conflict for that name, rather than
+// silently keeping one and dropping the other, or silently indexing both
+// under the same path. A single input revisiting its own path (for
+// example the same git repository indexing the same file on two
+// branches) is not a conflict and is not an error.
+//
+// inputID should identify the input a document came from (for example, a
+// directory argument, or a git repository's directory) - not the branch
+// or version a document came from within that input.
+//
+// Callers that may merge more than one input under a name should call
+// CheckPath for every document before adding it to the Builder returned
+// by Builder for that name. CheckPath itself does not touch the Builder;
+// on error, the caller decides how to respond (typically Abandon).
+func (g *Group) CheckPath(name, inputID, path string) error {
+	e, ok := g.entries[name]
+	if !ok {
+		return fmt.Errorf("buildgroup: CheckPath(%q, ...) called before Builder(%q, ...)", name, name)
+	}
+	if e.pathOwner == nil {
+		e.pathOwner = map[string]string{}
+	}
+	if owner, seen := e.pathOwner[path]; seen {
+		if owner != inputID {
+			return fmt.Errorf("buildgroup: path %q was added by more than one input merged under repository name %q", path, name)
+		}
+		return nil
+	}
+	e.pathOwner[path] = inputID
+	return nil
+}
+
+// Abandon gives up on the builder registered under name, if any: any
+// temporary shard data it already wrote is cleaned up (via
+// index.Builder.Abort), and the on-disk shards for name from a previous
+// index run are left completely untouched. Use this when one of several
+// inputs sharing name has failed, so the group's shards for that name are
+// not finished (and therefore not replaced) with only a partial result.
+// This also applies to a name that was Reserve'd but never got as far as
+// Builder, or to a name that was never even Reserve'd (for example, an
+// input that failed before it could resolve its own name and report it
+// accurately): there is no builder to abort in either case, but name is
+// still marked abandoned so a sibling input under the same name -
+// including one processed later that successfully Reserves it - can't be
+// finished (and published) on its own, leaving only a partial result for
+// a name that was supposed to be rolled back entirely.
+//
+// It is safe to call Abandon more than once, or for a name that was never
+// registered. After Abandon, further Reserve or Builder calls for the
+// same name return an error.
+func (g *Group) Abandon(name string) error {
+	e, ok := g.entries[name]
+	if !ok {
+		g.entries[name] = &entry{abandoned: true}
+		return nil
+	}
+	if e.abandoned {
+		return nil
+	}
+	e.abandoned = true
+	if e.builder == nil {
+		return nil
+	}
+	return e.builder.Abort()
+}
+
+// FinishAll calls Finish on every builder in the group that was not
+// abandoned, attempting every one even if an earlier one errors, and
+// returns every error encountered joined together (nil if there were
+// none). An entry that was Reserve'd but never reached Builder (and was
+// never abandoned either) has no builder and is skipped.
+func (g *Group) FinishAll() error {
+	var errs []error
+	for _, e := range g.entries {
+		if e.abandoned || e.builder == nil {
+			continue
+		}
+		if err := e.builder.Finish(); err != nil {
+			errs = append(errs, err)
+		}
+	}
+	return errors.Join(errs...)
+}
