+// claim registers the message as being handled. It reports duplicate=true
+// when an earlier copy was handled successfully. A copy that arrives while the
+// earlier one is still being handled waits for its outcome. The returned
+// release function must be called once with the outcome of the handling.
+func (d *Deduplicator) claim(ctx context.Context, key string) (duplicate bool, release func(success bool), err error) {
+	// takeover is set when an earlier copy did not finish within the timeout:
+	// the key is already remembered, but this copy has to be handled as well.
+	takeover := false
+
+	for {
+		d.mu.Lock()
+		if d.inflight == nil {
+			d.inflight = map[string]*handling{}
+		}
+		other, ok := d.inflight[key]
+		if !ok {
+			own := &handling{done: make(chan struct{})}
+			d.inflight[key] = own
+			d.mu.Unlock()
+
+			release = func(success bool) {
+				d.mu.Lock()
+				abandoned := own.abandoned
+				if d.inflight[key] == own {
+					delete(d.inflight, key)
+				}
+				own.succeeded = success
+				d.mu.Unlock()
+
+				// The key belongs to the copy that took over from this one.
+				if !success && !abandoned {
+					d.forget(ctx, key)
+				}
+				close(own.done)
+			}
+
+			if takeover {
+				return false, release, nil
+			}
+
+			repoCtx, cancel := context.WithTimeout(ctx, d.Timeout)
+			seen, err := d.Repository.IsDuplicate(repoCtx, key)
+			cancel()
+			if err != nil {
+				release(false)
+				return false, nil, err
+			}
+			if seen {
+				release(true)
+				return true, nil, nil
+			}
+			return false, release, nil
+		}
+		d.mu.Unlock()
+
+		timer := time.NewTimer(d.Timeout)
+		select {
+		case <-other.done:
+			timer.Stop()
+		case <-ctx.Done():
+			timer.Stop()
+			return false, nil, ctx.Err()
+		case <-timer.C:
+			d.mu.Lock()
+			if d.inflight[key] == other {
+				other.abandoned = true
+				delete(d.inflight, key)
+				takeover = true
+			}
+			d.mu.Unlock()
