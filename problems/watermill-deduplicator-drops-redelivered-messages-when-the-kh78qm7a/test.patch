+func TestDeduplicatorRouterRedeliversAfterNackWm9d3k(t *testing.T) {
+	logger := watermill.NopLogger{}
+	pubSub := gochannel.NewGoChannel(gochannel.Config{}, logger)
+	defer func() { _ = pubSub.Close() }()
+
+	router, err := message.NewRouter(message.RouterConfig{}, logger)
+	require.NoError(t, err)
+	router.AddMiddleware((&middleware.Deduplicator{}).Middleware)
+
+	var attempts atomic.Int32
+	handled := make(chan struct{})
+	router.AddConsumerHandler("handler", "orders", pubSub, func(*message.Message) error {
+		if attempts.Add(1) == 1 {
+			return errors.New("temporary failure")
+		}
+		close(handled)
+		return nil
+	})
+
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	go func() { _ = router.Run(ctx) }()
+	<-router.Running()
+
+	require.NoError(t, pubSub.Publish("orders", payloadMsgWm9d3k("order")))
+
+	select {
+	case <-handled:
+	case <-time.After(3 * time.Second):
+		t.Fatalf("the nacked message was never handled again (attempts: %d)", attempts.Load())
+	}
+}
