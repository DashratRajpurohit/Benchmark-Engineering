+func TestDeduplicatorPublisherOverlappingBatchesCompleteWm9d3k(t *testing.T) {
+	for round := range 25 {
+		var mu sync.Mutex
+		var out []string
+		pub := publisherFuncWm9d3k(func(_ string, msgs ...*message.Message) error {
+			time.Sleep(20 * time.Millisecond)
+			mu.Lock()
+			defer mu.Unlock()
+			for _, m := range msgs {
+				out = append(out, string(m.Payload))
+			}
+			return nil
+		})
+		decorated, err := (&middleware.Deduplicator{Repository: &slowRepositoryWm9d3k{}}).PublisherDecorator()(pub)
+		require.NoError(t, err)
+
+		first := publishAsyncWm9d3k(decorated, payloadMsgWm9d3k("a"), payloadMsgWm9d3k("b"))
+		second := publishAsyncWm9d3k(decorated, payloadMsgWm9d3k("b"), payloadMsgWm9d3k("a"))
+
+		require.NoError(t, expectResultWm9d3k(t, first, "first batch").err, "round %d", round)
+		mu.Lock()
+		assert.Subset(t, out, []string{"a", "b"}, "round %d: first batch returned early", round)
+		mu.Unlock()
+
+		require.NoError(t, expectResultWm9d3k(t, second, "second batch").err, "round %d", round)
+		mu.Lock()
+		assert.ElementsMatch(t, []string{"a", "b"}, out, "round %d", round)
+		mu.Unlock()
+	}
+}
