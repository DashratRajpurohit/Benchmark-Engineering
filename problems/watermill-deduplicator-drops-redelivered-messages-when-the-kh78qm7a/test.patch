@@ -0,0 +1,67 @@
+#!/usr/bin/env bash
+# Usage: ./test.sh [--output_path <junit.xml>] [base|new]
+set -uo pipefail
+
+OUTPUT_PATH=""
+if [ "${1:-}" = "--output_path" ]; then
+  OUTPUT_PATH="$2"
+  shift 2
+  case "$OUTPUT_PATH" in
+    /*) ;;
+    *) OUTPUT_PATH="$PWD/$OUTPUT_PATH" ;;
+  esac
+fi
+
+[ -f go.mod ] || cd "$(dirname "$0")"
+
+MODE="${1:-}"
+
+if [ -n "$OUTPUT_PATH" ] && [ -z "$MODE" ]; then
+  echo "--output_path needs a mode: base or new" >&2
+  exit 2
+fi
+
+if [ -n "$MODE" ]; then
+  TEST_LOG="$(mktemp)"
+  STATUS=0
+
+  run_tests() {
+    go test -count=1 -v "$@" 2>&1 | tee -a "$TEST_LOG"
+    status=${PIPESTATUS[0]}
+    if [ "$status" -ne 0 ]; then
+      STATUS=$status
+    fi
+  }
+
+  case "$MODE" in
+    base)
+      # One existing test measures a 5ms expiry window and cannot be relied on under load.
+      run_tests -tags Wm9d3kbas -timeout 600s ./message/ ./components/delay/
+      existing=$(go test -tags Wm9d3kbas -list '.*' ./message/router/middleware/ | grep -E '^Test' \
+        | grep -v -E 'RepositoryCleanup' | paste -sd '|' -)
+      run_tests -tags Wm9d3kbas -timeout 600s -run "^(${existing})\$" ./message/router/middleware/
+      ;;
+    new)
+      run_tests -tags Wm9d3knew -run 'Wm9d3k' -timeout 600s ./message/router/middleware/ ./components/delay/
+      ;;
+    *)
+      echo "unknown mode: $MODE (expected base or new)" >&2
+      exit 2
+      ;;
+  esac
+
+  if [ -n "$OUTPUT_PATH" ]; then
+    go-junit-report < "$TEST_LOG" > "$OUTPUT_PATH"
+    junit_status=$?
+    if [ "$junit_status" -ne 0 ] && [ "$STATUS" -eq 0 ]; then
+      echo "go-junit-report failed (exit $junit_status)" >&2
+      STATUS=$junit_status
+    fi
+  fi
+
+  exit "$STATUS"
+fi
+
+set +u +o pipefail
+set -e
+go test -count=1 -timeout 600s ./message/... ./components/delay/
