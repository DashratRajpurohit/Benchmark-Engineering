+func TestDeduplicatorPublisherForgetsBatchWhenKeyingFailsWm9d3k(t *testing.T) {
+	hasher := middleware.NewMessageHasherSHA256(1024)
+	var failOnBad atomic.Bool
+	failOnBad.Store(true)
+	pub := &recordingPublisherWm9d3k{}
+	decorated, err := (&middleware.Deduplicator{
+		KeyFactory: func(m *message.Message) (string, error) {
+			if failOnBad.Load() && string(m.Payload) == "bad" {
+				return "", errors.New("cannot hash")
+			}
+			return hasher(m)
+		},
+	}).PublisherDecorator()(pub)
+	require.NoError(t, err)
+
+	require.Error(t, decorated.Publish("topic", payloadMsgWm9d3k("a"), payloadMsgWm9d3k("bad")))
+	assert.Empty(t, pub.published())
+
+	failOnBad.Store(false)
+	require.NoError(t, decorated.Publish("topic", payloadMsgWm9d3k("a"), payloadMsgWm9d3k("bad")))
+	assert.Equal(t, []string{"a", "bad"}, pub.published())
+}
