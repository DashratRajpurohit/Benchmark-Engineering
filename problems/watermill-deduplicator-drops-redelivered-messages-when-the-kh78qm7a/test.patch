+
+	second := deliverWm9d3k(h, payloadMsgWm9d3k("order"))
+	copies.waitEntered(t, 1)
+	require.NoError(t, expectResultWm9d3k(t, second, "second copy").err)
+
+	close(release)
+	require.Error(t, expectResultWm9d3k(t, first, "first copy").err)
+
+	r := expectResultWm9d3k(t, deliverWm9d3k(h, payloadMsgWm9d3k("order")), "third copy")
+	require.NoError(t, r.err)
+	assert.EqualValues(t, 2, calls.Load(),
+		"the late failure of the first copy must not undo the success of the second")
+}
+
+func TestDeduplicatorPublisherStressWm9d3k(t *testing.T) {
+	const callers, keys = 8, 5
+
+	var mu sync.Mutex
+	published := map[string]int{}
+	var attempts atomic.Int32
+	pub := publisherFuncWm9d3k(func(_ string, msgs ...*message.Message) error {
+		time.Sleep(time.Millisecond)
+		if attempts.Add(1)%2 == 1 {
+			return errors.New("broker down")
+		}
+		mu.Lock()
+		defer mu.Unlock()
+		for _, m := range msgs {
+			published[string(m.Payload)]++
+		}
+		return nil
+	})
+	decorated, err := (&middleware.Deduplicator{}).PublisherDecorator()(pub)
+	require.NoError(t, err)
+
+	// The very first publish fails, as a broker that is not ready yet would.
+	var all []*message.Message
+	for k := range keys {
+		all = append(all, payloadMsgWm9d3k("key"+string(rune('0'+k))))
+	}
+	require.Error(t, decorated.Publish("topic", all...))
+
+	type call struct {
+		keys []string
+		err  error
+	}
+	results := make(chan call, callers*4)
+	var wg sync.WaitGroup
+	for c := range callers {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			for round := range 4 {
+				var batch []*message.Message
+				var names []string
+				for k := range keys {
+					if (c+round+k)%2 == 0 || k == (c+round)%keys {
+						name := "key" + string(rune('0'+(k+c*round)%keys))
+						names = append(names, name)
+						batch = append(batch, payloadMsgWm9d3k(name))
+					}
+				}
+				results <- call{names, decorated.Publish("topic", batch...)}
+			}
+		}()
+	}
+
+	done := make(chan struct{})
+	go func() { wg.Wait(); close(done) }()
+	select {
+	case <-done:
+	case <-time.After(15 * time.Second):
+		t.Fatalf("publishes never finished")
+	}
+	close(results)
+
+	mu.Lock()
+	defer mu.Unlock()
+	for name, n := range published {
+		assert.Equal(t, 1, n, "%s published more than once", name)
+	}
+	for r := range results {
+		if r.err != nil {
+			continue
+		}
+		for _, name := range r.keys {
+			assert.Contains(t, published, name, "a publish returned without an error but %s was never published", name)
+		}
+	}
+}
diff --git a/message/router/middleware/helpers_wm9d3k_test.go b/message/router/middleware/helpers_wm9d3k_test.go
new file mode 100644
index 00000000..d4c6cc8e
--- /dev/null
+++ b/message/router/middleware/helpers_wm9d3k_test.go
@@ -0,0 +1,201 @@
+//go:build Wm9d3knew || Wm9d3kbas
+
+package middleware_test
+
+import (
+	"context"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/ThreeDotsLabs/watermill/message"
+	"github.com/ThreeDotsLabs/watermill/message/router/middleware"
+)
+
+// copiesWm9d3k counts how many messages went through the key factory, so a
+// test can tell that a message has entered the deduplicator.
+type copiesWm9d3k struct {
+	entered chan struct{}
+	count   atomic.Int32
+	hasher  middleware.MessageHasher
+}
+
+func newCopiesWm9d3k() *copiesWm9d3k {
+	return &copiesWm9d3k{
+		entered: make(chan struct{}, 16),
+		hasher:  middleware.NewMessageHasherSHA256(1024),
+	}
+}
+
+func (c *copiesWm9d3k) keyFactory(m *message.Message) (string, error) {
+	c.count.Add(1)
+	c.entered <- struct{}{}
+	return c.hasher(m)
+}
+
+func (c *copiesWm9d3k) waitEntered(t *testing.T, n int) {
+	t.Helper()
+
+	for range n {
+		select {
+		case <-c.entered:
+		case <-time.After(5 * time.Second):
+			t.Fatalf("message never reached the deduplicator")
+		}
+	}
+}
+
+type resultWm9d3k struct {
+	produced []*message.Message
+	err      error
+}
+
+// deliverWm9d3k runs the handler for a message in the background.
+func deliverWm9d3k(h message.HandlerFunc, msg *message.Message) <-chan resultWm9d3k {
+	out := make(chan resultWm9d3k, 1)
+	go func() {
+		produced, err := h(msg)
+		out <- resultWm9d3k{produced, err}
+	}()
+	return out
+}
+
+func expectPendingWm9d3k(t *testing.T, ch <-chan resultWm9d3k, what string) {
+	t.Helper()
+
+	select {
+	case r := <-ch:
+		t.Fatalf("%s returned early (err: %v)", what, r.err)
+	case <-time.After(200 * time.Millisecond):
+	}
+}
+
+func expectResultWm9d3k(t *testing.T, ch <-chan resultWm9d3k, what string) resultWm9d3k {
+	t.Helper()
+
+	select {
+	case r := <-ch:
+		return r
+	case <-time.After(5 * time.Second):
+		t.Fatalf("%s never returned", what)
+		return resultWm9d3k{}
+	}
+}
+
+func payloadMsgWm9d3k(payload string) *message.Message {
+	return message.NewMessage(payload+"-uuid", []byte(payload))
+}
+
+// recordingPublisherWm9d3k stores the batches it was asked to publish and
+// fails the first failures publishes.
+type recordingPublisherWm9d3k struct {
+	mu       sync.Mutex
+	failures int
+	calls    int
+	payloads []string
+}
+
+func (p *recordingPublisherWm9d3k) Publish(_ string, msgs ...*message.Message) error {
+	p.mu.Lock()
+	defer p.mu.Unlock()
+
+	p.calls++
+	if p.failures > 0 {
+		p.failures--
+		return context.DeadlineExceeded
+	}
+	for _, m := range msgs {
+		p.payloads = append(p.payloads, string(m.Payload))
+	}
+	return nil
+}
+
+func (p *recordingPublisherWm9d3k) Close() error { return nil }
+
+func (p *recordingPublisherWm9d3k) published() []string {
+	p.mu.Lock()
+	defer p.mu.Unlock()
+
+	return append([]string(nil), p.payloads...)
+}
+
+// gatedPublisherWm9d3k blocks every Publish until released, then answers with
+// the next scripted result.
+type gatedPublisherWm9d3k struct {
+	mu       sync.Mutex
+	entered  chan struct{}
+	gate     chan struct{}
+	results  []error
+	payloads []string
+}
+
+func newGatedPublisherWm9d3k(results ...error) *gatedPublisherWm9d3k {
+	return &gatedPublisherWm9d3k{
+		entered: make(chan struct{}, 64),
+		gate:    make(chan struct{}),
+		results: results,
+	}
+}
+
+func (p *gatedPublisherWm9d3k) Publish(_ string, msgs ...*message.Message) error {
+	if len(msgs) == 0 {
+		return nil
+	}
+	p.entered <- struct{}{}
+	<-p.gate
+
+	p.mu.Lock()
+	defer p.mu.Unlock()
+
+	if len(p.results) > 0 {
+		err := p.results[0]
+		p.results = p.results[1:]
+		if err != nil {
+			return err
+		}
+	}
+	for _, m := range msgs {
+		p.payloads = append(p.payloads, string(m.Payload))
+	}
+	return nil
+}
+
+func (p *gatedPublisherWm9d3k) Close() error { return nil }
+
+func (p *gatedPublisherWm9d3k) published() []string {
+	p.mu.Lock()
+	defer p.mu.Unlock()
+
+	return append([]string(nil), p.payloads...)
+}
+
+// slowRepositoryWm9d3k is a minimal repository whose lookups take a while.
+type slowRepositoryWm9d3k struct {
+	mu   sync.Mutex
+	seen map[string]struct{}
+}
+
+func (r *slowRepositoryWm9d3k) IsDuplicate(_ context.Context, key string) (bool, error) {
+	time.Sleep(2 * time.Millisecond)
+
+	r.mu.Lock()
+	defer r.mu.Unlock()
+
+	if r.seen == nil {
+		r.seen = map[string]struct{}{}
+	}
+	if _, ok := r.seen[key]; ok {
+		return true, nil
+	}
+	r.seen[key] = struct{}{}
+	return false, nil
+}
+
+type publisherFuncWm9d3k func(topic string, msgs ...*message.Message) error
+
+func (f publisherFuncWm9d3k) Publish(topic string, msgs ...*message.Message) error {
+	return f(topic, msgs...)
+}
+
+func (f publisherFuncWm9d3k) Close() error { return nil }
