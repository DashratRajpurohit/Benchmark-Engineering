@@ -0,0 +1,123 @@
+//go:build Wm9d3knew
+
+package middleware_test
+
+import (
+	"context"
+	"errors"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+
+	"github.com/ThreeDotsLabs/watermill/components/delay"
+	"github.com/ThreeDotsLabs/watermill/message"
+	"github.com/ThreeDotsLabs/watermill/message/router/middleware"
+)
+
+func TestDelayOnErrorAppliesFractionalMultiplierWm9d3k(t *testing.T) {
+	m := middleware.DelayOnError{
+		InitialInterval: time.Second,
+		MaxInterval:     4 * time.Second,
+		Multiplier:      1.5,
+	}
+	h := m.Middleware(func(*message.Message) ([]*message.Message, error) {
+		return nil, errors.New("error")
+	})
+
+	msg := message.NewMessage("1", []byte("test"))
+	var got []string
+	for range 5 {
+		_, _ = h(msg)
+		got = append(got, msg.Metadata.Get(delay.DelayedForKey))
+	}
+
+	assert.Equal(t, []string{"1s", "1.5s", "2.25s", "3.375s", "4s"}, got)
+}
+
+func TestThrottleStopsWaitingWhenMessageIsCancelledWm9d3k(t *testing.T) {
+	throttle := middleware.NewThrottle(1, time.Hour)
+	handled := false
+	h := throttle.Middleware(func(*message.Message) ([]*message.Message, error) {
+		handled = true
+		return nil, nil
+	})
+
+	ctx, cancel := context.WithCancel(context.Background())
+	msg := message.NewMessage("1", nil)
+	msg.SetContext(ctx)
+	result := deliverWm9d3k(h, msg)
+
+	expectPendingWm9d3k(t, result, "a throttled message")
+	cancel()
+
+	r := expectResultWm9d3k(t, result, "cancelled message")
+	require.ErrorIs(t, r.err, context.Canceled)
+	assert.False(t, handled)
+}
+
+func TestDeduplicatorConcurrentCopiesAreHandledOneAtATimeWm9d3k(t *testing.T) {
+	const keys, copies = 8, 6
+
+	var mu sync.Mutex
+	active := map[string]int{}
+	attempts := map[string]int{}
+	successes := map[string]int{}
+	overlapped := false
+
+	failures := func(key string) int { return int(key[len(key)-1]-'0') % 4 }
+
+	h := (&middleware.Deduplicator{}).Middleware(func(m *message.Message) ([]*message.Message, error) {
+		key := string(m.Payload)
+
+		mu.Lock()
+		attempts[key]++
+		attempt := attempts[key]
+		active[key]++
+		if active[key] > 1 {
+			overlapped = true
+		}
+		mu.Unlock()
+
+		time.Sleep(time.Millisecond)
+
+		mu.Lock()
+		defer mu.Unlock()
+		active[key]--
+		if attempt <= failures(key) {
+			return nil, errors.New("temporary failure")
+		}
+		successes[key]++
+		return nil, nil
+	})
+
+	var wg sync.WaitGroup
+	for k := range keys {
+		for range copies {
+			wg.Add(1)
+			go func() {
+				defer wg.Done()
+				_, _ = h(payloadMsgWm9d3k("key" + string(rune('0'+k))))
+			}()
+		}
+	}
+
+	done := make(chan struct{})
+	go func() { wg.Wait(); close(done) }()
+	select {
+	case <-done:
+	case <-time.After(10 * time.Second):
+		t.Fatalf("copies never finished")
+	}
+
+	mu.Lock()
+	defer mu.Unlock()
+	assert.False(t, overlapped, "two copies of one message were handled at the same time")
+	for k := range keys {
+		key := "key" + string(rune('0'+k))
+		assert.Equal(t, 1, successes[key], key)
+		assert.Equal(t, failures(key)+1, attempts[key], key)
+	}
+}
