@@ -0,0 +1,155 @@
+//go:build newtest
+
+package cdc
+
+import (
+	"net/http"
+	"net/http/httptest"
+	"sync"
+	"testing"
+	"time"
+)
+
+// Test_Queue_ConcurrentCloseNeverHangs drives every public Queue method
+// (Enqueue, DeleteRange, FirstKey, HighestKey, Empty, Len, HasNext)
+// concurrently with Close, from many goroutines, across many iterations.
+//
+// The queue's managing goroutine exits as soon as Close is called. A method
+// that only checks "is the queue closed?" before sending its request on a
+// channel has a race: Close can complete, and the managing goroutine can
+// exit, in the window between that check and the send (or between the send
+// and receiving the response). When that happens the method blocks forever,
+// because nothing is left to read the request or answer it. This must never
+// happen for any method, no matter when Close is called relative to an
+// in-flight call.
+func Test_Queue_ConcurrentCloseNeverHangs(t *testing.T) {
+	const iterations = 200
+	const callersPerMethod = 4
+
+	for iter := 0; iter < iterations; iter++ {
+		q, _, _ := newTestQueue(t)
+
+		var wg sync.WaitGroup
+		start := func(fn func()) {
+			wg.Add(1)
+			go func() {
+				defer wg.Done()
+				fn()
+			}()
+		}
+
+		for i := 0; i < callersPerMethod; i++ {
+			start(func() { _ = q.Enqueue(&Event{Index: 1, Data: []byte("x")}) })
+			start(func() { _ = q.DeleteRange(1) })
+			start(func() { _, _ = q.FirstKey() })
+			start(func() { _, _ = q.HighestKey() })
+			start(func() { _, _ = q.Empty() })
+			start(func() { _ = q.Len() })
+			start(func() { _ = q.HasNext() })
+		}
+
+		// Close concurrently with the calls above, not after them, so the
+		// race window between each method's closed-check and its channel
+		// operation is actually exercised.
+		start(func() { q.Close() })
+
+		done := make(chan struct{})
+		go func() {
+			wg.Wait()
+			close(done)
+		}()
+
+		select {
+		case <-done:
+		case <-time.After(10 * time.Second):
+			t.Fatalf("iteration %d: at least one Queue method call is still blocked "+
+				"10s after Close was invoked concurrently with it", iter)
+		}
+	}
+}
+
+// Test_Service_StatsNeverHangsDuringStop confirms that Service.Stats, which
+// reads Queue.HasNext and Queue.Len, remains safe to call concurrently with
+// Service.Stop. Stop closes the underlying FIFO queue; a caller polling
+// Stats (as a status/diagnostics endpoint would) must never be left blocked
+// because the queue was closed out from under it mid-call.
+func Test_Service_StatsNeverHangsDuringStop(t *testing.T) {
+	ResetStats()
+
+	testSrv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		defer r.Body.Close()
+		w.WriteHeader(http.StatusOK)
+	}))
+	defer testSrv.Close()
+
+	cl := &mockCluster{}
+	cfg := DefaultConfig()
+	cfg.Endpoint = testSrv.URL
+
+	svc, err := NewService("node1", t.TempDir(), cl, cfg)
+	if err != nil {
+		t.Fatalf("failed to create service: %v", err)
+	}
+	if err := svc.Start(); err != nil {
+		t.Fatalf("failed to start service: %v", err)
+	}
+
+	var wg sync.WaitGroup
+	stop := make(chan struct{})
+
+	// Repeatedly poll Stats, as a status endpoint would, until told to stop.
+	wg.Add(1)
+	go func() {
+		defer wg.Done()
+		for {
+			select {
+			case <-stop:
+				return
+			default:
+			}
+			_, _ = svc.Stats()
+		}
+	}()
+
+	// Give the poller a moment to be actively calling Stats, then stop the
+	// service while it's in flight.
+	time.Sleep(10 * time.Millisecond)
+
+	stopped := make(chan struct{})
+	go func() {
+		svc.Stop()
+		close(stopped)
+	}()
+
+	select {
+	case <-stopped:
+	case <-time.After(10 * time.Second):
+		t.Fatal("Service.Stop did not return within 10s while Stats was being polled concurrently")
+	}
+
+	close(stop)
+
+	waitDone := make(chan struct{})
+	go func() {
+		wg.Wait()
+		close(waitDone)
+	}()
+
+	select {
+	case <-waitDone:
+	case <-time.After(10 * time.Second):
+		t.Fatal("a Stats poller goroutine is still blocked 10s after Stop returned")
+	}
+
+	// One final call after Stop must also return promptly rather than hang.
+	done := make(chan struct{})
+	go func() {
+		_, _ = svc.Stats()
+		close(done)
+	}()
+	select {
+	case <-done:
+	case <-time.After(10 * time.Second):
+		t.Fatal("Stats called after Stop is blocked")
+	}
+}
