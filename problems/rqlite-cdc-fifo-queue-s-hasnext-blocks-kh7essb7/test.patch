+#!/usr/bin/env bash
+# Test runner for the CDC FIFO queue shutdown-contract regression.
+#
+# Usage:
+#   ./test.sh [--output_path <junit.xml>] <base|new>
+#
+# base  runs the pre-existing cdc package regression suite (excluding the
+#       new tests below). Must pass both before and after the solution.
+# new   runs the new regression tests:
+#         - Test_Queue_ConcurrentCloseNeverHangs: drives every public Queue
+#           method concurrently with Close across many iterations and
+#           asserts none of them ever blocks forever.
+#         - Test_Service_StatsNeverHangsDuringStop: confirms Service.Stats
+#           (which reads Queue.HasNext/Len) stays safe to call concurrently
+#           with Service.Stop.
+#       Both fail (time out) before the solution and pass after it.
+set -uo pipefail
+
+cd /app
+
+OUTPUT_PATH=""
+if [ "${1:-}" = "--output_path" ]; then
+  OUTPUT_PATH="$2"
+  shift 2
+fi
+
+MODE="${1:-new}"
+
+TEST_LOG="$(mktemp)"
+STATUS=0
+
+run_tests() {
+  shift_args=("$@")
+  go test -count=1 -v "${shift_args[@]}" 2>&1 | tee -a "$TEST_LOG"
+  status=${PIPESTATUS[0]}
+  if [ "$status" -ne 0 ]; then
+    STATUS=$status
+  fi
+}
+
+case "$MODE" in
+  base)
+    # The new regression tests live in a file guarded by the "newtest" build
+    # tag, so a plain build (no tags) excludes them entirely and runs only
+    # the pre-existing cdc package suite.
+    run_tests -timeout 60s ./cdc/...
+    ;;
+  new)
+    run_tests -tags newtest -run '^(Test_Queue_ConcurrentCloseNeverHangs|Test_Service_StatsNeverHangsDuringStop)$' -timeout 120s ./cdc/...
+    ;;
+  *)
+    echo "unknown mode: $MODE (expected base or new)" >&2
+    exit 2
+    ;;
+esac
+
+if [ -n "$OUTPUT_PATH" ]; then
+  go-junit-report -set-exit-code < "$TEST_LOG" > "$OUTPUT_PATH"
+  junit_status=$?
+  if [ "$junit_status" -ne 0 ] && [ "$STATUS" -eq 0 ]; then
+    echo "go-junit-report failed to convert the test log (exit $junit_status)" >&2
+    STATUS=$junit_status
+  fi
+fi
+
+exit "$STATUS"
