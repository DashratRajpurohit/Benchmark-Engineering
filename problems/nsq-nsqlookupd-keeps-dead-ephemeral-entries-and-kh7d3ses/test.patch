+func TestNodeThatStopsPingingIsForgottenRg5e1b(t *testing.T) {
+	const timeout = 500 * time.Millisecond
+	l := startLookupdRg5e1b(t, timeout)
+	start := time.Now()
+
+	quiet := joinRg5e1b(t, l, "10.1.0.8", 4151)
+	quiet.ok(nsq.Register("hush#ephemeral", "c"))
+	quiet.ok(nsq.Register("ledger", "c"))
+
+	// busy keeps talking to nsqlookupd, several commands at a time, but never
+	// with a PING
+	busy := joinRg5e1b(t, l, "10.1.0.11", 4151)
+	busy.ok(nsq.Register("busy#ephemeral", "c"))
+
+	chatty := joinRg5e1b(t, l, "10.1.0.9", 4151)
+	chatty.ok(nsq.Register("chatter#ephemeral", "c"))
+
+	stop := make(chan struct{})
+	busyDone := keepSendingRg5e1b(busy, nsq.UnRegister("noise", ""), 3, 100*time.Millisecond, stop)
+	chattyDone := keepSendingRg5e1b(chatty, nsq.Ping(), 1, 100*time.Millisecond, stop)
+	defer func() {
+		select {
+		case <-stop:
+		default:
+			close(stop)
+		}
+	}()
+
+	// the nodes that stopped pinging lose their ephemeral entries, while the
+	// pinging node keeps its own for at least three inactive timeouts
+	deadline := start.Add(5 * time.Second)
+	forgotten := false
+	for !forgotten || time.Now().Before(start.Add(3*timeout)) {
+		topics := topicsRg5e1b(t, l)
+		if !containsRg5e1b(topics, "chatter#ephemeral") {
+			t.Fatalf("a node that keeps pinging lost its topic after %s", time.Since(start))
+		}
+		test.Equal(t, true, containsRg5e1b(topics, "ledger"))
+		forgotten = !containsRg5e1b(topics, "hush#ephemeral") && !containsRg5e1b(topics, "busy#ephemeral")
+		if !forgotten && time.Now().After(deadline) {
+			t.Fatalf("nodes without a PING for %s are still registered: %v", time.Since(start), topics)
+		}
+		time.Sleep(20 * time.Millisecond)
+	}
+
+	close(stop)
+	test.Nil(t, <-chattyDone)
+	<-busyDone
+	chatty.ok(nsq.Ping())
+	test.Equal(t, true, containsRg5e1b(topicsRg5e1b(t, l), "chatter#ephemeral"))
+}
