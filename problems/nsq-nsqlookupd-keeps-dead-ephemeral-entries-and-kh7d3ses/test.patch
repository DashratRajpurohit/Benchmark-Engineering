+// keepSendingRg5e1b writes cmd n times back to back every interval until stop
+// is closed, reads the n responses, and reports the first failure, if any.
+func keepSendingRg5e1b(p *peerRg5e1b, cmd *nsq.Command, n int, interval time.Duration, stop chan struct{}) chan error {
+	done := make(chan error, 1)
+	go func() {
+		ticker := time.NewTicker(interval)
+		defer ticker.Stop()
+		for {
+			select {
+			case <-stop:
+				done <- nil
+				return
+			case <-ticker.C:
+			}
+			_ = p.conn.SetDeadline(time.Now().Add(5 * time.Second))
+			var batch bytes.Buffer
+			for i := 0; i < n; i++ {
+				_, _ = cmd.WriteTo(&batch)
+			}
+			if _, err := p.conn.Write(batch.Bytes()); err != nil {
+				done <- err
+				return
+			}
+			for i := 0; i < n; i++ {
+				if _, err := nsq.ReadResponse(p.conn); err != nil {
+					done <- err
+					return
+				}
+			}
+		}
+	}()
+	return done
+}
