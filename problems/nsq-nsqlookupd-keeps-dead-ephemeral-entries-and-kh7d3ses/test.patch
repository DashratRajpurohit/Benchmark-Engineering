+// pauseLoggerRg5e1b is an nsqlookupd logger that holds the goroutine logging
+// the first line mentioning mark until release is closed. nsqlookupd logs
+// each registration as it makes it, so this pauses the connection that
+// registered mark right after the registration.
+type pauseLoggerRg5e1b struct {
+	mark    string
+	paused  chan struct{}
+	release chan struct{}
+	once    sync.Once
+}
+
+func (l *pauseLoggerRg5e1b) Output(_ int, s string) error {
+	if strings.Contains(s, l.mark) {
+		l.once.Do(func() {
+			close(l.paused)
+			<-l.release
+		})
+	}
+	return nil
+}
+
+// A node that has gone longer than --inactive-producer-timeout without a PING
+// is dead, however much else it sends. The node here stops pinging and sends
+// a burst of REGISTERs for durable topics in one write. nsqlookupd is held
+// right after the first of them until the timeout has passed, with the rest
+// already read. That first topic was registered in time and, being durable,
+// stays; nothing may be registered for the node after the timeout.
+func TestNothingRegistersForANodePastItsTimeoutRg5e1b(t *testing.T) {
+	const timeout = time.Second
+	pause := &pauseLoggerRg5e1b{mark: "gate7q", paused: make(chan struct{}), release: make(chan struct{})}
+	opts := nsqlookupd.NewOptions()
+	opts.Logger = pause
+	opts.TCPAddress = "127.0.0.1:0"
+	opts.HTTPAddress = "127.0.0.1:0"
+	opts.InactiveProducerTimeout = timeout
+	nl, err := nsqlookupd.New(opts)
+	test.Nil(t, err)
+	go func() { _ = nl.Main() }()
+	t.Cleanup(nl.Exit)
+	defer func() {
+		select {
+		case <-pause.release:
+		default:
+			close(pause.release)
+		}
+	}()
+	l := &lookupdRg5e1b{tcpAddr: nl.RealTCPAddr().String(), httpAddr: nl.RealHTTPAddr().String()}
+
+	p := joinRg5e1b(t, l, "10.2.0.1", 4151)
+	joined := time.Now()
+	var burst bytes.Buffer
+	_, _ = nsq.Register("gate7q", "").WriteTo(&burst)
+	for i := 0; i < 20; i++ {
+		_, _ = nsq.Register(fmt.Sprintf("late%02d", i), "").WriteTo(&burst)
+	}
+	test.Nil(t, p.conn.SetDeadline(joined.Add(timeout+10*time.Second)))
+	_, err = p.conn.Write(burst.Bytes())
+	test.Nil(t, err)
+
+	select {
+	case <-pause.paused:
+	case <-time.After(timeout / 2):
+		t.Fatal("nsqlookupd did not register gate7q")
+	}
+	time.Sleep(time.Until(joined.Add(timeout + 200*time.Millisecond)))
+	close(pause.release)
+
+	// read whatever replies come until nsqlookupd drops the connection
+	for {
+		if _, err := nsq.ReadResponse(p.conn); err != nil {
+			break
+		}
+	}
+	test.Equal(t, []string{"gate7q"}, topicsRg5e1b(t, l))
+}
