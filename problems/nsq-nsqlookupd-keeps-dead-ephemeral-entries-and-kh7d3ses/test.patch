+//go:build lookupdreg
+
+package nsqd_test
+
+import (
+	"bufio"
+	"encoding/binary"
+	"fmt"
+	"io"
+	"log"
+	"math"
+	"net"
+	"net/http"
+	"os"
+	"os/exec"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/nsqio/nsq/internal/test"
+	"github.com/nsqio/nsq/nsqd"
+)
+
+const (
+	nsqdChildEnvRg5e1b   = "NSQD_CHILD_RG5E1B"
+	nsqdLookupdEnvRg5e1b = "NSQD_CHILD_LOOKUPD_RG5E1B"
+)
+
+// lookupdChildRg5e1b runs nsqd in a separate process so a crash in nsqd is
+// observed as a dead server rather than a dead test.
+func lookupdChildRg5e1b() {
+	dataPath, err := os.MkdirTemp("", "nsq-test-")
+	if err != nil {
+		fmt.Println("ERR", err)
+		os.Exit(1)
+	}
+	defer os.RemoveAll(dataPath)
+	opts := nsqd.NewOptions()
+	opts.Logger = log.New(io.Discard, "", 0)
+	opts.TCPAddress = "127.0.0.1:0"
+	opts.HTTPAddress = "127.0.0.1:0"
+	opts.HTTPSAddress = "127.0.0.1:0"
+	opts.DataPath = dataPath
+	opts.NSQLookupdTCPAddresses = []string{os.Getenv(nsqdLookupdEnvRg5e1b)}
+	n, err := nsqd.New(opts)
+	if err != nil {
+		fmt.Println("ERR", err)
+		os.Exit(1)
+	}
+	go func() { _ = n.Main() }()
+	fmt.Println("ADDR", n.RealHTTPAddr())
+	_, _ = io.Copy(io.Discard, os.Stdin)
+	n.Exit()
+}
+
+func TestNSQDSurvivesLookupdReplyWithBadSizeRg5e1b(t *testing.T) {
+	if os.Getenv(nsqdChildEnvRg5e1b) == "1" {
+		lookupdChildRg5e1b()
+		return
+	}
+
+	for _, size := range []int64{-1, math.MinInt32} {
+		t.Run(fmt.Sprint(size), func(t *testing.T) {
+			fake, err := net.Listen("tcp", "127.0.0.1:0")
+			test.Nil(t, err)
+			defer fake.Close()
+
+			cmd := exec.Command(os.Args[0], "-test.run=^TestNSQDSurvivesLookupdReplyWithBadSizeRg5e1b$")
+			cmd.Env = append(os.Environ(), nsqdChildEnvRg5e1b+"=1", nsqdLookupdEnvRg5e1b+"="+fake.Addr().String())
+			stdin, err := cmd.StdinPipe()
+			test.Nil(t, err)
+			stdout, err := cmd.StdoutPipe()
+			test.Nil(t, err)
+			cmd.Stderr = io.Discard
+			test.Nil(t, cmd.Start())
+			exited := make(chan struct{})
+			go func() {
+				_ = cmd.Wait()
+				close(exited)
+			}()
+			defer func() {
+				_ = stdin.Close()
+				select {
+				case <-exited:
+				case <-time.After(10 * time.Second):
+					_ = cmd.Process.Kill()
+					<-exited
+				}
+			}()
+
+			var httpAddr string
+			scanner := bufio.NewScanner(stdout)
+			for scanner.Scan() {
+				if n, _ := fmt.Sscanf(scanner.Text(), "ADDR %s", &httpAddr); n == 1 {
+					break
+				}
+			}
+			if httpAddr == "" {
+				t.Fatal("nsqd child did not start")
+			}
+			go func() { _, _ = io.Copy(io.Discard, stdout) }()
+
+			// act as nsqlookupd: take the connection and IDENTIFY, then answer
+			// with a frame whose size field is not a usable length
+			test.Nil(t, fake.(*net.TCPListener).SetDeadline(time.Now().Add(5*time.Second)))
+			conn, err := fake.Accept()
+			test.Nil(t, err)
+			defer conn.Close()
+			test.Nil(t, conn.SetDeadline(time.Now().Add(5*time.Second)))
+			r := bufio.NewReader(conn)
+			magic := make([]byte, 4)
+			_, err = io.ReadFull(r, magic)
+			test.Nil(t, err)
+			test.Equal(t, "  V1", string(magic))
+			line, err := r.ReadString('\n')
+			test.Nil(t, err)
+			test.Equal(t, "IDENTIFY", strings.TrimSpace(line))
+			var bodyLen int32
+			test.Nil(t, binary.Read(r, binary.BigEndian, &bodyLen))
+			_, err = io.CopyN(io.Discard, r, int64(bodyLen))
+			test.Nil(t, err)
+			test.Nil(t, binary.Write(conn, binary.BigEndian, int32(size)))
+
+			// nsqd gives up on this lookupd connection and keeps serving
+			_, err = r.ReadByte()
+			if err != io.EOF {
+				t.Fatalf("nsqd did not close the lookupd connection (%v)", err)
+			}
+			client := &http.Client{Timeout: 5 * time.Second}
+			resp, err := client.Get("http://" + httpAddr + "/ping")
+			test.Nil(t, err)
+			resp.Body.Close()
+			test.Equal(t, 200, resp.StatusCode)
+		})
+	}
+}
diff --git a/nsqlookupd/registry_rg5e1b_test.go b/nsqlookupd/registry_rg5e1b_test.go
new file mode 100644
index 0000000..8ddd6a3
--- /dev/null
+++ b/nsqlookupd/registry_rg5e1b_test.go
@@ -0,0 +1,805 @@
+//go:build lookupdreg
+
+package nsqlookupd_test
+
+import (
+	"bufio"
+	"bytes"
+	"encoding/binary"
+	"encoding/json"
+	"fmt"
+	"io"
+	"log"
+	"math"
+	"net"
+	"net/http"
+	"net/url"
+	"os"
+	"os/exec"
+	"runtime"
+	"sort"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/nsqio/go-nsq"
+	"github.com/nsqio/nsq/internal/test"
+	"github.com/nsqio/nsq/nsqlookupd"
+)
+
+const lookupdChildEnvRg5e1b = "NSQLOOKUPD_CHILD_RG5E1B"
+
+type lookupdRg5e1b struct {
+	tcpAddr  string
+	httpAddr string
+}
+
+func startLookupdRg5e1b(t *testing.T, inactive time.Duration) *lookupdRg5e1b {
+	t.Helper()
+	opts := nsqlookupd.NewOptions()
+	opts.Logger = test.NewTestLogger(t)
+	opts.TCPAddress = "127.0.0.1:0"
+	opts.HTTPAddress = "127.0.0.1:0"
+	if inactive > 0 {
+		opts.InactiveProducerTimeout = inactive
+	}
+	l, err := nsqlookupd.New(opts)
+	test.Nil(t, err)
+	go func() { _ = l.Main() }()
+	t.Cleanup(l.Exit)
+	return &lookupdRg5e1b{tcpAddr: l.RealTCPAddr().String(), httpAddr: l.RealHTTPAddr().String()}
+}
+
+// peerRg5e1b is a connection that talks to nsqlookupd the way an nsqd does.
+type peerRg5e1b struct {
+	t    *testing.T
+	conn net.Conn
+}
+
+func dialRg5e1b(t *testing.T, l *lookupdRg5e1b) *peerRg5e1b {
+	t.Helper()
+	conn, err := net.DialTimeout("tcp", l.tcpAddr, time.Second)
+	test.Nil(t, err)
+	t.Cleanup(func() { _ = conn.Close() })
+	_, err = conn.Write(nsq.MagicV1)
+	test.Nil(t, err)
+	return &peerRg5e1b{t: t, conn: conn}
+}
+
+func joinRg5e1b(t *testing.T, l *lookupdRg5e1b, broadcast string, httpPort int) *peerRg5e1b {
+	t.Helper()
+	p := dialRg5e1b(t, l)
+	cmd, err := nsq.Identify(map[string]interface{}{
+		"broadcast_address": broadcast,
+		"hostname":          broadcast,
+		"tcp_port":          httpPort - 1,
+		"http_port":         httpPort,
+		"version":           "1.3.0",
+	})
+	test.Nil(t, err)
+	resp := p.send(cmd)
+	if strings.HasPrefix(resp, "E_") {
+		t.Fatalf("IDENTIFY as %s rejected: %s", broadcast, resp)
+	}
+	return p
+}
+
+func (p *peerRg5e1b) send(cmd *nsq.Command) string {
+	p.t.Helper()
+	test.Nil(p.t, p.conn.SetDeadline(time.Now().Add(5*time.Second)))
+	_, err := cmd.WriteTo(p.conn)
+	test.Nil(p.t, err)
+	resp, err := nsq.ReadResponse(p.conn)
+	if err != nil {
+		p.t.Fatalf("%s: no response - %s", cmd, err)
+	}
+	return string(resp)
+}
+
+func (p *peerRg5e1b) ok(cmd *nsq.Command) {
+	p.t.Helper()
+	if resp := p.send(cmd); resp != "OK" {
+		p.t.Fatalf("%s: got %q, want OK", cmd, resp)
+	}
+}
+
+func getRg5e1b(t *testing.T, l *lookupdRg5e1b, path string, v interface{}) int {
+	t.Helper()
+	return doRg5e1b(t, "GET", "http://"+l.httpAddr+path, v)
+}
+
+func postRg5e1b(t *testing.T, l *lookupdRg5e1b, path string) int {
+	t.Helper()
+	return doRg5e1b(t, "POST", "http://"+l.httpAddr+path, nil)
+}
+
+func doRg5e1b(t *testing.T, method, endpoint string, v interface{}) int {
+	t.Helper()
+	req, err := http.NewRequest(method, endpoint, nil)
+	test.Nil(t, err)
+	req.Header.Set("Accept", "application/vnd.nsq; version=1.0")
+	client := &http.Client{Timeout: 5 * time.Second}
+	resp, err := client.Do(req)
+	test.Nil(t, err)
+	defer resp.Body.Close()
+	body, err := io.ReadAll(resp.Body)
+	test.Nil(t, err)
+	if v != nil && resp.StatusCode == 200 {
+		if err := json.Unmarshal(body, v); err != nil {
+			t.Fatalf("%s %s: decoding %q - %s", method, endpoint, body, err)
+		}
+	}
+	return resp.StatusCode
+}
+
+func topicsRg5e1b(t *testing.T, l *lookupdRg5e1b) []string {
+	t.Helper()
+	var doc struct {
+		Topics []string `json:"topics"`
+	}
+	test.Equal(t, 200, getRg5e1b(t, l, "/topics", &doc))
+	sort.Strings(doc.Topics)
+	if doc.Topics == nil {
+		doc.Topics = []string{}
+	}
+	return doc.Topics
+}
+
+func channelsRg5e1b(t *testing.T, l *lookupdRg5e1b, topic string) []string {
+	t.Helper()
+	var doc struct {
+		Channels []string `json:"channels"`
+	}
+	test.Equal(t, 200, getRg5e1b(t, l, "/channels?topic="+url.QueryEscape(topic), &doc))
+	sort.Strings(doc.Channels)
+	if doc.Channels == nil {
+		doc.Channels = []string{}
+	}
+	return doc.Channels
+}
+
+type nodeRg5e1b struct {
+	BroadcastAddress string   `json:"broadcast_address"`
+	HTTPPort         int      `json:"http_port"`
+	Topics           []string `json:"topics"`
+	Tombstones       []bool   `json:"tombstones"`
+}
+
+func nodesRg5e1b(t *testing.T, l *lookupdRg5e1b) []nodeRg5e1b {
+	t.Helper()
+	var doc struct {
+		Producers []nodeRg5e1b `json:"producers"`
+	}
+	test.Equal(t, 200, getRg5e1b(t, l, "/nodes", &doc))
+	return doc.Producers
+}
+
+// lookupRg5e1b returns the status of /lookup and the broadcast addresses it lists.
+func lookupRg5e1b(t *testing.T, l *lookupdRg5e1b, topic string) (int, []string) {
+	t.Helper()
+	var doc struct {
+		Producers []struct {
+			BroadcastAddress string `json:"broadcast_address"`
+		} `json:"producers"`
+	}
+	status := getRg5e1b(t, l, "/lookup?topic="+url.QueryEscape(topic), &doc)
+	addrs := []string{}
+	for _, p := range doc.Producers {
+		addrs = append(addrs, p.BroadcastAddress)
+	}
+	sort.Strings(addrs)
+	return status, addrs
+}
+
+// leaveRg5e1b closes the peer and waits until nsqlookupd has finished handling
+// the disconnect, which is when the node is no longer listed by /nodes.
+func leaveRg5e1b(t *testing.T, l *lookupdRg5e1b, p *peerRg5e1b, broadcast string) {
+	t.Helper()
+	_ = p.conn.Close()
+	deadline := time.Now().Add(5 * time.Second)
+	for {
+		listed := false
+		for _, n := range nodesRg5e1b(t, l) {
+			if n.BroadcastAddress == broadcast {
+				listed = true
+			}
+		}
+		if !listed {
+			return
+		}
+		if time.Now().After(deadline) {
+			t.Fatalf("node %s still listed 5s after its connection closed", broadcast)
+		}
+		time.Sleep(10 * time.Millisecond)
+	}
+}
+
+func containsRg5e1b(list []string, s string) bool {
+	for _, v := range list {
+		if v == s {
+			return true
+		}
+	}
+	return false
+}
+
+func TestDisconnectForgetsEphemeralTopicRg5e1b(t *testing.T) {
+	l := startLookupdRg5e1b(t, 0)
+	p := joinRg5e1b(t, l, "10.1.0.1", 4151)
+	p.ok(nsq.Register("live#ephemeral", "audit"))
+	p.ok(nsq.Register("live#ephemeral", "tail#ephemeral"))
+	p.ok(nsq.Register("keep", "billing"))
+
+	leaveRg5e1b(t, l, p, "10.1.0.1")
+
+	test.Equal(t, []string{"keep"}, topicsRg5e1b(t, l))
+	test.Equal(t, []string{}, channelsRg5e1b(t, l, "live#ephemeral"))
+	status, _ := lookupRg5e1b(t, l, "live#ephemeral")
+	test.Equal(t, 404, status)
+	test.Equal(t, []string{"billing"}, channelsRg5e1b(t, l, "keep"))
+}
+
+func TestDisconnectForgetsEphemeralChannelOfDurableTopicRg5e1b(t *testing.T) {
+	l := startLookupdRg5e1b(t, 0)
+	p := joinRg5e1b(t, l, "10.1.0.2", 4151)
+	p.ok(nsq.Register("orders", "audit#ephemeral"))
+	p.ok(nsq.Register("orders", "billing"))
+
+	leaveRg5e1b(t, l, p, "10.1.0.2")
+
+	test.Equal(t, []string{"orders"}, topicsRg5e1b(t, l))
+	test.Equal(t, []string{"billing"}, channelsRg5e1b(t, l, "orders"))
+}
+
+func TestEphemeralSharedByTwoNodesOutlivesFirstRg5e1b(t *testing.T) {
+	l := startLookupdRg5e1b(t, 0)
+	a := joinRg5e1b(t, l, "10.1.0.3", 4151)
+	b := joinRg5e1b(t, l, "10.1.0.4", 4151)
+	for _, p := range []*peerRg5e1b{a, b} {
+		p.ok(nsq.Register("fan#ephemeral", "x#ephemeral"))
+	}
+	a.ok(nsq.Register("fan#ephemeral", "replay"))
+
+	leaveRg5e1b(t, l, a, "10.1.0.3")
+
+	test.Equal(t, []string{"fan#ephemeral"}, topicsRg5e1b(t, l))
+	test.Equal(t, []string{"x#ephemeral"}, channelsRg5e1b(t, l, "fan#ephemeral"))
+	status, producers := lookupRg5e1b(t, l, "fan#ephemeral")
+	test.Equal(t, 200, status)
+	test.Equal(t, []string{"10.1.0.4"}, producers)
+
+	leaveRg5e1b(t, l, b, "10.1.0.4")
+
+	test.Equal(t, []string{}, topicsRg5e1b(t, l))
+	test.Equal(t, []string{}, channelsRg5e1b(t, l, "fan#ephemeral"))
+}
+
+// registerManyRg5e1b pipelines a REGISTER for every topic and reads the replies.
+func registerManyRg5e1b(t *testing.T, p *peerRg5e1b, topics []string) error {
+	return pipelineRg5e1b(p, topics, func(topic string) *nsq.Command { return nsq.Register(topic, "c") })
+}
+
+// unregisterManyRg5e1b pipelines an UNREGISTER of every topic and reads the replies.
+func unregisterManyRg5e1b(t *testing.T, p *peerRg5e1b, topics []string) error {
+	return pipelineRg5e1b(p, topics, func(topic string) *nsq.Command { return nsq.UnRegister(topic, "") })
+}
+
+func pipelineRg5e1b(p *peerRg5e1b, topics []string, command func(string) *nsq.Command) error {
+	var buf bytes.Buffer
+	for _, topic := range topics {
+		_, _ = command(topic).WriteTo(&buf)
+	}
+	if err := p.conn.SetDeadline(time.Now().Add(20 * time.Second)); err != nil {
+		return err
+	}
+	written := make(chan error, 1)
+	go func() {
+		_, err := p.conn.Write(buf.Bytes())
+		written <- err
+	}()
+	for range topics {
+		resp, err := nsq.ReadResponse(p.conn)
+		if err != nil {
+			return err
+		}
+		if string(resp) != "OK" {
+			return fmt.Errorf("got %q, want OK", resp)
+		}
+	}
+	return <-written
+}
+
+func TestEphemeralKeptWhileAnotherNodeStillHasItRg5e1b(t *testing.T) {
+	// the registry is shared by every connection, so run them in parallel
+	defer runtime.GOMAXPROCS(runtime.GOMAXPROCS(8))
+	l := startLookupdRg5e1b(t, 0)
+
+	for round := 0; round < 30; round++ {
+		topics := make([]string, 1500)
+		for i := range topics {
+			topics[i] = fmt.Sprintf("r%d-%d#ephemeral", round, i)
+		}
+		leaving := fmt.Sprintf("10.2.%d.1", round)
+		a := joinRg5e1b(t, l, leaving, 4151)
+		test.Nil(t, registerManyRg5e1b(t, a, topics))
+
+		// while one node leaves, others register the same ephemeral topics
+		var stayers []*peerRg5e1b
+		for j := 0; j < 3; j++ {
+			stayers = append(stayers, joinRg5e1b(t, l, fmt.Sprintf("10.2.%d.%d", round, j+2), 4151))
+		}
+		stopReads := make(chan struct{})
+		readsDone := make(chan struct{})
+		go func() {
+			defer close(readsDone)
+			for {
+				select {
+				case <-stopReads:
+					return
+				default:
+					doRg5e1b(t, "GET", "http://"+l.httpAddr+"/topics", nil)
+				}
+			}
+		}()
+		errs := make(chan error, len(stayers))
+		for _, p := range stayers {
+			p := p
+			go func() { errs <- registerManyRg5e1b(t, p, topics) }()
+		}
+		_ = a.conn.Close()
+		for range stayers {
+			test.Nil(t, <-errs)
+		}
+		close(stopReads)
+		<-readsDone
+		leaveRg5e1b(t, l, a, leaving)
+
+		for _, n := range nodesRg5e1b(t, l) {
+			has := make(map[string]bool, len(n.Topics))
+			for _, topic := range n.Topics {
+				has[topic] = true
+			}
+			for _, topic := range topics {
+				if !has[topic] {
+					t.Fatalf("%s lost %s when %s left", n.BroadcastAddress, topic, leaving)
+				}
+			}
+		}
+
+		// once the last node with them is gone, so are the topics
+		for j, p := range stayers {
+			leaveRg5e1b(t, l, p, fmt.Sprintf("10.2.%d.%d", round, j+2))
+		}
+		deadline := time.Now().Add(5 * time.Second)
+		for {
+			listed := topicsRg5e1b(t, l)
+			if len(listed) == 0 {
+				break
+			}
+			if time.Now().After(deadline) {
+				t.Fatalf("round %d: %d topics still listed after every node that had them left", round, len(listed))
+			}
+			time.Sleep(10 * time.Millisecond)
+		}
+	}
+}
+
+func TestEphemeralKeptWhileAnotherNodeUnregistersItRg5e1b(t *testing.T) {
+	// the registry is shared by every connection, so run them in parallel
+	defer runtime.GOMAXPROCS(runtime.GOMAXPROCS(8))
+	l := startLookupdRg5e1b(t, 0)
+
+	for round := 0; round < 30; round++ {
+		topics := make([]string, 1500)
+		for i := range topics {
+			topics[i] = fmt.Sprintf("u%d-%d#ephemeral", round, i)
+		}
+		leaving := fmt.Sprintf("10.3.%d.1", round)
+		a := joinRg5e1b(t, l, leaving, 4151)
+		test.Nil(t, registerManyRg5e1b(t, a, topics))
+
+		// while one node unregisters the topics, others register the same ones
+		var stayers []*peerRg5e1b
+		for j := 0; j < 3; j++ {
+			stayers = append(stayers, joinRg5e1b(t, l, fmt.Sprintf("10.3.%d.%d", round, j+2), 4151))
+		}
+		stopReads := make(chan struct{})
+		readsDone := make(chan struct{})
+		go func() {
+			defer close(readsDone)
+			for {
+				select {
+				case <-stopReads:
+					return
+				default:
+					doRg5e1b(t, "GET", "http://"+l.httpAddr+"/topics", nil)
+				}
+			}
+		}()
+		// in small steps, so the nodes stay on the same topics
+		for start := 0; start < len(topics); start += 20 {
+			step := topics[start : start+20]
+			errs := make(chan error, len(stayers)+1)
+			go func() { errs <- unregisterManyRg5e1b(t, a, step) }()
+			for _, p := range stayers {
+				p := p
+				go func() { errs <- registerManyRg5e1b(t, p, step) }()
+			}
+			for i := 0; i < len(stayers)+1; i++ {
+				test.Nil(t, <-errs)
+			}
+		}
+		close(stopReads)
+		<-readsDone
+		leaveRg5e1b(t, l, a, leaving)
+
+		for _, n := range nodesRg5e1b(t, l) {
+			has := make(map[string]bool, len(n.Topics))
+			for _, topic := range n.Topics {
+				has[topic] = true
+			}
+			for _, topic := range topics {
+				if !has[topic] {
+					t.Fatalf("%s lost %s when %s unregistered it", n.BroadcastAddress, topic, leaving)
+				}
+			}
+		}
+
+		for j, p := range stayers {
+			leaveRg5e1b(t, l, p, fmt.Sprintf("10.3.%d.%d", round, j+2))
+		}
+		deadline := time.Now().Add(5 * time.Second)
+		for {
+			listed := topicsRg5e1b(t, l)
+			if len(listed) == 0 {
+				break
+			}
+			if time.Now().After(deadline) {
+				t.Fatalf("round %d: %d topics still listed after every node that had them left", round, len(listed))
+			}
+			time.Sleep(10 * time.Millisecond)
+		}
+	}
+}
