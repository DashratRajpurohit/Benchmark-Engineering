+// identifyChildRg5e1b runs nsqlookupd in a separate process so a crash while
+// handling a connection is observed as a dead server rather than a dead test.
+func identifyChildRg5e1b() {
+	opts := nsqlookupd.NewOptions()
+	opts.TCPAddress = "127.0.0.1:0"
+	opts.HTTPAddress = "127.0.0.1:0"
+	opts.Logger = log.New(io.Discard, "", 0)
+	l, err := nsqlookupd.New(opts)
+	if err != nil {
+		fmt.Println("ERR", err)
+		os.Exit(1)
+	}
+	go func() { _ = l.Main() }()
+	fmt.Println("ADDR", l.RealTCPAddr(), l.RealHTTPAddr())
+	_, _ = io.Copy(io.Discard, os.Stdin)
+	os.Exit(0)
+}
+
+func TestIdentifyWithBadBodySizeIsRefusedRg5e1b(t *testing.T) {
+	if os.Getenv(lookupdChildEnvRg5e1b) == "1" {
+		identifyChildRg5e1b()
+		return
+	}
+
+	cmd := exec.Command(os.Args[0], "-test.run=^TestIdentifyWithBadBodySizeIsRefusedRg5e1b$")
+	cmd.Env = append(os.Environ(), lookupdChildEnvRg5e1b+"=1")
+	stdin, err := cmd.StdinPipe()
+	test.Nil(t, err)
+	stdout, err := cmd.StdoutPipe()
+	test.Nil(t, err)
+	cmd.Stderr = io.Discard
+	test.Nil(t, cmd.Start())
+	exited := make(chan struct{})
+	go func() {
+		_ = cmd.Wait()
+		close(exited)
+	}()
+	t.Cleanup(func() {
+		_ = stdin.Close()
+		select {
+		case <-exited:
+		case <-time.After(5 * time.Second):
+			_ = cmd.Process.Kill()
+			<-exited
+		}
+	})
+
+	var tcpAddr, httpAddr string
+	scanner := bufio.NewScanner(stdout)
+	for scanner.Scan() {
+		if n, _ := fmt.Sscanf(scanner.Text(), "ADDR %s %s", &tcpAddr, &httpAddr); n == 2 {
+			break
+		}
+	}
+	if httpAddr == "" {
+		t.Fatal("nsqlookupd child did not start")
+	}
+	go func() { _, _ = io.Copy(io.Discard, stdout) }()
+	l := &lookupdRg5e1b{tcpAddr: tcpAddr, httpAddr: httpAddr}
+
+	for _, size := range []int64{0, -1, math.MinInt32, 64 << 20} {
+		p := dialRg5e1b(t, l)
+		_, err := p.conn.Write([]byte("IDENTIFY\n"))
+		test.Nil(t, err)
+		test.Nil(t, binary.Write(p.conn, binary.BigEndian, int32(size)))
+
+		test.Nil(t, p.conn.SetReadDeadline(time.Now().Add(3*time.Second)))
+		resp, err := nsq.ReadResponse(p.conn)
+		if err != nil {
+			t.Fatalf("IDENTIFY with body size %d: no error response - %s", size, err)
+		}
+		if !strings.HasPrefix(string(resp), "E_BAD_BODY") {
+			t.Fatalf("IDENTIFY with body size %d: got %q, want E_BAD_BODY", size, resp)
+		}
+		_, err = p.conn.Read(make([]byte, 1))
+		if err != io.EOF {
+			t.Fatalf("IDENTIFY with body size %d: connection left open (%v)", size, err)
+		}
+	}
+
+	select {
+	case <-exited:
+		t.Fatal("nsqlookupd exited")
+	default:
+	}
+	p := joinRg5e1b(t, l, "10.1.0.10", 4151)
+	p.ok(nsq.Register("after", ""))
+	test.Equal(t, []string{"after"}, topicsRg5e1b(t, l))
+}
diff --git a/test.sh b/test.sh
index 5874b6a..d4d6b28 100755
--- a/test.sh
