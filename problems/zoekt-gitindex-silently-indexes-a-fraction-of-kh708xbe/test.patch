+// createSharedCloneRepo builds a base repository "A" with files spread
+// across several subdirectories, then a clone "B" that shares A's object
+// store (git clone --shared) and adds one more commit. Every object that
+// predates the clone therefore lives only in A, reachable from B only via
+// the alternates file B/.git/objects/info/alternates.
+func createSharedCloneRepo(dir string) error {
+	if err := os.MkdirAll(dir, 0o755); err != nil {
+		return err
+	}
+	script := `
+export GIT_CONFIG_COUNT=1
+export GIT_CONFIG_KEY_0=protocol.file.allow
+export GIT_CONFIG_VALUE_0=always
+
+git init -q -b master A
+cd A
+git config user.email "you@example.com"
+git config user.name "Your Name"
+mkdir -p dir0 dir1 dir2 dir3
+echo "content 0" > dir0/f0.go
+echo "content 1" > dir1/f1.go
+echo "content 2" > dir2/f2.go
+echo "content 3" > dir3/f3.go
+git add -A
+git commit -qam base
+git repack -a -d -q
+cd ..
+
+git clone -q --shared A B
+cd B
+git config user.email "you@example.com"
+git config user.name "Your Name"
+echo "// touched" >> dir0/f0.go
+git add -A
+git commit -qam touch
+`
+	cmd := exec.Command("/bin/sh", "-euxc", script)
+	cmd.Dir = dir
+	cmd.Env = gitTestEnv()
+	if out, err := cmd.CombinedOutput(); err != nil {
+		return fmt.Errorf("execution error: %v, output %s", err, out)
+	}
+	return nil
+}
+
+// TestIndexSharedCloneAlternates guards against a regression where a
+// repository cloned with `git clone --shared` -- so most of its objects
+// live only in the origin's object store, reachable via an alternates
+// file -- silently indexed only the files that happened to live directly
+// in the clone's own object store, dropping every file that required
+// following the alternates path, without any error or warning.
+func TestIndexSharedCloneAlternates(t *testing.T) {
+	t.Parallel()
+
+	dir := t.TempDir()
+	if err := createSharedCloneRepo(dir); err != nil {
+		t.Fatalf("createSharedCloneRepo: %v", err)
+	}
+
+	indexDir := t.TempDir()
+	buildOpts := index.Options{
+		IndexDir: indexDir,
+		RepositoryDescription: zoekt.Repository{
+			Name: "B",
+		},
+	}
+	buildOpts.SetDefaults()
+
+	opts := Options{
+		RepoDir:      filepath.Join(dir, "B"),
+		BuildOptions: buildOpts,
+		BranchPrefix: "refs/heads/",
+		Branches:     []string{"master"},
+		Incremental:  true,
+	}
+	if _, err := IndexGitRepo(opts); err != nil {
+		t.Fatalf("IndexGitRepo: %v", err)
+	}
+
+	searcher, err := search.NewDirectorySearcher(indexDir)
+	if err != nil {
+		t.Fatalf("NewDirectorySearcher: %v", err)
+	}
+	defer searcher.Close()
+
+	rlist, err := searcher.List(context.Background(), &query.Repo{Regexp: regexp.MustCompile("B")}, nil)
+	if err != nil {
+		t.Fatalf("List: %v", err)
+	}
+	if len(rlist.Repos) != 1 {
+		t.Fatalf("got %d repos, want 1", len(rlist.Repos))
+	}
+
+	// All four files must be present: dir0/f0.go was touched in B itself,
+	// but dir1, dir2 and dir3 exist only via the alternates path to A.
+	if got, want := rlist.Repos[0].Stats.Documents, 4; got != want {
+		t.Fatalf("got %d indexed documents, want %d (a subtree reachable only "+
+			"through git alternates was silently dropped)", got, want)
+	}
+}
