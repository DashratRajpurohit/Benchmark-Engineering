+// createUnreadableSubtreeRepo builds a small repository, then deletes the
+// loose object backing one subdirectory's tree after it has already been
+// referenced by a commit, simulating a corrupted or partially-transferred
+// object store: the reference to that subtree exists, but its content
+// cannot be read.
+func createUnreadableSubtreeRepo(dir string) (missingTreeHash string, err error) {
+	if err := os.MkdirAll(dir, 0o755); err != nil {
+		return "", err
+	}
+	script := `
+git init -q -b master repo
+cd repo
+git config user.email "you@example.com"
+git config user.name "Your Name"
+mkdir -p keep drop
+echo "kept" > keep/k.go
+echo "dropped" > drop/d.go
+git add -A
+git commit -qam base
+
+# Print the tree hash for the "drop" subdirectory, then delete its loose
+# object so the reference in the parent tree can no longer be read.
+tree_hash=$(git rev-parse HEAD:drop)
+echo "TREE_HASH=$tree_hash"
+loose_path=".git/objects/${tree_hash:0:2}/${tree_hash:2}"
+if [ ! -f "$loose_path" ]; then
+  echo "expected loose object at $loose_path" >&2
+  exit 1
+fi
+rm "$loose_path"
+`
+	cmd := exec.Command("/bin/sh", "-euxc", script)
+	cmd.Dir = dir
+	cmd.Env = gitTestEnv()
+	out, cmdErr := cmd.CombinedOutput()
+	if cmdErr != nil {
+		return "", fmt.Errorf("execution error: %v, output %s", cmdErr, out)
+	}
+	for _, line := range strings.Split(string(out), "\n") {
+		if hash, ok := strings.CutPrefix(line, "TREE_HASH="); ok {
+			return hash, nil
+		}
+	}
+	return "", fmt.Errorf("did not find TREE_HASH in output: %s", out)
+}
+
+// TestIndexUnreadableSubtreeFailsLoudly guards against a regression where a
+// tree whose subtree cannot be read (here: its loose object is missing, as
+// happens with a corrupted or partially-transferred object store) is
+// indexed anyway, silently omitting every file under that subtree instead
+// of the build failing.
+func TestIndexUnreadableSubtreeFailsLoudly(t *testing.T) {
+	t.Parallel()
+
+	dir := t.TempDir()
+	missingTreeHash, err := createUnreadableSubtreeRepo(dir)
+	if err != nil {
+		t.Fatalf("createUnreadableSubtreeRepo: %v", err)
+	}
+	if missingTreeHash == "" {
+		t.Fatalf("createUnreadableSubtreeRepo returned an empty tree hash")
+	}
+
+	indexDir := t.TempDir()
+	buildOpts := index.Options{
+		IndexDir: indexDir,
+		RepositoryDescription: zoekt.Repository{
+			Name: "repo",
+		},
+	}
+	buildOpts.SetDefaults()
+
+	opts := Options{
+		RepoDir:      filepath.Join(dir, "repo"),
+		BuildOptions: buildOpts,
+		BranchPrefix: "refs/heads/",
+		Branches:     []string{"master"},
+		Incremental:  true,
+	}
+	if _, err := IndexGitRepo(opts); err == nil {
+		t.Fatalf("IndexGitRepo succeeded despite an unreadable subtree; " +
+			"it should have failed instead of silently indexing a partial tree")
+	}
+}
