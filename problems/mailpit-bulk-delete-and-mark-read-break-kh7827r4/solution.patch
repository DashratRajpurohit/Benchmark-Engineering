+
+// bulkBroadcastLimit is the number of changed messages above which connected
+// clients are told to reload rather than sent one notification per message.
+const bulkBroadcastLimit = 200
+
+// broadcastDeleted notifies connected clients of deleted messages
+func broadcastDeleted(ids []string) {
+	if len(ids) > bulkBroadcastLimit {
+		websockets.Broadcast("prune", nil)
+		return
+	}
+
+	for _, id := range ids {
+		d := struct {
+			ID string
+		}{ID: id}
+
+		websockets.Broadcast("delete", d)
+	}
+}
+
+// broadcastReadStatus notifies connected clients of messages marked as read or unread
+func broadcastReadStatus(ids []string, read bool) {
+	if len(ids) > bulkBroadcastLimit {
+		websockets.Broadcast("prune", nil)
+		return
+	}
+
+	for _, id := range ids {
+		websockets.Broadcast("update", struct {
+			ID   string
+			Read bool
+		}{ID: id, Read: read})
+	}
+}
