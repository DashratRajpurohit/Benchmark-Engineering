+func TestReadStatusNotificationsArriveInOrderBX(t *testing.T) {
+	ts := startBX(t)
+	id := storeBX(t, "toggle", 1)[0]
+	b := connectBX(t, ts)
+
+	const rounds = 5000
+	for i := 0; i < rounds; i++ {
+		if err := storage.MarkRead([]string{id}); err != nil {
+			t.Fatal(err)
+		}
+		if err := storage.MarkUnread([]string{id}); err != nil {
+			t.Fatal(err)
+		}
+	}
+
+	var got []bool
+	for _, e := range b.settle(t) {
+		if e.Type == "update" && e.Data.ID == id {
+			got = append(got, e.Data.Read)
+		}
+	}
+	if len(got) != 2*rounds {
+		t.Fatalf("expected %d read-status notifications, got %d", 2*rounds, len(got))
+	}
+	for i, read := range got {
+		if want := i%2 == 0; read != want {
+			t.Fatalf("notification %d says Read=%v, but that change made it Read=%v; "+
+				"the web UI would show the wrong state", i+1, read, want)
+		}
+	}
+}
+
+// smallBufferListenerBX keeps the server's socket send buffer small, so that a
+// client which stops reading is noticed after a few kilobytes rather than
+// after whatever the operating system would otherwise buffer.
+type smallBufferListenerBX struct{ net.Listener }
+
+// smallBufferDialerBX dials with a small socket receive buffer, so that a
+// client which stops reading is noticed quickly.
+func smallBufferDialerBX() *websocket.Dialer {
+	return &websocket.Dialer{NetDialContext: func(ctx context.Context, network, addr string) (net.Conn, error) {
+		nd := net.Dialer{Control: func(_, _ string, c syscall.RawConn) error {
+			// best effort: a sandbox may refuse to resize the buffer
+			return c.Control(func(fd uintptr) {
+				_ = syscall.SetsockoptInt(int(fd), syscall.SOL_SOCKET, syscall.SO_RCVBUF, 4096)
+			})
+		}}
+		return nd.DialContext(ctx, network, addr)
+	}}
+}
+
+func (l smallBufferListenerBX) Accept() (net.Conn, error) {
+	c, err := l.Listener.Accept()
+	if tc, ok := c.(*net.TCPConn); ok {
+		_ = tc.SetWriteBuffer(4096)
+	}
+	return c, err
+}
+
+func TestSlowBrowserIsNotDisconnectedBX(t *testing.T) {
+	ts := startBX(t)
+	id := storeBX(t, "slow", 1)[0]
+
+	// a browser with a small receive buffer that stops reading for a second
+	conn, _, err := smallBufferDialerBX().Dial("ws"+strings.TrimPrefix(ts.URL, "http")+"/api/events", nil)
+	if err != nil {
+		t.Fatalf("connecting to /api/events: %v", err)
+	}
+
+	// the client reads until it has received one notification, which shows it
+	// is registered, then stops reading until resume is closed
+	var (
+		mu     sync.Mutex
+		got    []bool
+		closed bool
+	)
+	registered := make(chan struct{})
+	resume := make(chan struct{})
+	var resumeOnce sync.Once
+	resumeReading := func() { resumeOnce.Do(func() { close(resume) }) }
+	done := make(chan struct{})
+	go func() {
+		defer close(done)
+		if _, _, err := conn.ReadMessage(); err != nil {
+			mu.Lock()
+			closed = true
+			mu.Unlock()
+			return
+		}
+		close(registered)
+		<-resume
+		for {
+			_, msg, err := conn.ReadMessage()
+			if err != nil {
+				mu.Lock()
+				closed = true
+				mu.Unlock()
+				return
+			}
+			var e eventBX
+			_ = json.Unmarshal(msg, &e)
+			if e.Type == "update" && e.Data.ID == id {
+				mu.Lock()
+				got = append(got, e.Data.Read)
+				mu.Unlock()
+			}
+		}
+	}()
+	t.Cleanup(func() {
+		resumeReading()
+		_ = conn.Close()
+		<-done
+	})
+
+	for deadline := time.Now().Add(10 * time.Second); ; {
+		storage.BroadcastMailboxStats()
+		select {
+		case <-registered:
+		case <-done:
+			t.Fatal("the web UI connection closed before receiving a notification")
+		case <-time.After(300 * time.Millisecond):
+			if time.Now().After(deadline) {
+				t.Fatal("the web UI client never received a notification")
+			}
+			continue
+		}
+		break
+	}
+
+	const rounds = 5000
+	paused := time.AfterFunc(time.Second, resumeReading)
+	defer paused.Stop()
+	for i := 0; i < rounds; i++ {
+		if err := storage.MarkRead([]string{id}); err != nil {
+			t.Fatal(err)
+		}
+		if err := storage.MarkUnread([]string{id}); err != nil {
+			t.Fatal(err)
+		}
+	}
+
+	deadline := time.Now().Add(60 * time.Second)
+	for {
+		mu.Lock()
+		n, c := len(got), closed
+		mu.Unlock()
+		if n == 2*rounds || c || time.Now().After(deadline) {
+			break
+		}
+		time.Sleep(25 * time.Millisecond)
+	}
+
+	mu.Lock()
+	defer mu.Unlock()
+	if closed {
+		t.Fatalf("the web UI stopped reading for a second and was disconnected after %d of %d notifications",
+			len(got), 2*rounds)
+	}
+	if len(got) != 2*rounds {
+		t.Fatalf("the web UI caught up but received %d of %d notifications", len(got), 2*rounds)
+	}
+	for i, read := range got {
+		if want := i%2 == 0; read != want {
+			t.Fatalf("notification %d says Read=%v, but that change made it Read=%v", i+1, read, want)
+		}
+	}
+}
+
+func tagCountsBX(t *testing.T, base string) map[string]int64 {
+	t.Helper()
+	data, err := clientGet(base + "/api/v1/info")
+	if err != nil {
