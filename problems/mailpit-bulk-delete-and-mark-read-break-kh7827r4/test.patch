+//go:build bulkevents
+
+package server
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"net"
+	"net/http/httptest"
+	"strings"
+	"sync"
+	"syscall"
+	"testing"
+	"time"
+
+	"github.com/axllent/mailpit/internal/storage"
+	"github.com/axllent/mailpit/server/apiv1"
+	"github.com/axllent/mailpit/server/websockets"
+	"github.com/gorilla/websocket"
+)
+
+// browserBX records the notifications a connected web UI receives.
+type browserBX struct {
+	mu     sync.Mutex
+	events []eventBX
+	closed bool
+	last   time.Time
+	conn   *websocket.Conn
+
+	// a browser that is behind stops reading after its first notification
+	// until catchUp is called
+	behind     chan struct{}
+	behindOnce sync.Once
+}
+
+type eventBX struct {
+	Type string
+	Data struct {
+		ID   string
+		Read bool
+		Tags []string
+	}
+}
+
+var startOnceBX sync.Once
+
+// startBX starts the API with an empty mailbox. The database and the
+// notification hub are shared by these tests and opened only once, because
+// background work started by one test may still be running when the next
+// one begins.
+func startBX(t *testing.T) *httptest.Server {
+	t.Helper()
+	startOnceBX.Do(func() {
+		setup()
+		websockets.MessageHub = websockets.NewHub()
+		websockets.SetCheckOriginFunc(corsOriginAccessControl)
+		go websockets.MessageHub.Run()
+	})
+	if err := storage.DeleteAllMessages(); err != nil {
+		t.Fatal(err)
+	}
+
+	ts := httptest.NewUnstartedServer(apiRoutes())
+	ts.Listener = smallBufferListenerBX{ts.Listener}
+	ts.Start()
+	t.Cleanup(ts.Close)
+	return ts
+}
+
+// connectBX connects one web UI client that reads every notification.
+func connectBX(t *testing.T, ts *httptest.Server) *browserBX {
+	t.Helper()
+	b := dialBX(t, ts, websocket.DefaultDialer, false)
+	b.settle(t)
+	return b
+}
+
+// connectBehindBX connects a web UI client with a small receive buffer that
+// stops reading once it is registered, until catchUp is called.
+func connectBehindBX(t *testing.T, ts *httptest.Server) *browserBX {
+	t.Helper()
+	return dialBX(t, ts, smallBufferDialerBX(), true)
+}
+
+// catchUp makes a browser that is behind read its notifications again.
+func (b *browserBX) catchUp() {
+	if b.behind != nil {
+		b.behindOnce.Do(func() { close(b.behind) })
+	}
+}
+
+func dialBX(t *testing.T, ts *httptest.Server, dialer *websocket.Dialer, behind bool) *browserBX {
+	t.Helper()
+	conn, _, err := dialer.Dial("ws"+strings.TrimPrefix(ts.URL, "http")+"/api/events", nil)
+	if err != nil {
+		t.Fatalf("connecting to /api/events: %v", err)
+	}
+
+	b := &browserBX{conn: conn, last: time.Now()}
+	if behind {
+		b.behind = make(chan struct{})
+	}
+	done := make(chan struct{})
+	t.Cleanup(func() {
+		b.catchUp()
+		_ = conn.Close()
+		<-done
+	})
+	go func() {
+		defer close(done)
+		for first := true; ; first = false {
+			if !first && b.behind != nil {
+				<-b.behind
+			}
+			_, msg, err := conn.ReadMessage()
+			b.mu.Lock()
+			b.last = time.Now()
+			if err != nil {
+				b.closed = true
+				b.mu.Unlock()
+				return
+			}
+			var e eventBX
+			_ = json.Unmarshal(msg, &e)
+			b.events = append(b.events, e)
+			b.mu.Unlock()
+		}
+	}()
+
+	// wait until the client is registered and receiving notifications
+	deadline := time.Now().Add(10 * time.Second)
+	for {
+		storage.BroadcastMailboxStats()
+		time.Sleep(300 * time.Millisecond)
+		b.mu.Lock()
+		ready := len(b.events) > 0
+		b.events = nil
+		b.mu.Unlock()
+		if ready {
+			break
+		}
+		if time.Now().After(deadline) {
+			t.Fatal("the web UI client never received a notification")
+		}
+	}
+	return b
+}
+
+// settle waits until no notification has arrived for a while, then returns
+// what was received since the previous call.
+func (b *browserBX) settle(t *testing.T) []eventBX {
+	t.Helper()
+	start := time.Now()
+	deadline := start.Add(20 * time.Second)
+	for {
+		b.mu.Lock()
+		since := b.last
+		if since.Before(start) {
+			since = start
+		}
+		quiet := time.Since(since) > 750*time.Millisecond
+		b.mu.Unlock()
+		if quiet || time.Now().After(deadline) {
+			break
+		}
+		time.Sleep(25 * time.Millisecond)
+	}
+	b.mu.Lock()
+	defer b.mu.Unlock()
+	out := b.events
+	b.events = nil
+	return out
+}
+
+// stillConnected checks that the client keeps receiving notifications after
+// the action, by delivering one more message.
+func (b *browserBX) stillConnected(t *testing.T) {
+	t.Helper()
+	b.mu.Lock()
+	closed := b.closed
+	b.mu.Unlock()
+	if closed {
+		t.Fatal("the web UI connection was closed by the server")
+	}
+	if _, err := storage.Store(rawMessageBX("after", 0), nil); err != nil {
+		t.Fatal(err)
+	}
+	for _, e := range b.settle(t) {
+		if e.Type == "new" {
+			return
+		}
+	}
+	t.Fatal("the web UI client stopped receiving notifications")
+}
+
+func rawMessageBX(tag string, i int) *[]byte {
+	raw := []byte(fmt.Sprintf("From: sender-%d@example.com\r\nTo: rcpt@example.com\r\n"+
+		"Subject: %s message %d\r\nMessage-ID: <%s-%d-%d@example.com>\r\n\r\nbody %d\r\n",
+		i, tag, i, tag, i, time.Now().UnixNano(), i))
+	return &raw
+}
+
+func storeBX(t *testing.T, tag string, n int) []string {
+	t.Helper()
+	ids := make([]string, 0, n)
+	for i := 0; i < n; i++ {
+		id, err := storage.Store(rawMessageBX(tag, i), nil)
+		if err != nil {
+			t.Fatal(err)
+		}
+		ids = append(ids, id)
+	}
+	return ids
+}
+
+func countsBX(t *testing.T, base string) (total, unread uint64) {
+	t.Helper()
+	m := apiv1.MessagesSummary{}
+	data, err := clientGet(base + "/api/v1/messages?limit=1")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := json.Unmarshal(data, &m); err != nil {
+		t.Fatalf("decoding %s: %v", data, err)
+	}
+	return m.Total, m.Unread
+}
+
+// toldAboutAllBX reports whether the notifications tell a client about every
+// listed message. A reload notification ("prune") counts for every message;
+// otherwise each message needs its own notification of the given kind.
+func toldAboutAllBX(events []eventBX, kind string, ids []string) (bool, int) {
+	seen := map[string]bool{}
+	for _, e := range events {
+		if e.Type == "prune" {
+			return true, len(ids)
+		}
+		if e.Type == kind {
+			seen[e.Data.ID] = true
+		}
+	}
+	n := 0
+	for _, id := range ids {
+		if seen[id] {
+			n++
+		}
+	}
+	return n == len(ids), n
+}
+
+func idsJSONBX(ids []string) string {
+	b, _ := json.Marshal(ids)
+	return string(b)
+}
+
+func TestDeleteSearchTellsBrowserAboutEveryDeletionBX(t *testing.T) {
+	ts := startBX(t)
+	ids := storeBX(t, "doomed", 1100)
+	storeBX(t, "kept", 5)
+	b := connectBX(t, ts)
+
+	if _, err := clientDelete(ts.URL+"/api/v1/search?query=doomed", ""); err != nil {
+		t.Fatalf("deleting by search: %v", err)
+	}
+	events := b.settle(t)
+
+	if total, _ := countsBX(t, ts.URL); total != 5 {
+		t.Fatalf("after deleting 1100 of 1105 messages, total is %d, want 5", total)
+	}
+	if ok, n := toldAboutAllBX(events, "delete", ids); !ok {
+		t.Errorf("1100 messages were deleted; the web UI was told about %d of them "+
+			"and was not told to reload", n)
+	}
+	b.stillConnected(t)
+}
+
