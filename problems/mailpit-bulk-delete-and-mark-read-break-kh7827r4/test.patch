+
+	if _, err := clientPut(ts.URL+"/api/v1/messages", `{"Read":false}`); err != nil {
+		t.Fatalf("marking every message unread: %v", err)
+	}
+	events = b.settle(t)
+	if _, unread := countsBX(t, ts.URL); unread != 50 {
+		t.Fatalf("after marking every message unread, %d are unread, want 50", unread)
+	}
+	if ok, n := toldAboutAllBX(events, "update", ids); !ok {
+		t.Errorf("every message was marked unread; an open web UI was told about %d of 50 "+
+			"and was not told to reload", n)
+	}
+	b.stillConnected(t)
+}
