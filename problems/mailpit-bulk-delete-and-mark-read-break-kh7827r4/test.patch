+func TestTaggingMissingMessagesLeavesNoTagBX(t *testing.T) {
+	ts := startBX(t)
+	ids := storeBX(t, "present", 2)
+
+	if _, err := clientPut(ts.URL+"/api/v1/tags", `{"Tags":["Ghost"],"IDs":["gone-1","gone-2"]}`); err != nil {
+		t.Fatalf("tagging messages that do not exist: %v", err)
+	}
+	if n, ok := tagCountsBX(t, ts.URL)["Ghost"]; ok {
+		t.Errorf("no existing message was tagged, but the tag list has Ghost on %d message(s)", n)
+	}
+
+	mixed := []string{"gone-3", ids[0]}
+	if _, err := clientPut(ts.URL+"/api/v1/tags", `{"Tags":["Mixed"],"IDs":`+idsJSONBX(mixed)+`}`); err != nil {
+		t.Fatalf("tagging a mix of existing and missing messages: %v", err)
+	}
+	if n := tagCountsBX(t, ts.URL)["Mixed"]; n != 1 {
+		t.Errorf("one existing message was tagged, but the tag list has Mixed on %d", n)
+	}
+}
