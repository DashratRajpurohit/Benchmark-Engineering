+// accidentally shadow gojq's own use of those names.
+type overridableCallback struct {
+	name     string
+	fallback any
+}
+
+// callFunctionCallback invokes callback, threading ctx through when the
+// callback is context-aware and discarding it otherwise.
+func callFunctionCallback(callback any, ctx context.Context, x any, xs []any) any {
+	switch f := callback.(type) {
+	case func(any, []any) any:
+		return f(x, xs)
+	case func(context.Context, any, []any) any:
+		return f(ctx, x, xs)
+	default:
+		panic(fmt.Sprintf("gojq: invalid function callback type %T", callback))
+	}
+}
