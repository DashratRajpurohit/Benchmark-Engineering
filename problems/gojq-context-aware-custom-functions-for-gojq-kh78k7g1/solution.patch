diff --git a/run_option.go b/run_option.go
new file mode 100644
index 0000000..ca9bca9
--- /dev/null
+++ b/run_option.go
@@ -0,0 +1,72 @@
+package gojq
+
+import (
+	"context"
+	"fmt"
+)
+
+// RunOption is a run option, passed to [*Code.RunWithOptions]. It only
+// affects a single run and is discarded afterward; it does not change the
+// compiled [*Code] itself, so the same *Code can still be reused
+// concurrently with different run options (or none) in other calls.
+type RunOption func(*runOptions)
+
+type runOptions struct {
+	funcs map[string]function
+}
+
+// WithRunFunction is a run option that overrides, for this run only, the
+// callback of a custom function previously registered at compile time with
+// [WithFunction], [WithIterFunction], [WithFunctionWithContext], or
+// [WithIterFunctionWithContext]. This lets a compiled query be reused across
+// many runs while varying what a named function does from run to run,
+// without recompiling the query or discarding the parsed bytecode. A
+// WithRunFunction for a name that no compile-time option registered has no
+// effect, because the query could not have compiled a call to that name in
+// the first place. As with [WithFunction], specify the minimum and maximum
+// count of the function arguments; a run option only overrides the arities
+// it covers, so calls to other arities of the same name keep using whatever
+// was registered at compile time.
+func WithRunFunction(name string, minarity, maxarity int, f func(context.Context, any, []any) any) RunOption {
+	return runFunction(name, minarity, maxarity, false, f)
+}
+
+// WithRunIterFunction is a run option like [WithRunFunction], but for a
+// function which returns an [Iter] to emit multiple values, as in
+// [WithIterFunctionWithContext].
+func WithRunIterFunction(name string, minarity, maxarity int, f func(context.Context, any, []any) Iter) RunOption {
+	return runFunction(name, minarity, maxarity, true,
+		func(ctx context.Context, v any, args []any) any {
+			return f(ctx, v, args)
+		},
+	)
+}
+
+func runFunction(name string, minarity, maxarity int, iter bool, callback any) RunOption {
+	if !(0 <= minarity && minarity <= maxarity && maxarity <= 30) {
+		panic(fmt.Sprintf("invalid arity for %q: %d, %d", name, minarity, maxarity))
+	}
+	argcount := 1<<(maxarity+1) - 1<<minarity
+	return func(o *runOptions) {
+		if o.funcs == nil {
+			o.funcs = make(map[string]function)
+		}
+		if fn, ok := o.funcs[name]; ok {
+			if fn.iter != iter {
+				panic(fmt.Sprintf("cannot define both iterator and non-iterator run functions for %q", name))
+			}
+			newArgcount, prevCallback := argcount, fn.callback
+			o.funcs[name] = function{
+				argcount | fn.argcount, iter,
+				func(ctx context.Context, x any, xs []any) any {
+					if newArgcount&(1<<len(xs)) != 0 {
+						return callFunctionCallback(callback, ctx, x, xs)
+					}
+					return callFunctionCallback(prevCallback, ctx, x, xs)
+				},
+			}
+		} else {
+			o.funcs[name] = function{argcount, iter, callback}
+		}
+	}
+}
