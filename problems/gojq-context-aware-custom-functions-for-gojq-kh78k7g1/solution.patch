+// RunWithOptions runs the code with context and run options, in addition to
+// the variable values (as in [*Code.Run]). Currently the only run options
+// are [WithRunFunction] and [WithRunIterFunction], which let a custom
+// function registered at compile time (with [WithFunction],
+// [WithIterFunction], [WithFunctionWithContext], or
+// [WithIterFunctionWithContext]) be overridden for this run only, without
+// recompiling the query. A run option for a name that was not registered at
+// compile time has no effect, since the query would not have compiled a call
+// to that name in the first place.
+func (c *Code) RunWithOptions(ctx context.Context, v any, values []any, opts ...RunOption) Iter {
+	if len(values) > len(c.variables) {
+		return NewIter(&tooManyVariableValuesError{})
+	} else if len(values) < len(c.variables) {
+		return NewIter(&expectedVariableError{c.variables[len(values)]})
+	}
+	var ro runOptions
+	for _, opt := range opts {
+		opt(&ro)
+	}
+	return newEnv(ctx, ro.funcs).execute(c, v, values...)
 }
 
