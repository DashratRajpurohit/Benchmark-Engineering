@@ -0,0 +1,36 @@
+#!/usr/bin/env bash
+set -u
+set -o pipefail
+
+output_path=""
+if [ "${1:-}" = "--output_path" ]; then
+  output_path="$2"
+  shift 2
+fi
+
+mode="${1:-}"
+
+case "$mode" in
+  base)
+    packages=". ./cli"
+    ;;
+  new)
+    packages="./contextfunc_163415/..."
+    ;;
+  *)
+    echo "usage: $0 [--output_path <file>] base|new" >&2
+    exit 2
+    ;;
+esac
+
+junit_report="$(go env GOPATH)/bin/go-junit-report"
+
+if [ -n "$output_path" ]; then
+  # shellcheck disable=SC2086
+  go test -v -json $packages | "$junit_report" -parser gojson -set-exit-code -out "$output_path"
+  exit $?
+fi
+
+# shellcheck disable=SC2086
+go test -v $packages
+exit $?
