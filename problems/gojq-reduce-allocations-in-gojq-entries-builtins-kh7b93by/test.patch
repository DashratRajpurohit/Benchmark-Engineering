+
+func mustNoErr_dac09c(t *testing.T, err error) {
+	t.Helper()
+	if err != nil {
+		t.Fatal(err)
+	}
+}
+
+func compileEntries_dac09c(t *testing.T, query string) *gojq.Code {
+	t.Helper()
+	q, err := gojq.Parse(query)
+	mustNoErr_dac09c(t, err)
+	code, err := gojq.Compile(q)
+	mustNoErr_dac09c(t, err)
+	return code
+}
+
+// runEntries_dac09c returns the newline-joined JSON results and the first error text.
+func runEntries_dac09c(t *testing.T, code *gojq.Code, in any) (string, string) {
+	t.Helper()
+	var outs []string
+	iter := code.Run(in)
+	for {
+		v, ok := iter.Next()
+		if !ok {
+			return strings.Join(outs, "\n"), ""
+		}
+		if e, ok := v.(error); ok {
+			return strings.Join(outs, "\n"), e.Error()
+		}
+		b, jerr := json.Marshal(v)
+		mustNoErr_dac09c(t, jerr)
+		outs = append(outs, string(b))
+	}
+}
+
+func decodeEntries_dac09c(t *testing.T, s string) any {
+	t.Helper()
+	var v any
+	mustNoErr_dac09c(t, json.Unmarshal([]byte(s), &v))
+	return v
+}
+
+func entriesAllocs_dac09c(t *testing.T, query string, in any) float64 {
+	code := compileEntries_dac09c(t, query)
+	return testing.AllocsPerRun(20, func() {
+		iter := code.Run(in)
+		for {
+			if _, ok := iter.Next(); !ok {
+				return
+			}
+		}
+	})
+}
+
+func bigEntriesObject_dac09c(n int) (map[string]any, []any) {
+	obj := make(map[string]any, n)
+	list := make([]any, 0, n)
+	for i := 0; i < n; i++ {
+		k := fmt.Sprintf("k%03d", i)
+		obj[k] = i
+		list = append(list, map[string]any{"key": k, "value": i})
+	}
+	return obj, list
+}
+
+// The entries builtins must keep returning exactly the same results and the
+// same errors as before, for every kind of input.
+func TestEntriesBuiltinsKeepResultsAndErrors_dac09c(t *testing.T) {
+	for _, c := range entriesCases_dac09c {
+		out, errText := runEntries_dac09c(t, compileEntries_dac09c(t, c.query), decodeEntries_dac09c(t, c.input))
+		got, want := [2]string{out, errText}, [2]string{c.out, c.err}
+		if !reflect.DeepEqual(got, want) {
+			t.Errorf("%s on %s:\n got  %q\n want %q", c.query, c.input, got, want)
+		}
+	}
+}
+
+// to_entries followed by from_entries is the identity on objects, and both
+// are repeatable.
+func TestEntriesRoundTripAndRepeatable_dac09c(t *testing.T) {
+	obj, list := bigEntriesObject_dac09c(50)
+	first, firstErr := runEntries_dac09c(t, compileEntries_dac09c(t, "to_entries | from_entries"), obj)
+	want, _ := json.Marshal(obj)
+	if !reflect.DeepEqual([2]string{first, firstErr}, [2]string{string(want), ""}) {
+		t.Fatalf("round trip of to_entries|from_entries changed the object: %q, %q", first, firstErr)
+	}
+	code := compileEntries_dac09c(t, "from_entries")
+	a, aErr := runEntries_dac09c(t, code, list)
+	b, bErr := runEntries_dac09c(t, code, list)
+	if !reflect.DeepEqual([2]string{a, aErr}, [2]string{b, bErr}) {
+		t.Fatalf("from_entries is not repeatable: %q vs %q", a, b)
+	}
+	if !reflect.DeepEqual([2]string{a, aErr}, [2]string{string(want), ""}) {
+		t.Fatalf("from_entries of the entries list = %q, %q, want %q", a, aErr, want)
+	}
+}
+
+// The results must not alias the input: changing a result afterwards must not
+// change what a later run sees.
+func TestEntriesDoNotAliasInput_dac09c(t *testing.T) {
+	obj := map[string]any{"a": 1, "b": 2}
+	res, ok := compileEntries_dac09c(t, "to_entries").Run(obj).Next()
+	if !ok {
+		t.Fatal("to_entries produced no result")
+	}
+	res.([]any)[0].(map[string]any)["value"] = 99
+	after, afterErr := runEntries_dac09c(t, compileEntries_dac09c(t, "to_entries"), obj)
+	want := `[{"key":"a","value":1},{"key":"b","value":2}]`
+	if !reflect.DeepEqual([2]string{after, afterErr}, [2]string{want, ""}) {
+		t.Fatalf("to_entries result aliased its input: %q, %q", after, afterErr)
+	}
+	if !reflect.DeepEqual(obj, map[string]any{"a": 1, "b": 2}) {
+		t.Fatalf("to_entries modified its input: %v", obj)
+	}
+}
+
+// from_entries and to_entries used to be written in jq, costing hundreds of
+// allocations per hundred entries. They must now be cheap.
+func TestEntriesAllocationBudget_dac09c(t *testing.T) {
+	obj, list := bigEntriesObject_dac09c(100)
+	budgets := []struct {
+		name  string
+		query string
+		in    any
+		max   float64
+	}{
+		{"from_entries", "from_entries", list, 120},
+		{"to_entries", "to_entries", obj, 470},
+		{"with_entries identity", "with_entries(.)", obj, 800},
+	}
+	for _, b := range budgets {
+		if got := entriesAllocs_dac09c(t, b.query, b.in); got > b.max {
+			t.Errorf("%s on 100 entries made %.0f allocations, want at most %.0f", b.name, got, b.max)
+		}
+	}
+}
