+#!/usr/bin/env bash
+# Test runner for the gojq to_entries / from_entries / with_entries
+# allocation-reduction task.
+#
+# Usage:
+#   ./test.sh [--output_path <junit.xml>] <base|new>
+#
+# base  runs the pre-existing suites (root package tests and the CLI
+#       suite, which exercises these builtins end to end); they must pass
+#       both before and after the solution is applied.
+# new   runs the allocation-budget test; it fails before the solution and
+#       passes after. The result/error parity and aliasing tests run in base
+#       mode: they pass on both sides and guard behaviour preservation.
+set -uo pipefail
+
+cd /app
+
+OUTPUT_PATH=""
+if [ "${1:-}" = "--output_path" ]; then
+  OUTPUT_PATH="$2"
+  shift 2
+fi
+
+MODE="${1:-new}"
+
+TEST_LOG="$(mktemp)"
+STATUS=0
+
+run_tests() {
+  regex="$1"
+  shift
+  go test -count=1 -v -run "$regex" "$@" 2>&1 | tee -a "$TEST_LOG"
+  status=${PIPESTATUS[0]}
+  if [ "$status" -ne 0 ]; then
+    STATUS=$status
+  fi
+}
+
+case "$MODE" in
+  base)
+    run_tests '^(TestCompare|TestCodeCompile_.*|TestParseErrorTokenOffset|TestCodeRun_.*|TestMarshal|TestWith.*|TestPreview|TestQueryRun_.*|TestQueryString|TestTypeOf)$' .
+    run_tests '^(TestEntriesBuiltinsKeepResultsAndErrors|TestEntriesRoundTripAndRepeatable|TestEntriesDoNotAliasInput)_dac09c$' .
+    run_tests '.*' ./cli/...
+    ;;
+  new)
+    run_tests '^TestEntriesAllocationBudget_dac09c$' .
+    ;;
+  *)
+    echo "unknown mode: $MODE (expected base or new)" >&2
+    exit 2
+    ;;
+esac
+
+if [ -n "$OUTPUT_PATH" ]; then
+  go-junit-report -set-exit-code < "$TEST_LOG" > "$OUTPUT_PATH" || true
+fi
+
+exit "$STATUS"
