+// walkTree recursively visits every entry of t, calling handleEntry for
+// each blob and recursing into subtrees.
+//
+// This does not use object.NewTreeWalker: that walker reports a subtree it
+// cannot load as io.EOF, which is exactly the signal it also uses for
+// "the walk finished normally". A build could not tell "every file is
+// indexed" from "part of the tree was silently skipped", so a shard could
+// end up holding a fraction of the repository and report success. walkTree
+// instead calls Tree.Tree per directory entry and propagates whatever
+// error that returns, so an unreadable subtree aborts the build with a
+// real error instead of producing a short, silently incomplete shard.
+func (rw *RepoWalker) walkTree(t *object.Tree, base string, seen map[plumbing.Hash]bool, branch string, subRepoVersions map[string]plumbing.Hash, ig *ignore.Matcher) error {
+	for i := range t.Entries {
+		entry := t.Entries[i]
+		if seen[entry.Hash] {
+			continue
+		}
+		seen[entry.Hash] = true
+
+		name := path.Join(base, entry.Name)
+
+		if entry.Mode == filemode.Dir {
+			sub, err := t.Tree(entry.Name)
+			if err != nil {
+				return fmt.Errorf("reading tree %q: %w", name, err)
+			}
+			if err := rw.walkTree(sub, name, seen, branch, subRepoVersions, ig); err != nil {
+				return err
+			}
+			continue
 		}
+
 		if err := rw.handleEntry(name, &entry, branch, subRepoVersions, ig); err != nil {
-			return nil, fmt.Errorf("handleEntry: %w", err)
