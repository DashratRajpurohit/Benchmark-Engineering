diff --git a/pkg/util/xpath/compile.go b/pkg/util/xpath/compile.go
new file mode 100644
index 0000000000..f264bfbd97
--- /dev/null
+++ b/pkg/util/xpath/compile.go
@@ -0,0 +1,667 @@
+// Copyright 2026 PingCAP, Inc.
+//
+// Licensed under the Apache License, Version 2.0 (the "License");
+// you may not use this file except in compliance with the License.
+// You may obtain a copy of the License at
+//
+//     http://www.apache.org/licenses/LICENSE-2.0
+//
+// Unless required by applicable law or agreed to in writing, software
+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+package xpath
+
+import (
+	"strconv"
+	"strings"
+)
+
+// SyntaxError reports an XPath expression that cannot be compiled. Near holds
+// the part of the expression starting at the offending token.
+type SyntaxError struct {
+	Near string
+}
+
+func (e *SyntaxError) Error() string {
+	return "XPATH syntax error: '" + e.Near + "'"
+}
+
+type tokKind uint8
+
+const (
+	tEOF tokKind = iota
+	tSlash
+	tDSlash
+	tLParen
+	tRParen
+	tLBracket
+	tRBracket
+	tDot
+	tDDot
+	tAt
+	tComma
+	tAxis // "::"
+	tPipe
+	tPlus
+	tMinus
+	tEq
+	tNe
+	tLt
+	tLe
+	tGt
+	tGe
+	tStar // name test "*"
+	tMul  // multiply operator "*"
+	tAnd
+	tOr
+	tDiv
+	tMod
+	tNumber
+	tLiteral
+	tName
+	tUserVar
+)
+
+type token struct {
+	kind tokKind
+	text string
+	num  float64
+	pos  int
+}
+
+type lexer struct {
+	src  string
+	pos  int
+	toks []token
+}
+
+// operatorFollows reports whether the previous token lets the next "*" or
+// NCName be read as an operator, following XPath 1.0 section 3.7.
+func operatorFollows(prev tokKind) bool {
+	switch prev {
+	case tEOF, tAt, tAxis, tLParen, tLBracket, tComma,
+		tAnd, tOr, tDiv, tMod, tMul, tSlash, tDSlash, tPipe,
+		tPlus, tMinus, tEq, tNe, tLt, tLe, tGt, tGe:
+		return false
+	}
+	return true
+}
+
+func isNameStart(c byte) bool {
+	return c >= 0x80 || c == '_' || (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z')
+}
+
+func (l *lexer) err(pos int) error {
+	return &SyntaxError{Near: l.src[pos:]}
+}
+
+func (l *lexer) scanName() string {
+	start := l.pos
+	for l.pos < len(l.src) {
+		c := l.src[l.pos]
+		if isNameByte(c) && c != ':' {
+			l.pos++
+			continue
+		}
+		// A single colon joins a prefix to a local name; "::" is an axis separator.
+		if c == ':' && l.pos+1 < len(l.src) && l.src[l.pos+1] != ':' && isNameStart(l.src[l.pos+1]) {
+			l.pos++
+			continue
+		}
+		break
+	}
+	return l.src[start:l.pos]
+}
+
+func (l *lexer) run() error {
+	prev := tEOF
+	for {
+		for l.pos < len(l.src) && isSpace(l.src[l.pos]) {
+			l.pos++
+		}
+		if l.pos >= len(l.src) {
+			l.toks = append(l.toks, token{kind: tEOF, pos: l.pos})
+			return nil
+		}
+		start := l.pos
+		c := l.src[l.pos]
+		tok := token{pos: start}
+		two := ""
+		if l.pos+1 < len(l.src) {
+			two = l.src[l.pos : l.pos+2]
+		}
+		switch {
+		case two == "//":
+			tok.kind, l.pos = tDSlash, l.pos+2
+		case two == "::":
+			tok.kind, l.pos = tAxis, l.pos+2
+		case two == "!=":
+			tok.kind, l.pos = tNe, l.pos+2
+		case two == "<=":
+			tok.kind, l.pos = tLe, l.pos+2
+		case two == ">=":
+			tok.kind, l.pos = tGe, l.pos+2
+		case two == "..":
+			tok.kind, l.pos = tDDot, l.pos+2
+		case c == '.' && (l.pos+1 >= len(l.src) || l.src[l.pos+1] < '0' || l.src[l.pos+1] > '9'):
+			tok.kind, l.pos = tDot, l.pos+1
+		case c == '.' || (c >= '0' && c <= '9'):
+			for l.pos < len(l.src) && l.src[l.pos] >= '0' && l.src[l.pos] <= '9' {
+				l.pos++
+			}
+			if l.pos < len(l.src) && l.src[l.pos] == '.' {
+				l.pos++
+				for l.pos < len(l.src) && l.src[l.pos] >= '0' && l.src[l.pos] <= '9' {
+					l.pos++
+				}
+			}
+			tok.kind, tok.text = tNumber, l.src[start:l.pos]
+			n, err := strconv.ParseFloat(tok.text, 64)
+			if err != nil {
+				return l.err(start)
+			}
+			tok.num = n
+		case c == '"' || c == '\'':
+			end := strings.IndexByte(l.src[l.pos+1:], c)
+			if end < 0 {
+				return l.err(start)
+			}
+			tok.kind, tok.text = tLiteral, l.src[l.pos+1:l.pos+1+end]
+			l.pos += end + 2
+		case c == '$':
+			// Only user variables ($@name) exist outside stored programs.
+			if l.pos+1 >= len(l.src) || l.src[l.pos+1] != '@' {
+				return l.err(start)
+			}
+			l.pos += 2
+			name := l.scanName()
+			if name == "" {
+				return l.err(start)
+			}
+			tok.kind, tok.text = tUserVar, name
+		case c == '/':
+			tok.kind, l.pos = tSlash, l.pos+1
+		case c == '(':
+			tok.kind, l.pos = tLParen, l.pos+1
+		case c == ')':
+			tok.kind, l.pos = tRParen, l.pos+1
+		case c == '[':
+			tok.kind, l.pos = tLBracket, l.pos+1
+		case c == ']':
+			tok.kind, l.pos = tRBracket, l.pos+1
+		case c == '@':
+			tok.kind, l.pos = tAt, l.pos+1
+		case c == ',':
+			tok.kind, l.pos = tComma, l.pos+1
+		case c == '|':
+			tok.kind, l.pos = tPipe, l.pos+1
+		case c == '+':
+			tok.kind, l.pos = tPlus, l.pos+1
+		case c == '-':
+			tok.kind, l.pos = tMinus, l.pos+1
+		case c == '=':
+			tok.kind, l.pos = tEq, l.pos+1
+		case c == '<':
+			tok.kind, l.pos = tLt, l.pos+1
+		case c == '>':
+			tok.kind, l.pos = tGt, l.pos+1
+		case c == '*':
+			l.pos++
+			if operatorFollows(prev) {
+				tok.kind = tMul
+			} else {
+				tok.kind = tStar
+			}
+		case isNameStart(c):
+			name := l.scanName()
+			tok.kind, tok.text = tName, name
+			if operatorFollows(prev) {
+				switch name {
+				case "and":
+					tok.kind = tAnd
+				case "or":
+					tok.kind = tOr
+				case "div":
+					tok.kind = tDiv
+				case "mod":
+					tok.kind = tMod
+				default:
+					return l.err(start)
+				}
+			}
+		default:
+			return l.err(start)
+		}
+		l.toks = append(l.toks, tok)
+		prev = tok.kind
+	}
+}
+
+type axisKind uint8
+
+const (
+	axisChild axisKind = iota
+	axisDescendant
+	axisDescendantOrSelf
+	axisParent
+	axisAncestor
+	axisAncestorOrSelf
+	axisSelf
+	axisAttribute
+	axisFollowingSibling
+	axisPrecedingSibling
+	axisFollowing
+	axisPreceding
+)
+
+var axisNames = map[string]axisKind{
+	"child":              axisChild,
+	"descendant":         axisDescendant,
+	"descendant-or-self": axisDescendantOrSelf,
+	"parent":             axisParent,
+	"ancestor":           axisAncestor,
+	"ancestor-or-self":   axisAncestorOrSelf,
+	"self":               axisSelf,
+	"attribute":          axisAttribute,
+	"following-sibling":  axisFollowingSibling,
+	"preceding-sibling":  axisPrecedingSibling,
+	"following":          axisFollowing,
+	"preceding":          axisPreceding,
+}
+
+func (a axisKind) reverse() bool {
+	switch a {
+	case axisParent, axisAncestor, axisAncestorOrSelf, axisPrecedingSibling, axisPreceding:
+		return true
+	}
+	return false
+}
+
+type testKind uint8
+
+const (
+	testName testKind = iota
+	testAny           // "*"
+	testText          // text()
+	testNode          // node()
+	testNone          // comment() and processing-instruction(), which never match
+)
+
+type step struct {
+	axis  axisKind
+	test  testKind
+	name  string
+	preds []expr
+}
+
+type expr interface{}
+
+type (
+	numberExpr  float64
+	literalExpr string
+	userVarExpr string
+	negExpr     struct{ arg expr }
+	binaryExpr  struct {
+		op   tokKind
+		l, r expr
+	}
+	unionExpr struct{ l, r expr }
+	pathExpr  struct {
+		absolute bool
+		steps    []step
+	}
+	funcExpr struct {
+		name string
+		args []expr
+	}
+)
+
+// unsupportedFunctions are XPath 1.0 functions MySQL documents as not
+// supported; using them is a syntax error.
+var unsupportedFunctions = map[string]struct{}{
+	"id": {}, "lang": {}, "local-name": {}, "name": {}, "namespace-uri": {},
+	"normalize-space": {}, "starts-with": {}, "string": {}, "substring-after": {},
+	"substring-before": {}, "translate": {},
+}
+
+// functionArity holds the minimum and maximum argument count of each
+// supported function; -1 means unbounded.
+var functionArity = map[string][2]int{
+	"last": {0, 0}, "position": {0, 0}, "count": {1, 1}, "sum": {1, 1},
+	"not": {1, 1}, "true": {0, 0}, "false": {0, 0}, "boolean": {1, 1},
+	"number": {1, 1}, "floor": {1, 1}, "ceiling": {1, 1}, "round": {1, 1},
+	"concat": {2, -1}, "contains": {2, 2}, "substring": {2, 3}, "string-length": {1, 1},
+}
+
+var nodeTypes = map[string]testKind{
+	"text": testText, "node": testNode, "comment": testNone, "processing-instruction": testNone,
+}
+
+// Expr is a compiled XPath expression. It is immutable and safe for
+// concurrent use.
+type Expr struct {
+	root expr
+}
+
+// Compile compiles an XPath expression.
+func Compile(src string) (*Expr, error) {
+	l := &lexer{src: src}
+	if err := l.run(); err != nil {
+		return nil, err
+	}
+	p := &parser{src: src, toks: l.toks}
+	e, err := p.orExpr()
+	if err != nil {
+		return nil, err
+	}
+	if p.peek().kind != tEOF {
+		return nil, p.errAt()
+	}
+	return &Expr{root: e}, nil
+}
+
+type parser struct {
+	src  string
+	toks []token
+	i    int
+}
+
+func (p *parser) peek() token { return p.toks[p.i] }
+func (p *parser) peekAt(n int) token {
+	if p.i+n < len(p.toks) {
+		return p.toks[p.i+n]
+	}
+	return p.toks[len(p.toks)-1]
+}
+func (p *parser) next() token {
+	t := p.toks[p.i]
+	if t.kind != tEOF {
+		p.i++
+	}
+	return t
+}
+func (p *parser) errAt() error { return &SyntaxError{Near: p.src[p.peek().pos:]} }
+
+func (p *parser) expect(k tokKind) error {
+	if p.peek().kind != k {
+		return p.errAt()
+	}
+	p.next()
+	return nil
+}
+
+func (p *parser) binary(sub func() (expr, error), ops ...tokKind) (expr, error) {
+	l, err := sub()
+	if err != nil {
+		return nil, err
+	}
+	for {
+		k := p.peek().kind
+		matched := false
+		for _, op := range ops {
+			if k == op {
+				matched = true
+				break
+			}
+		}
+		if !matched {
+			return l, nil
+		}
+		p.next()
+		r, err := sub()
+		if err != nil {
+			return nil, err
+		}
+		l = &binaryExpr{op: k, l: l, r: r}
+	}
+}
+
+func (p *parser) orExpr() (expr, error)  { return p.binary(p.andExpr, tOr) }
+func (p *parser) andExpr() (expr, error) { return p.binary(p.eqExpr, tAnd) }
+func (p *parser) eqExpr() (expr, error)  { return p.binary(p.relExpr, tEq, tNe) }
+func (p *parser) relExpr() (expr, error) { return p.binary(p.addExpr, tLt, tLe, tGt, tGe) }
+func (p *parser) addExpr() (expr, error) { return p.binary(p.mulExpr, tPlus, tMinus) }
+func (p *parser) mulExpr() (expr, error) { return p.binary(p.unaryExpr, tMul, tDiv, tMod) }
+
+func (p *parser) unaryExpr() (expr, error) {
+	if p.peek().kind == tMinus {
+		p.next()
+		e, err := p.unaryExpr()
+		if err != nil {
+			return nil, err
+		}
+		return &negExpr{arg: e}, nil
+	}
+	return p.unionExpr()
+}
+
+func (p *parser) unionExpr() (expr, error) {
+	l, err := p.pathOrPrimary()
+	if err != nil {
+		return nil, err
+	}
+	for p.peek().kind == tPipe {
+		p.next()
+		r, err := p.pathOrPrimary()
+		if err != nil {
+			return nil, err
+		}
+		if !isNodeSetExpr(l) || !isNodeSetExpr(r) {
+			return nil, p.errAt()
+		}
+		l = &unionExpr{l: l, r: r}
+	}
+	return l, nil
+}
+
+func isNodeSetExpr(e expr) bool {
+	switch e.(type) {
+	case *pathExpr, *unionExpr:
+		return true
+	}
+	return false
+}
+
+func (p *parser) startsStep(t token) bool {
+	switch t.kind {
+	case tDot, tDDot, tAt, tStar:
+		return true
+	case tName:
+		next := p.peekAt(1).kind
+		if next == tAxis {
+			return true
+		}
+		if next == tLParen {
+			_, isType := nodeTypes[t.text]
+			return isType
+		}
+		return true
+	}
+	return false
+}
+
+func (p *parser) pathOrPrimary() (expr, error) {
+	t := p.peek()
+	switch t.kind {
+	case tSlash, tDSlash:
+		return p.locationPath()
+	}
+	if p.startsStep(t) {
+		return p.locationPath()
+	}
+	e, err := p.primary()
+	if err != nil {
+		return nil, err
+	}
+	// A locator cannot start from a scalar expression, and a primary
+	// expression cannot be filtered with a predicate.
+	switch p.peek().kind {
+	case tSlash, tDSlash, tLBracket:
+		return nil, p.errAt()
+	}
+	return e, nil
+}
+
+func (p *parser) primary() (expr, error) {
+	t := p.peek()
+	switch t.kind {
+	case tUserVar:
+		p.next()
+		return userVarExpr(t.text), nil
+	case tLiteral:
+		p.next()
+		return literalExpr(t.text), nil
+	case tNumber:
+		p.next()
+		return numberExpr(t.num), nil
+	case tLParen:
+		p.next()
+		e, err := p.orExpr()
+		if err != nil {
+			return nil, err
+		}
+		if err := p.expect(tRParen); err != nil {
+			return nil, err
+		}
+		return e, nil
+	case tName:
+		if p.peekAt(1).kind == tLParen {
+			return p.function()
+		}
+	}
+	return nil, p.errAt()
+}
+
+func (p *parser) function() (expr, error) {
+	name := p.next().text
+	if _, ok := unsupportedFunctions[name]; ok {
+		return nil, p.errAt()
+	}
+	arity, ok := functionArity[name]
+	if !ok {
+		return nil, p.errAt()
+	}
+	argsAt := p.peek().pos
+	p.next() // '('
+	f := &funcExpr{name: name}
+	if p.peek().kind != tRParen {
+		for {
+			a, err := p.orExpr()
+			if err != nil {
+				return nil, err
+			}
+			f.args = append(f.args, a)
+			if p.peek().kind != tComma {
+				break
+			}
+			p.next()
+		}
+	}
+	if err := p.expect(tRParen); err != nil {
+		return nil, err
+	}
+	if len(f.args) < arity[0] || (arity[1] >= 0 && len(f.args) > arity[1]) {
+		return nil, &SyntaxError{Near: p.src[argsAt:]}
+	}
+	if (name == "count" || name == "sum") && !isNodeSetExpr(f.args[0]) {
+		return nil, &SyntaxError{Near: p.src[argsAt:]}
+	}
+	return f, nil
+}
+
+func (p *parser) locationPath() (expr, error) {
+	path := &pathExpr{}
+	switch p.peek().kind {
+	case tSlash:
+		p.next()
+		path.absolute = true
+		if !p.startsStep(p.peek()) {
+			return path, nil
+		}
+	case tDSlash:
+		p.next()
+		path.absolute = true
+		path.steps = append(path.steps, step{axis: axisDescendantOrSelf, test: testNode})
+	}
+	for {
+		s, err := p.step()
+		if err != nil {
+			return nil, err
+		}
+		path.steps = append(path.steps, s)
+		switch p.peek().kind {
+		case tSlash:
+			p.next()
+		case tDSlash:
+			p.next()
+			path.steps = append(path.steps, step{axis: axisDescendantOrSelf, test: testNode})
+		default:
+			return path, nil
+		}
+	}
+}
+
+func (p *parser) step() (step, error) {
+	t := p.peek()
+	switch t.kind {
+	case tDot:
+		p.next()
+		return step{axis: axisSelf, test: testNode}, nil
+	case tDDot:
+		p.next()
+		return step{axis: axisParent, test: testNode}, nil
+	}
+	s := step{axis: axisChild}
+	if t.kind == tAt {
+		p.next()
+		s.axis = axisAttribute
+	} else if t.kind == tName && p.peekAt(1).kind == tAxis {
+		axis, ok := axisNames[t.text]
+		if !ok {
+			return s, p.errAt()
+		}
+		p.next()
+		p.next()
+		s.axis = axis
+	}
+	t = p.peek()
+	switch {
+	case t.kind == tStar:
+		p.next()
+		s.test = testAny
+	case t.kind == tName && p.peekAt(1).kind == tLParen:
+		kind, ok := nodeTypes[t.text]
+		if !ok {
+			return s, p.errAt()
+		}
+		p.next()
+		p.next()
+		if kind == testNone && p.peek().kind == tLiteral {
+			p.next()
+		}
+		if err := p.expect(tRParen); err != nil {
+			return s, err
+		}
+		s.test = kind
+	case t.kind == tName:
+		p.next()
+		s.test, s.name = testName, t.text
+	default:
+		return s, p.errAt()
+	}
+	for p.peek().kind == tLBracket {
+		p.next()
+		e, err := p.orExpr()
+		if err != nil {
+			return s, err
+		}
+		if err := p.expect(tRBracket); err != nil {
+			return s, err
+		}
+		s.preds = append(s.preds, e)
+	}
+	return s, nil
+}
