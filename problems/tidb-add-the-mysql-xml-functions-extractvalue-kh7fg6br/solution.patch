diff --git a/pkg/expression/builtin_xml.go b/pkg/expression/builtin_xml.go
new file mode 100644
index 0000000000..cd7d4b4563
--- /dev/null
+++ b/pkg/expression/builtin_xml.go
@@ -0,0 +1,234 @@
+// Copyright 2026 PingCAP, Inc.
+//
+// Licensed under the Apache License, Version 2.0 (the "License");
+// you may not use this file except in compliance with the License.
+// You may obtain a copy of the License at
+//
+//     http://www.apache.org/licenses/LICENSE-2.0
+//
+// Unless required by applicable law or agreed to in writing, software
+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+package expression
+
+import (
+	"strings"
+
+	"github.com/pingcap/tidb/pkg/parser/mysql"
+	"github.com/pingcap/tidb/pkg/types"
+	"github.com/pingcap/tidb/pkg/util/chunk"
+	"github.com/pingcap/tidb/pkg/util/collate"
+	"github.com/pingcap/tidb/pkg/util/xpath"
+)
+
+var (
+	_ functionClass = &extractValueFunctionClass{}
+	_ functionClass = &updateXMLFunctionClass{}
+)
+
+var (
+	_ builtinFunc = &builtinExtractValueSig{}
+	_ builtinFunc = &builtinUpdateXMLSig{}
+)
+
+// constXPath compiles the XPath argument when it is a plain constant, so a
+// syntax error is reported while the statement is built and the compiled
+// expression is shared by every row. It returns nil when the argument is not
+// constant or is NULL.
+func constXPath(ctx BuildContext, arg Expression) (*xpath.Expr, error) {
+	c, ok := arg.(*Constant)
+	if !ok || c.ParamMarker != nil || c.DeferredExpr != nil {
+		return nil, nil
+	}
+	s, isNull, err := c.EvalString(ctx.GetEvalCtx(), chunk.Row{})
+	if err != nil || isNull {
+		return nil, err
+	}
+	return compileXPath(s)
+}
+
+func compileXPath(s string) (*xpath.Expr, error) {
+	e, err := xpath.Compile(s)
+	if err != nil {
+		if se, ok := err.(*xpath.SyntaxError); ok {
+			return nil, errXPathSyntax.GenWithStackByArgs(se.Near)
+		}
+		return nil, err
+	}
+	return e, nil
+}
+
+// xmlEnv builds the evaluation environment of a call: string comparisons and
+// contains() follow the collation of the call, and $@name reads the user
+// variable at execution time.
+func xmlEnv(ctx EvalContext, collation string) xpath.Env {
+	collator := collate.GetCollator(collation)
+	return xpath.Env{
+		Equal: func(a, b string) bool { return collator.Compare(a, b) == 0 },
+		Contains: func(s, sub string) bool {
+			if sub == "" {
+				return true
+			}
+			var sb strings.Builder
+			sb.WriteByte('%')
+			for i := 0; i < len(sub); i++ {
+				if c := sub[i]; c == '%' || c == '_' || c == '\\' {
+					sb.WriteByte('\\')
+				}
+				sb.WriteByte(sub[i])
+			}
+			sb.WriteByte('%')
+			pattern := collator.Pattern()
+			pattern.Compile(sb.String(), '\\')
+			return pattern.DoMatch(s)
+		},
+		Lookup: func(name string) (xpath.Variable, bool) {
+			d, ok := ctx.GetUserVarsReader().GetUserVarVal(strings.ToLower(name))
+			if !ok || d.IsNull() {
+				return xpath.Variable{}, false
+			}
+			switch d.Kind() {
+			case types.KindInt64, types.KindUint64, types.KindFloat32, types.KindFloat64, types.KindMysqlDecimal:
+				f, err := d.ToFloat64(typeCtx(ctx))
+				if err == nil {
+					return xpath.Variable{IsNumber: true, Number: f}, true
+				}
+			}
+			s, err := d.ToString()
+			if err != nil {
+				return xpath.Variable{}, false
+			}
+			return xpath.Variable{String: s}, true
+		},
+	}
+}
+
+// evalXMLArgs evaluates the XML and XPath arguments. A malformed XML value
+// makes the result NULL with a warning, like MySQL.
+func evalXMLArgs(ctx EvalContext, row chunk.Row, xmlArg, pathArg Expression, compiled *xpath.Expr) (*xpath.Document, *xpath.Expr, bool, error) {
+	path := compiled
+	if path == nil {
+		s, isNull, err := pathArg.EvalString(ctx, row)
+		if err != nil || isNull {
+			return nil, nil, true, err
+		}
+		if path, err = compileXPath(s); err != nil {
+			return nil, nil, true, err
+		}
+	}
+	src, isNull, err := xmlArg.EvalString(ctx, row)
+	if err != nil || isNull {
+		return nil, nil, true, err
+	}
+	doc, err := xpath.Parse(src)
+	if err != nil {
+		tc := typeCtx(ctx)
+		tc.AppendWarning(errIncorrectXMLValue.FastGenByArgs("XML", err.Error()))
+		return nil, nil, true, nil
+	}
+	return doc, path, false, nil
+}
+
+type extractValueFunctionClass struct {
+	baseFunctionClass
+}
+
+func (c *extractValueFunctionClass) getFunction(ctx BuildContext, args []Expression) (builtinFunc, error) {
+	if err := c.verifyArgs(args); err != nil {
+		return nil, err
+	}
+	bf, err := newBaseBuiltinFuncWithTp(ctx, c.funcName, args, types.ETString, types.ETString, types.ETString)
+	if err != nil {
+		return nil, err
+	}
+	bf.tp.SetFlen(mysql.MaxLongBlobWidth)
+	path, err := constXPath(ctx, args[1])
+	if err != nil {
+		return nil, err
+	}
+	return &builtinExtractValueSig{baseBuiltinFunc: bf, path: path}, nil
+}
+
+type builtinExtractValueSig struct {
+	baseBuiltinFunc
+	// path is the compiled constant XPath argument, nil when it is not
+	// constant. It is immutable after the function is built.
+	path *xpath.Expr
+}
+
+func (b *builtinExtractValueSig) Clone() builtinFunc {
+	newSig := &builtinExtractValueSig{path: b.path}
+	newSig.cloneFrom(&b.baseBuiltinFunc)
+	return newSig
+}
+
+// evalString evals EXTRACTVALUE(xml_frag, xpath_expr).
+// See https://dev.mysql.com/doc/refman/8.4/en/xml-functions.html#function_extractvalue
+func (b *builtinExtractValueSig) evalString(ctx EvalContext, row chunk.Row) (string, bool, error) {
+	doc, path, isNull, err := evalXMLArgs(ctx, row, b.args[0], b.args[1], b.path)
+	if isNull || err != nil {
+		return "", true, err
+	}
+	res, ok := path.Evaluate(doc, xmlEnv(ctx, b.collation)).Text()
+	return res, !ok, nil
+}
+
+type updateXMLFunctionClass struct {
+	baseFunctionClass
+}
+
+func (c *updateXMLFunctionClass) getFunction(ctx BuildContext, args []Expression) (builtinFunc, error) {
+	if err := c.verifyArgs(args); err != nil {
+		return nil, err
+	}
+	bf, err := newBaseBuiltinFuncWithTp(ctx, c.funcName, args, types.ETString, types.ETString, types.ETString, types.ETString)
+	if err != nil {
+		return nil, err
+	}
+	bf.tp.SetFlen(mysql.MaxLongBlobWidth)
+	path, err := constXPath(ctx, args[1])
+	if err != nil {
+		return nil, err
+	}
+	return &builtinUpdateXMLSig{baseBuiltinFunc: bf, path: path}, nil
+}
+
+type builtinUpdateXMLSig struct {
+	baseBuiltinFunc
+	// path is the compiled constant XPath argument, nil when it is not
+	// constant. It is immutable after the function is built.
+	path *xpath.Expr
+}
+
+func (b *builtinUpdateXMLSig) Clone() builtinFunc {
+	newSig := &builtinUpdateXMLSig{path: b.path}
+	newSig.cloneFrom(&b.baseBuiltinFunc)
+	return newSig
+}
+
+// evalString evals UPDATEXML(xml_target, xpath_expr, new_xml).
+// See https://dev.mysql.com/doc/refman/8.4/en/xml-functions.html#function_updatexml
+func (b *builtinUpdateXMLSig) evalString(ctx EvalContext, row chunk.Row) (string, bool, error) {
+	doc, path, isNull, err := evalXMLArgs(ctx, row, b.args[0], b.args[1], b.path)
+	if isNull || err != nil {
+		return "", true, err
+	}
+	replacement, isNull, err := b.args[2].EvalString(ctx, row)
+	if isNull || err != nil {
+		return "", true, err
+	}
+	nodes, ok := path.Evaluate(doc, xmlEnv(ctx, b.collation)).Nodes()
+	if !ok {
+		return "", true, nil
+	}
+	src := doc.Source()
+	// Only a single match is replaced; otherwise the target is returned as is.
+	if len(nodes) != 1 {
+		return src, false, nil
+	}
+	start, end := doc.Span(nodes[0])
+	return src[:start] + replacement + src[end:], false, nil
+}
