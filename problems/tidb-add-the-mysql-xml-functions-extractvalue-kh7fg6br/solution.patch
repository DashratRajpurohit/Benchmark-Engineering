+package xpath
+
+import (
+	"math"
+	"slices"
+	"strconv"
+	"strings"
+	"unicode/utf8"
+)
+
+// Variable is the value of a user variable referenced as $@name.
+type Variable struct {
+	IsNumber bool
+	Number   float64
+	String   string
+}
+
+// Env supplies the session dependent parts of an evaluation.
+type Env struct {
+	// Equal compares two strings under the collation of the call.
+	Equal func(a, b string) bool
+	// Contains reports whether s contains sub under the collation of the call.
+	Contains func(s, sub string) bool
+	// Lookup returns the user variable with the given name. ok is false when
+	// the variable is unset or NULL.
+	Lookup func(name string) (v Variable, ok bool)
+}
+
+type valueKind uint8
+
+const (
+	vNodes valueKind = iota
+	vNumber
+	vString
+	vBool
+)
+
+type value struct {
+	kind  valueKind
+	nodes []int
+	num   float64
+	str   string
+	b     bool
+}
+
+// Result is the value of an expression evaluated against a document.
+type Result struct {
+	doc *Document
+	v   value
+}
+
+// Nodes returns the selected nodes in document order. ok is false when the
+// expression does not produce a node set.
+func (r Result) Nodes() (nodes []int, ok bool) {
+	return r.v.nodes, r.v.kind == vNodes
+}
+
+// Text renders the result the way ExtractValue() returns it. For a node set
+// it is the text of every selected text or attribute node and of the direct
+// text children of every selected element, in document order, separated by
+// single spaces. ok is false when the result is SQL NULL.
+func (r Result) Text() (s string, ok bool) {
+	switch r.v.kind {
+	case vNodes:
+		return r.doc.render(r.v.nodes), true
+	case vNumber:
+		if math.IsNaN(r.v.num) || math.IsInf(r.v.num, 0) {
+			return "", false
+		}
+		return formatNumber(r.v.num), true
+	case vBool:
+		if r.v.b {
+			return "1", true
+		}
+		return "0", true
+	default:
+		return r.v.str, true
+	}
+}
+
+func (d *Document) render(nodes []int) string {
+	var texts []int
+	for _, n := range nodes {
+		texts = d.textOf(n, texts)
+	}
+	slices.Sort(texts)
+	texts = slices.Compact(texts)
+	var sb strings.Builder
+	for i, t := range texts {
+		if i > 0 {
+			sb.WriteByte(' ')
+		}
+		sb.WriteString(d.nodes[t].value)
+	}
+	return sb.String()
+}
+
+func formatNumber(f float64) string {
+	if f == math.Trunc(f) && math.Abs(f) < 1e18 {
+		return strconv.FormatInt(int64(f), 10)
+	}
+	// Print at most 15 significant digits, so 0.1+0.2 shows as 0.3.
+	rounded, err := strconv.ParseFloat(strconv.FormatFloat(f, 'g', 15, 64), 64)
+	if err != nil {
+		rounded = f
+	}
+	return strconv.FormatFloat(rounded, 'f', -1, 64)
+}
+
+// Evaluate evaluates the expression with the document root as context node.
+func (e *Expr) Evaluate(doc *Document, env Env) Result {
+	if env.Equal == nil {
+		env.Equal = func(a, b string) bool { return a == b }
+	}
+	if env.Contains == nil {
+		env.Contains = strings.Contains
+	}
+	if env.Lookup == nil {
+		env.Lookup = func(string) (Variable, bool) { return Variable{}, false }
+	}
+	ev := &evaluator{doc: doc, env: env}
+	return Result{doc: doc, v: ev.eval(e.root, evalCtx{node: 0, pos: 1, size: 1})}
+}
+
+type evalCtx struct {
+	node      int
+	pos, size int
+}
+
+type evaluator struct {
+	doc *Document
+	env Env
+}
+
+func (ev *evaluator) eval(e expr, c evalCtx) value {
+	switch x := e.(type) {
+	case numberExpr:
+		return value{kind: vNumber, num: float64(x)}
+	case literalExpr:
+		return value{kind: vString, str: string(x)}
+	case userVarExpr:
+		v, ok := ev.env.Lookup(string(x))
+		if !ok {
+			// An unset variable gives an empty result.
+			return value{kind: vString}
+		}
+		if v.IsNumber {
+			return value{kind: vNumber, num: v.Number}
+		}
+		return value{kind: vString, str: v.String}
+	case *negExpr:
+		return value{kind: vNumber, num: -ev.number(ev.eval(x.arg, c))}
+	case *pathExpr:
+		return value{kind: vNodes, nodes: ev.path(x, c.node)}
+	case *unionExpr:
+		l := ev.eval(x.l, c).nodes
+		r := ev.eval(x.r, c).nodes
+		nodes := append(slices.Clone(l), r...)
+		slices.Sort(nodes)
+		return value{kind: vNodes, nodes: slices.Compact(nodes)}
+	case *funcExpr:
+		return ev.call(x, c)
+	case *binaryExpr:
+		return ev.binary(x, c)
+	}
+	return value{kind: vString}
+}
+
+func (ev *evaluator) binary(x *binaryExpr, c evalCtx) value {
+	switch x.op {
+	case tOr:
+		return value{kind: vBool, b: ev.boolean(ev.eval(x.l, c)) || ev.boolean(ev.eval(x.r, c))}
+	case tAnd:
+		return value{kind: vBool, b: ev.boolean(ev.eval(x.l, c)) && ev.boolean(ev.eval(x.r, c))}
+	case tEq, tNe, tLt, tLe, tGt, tGe:
+		return value{kind: vBool, b: ev.compare(x.op, ev.eval(x.l, c), ev.eval(x.r, c))}
+	}
+	l, r := ev.number(ev.eval(x.l, c)), ev.number(ev.eval(x.r, c))
+	var n float64
+	switch x.op {
+	case tPlus:
+		n = l + r
+	case tMinus:
+		n = l - r
+	case tMul:
+		n = l * r
+	case tDiv:
+		n = l / r
+		if r == 0 {
+			n = math.NaN()
+		}
+	case tMod:
+		n = math.Mod(l, r)
+	}
+	return value{kind: vNumber, num: n}
+}
+
+// nodeString is the string value of a single node. Like MySQL it is the text
+// the node contributes to an ExtractValue() result.
+func (ev *evaluator) nodeString(n int) string {
+	return ev.doc.render([]int{n})
+}
+
+func (ev *evaluator) str(v value) string {
+	switch v.kind {
+	case vNodes:
+		return ev.doc.render(v.nodes)
+	case vNumber:
+		if math.IsNaN(v.num) {
+			return "NaN"
+		}
+		return formatNumber(v.num)
+	case vBool:
+		if v.b {
+			return "1"
+		}
+		return "0"
+	}
+	return v.str
+}
+
+// strToNumber converts the leading numeric part of s, or 0 when there is
+// none, like a SQL string to number conversion.
+func strToNumber(s string) float64 {
+	s = strings.TrimLeft(s, " \t\n\r")
+	end := 0
+	if end < len(s) && (s[end] == '-' || s[end] == '+') {
+		end++
+	}
+	digits := false
+	for end < len(s) && s[end] >= '0' && s[end] <= '9' {
+		end++
+		digits = true
+	}
+	if end < len(s) && s[end] == '.' {
+		end++
+		for end < len(s) && s[end] >= '0' && s[end] <= '9' {
+			end++
+			digits = true
+		}
+	}
+	if !digits {
+		return 0
+	}
+	n, err := strconv.ParseFloat(strings.TrimSuffix(s[:end], "."), 64)
+	if err != nil {
+		return 0
+	}
+	return n
+}
+
+func (ev *evaluator) number(v value) float64 {
+	switch v.kind {
+	case vNumber:
+		return v.num
+	case vBool:
+		if v.b {
+			return 1
+		}
+		return 0
+	}
+	return strToNumber(ev.str(v))
+}
+
+func (ev *evaluator) boolean(v value) bool {
+	switch v.kind {
+	case vNodes:
+		return len(v.nodes) > 0
+	case vNumber:
+		return v.num != 0 && !math.IsNaN(v.num)
+	case vBool:
+		return v.b
+	}
+	return v.str != ""
+}
+
+func compareNumbers(op tokKind, a, b float64) bool {
+	switch op {
+	case tEq:
+		return a == b
+	case tNe:
+		return a != b
+	case tLt:
+		return a < b
+	case tLe:
+		return a <= b
+	case tGt:
+		return a > b
+	case tGe:
+		return a >= b
+	}
+	return false
+}
+
+// flip returns the operator that gives the same result with swapped operands.
+func flip(op tokKind) tokKind {
+	switch op {
+	case tLt:
+		return tGt
+	case tLe:
+		return tGe
+	case tGt:
+		return tLt
+	case tGe:
+		return tLe
+	}
+	return op
+}
+
+func (ev *evaluator) compareStrings(op tokKind, a, b string) bool {
+	switch op {
+	case tEq:
+		return ev.env.Equal(a, b)
+	case tNe:
+		return !ev.env.Equal(a, b)
+	}
+	return compareNumbers(op, strToNumber(a), strToNumber(b))
+}
+
+// compare implements the XPath 1.0 comparison rules: a node set compares
+// true when any of its nodes does.
+func (ev *evaluator) compare(op tokKind, l, r value) bool {
+	if l.kind != vNodes && r.kind == vNodes {
+		return ev.compare(flip(op), r, l)
+	}
+	if l.kind == vNodes {
+		switch r.kind {
+		case vNodes:
+			for _, a := range l.nodes {
+				for _, b := range r.nodes {
+					if ev.compareStrings(op, ev.nodeString(a), ev.nodeString(b)) {
+						return true
+					}
+				}
+			}
+			return false
+		case vBool:
+			return compareNumbers(op, ev.number(value{kind: vBool, b: len(l.nodes) > 0}), ev.number(r))
+		case vNumber:
+			for _, a := range l.nodes {
+				if compareNumbers(op, strToNumber(ev.nodeString(a)), r.num) {
+					return true
+				}
+			}
+			return false
+		default:
+			for _, a := range l.nodes {
+				if ev.compareStrings(op, ev.nodeString(a), r.str) {
+					return true
+				}
+			}
+			return false
+		}
+	}
+	if op == tEq || op == tNe {
+		switch {
+		case l.kind == vBool || r.kind == vBool:
+			return compareNumbers(op, ev.number(value{kind: vBool, b: ev.boolean(l)}), ev.number(value{kind: vBool, b: ev.boolean(r)}))
+		case l.kind == vNumber || r.kind == vNumber:
+			return compareNumbers(op, ev.number(l), ev.number(r))
+		default:
+			return ev.compareStrings(op, ev.str(l), ev.str(r))
+		}
+	}
+	return compareNumbers(op, ev.number(l), ev.number(r))
+}
+
+func (ev *evaluator) call(f *funcExpr, c evalCtx) value {
+	arg := func(i int) value { return ev.eval(f.args[i], c) }
+	num := func(n float64) value { return value{kind: vNumber, num: n} }
+	switch f.name {
+	case "last":
+		return num(float64(c.size))
+	case "position":
+		return num(float64(c.pos))
+	case "count":
+		return num(float64(len(arg(0).nodes)))
+	case "sum":
+		total := 0.0
+		for _, n := range arg(0).nodes {
+			total += strToNumber(ev.nodeString(n))
+		}
+		return num(total)
+	case "not":
+		return value{kind: vBool, b: !ev.boolean(arg(0))}
+	case "true":
+		return value{kind: vBool, b: true}
+	case "false":
+		return value{kind: vBool}
+	case "boolean":
+		return value{kind: vBool, b: ev.boolean(arg(0))}
+	case "number":
+		return num(ev.number(arg(0)))
+	case "floor":
+		return num(math.Floor(ev.number(arg(0))))
+	case "ceiling":
+		return num(math.Ceil(ev.number(arg(0))))
+	case "round":
+		return num(math.RoundToEven(ev.number(arg(0))))
+	case "concat":
+		var sb strings.Builder
+		for i := range f.args {
+			sb.WriteString(ev.str(arg(i)))
+		}
+		return value{kind: vString, str: sb.String()}
+	case "contains":
+		return value{kind: vBool, b: ev.env.Contains(ev.str(arg(0)), ev.str(arg(1)))}
+	case "string-length":
+		return num(float64(utf8.RuneCountInString(ev.str(arg(0)))))
+	case "substring":
+		s := []rune(ev.str(arg(0)))
+		start := math.Round(ev.number(arg(1)))
+		end := math.Inf(1)
+		if len(f.args) == 3 {
+			end = start + math.Round(ev.number(arg(2)))
+		}
+		var sb strings.Builder
+		for i, r := range s {
+			p := float64(i + 1)
+			if p >= start && p < end {
+				sb.WriteRune(r)
+			}
+		}
+		return value{kind: vString, str: sb.String()}
+	}
+	return value{kind: vString}
+}
+
+// path evaluates a location path from the given context node and returns the
+// selected nodes in document order without duplicates.
+func (ev *evaluator) path(p *pathExpr, ctxNode int) []int {
+	cur := []int{ctxNode}
+	if p.absolute {
+		cur = []int{0}
+	}
+	for i := range p.steps {
+		s := &p.steps[i]
+		var next []int
+		for _, n := range cur {
+			cand := ev.axis(s, n)
+			for _, pred := range s.preds {
+				cand = ev.filter(cand, pred)
+			}
+			next = append(next, cand...)
+		}
+		slices.Sort(next)
+		cur = slices.Compact(next)
+	}
+	return cur
+}
+
+// filter keeps the candidates for which the predicate holds. Candidates are
+// in axis order, so positions count from the context node.
+func (ev *evaluator) filter(cand []int, pred expr) []int {
+	kept := cand[:0:0]
+	for i, n := range cand {
+		v := ev.eval(pred, evalCtx{node: n, pos: i + 1, size: len(cand)})
+		if v.kind == vNumber {
+			if v.num == float64(i+1) {
+				kept = append(kept, n)
+			}
+		} else if ev.boolean(v) {
+			kept = append(kept, n)
+		}
+	}
+	return kept
+}
+
+func (ev *evaluator) matches(s *step, n int) bool {
+	nd := &ev.doc.nodes[n]
+	principal := ElementNode
+	if s.axis == axisAttribute {
+		principal = AttributeNode
+	}
+	switch s.test {
+	case testName:
+		return nd.kind == principal && nd.name == s.name
+	case testAny:
+		return nd.kind == principal
+	case testText:
+		return nd.kind == TextNode
+	case testNode:
+		return true
+	}
+	return false
+}
+
+func (ev *evaluator) descendants(n int, dst []int) []int {
+	for _, c := range ev.doc.nodes[n].children {
+		dst = append(dst, c)
+		dst = ev.descendants(c, dst)
+	}
+	return dst
+}
+
+// axis returns the nodes on the step's axis that pass its node test, in axis
+// order (reverse document order for reverse axes).
+func (ev *evaluator) axis(s *step, n int) []int {
+	nodes := ev.doc.nodes
+	var all []int
+	switch s.axis {
+	case axisChild:
+		all = nodes[n].children
+	case axisAttribute:
+		all = nodes[n].attrs
+	case axisSelf:
+		all = []int{n}
+	case axisDescendant:
+		all = ev.descendants(n, nil)
+	case axisDescendantOrSelf:
+		all = ev.descendants(n, []int{n})
+	case axisParent:
+		if nodes[n].parent >= 0 {
+			all = []int{nodes[n].parent}
+		}
+	case axisAncestor, axisAncestorOrSelf:
+		if s.axis == axisAncestorOrSelf {
+			all = append(all, n)
+		}
+		for p := nodes[n].parent; p >= 0; p = nodes[p].parent {
+			all = append(all, p)
+		}
+	case axisFollowingSibling, axisPrecedingSibling:
+		if nodes[n].kind == AttributeNode || nodes[n].parent < 0 {
+			break
+		}
+		siblings := nodes[nodes[n].parent].children
+		at := slices.Index(siblings, n)
+		if s.axis == axisFollowingSibling {
+			all = siblings[at+1:]
+		} else {
+			for i := at - 1; i >= 0; i-- {
+				all = append(all, siblings[i])
+			}
+		}
+	case axisFollowing:
+		if nodes[n].kind == AttributeNode {
+			n = nodes[n].parent
+		}
+		_, end := ev.lastDescendant(n)
+		for i := end + 1; i < len(nodes); i++ {
+			if nodes[i].kind != AttributeNode {
+				all = append(all, i)
+			}
+		}
+	case axisPreceding:
+		ancestors := map[int]bool{}
+		for p := nodes[n].parent; p >= 0; p = nodes[p].parent {
+			ancestors[p] = true
+		}
+		for i := n - 1; i > 0; i-- {
+			if nodes[i].kind != AttributeNode && !ancestors[i] {
+				all = append(all, i)
+			}
+		}
+	}
+	var out []int
+	for _, c := range all {
+		if ev.matches(s, c) {
+			out = append(out, c)
+		}
+	}
+	return out
+}
+
+// lastDescendant returns n and the index of the last node in its subtree.
+func (ev *evaluator) lastDescendant(n int) (int, int) {
+	last := n
+	for {
+		nd := &ev.doc.nodes[last]
+		switch {
+		case len(nd.children) > 0:
+			last = nd.children[len(nd.children)-1]
+		case len(nd.attrs) > 0:
+			return n, nd.attrs[len(nd.attrs)-1]
+		default:
+			return n, last
+		}
+	}
+}
