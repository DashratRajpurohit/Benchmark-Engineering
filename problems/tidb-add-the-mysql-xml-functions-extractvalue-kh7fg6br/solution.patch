+
+// Package xpath implements the XML fragment model and the XPath subset used by
+// the MySQL compatible ExtractValue() and UpdateXML() functions.
+package xpath
+
+import (
+	"fmt"
+	"strings"
+)
+
+// NodeKind is the kind of a node in a parsed XML fragment.
+type NodeKind uint8
+
+const (
+	// RootNode is the document root. It is always the first node.
+	RootNode NodeKind = iota
+	// ElementNode is an XML element.
+	ElementNode
+	// AttributeNode is an attribute of an element.
+	AttributeNode
+	// TextNode is a run of character data or a CDATA section.
+	TextNode
+)
+
+// node is one node of a parsed fragment. Nodes are stored in document order,
+// so a node's index is also its document position.
+type node struct {
+	kind NodeKind
+	name string
+	// value is the raw text of a text node or the raw value of an attribute.
+	// Entity references are kept as written, like MySQL does.
+	value  string
+	parent int
+	// start and end delimit the source text of the node: the whole element
+	// from its start tag to its end tag, the whole attribute, or the text.
+	start, end int
+	children   []int // child elements and text nodes
+	attrs      []int
+}
+
+// Document is a parsed XML fragment.
+type Document struct {
+	src   string
+	nodes []node
+}
+
+// XMLError reports why a fragment is not well formed.
+type XMLError struct {
+	Line int
+	Pos  int
+	Msg  string
+}
+
+func (e *XMLError) Error() string {
+	return fmt.Sprintf("parse error at line %d pos %d: %s", e.Line, e.Pos, e.Msg)
+}
+
+// Parse parses an XML fragment. A fragment may hold several top level
+// elements and text outside any element. Comments, processing instructions
+// and declarations are skipped.
+func Parse(src string) (*Document, error) {
+	p := &xmlParser{src: src}
+	p.doc = &Document{src: src}
+	p.doc.nodes = append(p.doc.nodes, node{kind: RootNode, parent: -1, start: 0, end: len(src)})
+	p.stack = []int{0}
+	if err := p.parse(); err != nil {
+		return nil, err
+	}
+	return p.doc, nil
+}
+
+type xmlParser struct {
+	src   string
+	pos   int
+	doc   *Document
+	stack []int
+}
+
+func (p *xmlParser) errorf(at int, format string, args ...any) error {
+	// Positions are counted from 1, like MySQL reports them.
+	line, col := 1, 1
+	for i := 0; i < at && i < len(p.src); i++ {
+		if p.src[i] == '\n' {
+			line++
+			col = 1
+		} else {
+			col++
+		}
+	}
+	return &XMLError{Line: line, Pos: col, Msg: fmt.Sprintf(format, args...)}
+}
+
+func (p *xmlParser) add(n node) int {
+	idx := len(p.doc.nodes)
+	p.doc.nodes = append(p.doc.nodes, n)
+	return idx
+}
+
+func (p *xmlParser) top() int {
+	return p.stack[len(p.stack)-1]
+}
+
+func (p *xmlParser) addText(start, end, valStart, valEnd int) {
+	parent := p.top()
+	idx := p.add(node{kind: TextNode, value: p.src[valStart:valEnd], parent: parent, start: start, end: end})
+	p.doc.nodes[parent].children = append(p.doc.nodes[parent].children, idx)
+}
+
+func (p *xmlParser) parse() error {
+	src := p.src
+	for p.pos < len(src) {
+		if src[p.pos] != '<' {
+			end := strings.IndexByte(src[p.pos:], '<')
+			if end < 0 {
+				end = len(src)
+			} else {
+				end += p.pos
+			}
+			p.addText(p.pos, end, p.pos, end)
+			p.pos = end
+			continue
+		}
+		rest := src[p.pos:]
+		var err error
+		switch {
+		case strings.HasPrefix(rest, "<!--"):
+			err = p.skipTo(p.pos+4, "-->")
+		case strings.HasPrefix(rest, "<![CDATA["):
+			err = p.cdata()
+		case strings.HasPrefix(rest, "<?"):
+			err = p.skipTo(p.pos+2, "?>")
+		case strings.HasPrefix(rest, "<!"):
+			err = p.declaration()
+		case strings.HasPrefix(rest, "</"):
+			err = p.endTag()
+		default:
+			err = p.startTag()
+		}
+		if err != nil {
+			return err
+		}
+	}
+	if len(p.stack) > 1 {
+		return p.errorf(len(src), "unexpected END-OF-INPUT")
+	}
+	return nil
+}
+
+func (p *xmlParser) skipTo(from int, terminator string) error {
+	end := strings.Index(p.src[from:], terminator)
+	if end < 0 {
+		return p.errorf(len(p.src), "unexpected END-OF-INPUT")
+	}
+	p.pos = from + end + len(terminator)
+	return nil
+}
+
+func (p *xmlParser) cdata() error {
+	valStart := p.pos + len("<![CDATA[")
+	end := strings.Index(p.src[valStart:], "]]>")
+	if end < 0 {
+		return p.errorf(len(p.src), "unexpected END-OF-INPUT")
+	}
+	valEnd := valStart + end
+	p.addText(p.pos, valEnd+3, valStart, valEnd)
+	p.pos = valEnd + 3
+	return nil
+}
+
+// declaration skips a <!DOCTYPE ...> style declaration, including an
+// internal subset in square brackets.
+func (p *xmlParser) declaration() error {
+	depth := 0
+	for i := p.pos + 2; i < len(p.src); i++ {
+		switch p.src[i] {
+		case '[':
+			depth++
+		case ']':
+			depth--
+		case '>':
+			if depth <= 0 {
+				p.pos = i + 1
+				return nil
+			}
+		}
+	}
+	return p.errorf(len(p.src), "unexpected END-OF-INPUT")
+}
+
+func isNameByte(c byte) bool {
+	return c >= 0x80 || c == '_' || c == '-' || c == '.' || c == ':' ||
+		(c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9')
+}
+
+func isSpace(c byte) bool {
+	return c == ' ' || c == '\t' || c == '\n' || c == '\r'
+}
+
+func (p *xmlParser) skipSpaces() {
+	for p.pos < len(p.src) && isSpace(p.src[p.pos]) {
+		p.pos++
+	}
+}
+
+func (p *xmlParser) name() string {
+	start := p.pos
+	for p.pos < len(p.src) && isNameByte(p.src[p.pos]) {
+		p.pos++
+	}
+	return p.src[start:p.pos]
+}
+
+func (p *xmlParser) expect(c byte, what string) error {
+	if p.pos >= len(p.src) {
+		return p.errorf(p.pos, "END-OF-INPUT unexpected (%s wanted)", what)
+	}
+	if p.src[p.pos] != c {
+		return p.errorf(p.pos, "'%c' unexpected (%s wanted)", p.src[p.pos], what)
+	}
+	p.pos++
+	return nil
+}
+
+func (p *xmlParser) startTag() error {
+	start := p.pos
+	p.pos++ // '<'
+	name := p.name()
+	if name == "" {
+		return p.errorf(p.pos, "unknown token unexpected (ident wanted)")
+	}
+	parent := p.top()
+	elem := p.add(node{kind: ElementNode, name: name, parent: parent, start: start})
+	p.doc.nodes[parent].children = append(p.doc.nodes[parent].children, elem)
+	for {
+		p.skipSpaces()
+		if p.pos >= len(p.src) {
+			return p.errorf(p.pos, "END-OF-INPUT unexpected ('>' wanted)")
+		}
+		switch c := p.src[p.pos]; {
+		case c == '>':
+			p.pos++
+			p.stack = append(p.stack, elem)
+			return nil
+		case c == '/':
+			p.pos++
+			if err := p.expect('>', "'>'"); err != nil {
+				return err
+			}
+			p.doc.nodes[elem].end = p.pos
+			return nil
+		case isNameByte(c):
+			if err := p.attribute(elem); err != nil {
+				return err
+			}
+		default:
+			return p.errorf(p.pos, "'%c' unexpected ('>' wanted)", c)
+		}
+	}
+}
+
+func (p *xmlParser) attribute(elem int) error {
+	start := p.pos
+	name := p.name()
+	p.skipSpaces()
+	if err := p.expect('=', "'='"); err != nil {
+		return err
+	}
+	p.skipSpaces()
+	if p.pos >= len(p.src) {
+		return p.errorf(p.pos, "END-OF-INPUT unexpected (string wanted)")
+	}
+	quote := p.src[p.pos]
+	if quote != '"' && quote != '\'' {
+		return p.errorf(p.pos, "unknown token unexpected (ident or string wanted)")
+	}
+	valStart := p.pos + 1
+	end := strings.IndexByte(p.src[valStart:], quote)
+	if end < 0 {
+		return p.errorf(len(p.src), "unexpected END-OF-INPUT")
+	}
+	valEnd := valStart + end
+	p.pos = valEnd + 1
+	idx := p.add(node{kind: AttributeNode, name: name, value: p.src[valStart:valEnd], parent: elem, start: start, end: p.pos})
+	p.doc.nodes[elem].attrs = append(p.doc.nodes[elem].attrs, idx)
+	return nil
+}
+
+// endTag closes the innermost open element. Like MySQL, the name in the end
+// tag is not required to match the start tag.
+func (p *xmlParser) endTag() error {
+	p.pos += 2
+	p.name()
+	p.skipSpaces()
+	if err := p.expect('>', "'>'"); err != nil {
+		return err
+	}
+	if len(p.stack) == 1 {
+		return p.errorf(p.pos, "end tag unexpected (END-OF-INPUT wanted)")
+	}
+	elem := p.top()
+	p.doc.nodes[elem].end = p.pos
+	p.stack = p.stack[:len(p.stack)-1]
+	return nil
+}
+
+// Source returns the text the document was parsed from.
+func (d *Document) Source() string {
+	return d.src
+}
+
+// Span returns the source range of node n.
+func (d *Document) Span(n int) (start, end int) {
+	return d.nodes[n].start, d.nodes[n].end
+}
+
+// Kind returns the kind of node n.
+func (d *Document) Kind(n int) NodeKind {
+	return d.nodes[n].kind
+}
+
+// textOf appends the text a node contributes to an ExtractValue() result: the
+// node itself for text and attribute nodes, the direct text children for
+// elements and the root.
+func (d *Document) textOf(n int, dst []int) []int {
+	switch d.nodes[n].kind {
+	case TextNode, AttributeNode:
+		return append(dst, n)
+	default:
+		for _, c := range d.nodes[n].children {
+			if d.nodes[c].kind == TextNode {
+				dst = append(dst, c)
+			}
+		}
+		return dst
+	}
+}
