+func TestXPathComparisonsFollowTheCollation(t *testing.T) {
+	tk := newTestKit(t)
+	checks := []struct{ query, want string }{
+		{`select ExtractValue('<a>hello</a>' collate utf8mb4_general_ci, 'contains(/a, "ELL")')`, `1`},
+		{`select ExtractValue('<a>hello</a>' collate utf8mb4_bin, 'contains(/a, "ELL")')`, `0`},
+		{`select ExtractValue('<a>hello</a>' collate utf8mb4_bin, 'contains(/a, "ell")')`, `1`},
+		{`select ExtractValue('<a>X</a>' collate utf8mb4_general_ci, '/a = "x"')`, `1`},
+		{`select ExtractValue('<a>X</a>' collate utf8mb4_bin, '/a = "x"')`, `0`},
+		{`select ExtractValue('<a>Ünïcode</a>' collate utf8mb4_0900_ai_ci, '/a = "unicode"')`, `1`},
+		{`select ExtractValue('<a>Ünïcode</a>' collate utf8mb4_bin, '/a = "unicode"')`, `0`},
+		{`select ExtractValue('<a><b>X</b><b>Y</b></a>' collate utf8mb4_general_ci, 'count(//b[. = "x" or . = "y"])')`, `2`},
+		{`select ExtractValue('<a><b>X</b><b>Y</b></a>' collate utf8mb4_bin, 'count(//b[. = "x" or . = "y"])')`, `0`},
+		{`select ExtractValue('<a b="Q">t</a>' collate utf8mb4_general_ci, '/a[@b = "q"]')`, `t`},
+		{`select concat('[', ExtractValue('<a b="Q">t</a>' collate utf8mb4_bin, '/a[@b = "q"]'), ']')`, `[]`},
+		{`select ExtractValue('<a>50%</a>' collate utf8mb4_bin, 'contains(/a, "%")')`, `1`},
+		{`select ExtractValue('<a>a_b</a>' collate utf8mb4_bin, 'contains(/a, "x_")')`, `0`},
+		{`select UpdateXML('<a><b>X</b><b>Y</b></a>' collate utf8mb4_general_ci, '//b[. = "y"]', '<c/>')`, `<a><b>X</b><c/></a>`},
+		{`select UpdateXML('<a><b>X</b><b>Y</b></a>' collate utf8mb4_bin, '//b[. = "y"]', '<c/>')`, `<a><b>X</b><b>Y</b></a>`},
+	}
+	for _, c := range checks {
+		checkValue(t, tk, c.query, c.want)
+	}
+
+	// The collation is aggregated from the arguments like CONCAT() does, so
+	// an explicit collation on the XPath argument wins over the column's.
+	tk.MustExec("create table docs (id int primary key, doc text collate utf8mb4_bin, cdoc text collate utf8mb4_general_ci)")
+	tk.MustExec("insert into docs values (1, '<r><tag>Red</tag></r>', '<r><tag>Red</tag></r>'), (2, '<r><tag>blue</tag></r>', '<r><tag>blue</tag></r>')")
+	tk.MustQuery(`select id, ExtractValue(cdoc, 'contains(/r/tag, "RE")' collate utf8mb4_bin), ExtractValue(cdoc, 'contains(/r/tag, "RE")'), ` +
+		`ExtractValue(doc, 'contains(/r/tag, "RE")'), ExtractValue(doc, 'contains(/r/tag, "RE")' collate utf8mb4_general_ci) from docs order by id`).
+		Check(testkit.Rows("1 0 1 0 1", "2 0 0 0 0"))
+	tk.MustQuery(`select id from docs where ExtractValue(cdoc, '/r/tag = "RED"') = 1 order by id`).Check(testkit.Rows("1"))
+	tk.MustQuery(`select id, ExtractValue(cdoc, '//tag[. = "BLUE"]'), concat('[', ExtractValue(doc, '//tag[. = "BLUE"]'), ']') from docs order by id`).
+		Check(testkit.Rows("1  []", "2 blue []"))
+}
+
+func TestXPathUserVariables(t *testing.T) {
+	tk := newTestKit(t)
+	tk.MustExec("set @i = 2, @s = 'y', @MixedCase = 1")
+	checkValue(t, tk, `select ExtractValue('<a><b>x</b><b>y</b></a>', '/a/b[$@i]')`, `y`)
+	checkValue(t, tk, `select ExtractValue('<a><b>x</b><b>y</b></a>', '/a/b[. = $@s]')`, `y`)
+	checkValue(t, tk, `select ExtractValue('<a><b>x</b><b>y</b></a>', '/a/b[$@mixedcase]')`, `x`)
+	checkValue(t, tk, `select ExtractValue('<a><b>x</b><b>y</b></a>', '/a/b[$@MIXEDCASE + 1]')`, `y`)
+	// An unset variable matches nothing and raises no error.
+	checkValue(t, tk, `select concat('[', ExtractValue('<a><b>x</b><b>y</b></a>', '/a/b[$@nosuch]'), ']')`, `[]`)
+
+	// The variable is read when the statement runs, also for a prepared
+	// statement executed again after the variable changed.
+	tk.MustExec(`prepare ps from 'select ExtractValue(''<a><b>x</b><b>y</b><b>z</b></a>'', ''/a/b[$@i]'')'`)
+	tk.MustQuery("execute ps").Check(testkit.Rows("y"))
+	tk.MustExec("set @i = 3")
+	tk.MustQuery("execute ps").Check(testkit.Rows("z"))
+	tk.MustExec("set @i = 1")
+	tk.MustQuery("execute ps").Check(testkit.Rows("x"))
+	checkValue(t, tk, `select ExtractValue('<a><b>x</b><b>y</b><b>z</b></a>', '/a/b[$@i]')`, `x`)
+	tk.MustExec("set @i = 2")
+	checkValue(t, tk, `select ExtractValue('<a><b>x</b><b>y</b><b>z</b></a>', '/a/b[$@i]')`, `y`)
+
+	tk.MustExec("create table docs (id int primary key, doc text)")
+	tk.MustExec("insert into docs values (1, '<r><n>3</n></r>'), (2, '<r><n>5</n></r>'), (3, '<r/>'), (4, null)")
+	tk.MustQuery(`select id, ExtractValue(doc, '/r/n + $@i') from docs order by id`).
+		Check(testkit.Rows("1 5", "2 7", "3 2", "4 <nil>"))
+	tk.MustExec("set @i = 10")
+	tk.MustQuery(`select id from docs where ExtractValue(doc, '/r/n + $@i') > 14 order by id`).Check(testkit.Rows("2"))
+}
+
+// checkXMLWarning checks that the last statement raised exactly one
+// "Incorrect XML value" warning.
+func checkXMLWarning(t *testing.T, tk *testkit.TestKit) {
+	t.Helper()
+	rows := tk.MustQuery("show warnings").Rows()
+	require.Len(t, rows, 1)
+	require.Equal(t, "Warning", rows[0][0])
+	require.Equal(t, "1525", rows[0][1])
+	require.True(t, strings.HasPrefix(rows[0][2].(string), "Incorrect XML value: "), rows[0][2])
+}
+
+func TestXMLFunctionsNullAndMalformedInput(t *testing.T) {
+	tk := newTestKit(t)
+	tk.MustQuery(`select ExtractValue(null, '/a'), ExtractValue('<a/>', null), UpdateXML(null, '/a', '<b/>'), UpdateXML('<a/>', null, '<b/>'), UpdateXML('<a/>', '/a', null)`).
+		Check(testkit.Rows("<nil> <nil> <nil> <nil> <nil>"))
+
+	for _, xml := range []string{`<a>c</a><b`, `<a>`, `<a b=1/>`, `<a><b>x</b></a`} {
+		tk.MustQuery("select ExtractValue('" + xml + "', '/a')").Check(testkit.Rows("<nil>"))
+		checkXMLWarning(t, tk)
+	}
+	tk.MustQuery("select UpdateXML('<a><b>1</b>', '/a/b', '<c/>')").Check(testkit.Rows("<nil>"))
+	checkXMLWarning(t, tk)
+
+	// Only the row holding the malformed value is NULL.
+	tk.MustExec("create table docs (id int primary key, doc text)")
+	tk.MustExec("insert into docs values (1, '<r><id>A1</id></r>'), (2, '<r><id>B2</id'), (3, '<r><id>C3</id></r>')")
+	tk.MustQuery("select id, ExtractValue(doc, '/r/id'), UpdateXML(doc, '/r/id', '<id/>') from docs order by id").
+		Check(testkit.Rows("1 A1 <r><id/></r>", "2 <nil> <nil>", "3 C3 <r><id/></r>"))
+}
+
+func TestXMLFunctionsRejectInvalidXPath(t *testing.T) {
+	tk := newTestKit(t)
+	tk.MustExec("create table docs (doc text)")
+	tk.MustExec("insert into docs values ('<a>c</a>')")
+	queries := []string{
+		`select ExtractValue('<a>c</a>', '/&a')`,
+		`select ExtractValue('<a>c</a>', '/a[')`,
+		`select ExtractValue('<a>c</a>', 'name(/a)')`,
+		`select ExtractValue('<a>c</a>', 'starts-with(/a, "c")')`,
+		`select ExtractValue(doc, '/a/b[') from docs`,
+		`select UpdateXML('<a><b>1</b></a>', '/a/b[', '<c/>')`,
+		`select UpdateXML(doc, '//', '<c/>') from docs`,
+	}
+	for _, q := range queries {
+		err := tk.ExecToErr(q)
+		require.Error(t, err, q)
+		require.Contains(t, err.Error(), "XPATH syntax error", q)
+		tk.MustGetErrCode(q, errno.ErrUnknown)
+	}
+
+	// A statement with an invalid XPath fails as a whole and changes nothing.
+	tk.MustGetErrCode("update docs set doc = UpdateXML(doc, '/a[', '<b/>')", errno.ErrUnknown)
+	tk.MustQuery("select doc from docs").Check(testkit.Rows("<a>c</a>"))
+}
