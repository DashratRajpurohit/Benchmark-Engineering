+// The expected values below are what MySQL 8.4 returns for the same queries.
+
+func newTestKit(t *testing.T) *testkit.TestKit {
+	store := testkit.CreateMockStore(t)
+	tk := testkit.NewTestKit(t, store)
+	tk.MustExec("use test")
+	return tk
+}
+
+// checkValue runs a single-column query and compares it with want, where
+// NULL is written as <nil>.
+func checkValue(t *testing.T, tk *testkit.TestKit, query, want string) {
+	t.Helper()
+	tk.MustQuery(query).Check(testkit.RowsWithSep("|", want))
+}
+
+func TestExtractValueReturnsTextOfMatchedElements(t *testing.T) {
+	tk := newTestKit(t)
+	cases := []struct{ xml, path, want string }{
+		{`<a>ccc<b>ddd</b></a>`, `/a`, `ccc`},
+		{`<a>ccc<b>ddd</b></a>`, `/a/b`, `ddd`},
+		{`<a>ccc<b>ddd</b></a>`, `//b`, `ddd`},
+		{`<a>ccc<b>ddd</b></a>`, `/a/b/text()`, `ddd`},
+		{`<a><b>ddd</b><b>eee</b></a>`, `//b`, `ddd eee`},
+		{`<a><b><c>1</c></b><c>2</c></a>`, `/a//c`, `1 2`},
+		{`<a><![CDATA[x<y]]></a>`, `/a`, `x<y`},
+		{`<a><b c="q">1</b></a>`, `/a/b/@c`, `q`},
+		{`<a b=''1''>t</a>`, `/a/@b`, `1`},
+		{`<?xml version="1.0"?><a>t</a>`, `/a`, `t`},
+		{`<a><!-- c -->t</a>`, `/a`, `t`},
+		{`<a>1</a><a>2</a>`, `/a`, `1 2`},
+	}
+	for _, c := range cases {
+		checkValue(t, tk, "select ExtractValue('"+c.xml+"', '"+c.path+"')", c.want)
+	}
+
+	// An empty element and a path that matches nothing both give an empty string.
+	checkValue(t, tk, "select concat('[', ExtractValue('<a><b/></a>', '/a/b'), ']')", "[]")
+	checkValue(t, tk, "select concat('[', ExtractValue('<a><c>x</c></a>', '/a/b'), ']')", "[]")
+	checkValue(t, tk, "select concat('[', ExtractValue('<a>ccc<b>ddd</b></a>', '/b'), ']')", "[]")
+	// Text is returned as written, including surrounding white space.
+	checkValue(t, tk, "select concat('[', ExtractValue('<a> x </a>', '/a'), ']')", "[ x ]")
+}
+
+func TestExtractValueLocationPaths(t *testing.T) {
+	tk := newTestKit(t)
+	cases := []struct{ xml, path, want string }{
+		// Relative locators are resolved from the root.
+		{`<a><b>1</b></a>`, `a/b`, `1`},
+		{`<a><b>1</b><c>2</c></a>`, `/a/*`, `1 2`},
+		{`<a><b>1</b><c>2</c></a>`, `/*/c`, `2`},
+		// A union lists its matches in document order.
+		{`<a><c>2</c><b>1</b></a>`, `//b|//c`, `2 1`},
+		{`<a><e:f>1</e:f><b:c>2</b:c></a>`, `//e:f`, `1`},
+		{`<a><e:f>1</e:f><b:c>2</b:c></a>`, `/a/b:c`, `2`},
+		{`<a><b>1</b><b>2</b><b>3</b></a>`, `//b[1]`, `1`},
+		{`<a><b>1</b><b>2</b><b>3</b></a>`, `//b[2]`, `2`},
+		{`<a><b>1</b><b>2</b><b>3</b></a>`, `//b[last()]`, `3`},
+		{`<a><b>1</b><b>2</b><b>3</b></a>`, `//b[position()>1]`, `2 3`},
+		{`<a><b>1</b><b>2</b><b>3</b></a>`, `//b[. > 1]`, `2 3`},
+		{`<a><b id="idA">x</b><b id="idB">y</b></a>`, `//b[@id="idB"]`, `y`},
+		{`<a><b c="x" d="y">1</b><b c="x" d="z">2</b></a>`, `//b[@c="x"][@d="z"]`, `2`},
+		{`<a><b c="23">1</b><b c="17">2</b><b c="5">3</b></a>`, `//b[@c="23" or @c="17"]`, `1 2`},
+		{`<a><b c="23" d="1">1</b><b c="23" d="2">2</b></a>`, `//b[@c="23" and @d=2]`, `2`},
+		{`<a c="1"><d>X</d></a>`, `a/d[../@c="1"]`, `X`},
+		{`<a><b attr="value">1</b><c attr="value">2</c><d attr="no">3</d></a>`, `//*[@attr="value"]`, `1 2`},
+		{`<a><b c="1">x</b><b>z</b></a>`, `//b[not(@c)]`, `z`},
+		{`<a><b c="1">x</b><b c="2">y</b></a>`, `//b[@c>1]`, `y`},
+		{`<a><b><c>1</c></b><d>2</d></a>`, `//*[c]`, ``},
+		{`<a>0<b>9<c>1</c></b></a>`, `//*[c]`, `9`},
+	}
+	for _, c := range cases {
+		checkValue(t, tk, "select ExtractValue('"+c.xml+"', '"+c.path+"')", c.want)
+	}
+}
+
+func TestExtractValueAxes(t *testing.T) {
+	tk := newTestKit(t)
+	cases := []struct{ xml, path, want string }{
+		{`<a><b>1</b><c>2</c></a>`, `child::a/child::b`, `1`},
+		{`<a><b>1</b><c>2</c></a>`, `/a/child::*`, `1 2`},
+		{`<a><b><c>1</c></b><c>2</c></a>`, `/a/descendant::c`, `1 2`},
+		{`<a><b>1</b><c><b>2</b></c></a>`, `/descendant-or-self::b`, `1 2`},
+		{`<a>0<b>9<c>1</c></b></a>`, `//c/parent::*`, `9`},
+		{`<a>0<b>9<c>1</c></b></a>`, `//c/ancestor::*`, `0 9`},
+		{`<a>0<b>9<c>1</c></b></a>`, `//c/ancestor-or-self::*`, `0 9 1`},
+		{`<a>0<b>9<c>1</c></b></a>`, `//c/..`, `9`},
+		{`<a>0<b>9<c>1</c></b></a>`, `//c/../..`, `0`},
+		{`<a><b>1</b></a>`, `/a/b/self::b`, `1`},
+		{`<a><b c="5">1</b></a>`, `/a/b/attribute::c`, `5`},
+	}
+	for _, c := range cases {
+		checkValue(t, tk, "select ExtractValue('"+c.xml+"', '"+c.path+"')", c.want)
+	}
+}
+
+func TestExtractValueScalarExpressions(t *testing.T) {
+	tk := newTestKit(t)
+	cases := []struct{ xml, path, want string }{
+		{`<a><b>1</b><b>2</b></a>`, `count(/a/b)`, `2`},
+		{`<a><b>1</b><b>2</b></a>`, `count(/a/c)`, `0`},
+		{`<a><b>1</b><b>2</b><b>3</b></a>`, `sum(//b)`, `6`},
+		{`<a/>`, `1 + 2 * 3`, `7`},
+		{`<a/>`, `(1 + 2) * 3`, `9`},
+		{`<a/>`, `7 mod 3`, `1`},
+		{`<a/>`, `-3 - -2`, `-1`},
+		{`<a/>`, `6 div 3`, `2`},
+		{`<a/>`, `1.5 + 1`, `2.5`},
+		{`<a><b>3</b></a>`, `/a/b * 2`, `6`},
+		{`<a/>`, `1 = 1`, `1`},
+		{`<a/>`, `1 < 2 and 2 < 1`, `0`},
+		{`<a/>`, `2 >= 2 or 0`, `1`},
+		{`<a/>`, `true()`, `1`},
+		{`<a/>`, `false()`, `0`},
+		{`<a/>`, `not(1)`, `0`},
+		{`<a/>`, `floor(2.7)`, `2`},
+		{`<a/>`, `ceiling(2.1)`, `3`},
+		{`<a/>`, `number("12")`, `12`},
+		{`<a>x</a>`, `boolean(/a)`, `1`},
+		{`<a>hello</a>`, `substring(/a, 2, 3)`, `ell`},
+		{`<a>hello</a>`, `string-length(/a)`, `5`},
+		{`<a>hello</a>`, `concat(/a, "!")`, `hello!`},
+		{`<a>héllo</a>`, `string-length(/a)`, `5`},
+		{`<a>héllo</a>`, `substring(/a, 2, 2)`, `él`},
+		// A node set compares true when any of its nodes does.
+		{`<a>12</a>`, `/a = "12"`, `1`},
+		{`<a><b>1</b><b>2</b></a>`, `/a/b = 2`, `1`},
+		{`<a><b>1</b><b>2</b></a>`, `/a/b != 2`, `1`},
+		{`<a><b>1</b></a>`, `/a/b/c = 1`, `0`},
+		{`<a><b>1</b></a>`, `not(/a/c)`, `1`},
+	}
+	for _, c := range cases {
+		checkValue(t, tk, "select ExtractValue('"+c.xml+"', '"+c.path+"')", c.want)
+	}
+}
