+import (
+	"testing"
+
+	"github.com/pingcap/tidb/pkg/errno"
+	"github.com/pingcap/tidb/pkg/testkit"
+)
+
+func TestUpdateXMLReplacesASingleMatch(t *testing.T) {
+	tk := newTestKit(t)
+	cases := []struct{ xml, path, replacement, want string }{
+		{`<a><b>ccc</b><d></d></a>`, `/a`, `<e>fff</e>`, `<e>fff</e>`},
+		{`<a><b>ccc</b><d></d></a>`, `//b`, `<e>fff</e>`, `<a><e>fff</e><d></d></a>`},
+		{`<a><d><b>ccc</b></d></a>`, `/a/d/b`, `<e>fff</e>`, `<a><d><e>fff</e></d></a>`},
+		// No match, or more than one match, leaves the value unchanged.
+		{`<a><b>ccc</b><d></d></a>`, `/b`, `<e>fff</e>`, `<a><b>ccc</b><d></d></a>`},
+		{`<a><d></d><b>ccc</b><d></d></a>`, `/a/d`, `<e>fff</e>`, `<a><d></d><b>ccc</b><d></d></a>`},
+		// The rest of the value is kept exactly as written.
+		{`<a>  <b x="1">t</b>  </a>`, `/a/b`, `<c/>`, `<a>  <c/>  </a>`},
+		{`<a><b/><c/></a>`, `/a/b`, `<z>9</z>`, `<a><z>9</z><c/></a>`},
+		{`<a><b>1</b><c/></a>`, `/a/b`, ``, `<a><c/></a>`},
+		{`<a><b n="1">x</b><b n="2">y</b></a>`, `/a/b[@n="2"]`, `<b n="2">Y</b>`, `<a><b n="1">x</b><b n="2">Y</b></a>`},
+		// The replacement is not checked for well-formedness.
+		{`<a><b>1</b></a>`, `/a/b`, `<unclosed`, `<a><unclosed</a>`},
+	}
+	for _, c := range cases {
+		checkValue(t, tk, "select UpdateXML('"+c.xml+"', '"+c.path+"', '"+c.replacement+"')", c.want)
+	}
+}
+
+func TestXMLFunctionsOnTableRows(t *testing.T) {
+	tk := newTestKit(t)
+	tk.MustExec("create table docs (id int primary key, doc text)")
+	tk.MustExec(`insert into docs values (1, '<r><id>A1</id><tag>Red</tag><n>3</n></r>'), (2, '<r><id>B2</id><tag>blue</tag><n>5</n></r>'), ` +
+		`(3, '<r><id>C3</id></r>'), (4, null)`)
+	tk.MustQuery("select id, UpdateXML(doc, '/r/tag', '<tag>green</tag>') from docs order by id").Check(testkit.Rows(
+		"1 <r><id>A1</id><tag>green</tag><n>3</n></r>",
+		"2 <r><id>B2</id><tag>green</tag><n>5</n></r>",
+		"3 <r><id>C3</id></r>",
+		"4 <nil>",
+	))
+	tk.MustQuery("select id from docs where ExtractValue(doc, '/r/n') > 4 order by id").Check(testkit.Rows("2"))
+	tk.MustQuery("select id from docs where ExtractValue(doc, 'count(/r/tag)') = 0 order by id").Check(testkit.Rows("3"))
+	tk.MustExec("update docs set doc = UpdateXML(doc, '/r/id', concat('<id>', lower(ExtractValue(doc, '/r/id')), '</id>')) where id <= 3")
+	tk.MustQuery("select id, doc from docs order by id").Check(testkit.Rows(
+		"1 <r><id>a1</id><tag>Red</tag><n>3</n></r>",
+		"2 <r><id>b2</id><tag>blue</tag><n>5</n></r>",
+		"3 <r><id>c3</id></r>",
+		"4 <nil>",
+	))
+}
+
+func TestXMLFunctionsInGeneratedColumns(t *testing.T) {
+	tk := newTestKit(t)
+	tk.MustExec("create table g (doc text, k varchar(20) as (ExtractValue(doc, '/r/k')) stored, v varchar(20) as (ExtractValue(doc, '/r/v')) virtual)")
+	tk.MustExec("insert into g (doc) values ('<r><k>one</k><v>1</v></r>'), ('<r><k>two</k></r>')")
+	tk.MustQuery("select k, v from g order by k").Check(testkit.Rows("one 1", "two "))
+	tk.MustExec("update g set doc = '<r><k>three</k><v>3</v></r>' where k = 'two'")
+	tk.MustQuery("select k, v from g order by k").Check(testkit.Rows("one 1", "three 3"))
+
+	// UpdateXML() is not allowed in a generated column.
+	tk.MustGetErrCode("create table g2 (doc text, u text as (UpdateXML(doc, '/r', '<r/>')))", errno.ErrGeneratedColumnFunctionIsNotAllowed)
+	tk.MustGetErrCode("alter table g add column u text as (UpdateXML(doc, '/r', '<r/>'))", errno.ErrGeneratedColumnFunctionIsNotAllowed)
+}
diff --git a/test.sh b/test.sh
new file mode 100755
index 0000000000..ac19a966d0
--- /dev/null
+++ b/test.sh
@@ -0,0 +1,65 @@
+#!/usr/bin/env bash
+# Usage:
+#   ./test.sh [--output_path <junit.xml>] <base|new>
+#
+# base  runs existing tests of the packages this change builds on: the
+#       collation package, the collation and constant folding tests of
+#       pkg/expression and the generated column function tests of pkg/ddl.
+#       The rest of pkg/expression and pkg/ddl is left out because some of
+#       those tests only pass with failpoints enabled through make.
+# new   runs the SQL level tests in pkg/expression/test/xmlfunctions, which
+#       are compiled only with -tags xmlfuncs.
+set -uo pipefail
+
+ORIG_PWD="$(pwd)"
+
+OUTPUT_PATH=""
+if [ "${1:-}" = "--output_path" ]; then
+  OUTPUT_PATH="$2"
+  shift 2
+  case "$OUTPUT_PATH" in
+    /*) : ;;
+    *) OUTPUT_PATH="$ORIG_PWD/$OUTPUT_PATH" ;;
+  esac
+fi
+
+MODE="${1:-new}"
+
+[ -f go.mod ] || cd "$(dirname "$0")"
+
+TEST_LOG="$(mktemp)"
+STATUS=0
+
+run_tests() {
+  go test -count=1 -v "$@" 2>&1 | tee -a "$TEST_LOG"
+  status=${PIPESTATUS[0]}
+  if [ "$status" -ne 0 ]; then
+    STATUS=$status
+  fi
+}
+
+case "$MODE" in
+  base)
+    run_tests -timeout 1200s -tags intest ./pkg/util/collate
+    run_tests -timeout 1200s -tags intest -run 'Collation|Unfoldable' ./pkg/expression
+    run_tests -timeout 1200s -tags intest -run 'FunctionsInGeneratedColumns' ./pkg/ddl
+    ;;
+  new)
+    run_tests -timeout 1200s -tags intest,xmlfuncs ./pkg/expression/test/xmlfunctions
+    ;;
+  *)
+    echo "unknown mode: $MODE (expected base or new)" >&2
+    exit 2
+    ;;
+esac
+
+if [ -n "$OUTPUT_PATH" ]; then
+  go-junit-report -set-exit-code < "$TEST_LOG" > "$OUTPUT_PATH"
+  junit_status=$?
+  if [ "$junit_status" -ne 0 ] && [ "$STATUS" -eq 0 ]; then
+    echo "go-junit-report failed to convert the test log (exit $junit_status)" >&2
+    STATUS=$junit_status
+  fi
+fi
+
+exit "$STATUS"
