+#!/usr/bin/env bash
+# Test runner for the sift "preview the next index run" (internal/plan) task.
+#
+# Usage:
+#   ./test.sh [--output_path <junit.xml>] <base|new>
+#
+# base  runs every pre-existing package's tests (everything except the new
+#       internal/plan package); they must pass before and after the solution.
+# new   runs the new internal/plan tests; they fail before the solution and
+#       pass after.
+set -uo pipefail
+
+cd /app
+
+OUTPUT_PATH=""
+if [ "${1:-}" = "--output_path" ]; then
+  OUTPUT_PATH="$2"
+  shift 2
+fi
+
+MODE="${1:-new}"
+
+TEST_LOG="$(mktemp)"
+STATUS=0
+
+run_tests() {
+  regex="$1"
+  shift
+  go test -count=1 -v -run "$regex" "$@" 2>&1 | tee -a "$TEST_LOG"
+  status=${PIPESTATUS[0]}
+  if [ "$status" -ne 0 ]; then
+    STATUS=$status
+  fi
+}
+
+case "$MODE" in
+  base)
+    run_tests '.*' $(go list ./... | grep -v '/internal/plan$')
+    ;;
+  new)
+    run_tests '^TestCompute.*_af2d5d$' ./internal/plan/
+    ;;
+  *)
+    echo "unknown mode: $MODE (expected base or new)" >&2
+    exit 2
+    ;;
+esac
+
+if [ -n "$OUTPUT_PATH" ]; then
+  go-junit-report -set-exit-code < "$TEST_LOG" > "$OUTPUT_PATH" || true
+fi
+
+exit "$STATUS"
