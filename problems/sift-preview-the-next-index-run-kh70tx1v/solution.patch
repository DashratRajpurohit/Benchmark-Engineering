+// Plan previews what Index would do to the corpus at root without changing
+// anything on disk.
+func (a App) Plan(root string) ([]plan.Change, error) {
+	cfg, err := a.Config(root)
+	if err != nil {
+		return nil, err
+	}
+	changes, err := plan.Compute(cfg)
+	if err != nil {
+		return nil, fmt.Errorf("app: plan %s: %w", cfg.Root, err)
+	}
+	return changes, nil
+}
