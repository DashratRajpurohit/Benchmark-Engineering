+
+package functions
+
+import (
+	"fmt"
+	"math"
+	"time"
+
+	"github.com/m3db/m3/src/query/block"
+	"github.com/m3db/m3/src/query/executor/transform"
+	"github.com/m3db/m3/src/query/models"
+	"github.com/m3db/m3/src/query/parser"
+	xtime "github.com/m3db/m3/src/x/time"
+)
+
+// AtType evaluates its input at a single time and repeats the result at
+// every step of the query, as the PromQL @ modifier does.
+const AtType = "at"
+
+// AtAnchor is what an AtOp pins its input to.
+type AtAnchor int
+
+const (
+	// AtTime pins to the op's fixed time.
+	AtTime AtAnchor = iota
+	// AtQueryStart pins to the start of the query, as @ start() does.
+	AtQueryStart
+	// AtQueryEnd pins to the end of the query, as @ end() does.
+	AtQueryEnd
+)
+
+// AtOp stores the time its input is evaluated at.
+type AtOp struct {
+	Time   xtime.UnixNano
+	Anchor AtAnchor
+	// Timestamps makes the op return the time of each series' sample at the
+	// pinned time rather than its value, as timestamp() of a pinned selector.
+	Timestamps bool
+	// Offset is the offset of the pinned selector, which has already been
+	// added to the times of its samples.
+	Offset time.Duration
+}
+
+// OpType for the operator.
+func (o AtOp) OpType() string {
+	return AtType
+}
+
+// String representation.
+func (o AtOp) String() string {
+	var at string
+	switch o.Anchor {
+	case AtTime:
+		at = o.Time.String()
+	case AtQueryStart:
+		at = "start()"
+	case AtQueryEnd:
+		at = "end()"
+	}
+
+	return fmt.Sprintf("type: %s, time: %s, timestamps: %v", o.OpType(), at, o.Timestamps)
+}
+
+// at returns the time the input is evaluated at for a query with the given
+// time spec.
+func (o AtOp) at(timeSpec transform.TimeSpec) xtime.UnixNano {
+	switch o.Anchor {
+	case AtQueryStart:
+		return timeSpec.QueryStart
+	case AtQueryEnd:
+		return timeSpec.QueryEnd
+	default:
+		return o.Time
+	}
+}
+
+// InputTimeSpec returns the time spec of an instant query at the op's time,
+// keeping the lookback and range room of the outer query.
+func (o AtOp) InputTimeSpec(timeSpec transform.TimeSpec) transform.TimeSpec {
+	at := o.at(timeSpec)
+	room := timeSpec.QueryStart.Sub(timeSpec.Start)
+	return transform.TimeSpec{
+		Start:      at.Add(-room),
+		End:        at.Add(timeSpec.Step),
+		Now:        timeSpec.Now,
+		Step:       timeSpec.Step,
+		QueryStart: at,
+		QueryEnd:   at,
+		Lookback:   timeSpec.Lookback,
+	}
+}
+
+// Node creates an execution node.
+func (o AtOp) Node(
+	controller *transform.Controller,
+	opts transform.Options,
+) transform.OpNode {
+	return &atNode{
+		op:         o,
+		controller: controller,
+		at:         o.at(opts.TimeSpec()),
+		lookback:   opts.TimeSpec().Lookback,
+		bounds:     opts.TimeSpec().Bounds(),
+	}
+}
+
+type atNode struct {
+	op         AtOp
+	controller *transform.Controller
+	at         xtime.UnixNano
+	lookback   time.Duration
+	bounds     models.Bounds
+}
+
+func (n *atNode) Params() parser.Params {
+	return n.op
+}
+
+// Process the block.
+func (n *atNode) Process(
+	queryCtx *models.QueryContext,
+	ID parser.NodeID,
+	b block.Block,
+) error {
+	return transform.ProcessSimpleBlock(n, n.controller, queryCtx, ID, b)
+}
+
+func (n *atNode) ProcessBlock(
+	queryCtx *models.QueryContext,
+	ID parser.NodeID,
+	b block.Block,
+) (block.Block, error) {
+	valuesAt := n.valuesAt
+	if n.op.Timestamps {
+		valuesAt = n.sampleTimesAt
+	}
+
+	seriesMetas, values, err := valuesAt(b)
+	if err != nil {
+		return nil, err
+	}
+
+	// NB: a series with no value at the pinned time is not in the result, the
+	// same as a series with no sample there.
+	keptMetas := make([]block.SeriesMeta, 0, len(seriesMetas))
+	keptValues := make([]float64, 0, len(values))
+	for i, v := range values {
+		if !math.IsNaN(v) {
+			keptMetas = append(keptMetas, seriesMetas[i])
+			keptValues = append(keptValues, v)
+		}
+	}
+
+	meta := b.Meta()
+	meta.Bounds = n.bounds
+	builder, err := n.controller.BlockBuilder(queryCtx, meta, keptMetas)
+	if err != nil {
+		return nil, err
+	}
+
+	steps := n.bounds.Steps()
+	if err := builder.AddCols(steps); err != nil {
+		return nil, err
+	}
+
+	for i := range steps {
+		if err := builder.AppendValues(i, keptValues); err != nil {
+			return nil, err
+		}
+	}
+
+	return builder.Build(), nil
+}
+
+// valuesAt returns the value of every series of the block at the pinned time.
+func (n *atNode) valuesAt(b block.Block) ([]block.SeriesMeta, []float64, error) {
+	stepIter, err := b.StepIter()
+	if err != nil {
+		return nil, nil, err
+	}
+
+	seriesMetas := stepIter.SeriesMeta()
+	values := make([]float64, len(seriesMetas))
+	for i := range values {
+		values[i] = math.NaN()
+	}
+
+	// NB: find the step by index, since some step iterators report the end
+	// of the step as its time.
+	bounds := b.Meta().Bounds
+	atIndex := -1
+	if !n.at.Before(bounds.Start) {
+		atIndex = int(n.at.Sub(bounds.Start) / bounds.StepSize)
+	}
+
+	for i := 0; stepIter.Next(); i++ {
+		if i == atIndex {
+			copy(values, stepIter.Current().Values())
+		}
+	}
+
+	return seriesMetas, values, stepIter.Err()
+}
+
+// sampleTimesAt returns, in seconds, the time of the sample every series of
+// the block has at the pinned time: its last sample at or before that time
+// and within the lookback. The time is the one the sample was stored with,
+// before the selector's offset.
+func (n *atNode) sampleTimesAt(b block.Block) ([]block.SeriesMeta, []float64, error) {
+	iter, err := b.SeriesIter()
+	if err != nil {
+		return nil, nil, err
+	}
+
+	seriesMetas := iter.SeriesMeta()
+	times := make([]float64, len(seriesMetas))
+	from := n.at.Add(-n.lookback)
+	for i := 0; iter.Next(); i++ {
+		times[i] = math.NaN()
+		for _, dp := range iter.Current().Datapoints() {
+			if dp.Timestamp.After(n.at) {
+				break
+			}
+
+			if !dp.Timestamp.Before(from) && !math.IsNaN(dp.Value) {
+				times[i] = float64(dp.Timestamp.Add(-n.op.Offset)) / float64(time.Second)
+			}
+		}
+	}
+
+	return seriesMetas, times, iter.Err()
+}
