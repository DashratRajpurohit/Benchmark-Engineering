@@ -0,0 +1,288 @@
+//go:build atmodifier
+
+package atmodifier55b6f8
+
+import (
+	"fmt"
+	"testing"
+	"time"
+)
+
+// Range queries below run from 1801s to 1846s in 15s steps, so the steps are
+// at 1801s, 1816s, 1831s and 1846s; none of them is a sample time.
+const (
+	start = 1801
+	end   = 1846
+	step  = 15 * time.Second
+)
+
+func TestPinnedSelectors(t *testing.T) {
+	s := newQueryServer(t)
+
+	t.Run("selector pinned to a time", func(t *testing.T) {
+		s.queryRange(t, "http_requests @ "+s.at(507), start, end, step, map[string][]point{
+			"a": constant(503, start, end, step),
+			"b": constant(1006, start, end, step),
+		})
+	})
+
+	t.Run("range function pinned to a time", func(t *testing.T) {
+		s.queryRange(t, "sum_over_time(http_requests[1m] @ "+s.at(507)+")", start, end, step, map[string][]point{
+			"a": constant(sumBetween(447, 507), start, end, step),
+			"b": constant(2*sumBetween(447, 507), start, end, step),
+		})
+	})
+
+	t.Run("pinned time is a sample time", func(t *testing.T) {
+		s.queryRange(t, "http_requests @ "+s.at(503), start, end, step, map[string][]point{
+			"a": constant(503, start, end, step),
+			"b": constant(1006, start, end, step),
+		})
+		s.queryRange(t, "count_over_time(http_requests[55s] @ "+s.at(503)+")", start, end, step, map[string][]point{
+			"a": constant(6, start, end, step),
+			"b": constant(6, start, end, step),
+		})
+	})
+
+	t.Run("offset counts back from the pinned time", func(t *testing.T) {
+		s.queryRange(t, "http_requests @ "+s.at(507)+" offset 2m", start, end, step, map[string][]point{
+			"a": constant(383, start, end, step),
+			"b": constant(766, start, end, step),
+		})
+		s.queryRange(t, "http_requests @ "+s.at(507)+" offset 17s", start, end, step, map[string][]point{
+			"a": constant(483, start, end, step),
+			"b": constant(966, start, end, step),
+		})
+	})
+
+	t.Run("range function pinned with an offset", func(t *testing.T) {
+		s.queryRange(t, "sum_over_time(http_requests[1m] @ "+s.at(507)+" offset 17s)", start, end, step, map[string][]point{
+			"a": constant(sumBetween(430, 490), start, end, step),
+			"b": constant(2*sumBetween(430, 490), start, end, step),
+		})
+	})
+
+	t.Run("two selectors pinned to different times", func(t *testing.T) {
+		q := fmt.Sprintf("http_requests @ %s - http_requests @ %s", s.at(507), s.at(307))
+		s.queryRange(t, q, start, end, step, map[string][]point{
+			"a": constant(503-303, start, end, step),
+			"b": constant(2*(503-303), start, end, step),
+		})
+	})
+
+	t.Run("pinned time outside the range", func(t *testing.T) {
+		s.queryRange(t, "http_requests @ "+s.at(3007), start, end, step, map[string][]point{
+			"a": constant(3003, start, end, step),
+			"b": constant(6006, start, end, step),
+		})
+		s.queryRange(t, "http_requests @ "+s.at(307), 6001, 6046, step, map[string][]point{
+			"a": constant(303, 6001, 6046, step),
+			"b": constant(606, 6001, 6046, step),
+		})
+	})
+
+	t.Run("last sample within the lookback of the pinned time", func(t *testing.T) {
+		// The last samples are at 7193s, 90s before the pinned time, and the
+		// range selector only covers 30s.
+		q := "http_requests @ " + s.at(7283) + " + count_over_time(http_requests[30s])"
+		s.queryRange(t, q, start, end, step, map[string][]point{
+			"a": constant(7193+3, start, end, step),
+			"b": constant(14386+3, start, end, step),
+		})
+	})
+
+	t.Run("pinned and unpinned selectors together", func(t *testing.T) {
+		s.queryRange(t, "http_requests - http_requests @ "+s.at(507), start, end, step, map[string][]point{
+			"a": {{1801, 1793 - 503}, {1816, 1813 - 503}, {1831, 1823 - 503}, {1846, 1843 - 503}},
+			"b": {{1801, 2 * (1793 - 503)}, {1816, 2 * (1813 - 503)}, {1831, 2 * (1823 - 503)}, {1846, 2 * (1843 - 503)}},
+		})
+	})
+
+	t.Run("pinned selector in arithmetic", func(t *testing.T) {
+		s.queryRange(t, "http_requests @ "+s.at(507)+" * 2", start, end, step, map[string][]point{
+			"a": constant(2*503, start, end, step),
+			"b": constant(2*1006, start, end, step),
+		})
+	})
+
+	t.Run("aggregation of a pinned selector", func(t *testing.T) {
+		s.queryRange(t, "sum(http_requests @ "+s.at(507)+")", start, end, step, map[string][]point{
+			"": constant(503+1006, start, end, step),
+		})
+	})
+}
+
+func TestStartAndEnd(t *testing.T) {
+	s := newQueryServer(t)
+
+	t.Run("start of a range query", func(t *testing.T) {
+		s.queryRange(t, "http_requests @ start()", start, end, step, map[string][]point{
+			"a": constant(1793, start, end, step),
+			"b": constant(3586, start, end, step),
+		})
+		s.queryRange(t, "sum_over_time(http_requests[1m] @ start())", start, end, step, map[string][]point{
+			"a": constant(sumBetween(1741, 1801), start, end, step),
+			"b": constant(2*sumBetween(1741, 1801), start, end, step),
+		})
+	})
+
+	t.Run("end of a range query", func(t *testing.T) {
+		s.queryRange(t, "http_requests @ end()", start, end, step, map[string][]point{
+			"a": constant(1843, start, end, step),
+			"b": constant(3686, start, end, step),
+		})
+		s.queryRange(t, "sum_over_time(http_requests[1m] @ end())", start, end, step, map[string][]point{
+			"a": constant(sumBetween(1786, 1846), start, end, step),
+			"b": constant(2*sumBetween(1786, 1846), start, end, step),
+		})
+	})
+
+	t.Run("offset from the start", func(t *testing.T) {
+		s.queryRange(t, "http_requests @ start() offset 1m", start, end, step, map[string][]point{
+			"a": constant(1733, start, end, step),
+			"b": constant(3466, start, end, step),
+		})
+	})
+
+	t.Run("instant query", func(t *testing.T) {
+		for _, q := range []string{
+			"http_requests @ start() - http_requests @ " + s.at(507),
+			"http_requests @ end() - http_requests @ " + s.at(507),
+		} {
+			s.queryInstant(t, q, end, map[string]float64{
+				"a": 1843 - 503,
+				"b": 2 * (1843 - 503),
+			})
+		}
+	})
+}
+
+func TestNegativeOffset(t *testing.T) {
+	s := newQueryServer(t)
+
+	t.Run("instant selector", func(t *testing.T) {
+		s.queryRange(t, "http_requests offset -1m", start, end, step, map[string][]point{
+			"a": {{1801, 1853}, {1816, 1873}, {1831, 1883}, {1846, 1903}},
+			"b": {{1801, 3706}, {1816, 3746}, {1831, 3766}, {1846, 3806}},
+		})
+	})
+
+	t.Run("range selector in a function", func(t *testing.T) {
+		var a, b []point
+		for sec := start; sec <= end; sec += 15 {
+			sum := sumBetween(sec, sec+60)
+			a = append(a, point{sec, sum})
+			b = append(b, point{sec, 2 * sum})
+		}
+
+		s.queryRange(t, "sum_over_time(http_requests[1m] offset -1m)", start, end, step, map[string][]point{
+			"a": a,
+			"b": b,
+		})
+	})
+
+	t.Run("pinned selector", func(t *testing.T) {
+		s.queryRange(t, "http_requests @ "+s.at(507)+" offset -1m", start, end, step, map[string][]point{
+			"a": constant(563, start, end, step),
+			"b": constant(1126, start, end, step),
+		})
+	})
+}
+
+func TestSampleAtTheEvaluatedTime(t *testing.T) {
+	s := newQueryServer(t)
+
+	t.Run("instant query", func(t *testing.T) {
+		s.queryInstant(t, "http_requests", 1803, map[string]float64{"a": 1803, "b": 3606})
+	})
+
+	t.Run("last step of a range query", func(t *testing.T) {
+		s.queryRange(t, "http_requests", 1803, 1863, 30*time.Second, map[string][]point{
+			"a": {{1803, 1803}, {1833, 1833}, {1863, 1863}},
+			"b": {{1803, 3606}, {1833, 3666}, {1863, 3726}},
+		})
+	})
+
+	t.Run("end of a range selector", func(t *testing.T) {
+		s.queryInstant(t, "count_over_time(http_requests[55s])", 1803, map[string]float64{"a": 6, "b": 6})
+	})
+}
+
+func TestOffsetThatIsNotWholeSteps(t *testing.T) {
+	s := newQueryServer(t)
+
+	t.Run("instant selector", func(t *testing.T) {
+		s.queryRange(t, "http_requests offset 17s", start, end, step, map[string][]point{
+			"a": {{1801, 1783}, {1816, 1793}, {1831, 1813}, {1846, 1823}},
+			"b": {{1801, 3566}, {1816, 3586}, {1831, 3626}, {1846, 3646}},
+		})
+		s.queryRange(t, "http_requests offset 22s", start, end, step, map[string][]point{
+			"a": {{1801, 1773}, {1816, 1793}, {1831, 1803}, {1846, 1823}},
+			"b": {{1801, 3546}, {1816, 3586}, {1831, 3606}, {1846, 3646}},
+		})
+	})
+
+	t.Run("range selector in a function", func(t *testing.T) {
+		var a, b []point
+		for sec := start; sec <= end; sec += 15 {
+			sum := sumBetween(sec-77, sec-17)
+			a = append(a, point{sec, sum})
+			b = append(b, point{sec, 2 * sum})
+		}
+
+		s.queryRange(t, "sum_over_time(http_requests[1m] offset 17s)", start, end, step, map[string][]point{
+			"a": a,
+			"b": b,
+		})
+
+		a, b = nil, nil
+		for sec := start; sec <= end; sec += 15 {
+			sum := sumBetween(sec-82, sec-22)
+			a = append(a, point{sec, sum})
+			b = append(b, point{sec, 2 * sum})
+		}
+
+		s.queryRange(t, "sum_over_time(http_requests[1m] offset 22s)", start, end, step, map[string][]point{
+			"a": a,
+			"b": b,
+		})
+	})
+}
+
+func TestTimestampOfPinnedSelector(t *testing.T) {
+	s := newQueryServer(t)
+
+	t.Run("pinned to a sample time", func(t *testing.T) {
+		at := float64(s.unix(1203))
+		s.queryRange(t, "timestamp(http_requests @ "+s.at(1203)+")", start, end, step, map[string][]point{
+			"a": constant(at, start, end, step),
+			"b": constant(at, start, end, step),
+			"c": constant(at, start, end, step),
+		})
+	})
+
+	t.Run("pinned between samples", func(t *testing.T) {
+		at := float64(s.unix(1203))
+		s.queryRange(t, "timestamp(http_requests @ "+s.at(1207)+")", start, end, step, map[string][]point{
+			"a": constant(at, start, end, step),
+			"b": constant(at, start, end, step),
+			"c": constant(at, start, end, step),
+		})
+	})
+
+	t.Run("pinned to the end of a range query", func(t *testing.T) {
+		at := float64(s.unix(1843))
+		s.queryRange(t, "timestamp(http_requests @ end())", start, end, step, map[string][]point{
+			"a": constant(at, start, end, step),
+			"b": constant(at, start, end, step),
+		})
+	})
+
+	t.Run("pinned with an offset", func(t *testing.T) {
+		at := float64(s.unix(483))
+		s.queryRange(t, "timestamp(http_requests @ "+s.at(507)+" offset 17s)", start, end, step, map[string][]point{
+			"a": constant(at, start, end, step),
+			"b": constant(at, start, end, step),
+		})
+	})
+}
