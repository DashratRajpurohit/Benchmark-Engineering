+// renameDBFiles moves a SQLite database file, and any associated WAL and SHM
+// files, from srcPath to dstPath. If a WAL or SHM file does not exist at
+// srcPath, it is simply not moved.
+func renameDBFiles(srcPath, dstPath string) error {
+	if err := os.Rename(srcPath, dstPath); err != nil {
+		return err
+	}
+	if fsutil.FileExists(srcPath + "-wal") {
+		if err := os.Rename(srcPath+"-wal", dstPath+"-wal"); err != nil {
+			return err
+		}
+	}
+	if fsutil.FileExists(srcPath + "-shm") {
+		if err := os.Rename(srcPath+"-shm", dstPath+"-shm"); err != nil {
+			return err
+		}
+	}
+	return nil
+}
