+#!/usr/bin/env bash
+# Test runner for the SwappableDB.Swap failed-open recovery task.
+#
+# Usage:
+#   ./test.sh [--output_path <junit.xml>] <base|new>
+#
+#   base  runs the repository's existing test suite as a regression check.
+#         Must pass both before and after the solution is applied. Run
+#         without the swaprestore build tag, so the new tests below are not
+#         even compiled into this run.
+#   new   runs only the new regression tests added for this task, in
+#         db/swap_restore_b7e2c1_test.go. These tests exercise Swap's
+#         existing, exported behavior (no new API is introduced), so they
+#         compile and run both before and after solution.patch is applied -
+#         before the fix they fail with assertion errors describing the bug,
+#         and after the fix they pass. The swaprestore build tag gates the
+#         test file so it's excluded from ordinary `base` runs.
+set -uo pipefail
+
+cd /app
+
+OUTPUT_PATH=""
+if [ "${1:-}" = "--output_path" ]; then
+  OUTPUT_PATH="$2"
+  shift 2
+fi
+
+MODE="${1:-new}"
+
+TEST_LOG="$(mktemp)"
+STATUS=0
+
+run_tests() {
+  go test -count=1 -v "$@" 2>&1 | tee -a "$TEST_LOG"
+  status=${PIPESTATUS[0]}
+  if [ "$status" -ne 0 ]; then
+    STATUS=$status
+  fi
+}
+
+case "$MODE" in
+  base)
+    mapfile -t PKGS < <(go list ./...)
+    # Test_Geopoly is skipped: it fails identically on an unmodified checkout
+    # of this commit in this container (a floating-point formatting mismatch
+    # from the SQLite geopoly extension, unrelated to this task's change).
+    run_tests -skip 'Test_Geopoly' "${PKGS[@]}"
+    ;;
+  new)
+    run_tests -tags swaprestore ./db/... -run 'Test_Swap_FailedOpen_RestoresOriginal|Test_Swap_FailedOpen_PreservesWALAndFKSettings'
+    ;;
+  *)
+    echo "unknown mode: $MODE (expected base or new)" >&2
+    exit 2
+    ;;
+esac
+
+if [ -n "$OUTPUT_PATH" ]; then
+  go-junit-report -set-exit-code < "$TEST_LOG" > "$OUTPUT_PATH" || true
+fi
+
+exit "$STATUS"
