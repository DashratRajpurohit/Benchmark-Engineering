+++ b/db/swap_restore_b7e2c1_test.go
@@ -0,0 +1,167 @@
+//go:build swaprestore
+
+package db
+
+import (
+	"os"
+	"testing"
+
+	command "github.com/rqlite/rqlite/v10/command/proto"
+	"github.com/rqlite/rqlite/v10/internal/fsutil"
+)
+
+// mustExecuteSwappable runs a single write statement against a SwappableDB
+// using only its public API.
+func mustExecuteSwappable(t *testing.T, s *SwappableDB, stmt string) {
+	t.Helper()
+	req := &command.Request{
+		Statements: []*command.Statement{{Sql: stmt}},
+	}
+	if _, err := s.Execute(req, false); err != nil {
+		t.Fatalf("failed to execute %q: %s", stmt, err)
+	}
+}
+
+// corruptSQLiteFile writes a file at path whose header passes
+// IsValidSQLiteFile (which only inspects the 16-byte magic string) but whose
+// body is garbage, so opening it as a real SQLite database fails.
+func corruptSQLiteFile(t *testing.T, path string) {
+	t.Helper()
+	data := make([]byte, 4096)
+	copy(data, []byte("SQLite format 3\x00"))
+	for i := 16; i < len(data); i++ {
+		data[i] = 0xFF
+	}
+	if err := os.WriteFile(path, data, 0644); err != nil {
+		t.Fatalf("failed to write corrupt SQLite file: %s", err)
+	}
+	if !IsValidSQLiteFile(path) {
+		t.Fatalf("test setup invalid: corrupt file does not pass IsValidSQLiteFile")
+	}
+}
+
+// Test_Swap_FailedOpen_RestoresOriginal confirms that when the replacement
+// database at the swap path fails to open, the SwappableDB recovers its
+// original database and remains fully usable with the data it had before
+// the failed swap was attempted.
+func Test_Swap_FailedOpen_RestoresOriginal(t *testing.T) {
+	swappablePath := mustTempPath()
+	defer os.Remove(swappablePath)
+	swappableDB, err := OpenSwappable(swappablePath, nil, false, false, 0)
+	if err != nil {
+		t.Fatalf("failed to open swappable database: %s", err)
+	}
+	defer swappableDB.Close()
+
+	mustExecuteSwappable(t, swappableDB, "CREATE TABLE foo (id INTEGER NOT NULL PRIMARY KEY, name TEXT)")
+	mustExecuteSwappable(t, swappableDB, `INSERT INTO foo(name) VALUES("original")`)
+
+	badPath := mustTempPath()
+	defer os.Remove(badPath)
+	corruptSQLiteFile(t, badPath)
+
+	if err := swappableDB.Swap(badPath, false, false); err == nil {
+		t.Fatalf("expected Swap to fail against a corrupt replacement database")
+	}
+
+	// The SwappableDB must still be usable, and must still contain the
+	// original data, not be left pointing at a closed or missing database.
+	rows, err := swappableDB.QueryStringStmt("SELECT * FROM foo")
+	if err != nil {
+		t.Fatalf("swappable database is unusable after failed swap: %s", err)
+	}
+	if exp, got := `[{"columns":["id","name"],"types":["integer","text"],"values":[[1,"original"]]}]`, asJSON(rows); exp != got {
+		t.Fatalf("unexpected results after failed swap, expected %s, got %s", exp, got)
+	}
+
+	// A subsequent write must also work, proving the recovered connection is
+	// not just readable but fully functional.
+	mustExecuteSwappable(t, swappableDB, `INSERT INTO foo(name) VALUES("after-recovery")`)
+
+	// No stray backup files should be left behind after the caller retries
+	// with a valid file and the swap succeeds.
+	goodPath := mustTempPath()
+	defer os.Remove(goodPath)
+	goodSrc, err := Open(goodPath, false, false)
+	if err != nil {
+		t.Fatalf("failed to create replacement database: %s", err)
+	}
+	mustExecute(goodSrc, "CREATE TABLE bar (id INTEGER NOT NULL PRIMARY KEY)")
+	if err := goodSrc.Close(); err != nil {
+		t.Fatalf("failed to close replacement database: %s", err)
+	}
+	if err := swappableDB.Swap(goodPath, false, false); err != nil {
+		t.Fatalf("expected swap with valid replacement to succeed after prior failed swap: %s", err)
+	}
+	if _, err := os.Stat(swappablePath + ".bak"); !os.IsNotExist(err) {
+		t.Fatalf("expected backup file to be removed after successful swap, stat err: %v", err)
+	}
+}
+
+// Test_Swap_FailedOpen_PreservesWALAndFKSettings confirms that a failed swap
+// recovers a WAL-mode, foreign-key-enabled original database with its WAL
+// and SHM files intact, and reopens it with its original settings rather
+// than the settings that were passed for the failed replacement.
+func Test_Swap_FailedOpen_PreservesWALAndFKSettings(t *testing.T) {
+	swappablePath := mustTempPath()
+	defer os.Remove(swappablePath)
+	swappableDB, err := OpenSwappable(swappablePath, nil, true, true, 0)
+	if err != nil {
+		t.Fatalf("failed to open swappable database: %s", err)
+	}
+	defer swappableDB.Close()
+
+	if !swappableDB.FKEnabled() || !swappableDB.WALEnabled() {
+		t.Fatalf("expected original database to have FK and WAL enabled")
+	}
+
+	mustExecuteSwappable(t, swappableDB, "CREATE TABLE parent (id INTEGER NOT NULL PRIMARY KEY)")
+	mustExecuteSwappable(t, swappableDB, "CREATE TABLE child (id INTEGER NOT NULL PRIMARY KEY, parent_id INTEGER REFERENCES parent(id))")
+	mustExecuteSwappable(t, swappableDB, "INSERT INTO parent(id) VALUES(1)")
+	mustExecuteSwappable(t, swappableDB, "INSERT INTO child(id, parent_id) VALUES(1, 1)")
+
+	if !fsutil.FileExists(swappablePath + "-wal") {
+		t.Fatalf("expected WAL file to exist before swap attempt")
+	}
+
+	badPath := mustTempPath()
+	defer os.Remove(badPath)
+	corruptSQLiteFile(t, badPath)
+
+	// Attempt the swap with different (disabled) FK/WAL settings; since the
+	// replacement fails to open, the original database's own settings must
+	// be what gets restored, not these.
+	if err := swappableDB.Swap(badPath, false, false); err == nil {
+		t.Fatalf("expected Swap to fail against a corrupt replacement database")
+	}
+
+	if !swappableDB.FKEnabled() || !swappableDB.WALEnabled() {
+		t.Fatalf("expected recovered database to preserve its original FK/WAL settings, got FKEnabled=%v WALEnabled=%v",
+			swappableDB.FKEnabled(), swappableDB.WALEnabled())
+	}
+	if !fsutil.FileExists(swappablePath + "-wal") {
+		t.Fatalf("expected WAL file to still exist after recovery")
+	}
+
+	// The foreign key constraint must still be enforced, proving the
+	// recovered connection was reopened with FK support, not just that the
+	// flag reads true.
+	req := &command.Request{
+		Statements: []*command.Statement{{Sql: "INSERT INTO child(id, parent_id) VALUES(2, 999)"}},
+	}
+	results, err := swappableDB.Execute(req, false)
+	if err != nil {
+		t.Fatalf("unexpected error executing statement: %s", err)
+	}
+	if len(results) != 1 || results[0].GetError() == "" {
+		t.Fatalf("expected foreign key violation to be rejected after recovery, got %v", results)
+	}
+
+	rows, err := swappableDB.QueryStringStmt("SELECT * FROM child ORDER BY id")
+	if err != nil {
+		t.Fatalf("swappable database is unusable after failed swap: %s", err)
+	}
+	if exp, got := `[{"columns":["id","parent_id"],"types":["integer","integer"],"values":[[1,1]]}]`, asJSON(rows); exp != got {
+		t.Fatalf("unexpected results after failed swap, expected %s, got %s", exp, got)
+	}
+}
