+//go:build maxcostlimits || maxcostlimits_base
+
+package ristretto
+
+import (
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/require"
+)
+
+// limRecorder collects the callbacks of a cache under test.
+type limRecorder struct {
+	sync.Mutex
+	evicted map[uint64][]Item[int]
+	exited  map[int]int
+	// When set, the first eviction reported blocks until gate is closed, after
+	// signalling on entered.
+	gate    chan struct{}
+	entered chan struct{}
+	once    sync.Once
+}
+
+func newLimRecorder() *limRecorder {
+	return &limRecorder{evicted: map[uint64][]Item[int]{}, exited: map[int]int{}}
+}
+
+func (r *limRecorder) onEvict(i *Item[int]) {
+	if r.gate != nil {
+		r.once.Do(func() {
+			close(r.entered)
+			<-r.gate
+		})
+	}
+	r.Lock()
+	defer r.Unlock()
+	r.evicted[i.Key] = append(r.evicted[i.Key], Item[int]{Key: i.Key, Value: i.Value, Cost: i.Cost, Expiration: i.Expiration})
+}
+
+func (r *limRecorder) onExit(v int) {
+	r.Lock()
+	defer r.Unlock()
+	r.exited[v]++
+}
+
+func (r *limRecorder) evictedKeys() map[uint64]int {
+	r.Lock()
+	defer r.Unlock()
+	out := map[uint64]int{}
+	for k, v := range r.evicted {
+		out[k] = len(v)
+	}
+	return out
+}
+
+func newLimCache(t *testing.T, maxCost int64, rec *limRecorder) *Cache[uint64, int] {
+	t.Helper()
+	return newLimCacheFrom(t, limConfig(maxCost, rec))
+}
+
+// newLimCountingCache is newLimCache with every Get handed to the admission
+// policy right away, so a test can make some keys more popular than others.
+func newLimCountingCache(t *testing.T, maxCost int64, rec *limRecorder) *Cache[uint64, int] {
+	t.Helper()
+	cfg := limConfig(maxCost, rec)
+	cfg.BufferItems = 1
+	return newLimCacheFrom(t, cfg)
+}
+
+func limConfig(maxCost int64, rec *limRecorder) *Config[uint64, int] {
+	cfg := &Config[uint64, int]{
+		NumCounters:            1000,
+		MaxCost:                maxCost,
+		BufferItems:            64,
+		IgnoreInternalCost:     true,
+		Metrics:                true,
+		TtlTickerDurationInSec: 3600,
+	}
+	if rec != nil {
+		cfg.OnEvict = rec.onEvict
+		cfg.OnExit = rec.onExit
+	}
+	return cfg
+}
+
+func newLimCacheFrom(t *testing.T, cfg *Config[uint64, int]) *Cache[uint64, int] {
+	t.Helper()
+	c, err := NewCache(cfg)
+	require.NoError(t, err)
+	t.Cleanup(c.Close)
+	return c
+}
+
+// limStored returns the keys in [1, n] that can be read back.
+func limStored(c *Cache[uint64, int], n uint64) []uint64 {
+	var out []uint64
+	for k := uint64(1); k <= n; k++ {
+		if _, ok := c.Get(k); ok {
+			out = append(out, k)
+		}
+	}
+	return out
+}
+
+// limFill stores keys 1..n with the given cost, each holding its own key as value.
+func limFill(t *testing.T, c *Cache[uint64, int], n uint64, cost int64) {
+	t.Helper()
+	for k := uint64(1); k <= n; k++ {
+		require.True(t, c.Set(k, int(k), cost))
+	}
+	c.Wait()
+	require.Len(t, limStored(c, n), int(n))
+}
+
+// limFillWithExpired stores keys 1..n, where the keys in expired carry a short
+// TTL, and returns once those entries read as expired.
+func limFillWithExpired(t *testing.T, c *Cache[uint64, int], n uint64, cost int64, expired ...uint64) {
+	t.Helper()
+	isExpired := map[uint64]bool{}
+	for _, k := range expired {
+		isExpired[k] = true
+	}
+	for k := uint64(1); k <= n; k++ {
+		if isExpired[k] {
+			require.True(t, c.SetWithTTL(k, int(k), cost, 40*time.Millisecond))
+		} else {
+			require.True(t, c.Set(k, int(k), cost))
+		}
+	}
+	c.Wait()
+	deadline := time.Now().Add(5 * time.Second)
+	for _, k := range expired {
+		for {
+			if _, ok := c.Get(k); !ok {
+				break
+			}
+			require.True(t, time.Now().Before(deadline), "key %d never expired", k)
+			time.Sleep(5 * time.Millisecond)
+		}
+	}
+}
+
+// limHeat reads every key a few times, so that a cache from
+// newLimCountingCache treats them as popular. Missing keys count too.
+func limHeat(c *Cache[uint64, int], keys ...uint64) {
+	for round := 0; round < 6; round++ {
+		for _, k := range keys {
+			c.Get(k)
+			time.Sleep(time.Millisecond)
+		}
+	}
+	// The policy counts the reads on its own goroutine.
+	time.Sleep(100 * time.Millisecond)
+}
