+//go:build maxcostlimits
+
+package ristretto
+
+import (
+	"runtime"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/require"
+)
+
+func TestLimitsLoweringMaxCostEvictsOnlyWhatIsNeeded(t *testing.T) {
+	c := newLimCache(t, 100, nil)
+	limFill(t, c, 10, 10)
+
+	c.UpdateMaxCost(40)
+	c.Wait()
+
+	require.Equal(t, int64(40), c.MaxCost())
+	require.Equal(t, int64(0), c.RemainingCost())
+	require.Len(t, limStored(c, 10), 4)
+}
+
+func TestLimitsEvictedEntriesAreReportedOnce(t *testing.T) {
+	for round := 0; round < 25; round++ {
+		rec := newLimRecorder()
+		c := newLimCache(t, 100, rec)
+		limFill(t, c, 20, 5)
+
+		c.UpdateMaxCost(30)
+		c.Wait()
+
+		require.GreaterOrEqual(t, c.RemainingCost(), int64(0), "round %d", round)
+		evicted := rec.evictedKeys()
+		require.Len(t, evicted, 14, "round %d", round)
+		for key, n := range evicted {
+			require.Equal(t, 1, n, "round %d: key %d reported %d times", round, key, n)
+			item := rec.evicted[key][0]
+			require.Equal(t, int(key), item.Value, "round %d", round)
+			require.Equal(t, int64(5), item.Cost, "round %d", round)
+			require.Equal(t, 1, rec.exited[int(key)], "round %d: value of key %d", round, key)
+			_, ok := c.Get(key)
+			require.False(t, ok, "round %d: key %d still readable", round, key)
+		}
+		c.Close()
+	}
+}
+
+func TestLimitsEvictedEntriesCarryTheirExpiration(t *testing.T) {
+	rec := newLimRecorder()
+	c := newLimCache(t, 60, rec)
+	for k := uint64(1); k <= 6; k++ {
+		if k%2 == 0 {
+			require.True(t, c.SetWithTTL(k, int(k), 10, time.Hour))
+		} else {
+			require.True(t, c.Set(k, int(k), 10))
+		}
+	}
+	c.Wait()
+	inAnHour := time.Now().Add(time.Hour)
+
+	c.UpdateMaxCost(10)
+	c.Wait()
+
+	require.Len(t, rec.evicted, 5)
+	for key, items := range rec.evicted {
+		if key%2 == 1 {
+			require.True(t, items[0].Expiration.IsZero(), "key %d", key)
+			continue
+		}
+		require.WithinDuration(t, inAnHour, items[0].Expiration, time.Minute, "key %d", key)
+	}
+}
+
+func TestLimitsShrinkingEvictsExpiredEntriesFirst(t *testing.T) {
+	t.Run("expired entries are enough", func(t *testing.T) {
+		c := newLimCache(t, 80, nil)
+		limFillWithExpired(t, c, 8, 10, 1, 3, 5)
+
+		c.UpdateMaxCost(50)
+		c.Wait()
+
+		require.Equal(t, []uint64{2, 4, 6, 7, 8}, limStored(c, 8))
+		require.Equal(t, int64(0), c.RemainingCost())
+	})
+	t.Run("live entries go after the expired ones", func(t *testing.T) {
+		c := newLimCache(t, 80, nil)
+		limFillWithExpired(t, c, 8, 10, 2, 4, 6)
+
+		c.UpdateMaxCost(40)
+		c.Wait()
+
+		stored := limStored(c, 8)
+		require.Len(t, stored, 4)
+		for _, k := range []uint64{2, 4, 6} {
+			require.NotContains(t, stored, k)
+		}
+		require.Equal(t, int64(0), c.RemainingCost())
+	})
+}
+
+func TestLimitsRaisingTheCostOfAStoredEntryEvictsOthers(t *testing.T) {
+	for round := 0; round < 20; round++ {
+		rec := newLimRecorder()
+		c := newLimCache(t, 100, rec)
+		limFill(t, c, 5, 20)
+
+		require.True(t, c.Set(1, 1001, 60))
+		c.Wait()
+
+		require.Equal(t, int64(0), c.RemainingCost(), "round %d", round)
+		v, ok := c.Get(1)
+		require.True(t, ok, "round %d: the updated entry was evicted", round)
+		require.Equal(t, 1001, v)
+		require.Len(t, limStored(c, 5), 3, "round %d", round)
+		require.NotContains(t, rec.evictedKeys(), uint64(1), "round %d", round)
+		c.Close()
+	}
+}
+
+func TestLimitsRaisingTheCostEvictsExpiredEntriesFirst(t *testing.T) {
+	for round := 0; round < 20; round++ {
+		c := newLimCache(t, 50, nil)
+		limFillWithExpired(t, c, 5, 10, 1, 2)
+
+		require.True(t, c.Set(5, 1005, 30))
+		c.Wait()
+
+		require.Equal(t, []uint64{3, 4, 5}, limStored(c, 5), "round %d", round)
+		require.Equal(t, int64(0), c.RemainingCost(), "round %d", round)
+		c.Close()
+	}
+}
+
+func TestLimitsAnUpdateBiggerThanTheWholeCacheRemovesOnlyThatEntry(t *testing.T) {
+	rec := newLimRecorder()
+	c := newLimCache(t, 100, rec)
+	limFill(t, c, 4, 20)
+
+	require.True(t, c.Set(1, 1001, 150))
+	c.Wait()
+
+	require.Equal(t, []uint64{2, 3, 4}, limStored(c, 4))
+	require.Equal(t, int64(40), c.RemainingCost())
+	require.Equal(t, map[uint64]int{1: 1}, rec.evictedKeys())
+	require.Equal(t, 1001, rec.evicted[1][0].Value)
+}
+
+func TestLimitsHoldUnderConcurrentGrowthAndShrinking(t *testing.T) {
+	c := newLimCache(t, 400, nil)
+	limFill(t, c, 24, 5)
+
+	// Every entry grows from several goroutines while the limit keeps going down.
+	var wg sync.WaitGroup
+	for g := 0; g < 6; g++ {
+		wg.Add(1)
+		go func(g int) {
+			defer wg.Done()
+			for key := uint64(g*4 + 1); key <= uint64(g*4+4); key++ {
+				c.Set(key, 1000+int(key), 24)
+			}
+		}(g)
+	}
+	wg.Add(1)
+	go func() {
+		defer wg.Done()
+		for max := int64(380); max >= 120; max -= 20 {
+			c.UpdateMaxCost(max)
+			runtime.Gosched()
+		}
+	}()
+	wg.Wait()
+	c.Wait()
+
+	require.Equal(t, int64(120), c.MaxCost())
+	require.GreaterOrEqual(t, c.RemainingCost(), int64(0))
+	require.NotEmpty(t, limStored(c, 24))
+}
+
+func TestLimitsEvictionForANewEntryCarriesTheExpiration(t *testing.T) {
+	rec := newLimRecorder()
+	c := newLimCache(t, 30, rec)
+	for k := uint64(1); k <= 3; k++ {
+		require.True(t, c.SetWithTTL(k, int(k), 10, time.Hour))
+	}
+	c.Wait()
+	inAnHour := time.Now().Add(time.Hour)
+
+	require.True(t, c.Set(4, 4, 10))
+	c.Wait()
+
+	require.Len(t, rec.evicted, 1)
+	for key, items := range rec.evicted {
+		require.WithinDuration(t, inAnHour, items[0].Expiration, time.Minute, "key %d", key)
+	}
+}
+
+func TestLimitsAnUpdateIsNotLostWhenTheWriteBufferIsFull(t *testing.T) {
+	rec := newLimRecorder()
+	gate, entered := make(chan struct{}), make(chan struct{})
+	rec.gate, rec.entered = gate, entered
+	c := newLimCache(t, 100, rec)
+	limFill(t, c, 5, 20)
+	require.True(t, c.Set(6, 6, 20))
+	select {
+	case <-entered:
+	case <-time.After(5 * time.Second):
+		t.Fatal("no entry was evicted to make room")
+	}
+
+	// With the write loop held, pile up more writes than the buffer takes, then
+	// make the entry bigger as the very last write.
+	const writes = 40000
+	var done atomic.Int64
+	written := make(chan struct{})
+	go func() {
+		defer close(written)
+		for i := 0; i < writes; i++ {
+			c.Set(6, 6, 20)
+			done.Add(1)
+		}
+		c.Set(6, 1006, 60)
+		done.Add(1)
+	}()
+	// Let the writes go on until they are all done or stop on the full buffer.
+	deadline := time.Now().Add(20 * time.Second)
+	for last, still := int64(-1), 0; still < 5; {
+		require.True(t, time.Now().Before(deadline), "the writes neither finished nor stopped")
+		time.Sleep(10 * time.Millisecond)
+		n := done.Load()
+		if n == writes+1 {
+			break
+		}
+		if n == last {
+			still++
+		} else {
+			last, still = n, 0
+		}
+	}
+	close(gate)
+	<-written
+	c.Wait()
+
+	v, ok := c.Get(6)
+	require.True(t, ok)
+	require.Equal(t, 1006, v)
+	require.Equal(t, int64(0), c.RemainingCost())
+	require.Len(t, limStored(c, 6), 3)
+}
+
+func TestLimitsClearingReleasesValuesWithoutReportingEvictions(t *testing.T) {
+	rec := newLimRecorder()
+	c := newLimCache(t, 100, rec)
+	limFill(t, c, 5, 10)
+
+	c.Clear()
+	c.Wait()
+
+	require.Empty(t, rec.evictedKeys())
+	for k := 1; k <= 5; k++ {
+		require.Equal(t, 1, rec.exited[k], "value %d", k)
+	}
+	require.Empty(t, limStored(c, 5))
+}
+
+func TestLimitsOnlyEntriesStillInTheCacheAreReportedAsEvicted(t *testing.T) {
+	// limParked returns a cache whose write loop is held inside the OnEvict call
+	// of an eviction until release is called, with a shrink still to come.
+	limParked := func(t *testing.T) (c *Cache[uint64, int], rec *limRecorder, release func()) {
+		t.Helper()
+		rec = newLimRecorder()
+		gate, entered := make(chan struct{}), make(chan struct{})
+		rec.gate, rec.entered = gate, entered
+		c = newLimCache(t, 100, rec)
+		limFill(t, c, 10, 10)
+		require.True(t, c.Set(100, 100, 10))
+		select {
+		case <-entered:
+		case <-time.After(5 * time.Second):
+			t.Fatal("no entry was evicted to make room")
+		}
+		return c, rec, func() { close(gate) }
+	}
+	limNothingZero := func(t *testing.T, rec *limRecorder) {
+		t.Helper()
+		rec.Lock()
+		defer rec.Unlock()
+		for key, items := range rec.evicted {
+			for _, item := range items {
+				require.NotZero(t, item.Value, "key %d was reported with a zero value", key)
+			}
+		}
+	}
+
+	// A shrink is still queued when the cache is cleared: nothing may be reported
+	// without a value.
+	c, rec, release := limParked(t)
+	for i := 0; i < 5000; i++ {
+		require.True(t, c.Set(100, 100, 10))
+	}
+	require.True(t, c.Set(200, 200, 10))
+	c.UpdateMaxCost(30)
+	cleared := make(chan struct{})
+	go func() {
+		defer close(cleared)
+		c.Clear()
+	}()
+	time.Sleep(50 * time.Millisecond) // let Clear queue behind the parked write loop
+	release()
+	<-cleared
+	c.Wait()
+	limNothingZero(t, rec)
+	require.Zero(t, rec.exited[0], "a shrink marker released a zero value")
+	require.Empty(t, limStored(c, 100))
+
+	// An entry is deleted and the cache is cleared before the delete is applied.
+	c, rec, release = limParked(t)
+	stored := limStored(c, 100)
+	require.NotEmpty(t, stored)
+	for i := 0; i < 5000; i++ {
+		require.True(t, c.Set(100, 100, 10))
+	}
+	var deleted uint64
+	for _, k := range stored {
+		if k != 100 {
+			deleted = k
+			break
+		}
+	}
+	c.Del(deleted)
+	cleared = make(chan struct{})
+	go func() {
+		defer close(cleared)
+		c.Clear()
+	}()
+	time.Sleep(50 * time.Millisecond) // let Clear queue behind the parked write loop
+	release()
+	<-cleared
+	c.Wait()
+	limNothingZero(t, rec)
+	require.NotContains(t, rec.evictedKeys(), deleted)
+	require.Zero(t, rec.exited[0], "a delete that was never applied released a zero value")
+
+	// Some entries are deleted while a shrink is queued: the shrink must neither
+	// report them nor stop short of the new limit for the others.
+	c, rec, release = limParked(t)
+	c.UpdateMaxCost(30)
+	stored = limStored(c, 100)
+	require.Greater(t, len(stored), 4)
+	for _, k := range stored[:3] {
+		c.Del(k)
+	}
+	release()
+	c.Wait()
+	limNothingZero(t, rec)
+	for key, n := range rec.evictedKeys() {
+		require.Equal(t, 1, n, "key %d", key)
+	}
+	require.LessOrEqual(t, len(limStored(c, 100)), 3)
+	require.GreaterOrEqual(t, c.RemainingCost(), int64(0))
+}
+
+func TestLimitsEntriesDeletedMeanwhileAreNotReportedByOtherEvictions(t *testing.T) {
+	t.Run("making room for a new entry", func(t *testing.T) {
+		rec := newLimRecorder()
+		gate, entered := make(chan struct{}), make(chan struct{})
+		rec.gate, rec.entered = gate, entered
+		c := newLimCache(t, 40, rec)
+		limFill(t, c, 4, 10)
+
+		// The new entry needs two victims; the write loop is held on the first.
+		require.True(t, c.Set(100, 100, 20))
+		select {
+		case <-entered:
+		case <-time.After(5 * time.Second):
+			t.Fatal("no entry was evicted to make room")
+		}
+		for _, k := range limStored(c, 4) {
+			c.Del(k)
+		}
+		close(gate)
+		c.Wait()
+
+		require.Len(t, rec.evictedKeys(), 1)
+		rec.Lock()
+		defer rec.Unlock()
+		for key, items := range rec.evicted {
+			require.NotZero(t, items[0].Value, "key %d was reported with a zero value", key)
+		}
+	})
+	t.Run("expiry cleanup", func(t *testing.T) {
+		rec := newLimRecorder()
+		gate, entered := make(chan struct{}), make(chan struct{})
+		rec.gate, rec.entered = gate, entered
+		c, err := NewCache(&Config[uint64, int]{
+			NumCounters:            1000,
+			MaxCost:                100,
+			BufferItems:            64,
+			IgnoreInternalCost:     true,
+			Metrics:                true,
+			TtlTickerDurationInSec: 1,
+			OnEvict:                rec.onEvict,
+			OnExit:                 rec.onExit,
+		})
+		require.NoError(t, err)
+		t.Cleanup(c.Close)
+		for k := uint64(1); k <= 2; k++ {
+			require.True(t, c.SetWithTTL(k, int(k), 10, 40*time.Millisecond))
+		}
+		c.Wait()
+
+		// The cleanup of the expired entries is held on the first one it reports.
+		select {
+		case <-entered:
+		case <-time.After(20 * time.Second):
+			t.Fatal("expired entries were never cleaned up")
+		}
+		for _, k := range []uint64{1, 2} {
+			c.Del(k)
+		}
+		close(gate)
+		c.Wait()
+
+		require.Len(t, rec.evictedKeys(), 1)
+		rec.Lock()
+		defer rec.Unlock()
+		for key, items := range rec.evicted {
+			require.NotZero(t, items[0].Value, "key %d was reported with a zero value", key)
+		}
+	})
+}
+
+func TestLimitsANewEntryTakesThePlaceOfExpiredEntriesFirst(t *testing.T) {
+	cases := []struct {
+		name string
+		// popular are the keys that are read often before the cache fills up.
+		popular []uint64
+	}{
+		// LFU alone would evict the live entries, which were never read.
+		{"live entries are the least used", []uint64{2, 4}},
+		// LFU alone would reject the new entry, which was never read.
+		{"the new entry is the least used", []uint64{1, 2, 3, 4, 5}},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			rec := newLimRecorder()
+			c := newLimCountingCache(t, 50, rec)
+			limHeat(c, tc.popular...)
+			limFillWithExpired(t, c, 5, 10, 2, 4)
+
+			require.True(t, c.Set(6, 6, 20))
+			c.Wait()
+
+			require.Equal(t, []uint64{1, 3, 5, 6}, limStored(c, 6))
+			require.Equal(t, int64(0), c.RemainingCost())
+			evicted := rec.evictedKeys()
+			require.Equal(t, map[uint64]int{2: 1, 4: 1}, evicted)
+			for _, k := range []uint64{2, 4} {
+				item := rec.evicted[k][0]
+				require.Equal(t, int(k), item.Value)
+				require.False(t, item.Expiration.IsZero(), "key %d", k)
+			}
+		})
+	}
+}
+
+func TestLimitsARejectedEntryEvictsNothing(t *testing.T) {
+	rec := newLimRecorder()
+	c := newLimCountingCache(t, 30, rec)
+	for k := uint64(1); k <= 3; k++ {
+		require.True(t, c.Set(k, int(k), 10))
+	}
+	c.Wait()
+	// Key 1 is as unpopular as the new entry, keys 2 and 3 are more popular, so
+	// making room for 20 would take key 1 and then one of the popular keys.
+	limHeat(c, 2, 3)
+
+	require.True(t, c.Set(4, 4, 20))
+	c.Wait()
+
+	require.Empty(t, rec.evictedKeys())
+	require.Equal(t, []uint64{1, 2, 3}, limStored(c, 4))
+	require.Equal(t, int64(0), c.RemainingCost())
+}
