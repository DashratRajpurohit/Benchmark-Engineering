+++ b/test.sh
@@ -0,0 +1,72 @@
+#!/usr/bin/env bash
+# Usage:
+#   ./test.sh [--output_path <junit.xml>] <base|new>
+#
+# base  runs the existing tests of the cache package, the only package this
+#       change touches, plus a small set of regression controls in
+#       cache_limits_base_a83c07_test.go (compiled only with -tags
+#       maxcostlimits_base) that already hold on the base commit and must keep
+#       holding after any change. The z, sim and contrib packages are not
+#       affected by it and are left out, so the baseline does not depend on
+#       the machine.
+# new   runs the capacity tests in cache_limits_5d29b1_test.go, the file that is
+#       compiled only with -tags maxcostlimits.
+set -uo pipefail
+
+ORIG_PWD="$(pwd)"
+
+OUTPUT_PATH=""
+if [ "${1:-}" = "--output_path" ]; then
+  OUTPUT_PATH="$2"
+  shift 2
+  case "$OUTPUT_PATH" in
+    /*) : ;;
+    *) OUTPUT_PATH="$ORIG_PWD/$OUTPUT_PATH" ;;
+  esac
+fi
+
+MODE="${1:-new}"
+
+[ -f go.mod ] || cd "$(dirname "$0")"
+
+TEST_LOG="$(mktemp)"
+STATUS=0
+
+run_tests() {
+  go test -count=1 -v "$@" 2>&1 | tee -a "$TEST_LOG"
+  status=${PIPESTATUS[0]}
+  if [ "$status" -ne 0 ]; then
+    STATUS=$status
+  fi
+}
+
+# new_tests lists the test functions of the files built only with the given tag.
+new_tests() {
+  grep -lx "//go:build $1" ./*_test.go |
+    xargs sed -n 's/^func \(Test[A-Za-z0-9_]*\)(t \*testing\.T).*/\1/p' |
+    paste -sd '|' -
+}
+
+case "$MODE" in
+  base)
+    run_tests -timeout 900s -tags maxcostlimits_base .
+    ;;
+  new)
+    run_tests -timeout 600s -tags maxcostlimits -run "^($(new_tests maxcostlimits))\$" .
+    ;;
+  *)
+    echo "unknown mode: $MODE (expected base or new)" >&2
+    exit 2
+    ;;
+esac
+
+if [ -n "$OUTPUT_PATH" ]; then
+  go-junit-report -set-exit-code < "$TEST_LOG" > "$OUTPUT_PATH"
+  junit_status=$?
+  if [ "$junit_status" -ne 0 ] && [ "$STATUS" -eq 0 ]; then
+    echo "go-junit-report failed to convert the test log (exit $junit_status)" >&2
+    STATUS=$junit_status
+  fi
+fi
+
+exit "$STATUS"
