+// evictOverflow evicts entries until the cache is back within its maximum cost.
+// The entry stored under the optional updated key is kept unless it is too big
+// for the cache on its own.
+func (c *Cache[K, V]) evictOverflow(onEvict func(*Item[V]), updated ...uint64) {
+	for _, victim := range c.cachePolicy.Shrink(updated...) {
+		c.removeVictim(victim, onEvict)
+	}
+}
+
+// removeVictim takes a victim the policy gave up out of the store, counts it as
+// evicted and reports it to onEvict with its value and expiration. An entry that
+// a Del already removed is not an eviction, so it is left alone.
+func (c *Cache[K, V]) removeVictim(victim *Item[V], onEvict func(*Item[V])) {
+	removed, ok := c.storedItems.DelIfPresent(victim.Key, 0)
+	if !ok {
+		return
+	}
+	victim.Conflict, victim.Value, victim.Expiration = removed.conflict, removed.value, removed.expiration
+	c.Metrics.add(keyEvict, victim.Key, 1)
+	c.Metrics.add(costEvict, victim.Key, uint64(victim.Cost))
+	onEvict(victim)
+}
