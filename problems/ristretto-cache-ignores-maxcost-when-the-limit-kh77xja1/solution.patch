+// pickExpired picks entries that are past their TTL, other than the skipped
+// ones, until their cost covers need. It returns them along with the part of
+// need that is still left.
+func (p *defaultPolicy[V]) pickExpired(need int64, skip ...uint64) ([]*policyPair, int64) {
+	if need <= 0 || p.expired == nil {
+		return nil, need
+	}
+	var picked []*policyPair
+	for _, key := range p.expired() {
+		if need <= 0 {
+			break
+		}
+		cost, ok := p.evict.keyCosts[key]
+		if !ok || slices.Contains(skip, key) {
+			continue
+		}
+		picked = append(picked, &policyPair{key, cost})
+		need -= cost
+	}
+	return picked, need
+}
