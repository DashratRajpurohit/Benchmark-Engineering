+// Shrink evicts entries until the policy is back within its maximum cost and
+// returns them. Expired entries go first, then the least used ones. The entry
+// stored under the optional updated key is only evicted when its cost alone is
+// more than the maximum; otherwise it is kept.
+func (p *defaultPolicy[V]) Shrink(updated ...uint64) []*Item[V] {
+	p.Lock()
+	defer p.Unlock()
+
+	var victims []*Item[V]
+	take := func(pair *policyPair) {
+		p.evict.drop(pair.key)
+		victims = append(victims, &Item[V]{Key: pair.key, Cost: pair.cost})
+	}
+
+	if len(updated) > 0 {
+		if cost, ok := p.evict.keyCosts[updated[0]]; ok && cost > p.evict.getMaxCost() {
+			take(&policyPair{updated[0], cost})
+		}
+	}
+	expired, _ := p.pickExpired(-p.evict.roomLeft(0), updated...)
+	for _, pair := range expired {
+		take(pair)
+	}
+	sample := make([]*policyPair, 0, lfuSample)
+	for p.evict.roomLeft(0) < 0 {
+		sample = p.evict.fillSampleExcept(sample, updated...)
+		id, _ := p.admit.leastUsed(sample)
+		if id < 0 {
+			break
+		}
+		pair := sample[id]
+		sample[id] = sample[len(sample)-1]
+		sample = sample[:len(sample)-1]
+		take(pair)
+	}
+	return victims
+}
