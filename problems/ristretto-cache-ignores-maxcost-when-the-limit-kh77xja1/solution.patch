+// leastUsed returns the index of the sampled entry with the fewest hits and
+// that hit count, or -1 if there is no sample.
+func (p *tinyLFU) leastUsed(sample []*policyPair) (id int, hits int64) {
+	id, hits = -1, math.MaxInt64
+	for i, pair := range sample {
+		if h := p.Estimate(pair.key); h < hits {
+			id, hits = i, h
+		}
+	}
+	return id, hits
+}
