+// pending returns the keys in the buckets that the cleanup has not reached yet
+// and that may already hold expired items.
+func (m *expirationMap[_]) pending(now time.Time) []uint64 {
+	if m == nil {
+		return nil
+	}
+
+	m.RLock()
+	defer m.RUnlock()
+	var keys []uint64
+	for bucketNum := m.lastCleanedBucketNum + 1; bucketNum <= storageBucket(now); bucketNum++ {
+		for key := range m.buckets[bucketNum] {
+			keys = append(keys, key)
+		}
+	}
+	return keys
+}
