+	// BeforeTypes and AfterTypes give the type of each value in Before and After,
+	// keyed by column name. They are set only when the row carries those types.
+	BeforeTypes map[string]string `json:"before_types,omitempty"`
+	AfterTypes  map[string]string `json:"after_types,omitempty"`
+}
+
+// rowTypes pairs each column name with the type of that column's value. It returns
+// nil if the row carries no types, so events without them are unchanged.
+func rowTypes(columnNames, types []string) map[string]string {
+	if len(types) == 0 {
+		return nil
+	}
+	m := make(map[string]string, len(types))
+	for i, t := range types {
+		if i < len(columnNames) {
+			m[columnNames[i]] = t
+		}
+	}
+	return m
 }
 
