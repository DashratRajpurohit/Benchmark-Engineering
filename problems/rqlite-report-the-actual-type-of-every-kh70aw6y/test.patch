+func Test_VTypes_FollowerForwarding(t *testing.T) {
+	leader := mustNewLeaderNode("leader")
+	defer leader.Deprovision()
+	mustSetupVTypesTable(t, leader)
+
+	follower := mustNewNode("follower", false)
+	defer follower.Deprovision()
+	if err := follower.Join(leader); err != nil {
+		t.Fatalf("follower failed to join leader: %v", err)
+	}
+	if _, err := follower.WaitForLeader(); err != nil {
+		t.Fatalf("follower never saw a leader: %v", err)
+	}
+	for range 3 {
+		leader.Noop("vtypes")
+	}
+
+	// Allow the follower a bounded amount of time to start serving the request.
+	var body string
+	if !trueOrTimeout(func() bool {
+		resp, err := http.Get("http://" + follower.APIAddr + "/db/query?" +
+			url.Values{"q": {vtypesQuery}, "vtypes": {""}, "level": {"weak"}}.Encode())
+		if err != nil {
+			return false
+		}
+		defer resp.Body.Close()
+		b, _ := io.ReadAll(resp.Body)
+		body = string(b)
+		return resp.StatusCode == http.StatusOK && strings.Contains(body, `"values"`)
+	}, 20*time.Second) {
+		t.Fatalf("follower never served the query, last response: %s", body)
+	}
+	mustStandard(t, mustVTypes(t, body, 0), wantStandardVTypes)
+	mustKeepBytes(t, body)
+
+	// Reads that go through the leader for a different reason must behave the same.
+	for _, level := range []string{"none", "strong", "linearizable", "auto"} {
+		body = vtypesGet(t, follower, url.Values{"q": {vtypesQuery}, "vtypes": {""}, "level": {level}})
+		mustStandard(t, mustVTypes(t, body, 0), wantStandardVTypes)
+		mustKeepBytes(t, body)
+	}
+
+	// A write forwarded to the leader returns its rows the same way.
+	body = vtypesPost(t, follower, "/db/execute", url.Values{"vtypes": {""}},
+		`["INSERT INTO t (id, txt) VALUES (30, X'c0fe') RETURNING id, txt"]`)
+	mustStandard(t, mustVTypes(t, body, 0), [][]string{{"integer", "blob"}})
+	var returned [][]json.RawMessage
+	if err := json.Unmarshal(decodeResults(t, body)[0]["values"], &returned); err != nil {
+		t.Fatalf("failed to decode values: %v", err)
+	}
+	if len(returned) != 1 || len(returned[0]) != 2 {
+		t.Fatalf("the forwarded write returned no row: %s", body)
+	}
+	mustBeC0FE(t, returned[0][1], body)
+}
+
+// Test_VTypes_CDC checks that change data capture events report the type of every
+// value they carry, keyed by column name.
+func Test_VTypes_CDC(t *testing.T) {
+	node := mustNewLeaderNode("cdcnode")
+	defer node.Deprovision()
+
+	endpoint := cdctest.NewHTTPTestServer()
+	endpoint.Start()
+	defer endpoint.Close()
+
+	cdcCluster := cdc.NewCDCCluster(node.Store, node.Cluster, node.Client)
+	svc, err := cdc.NewService(node.ID, node.Dir, cdcCluster, mustCDCConfig(endpoint.URL()))
+	if err != nil {
+		t.Fatalf("failed to create CDC service: %v", err)
+	}
+	node.CDC = svc
+	node.CDC.Start()
+	node.CDC.SetLeader(true)
+	node.Store.EnableCDC(node.CDC.C(), nil, false)
+
+	for _, stmt := range []string{
+		`CREATE TABLE c (id INTEGER, txt TEXT, b BLOB, ts DATETIME)`,
+		// The TEXT column holds a blob and the BLOB column holds text, so the declared
+		// column types cannot stand in for the types of these values.
+		// ts holds an integer, but a date-like column always reports text.
+		`INSERT INTO c VALUES (1, X'c0fe', 'hi', 1700000000)`,
+		// A NULL is a null whatever the column declares.
+		`INSERT INTO c VALUES (2, NULL, NULL, NULL)`,
+		// A BLOB column has no affinity, so this stores an integer where text was.
+		`UPDATE c SET b = 5 WHERE id = 1`,
+	} {
+		if _, err := node.Execute(stmt); err != nil {
+			t.Fatalf("failed to execute %q: %v", stmt, err)
+		}
+	}
+
+	// Collect the types of every event delivered to the endpoint.
+	var got []map[string]any
+	testPoll(t, func() (bool, error) {
+		got = got[:0]
+		for _, req := range endpoint.GetRequests() {
+			var env struct {
+				Payload []struct {
+					Events []map[string]any `json:"events"`
+				} `json:"payload"`
+			}
+			if err := json.Unmarshal(req, &env); err != nil {
+				return false, err
+			}
+			for _, m := range env.Payload {
+				got = append(got, m.Events...)
+			}
+		}
+		return len(got) >= 3, nil
+	}, 100*time.Millisecond, 20*time.Second)
+
+	mustTypes := func(ev map[string]any, key string, want map[string]string) {
+		t.Helper()
+		raw, ok := ev[key]
+		if !ok {
+			t.Fatalf("event carries no %s: %v", key, ev)
+		}
+		m, _ := raw.(map[string]any)
+
+		// The types must describe every column of the row image they belong to.
+		image, _ := ev[strings.TrimSuffix(key, "_types")].(map[string]any)
+		if len(image) != len(m) {
+			t.Fatalf("%s has %d columns but its row image has %d: %v", key, len(m), len(image), ev)
+		}
+		for col := range image {
+			if _, ok := m[col]; !ok {
+				t.Fatalf("%s has no entry for column %q: %v", key, col, ev)
+			}
+		}
+		for col, wantType := range want {
+			if m[col] != wantType {
+				t.Fatalf("%s[%s] is %v, want %s: %v", key, col, m[col], wantType, ev)
+			}
+		}
+	}
+
+	mustTypes(got[0], "after_types", map[string]string{"id": "integer", "txt": "blob", "b": "text", "ts": "text"})
+	mustTypes(got[1], "after_types", map[string]string{"id": "integer", "txt": "null", "b": "null", "ts": "null"})
+	mustTypes(got[2], "before_types", map[string]string{"txt": "blob", "b": "text"})
+	mustTypes(got[2], "after_types", map[string]string{"txt": "blob", "b": "integer"})
+}
