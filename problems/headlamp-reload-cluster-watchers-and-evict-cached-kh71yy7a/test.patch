+// labelledGoroutines counts live goroutines carrying label whose stack mentions frame; goroutines
+// inherit the labels of the goroutine that creates them.
+func labelledGoroutines(t *testing.T, label, frame string) int {
+	t.Helper()
+
+	var profile bytes.Buffer
+	require.NoError(t, pprof.Lookup("goroutine").WriteTo(&profile, 1))
+
+	count := 0
+
+	for _, record := range strings.Split(profile.String(), "\n\n") {
+		if strings.Contains(record, `"reload":"`+label+`"`) && strings.Contains(record, frame) {
+			var goroutines int
+
+			_, err := fmt.Sscanf(record, "%d @", &goroutines)
+			require.NoError(t, err)
+
+			count += goroutines
+		}
+	}
+
+	return count
+}
