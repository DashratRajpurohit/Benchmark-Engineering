+
+const reloadCluster = "reload-cluster"
+
+// reloadServer is a stand-in cluster API server that counts the watches it serves.
+type reloadServer struct {
+	*httptest.Server
+	mu     sync.Mutex
+	open   int
+	opened int
+	// reviewed counts the authorization reviews sent to the server, which answers them only with
+	// authorizeReviews set. With holdReview set, the next review closes reviewHeld and waits for release.
+	reviewed         int
+	authorizeReviews bool
+	holdReview       bool
+	reviewHeld       chan struct{}
+	done             chan struct{}
+	// A pods list carrying holdHeader waits for release, after closing held.
+	held     chan struct{}
+	release  chan struct{}
+	heldOnce sync.Once
+	// With holdDiscovery set, the next discovery request closes discoveryHeld, then fails on release.
+	holdDiscovery    bool
+	discoveryHeld    chan struct{}
+	discoveryRelease chan struct{}
+}
+
+// holdHeader marks the one request a test wants its cluster to keep waiting.
+const holdHeader = "X-Reload-Hold"
+
+func newReloadServer(t *testing.T, name string) *reloadServer {
+	t.Helper()
+
+	s := &reloadServer{
+		done: make(chan struct{}), held: make(chan struct{}), release: make(chan struct{}),
+		discoveryHeld: make(chan struct{}), discoveryRelease: make(chan struct{}), reviewHeld: make(chan struct{}),
+	}
+	m := http.NewServeMux()
+	respond := func(w http.ResponseWriter, body string) {
+		w.Header().Set("Content-Type", "application/json")
+		_, _ = fmt.Fprint(w, body)
+	}
+
+	m.HandleFunc("/api", func(w http.ResponseWriter, _ *http.Request) {
+		s.mu.Lock()
+		hold := s.holdDiscovery
+		s.holdDiscovery = false
+		s.mu.Unlock()
+
+		if hold {
+			close(s.discoveryHeld)
+			<-s.discoveryRelease
+			w.WriteHeader(http.StatusInternalServerError)
+
+			return
+		}
+
+		respond(w, `{"kind":"APIVersions","versions":["v1"]}`)
+	})
+	m.HandleFunc("/api/v1", func(w http.ResponseWriter, _ *http.Request) {
+		respond(w, `{"kind":"APIResourceList","groupVersion":"v1","resources":[`+
+			`{"name":"pods","namespaced":true,"kind":"Pod","verbs":["list","watch"]}]}`)
+	})
+	m.HandleFunc("/apis", func(w http.ResponseWriter, _ *http.Request) {
+		respond(w, `{"kind":"APIGroupList","groups":[]}`)
+	})
+	m.HandleFunc("/version", func(w http.ResponseWriter, _ *http.Request) {
+		respond(w, `{"major":"1","minor":"30","gitVersion":"`+name+`"}`)
+	})
+	m.HandleFunc("/api/v1/pods", func(w http.ResponseWriter, r *http.Request) { s.servePods(w, r, name, respond) })
+	m.HandleFunc("/apis/authorization.k8s.io/v1/selfsubjectaccessreviews", s.serveReview)
+
+	s.Server = httptest.NewServer(m)
+
+	t.Cleanup(func() {
+		close(s.done)
+		s.Close()
+	})
+
+	return s
+}
+
+// servePods answers a pods list, or keeps a pods watch open until the client or test goes away.
+func (s *reloadServer) servePods(w http.ResponseWriter, r *http.Request, name string,
+	respond func(http.ResponseWriter, string),
+) {
+	if r.URL.Query().Get("watch") != "true" {
+		if r.Header.Get(holdHeader) != "" {
+			s.heldOnce.Do(func() { close(s.held) })
+			<-s.release
+		}
+
+		respond(w, `{"kind":"PodList","apiVersion":"v1","metadata":{"resourceVersion":"1"},`+
+			`"items":[{"metadata":{"name":"`+name+`"}}]}`)
+
+		return
+	}
+
+	s.mu.Lock()
+	s.open++
+	s.opened++
+	s.mu.Unlock()
+
+	defer func() {
+		s.mu.Lock()
+		s.open--
+		s.mu.Unlock()
+	}()
+
+	w.WriteHeader(http.StatusOK)
+	w.(http.Flusher).Flush()
+
+	select {
+	case <-r.Context().Done():
+	case <-s.done:
+	}
+}
+
+func (s *reloadServer) openWatches() int {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+
+	return s.open
+}
+
+func (s *reloadServer) serveReview(w http.ResponseWriter, r *http.Request) {
+	s.mu.Lock()
+	s.reviewed++
+	authorize, hold := s.authorizeReviews, s.holdReview
+	s.holdReview = false
+	s.mu.Unlock()
+
+	if hold {
+		close(s.reviewHeld)
+		<-s.release
+	}
+
+	if !authorize {
+		http.NotFound(w, r)
+		return
+	}
+
+	w.Header().Set("Content-Type", "application/json")
+	w.WriteHeader(http.StatusCreated)
+	_, _ = fmt.Fprint(w, `{"kind":"SelfSubjectAccessReview","apiVersion":"authorization.k8s.io/v1",`+
+		`"status":{"allowed":true}}`)
+}
+
+func (s *reloadServer) reviews() int {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+
+	return s.reviewed
+}
+
+// openedWatches counts every watch the server has been sent, including ones since closed.
+func (s *reloadServer) openedWatches() int {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+
+	return s.opened
+}
+
+func tokenUser(token string) string { return "token: " + token }
+
+// oidcIDToken is an unexpired, unsigned ID token, so a watcher can authenticate without the issuer.
+func oidcIDToken(clientID, issuer string) string {
+	enc := base64.RawURLEncoding
+	claims := fmt.Sprintf(`{"iss":%q,"aud":%q,"exp":4102444800}`, issuer, clientID)
+
+	return enc.EncodeToString([]byte(`{"alg":"none"}`)) + "." + enc.EncodeToString([]byte(claims)) + ".sig"
+}
+
+func oidcUser(clientID, issuer string) string {
+	return "auth-provider:\n      name: oidc\n      config:\n        client-id: " + clientID +
+		"\n        client-secret: s\n        idp-issuer-url: " + issuer +
+		"\n        id-token: " + oidcIDToken(clientID, issuer) + "\n        scope: openid"
+}
+
+func reloadKubeConfig(server, user string) string {
+	yaml := fmt.Sprintf(`apiVersion: v1
+kind: Config
+clusters:
+- cluster:
+    server: %[1]s
+    insecure-skip-tls-verify: true
+  name: %[2]s
+contexts:
+- context:
+    cluster: %[2]s
+    user: %[2]s
+  name: %[2]s
+current-context: %[2]s
+users:
+- name: %[2]s
+  user:
+    %[3]s
+`, server, reloadCluster, user)
+
+	return base64.StdEncoding.EncodeToString([]byte(yaml))
+}
+
+// reloadChain mounts the cache middleware the way the server does, in front of a fresh store.
+func reloadChain(t *testing.T) (*HeadlampConfig, http.Handler) {
+	t.Helper()
+
+	k8cache.ResetForTesting()
+	t.Cleanup(k8cache.ResetForTesting)
+
+	c := &HeadlampConfig{HeadlampConfig: &headlampconfig.HeadlampConfig{
+		HeadlampCFG: &headlampconfig.HeadlampCFG{
+			EnableDynamicClusters: true,
+			KubeConfigStore:       kubeconfig.NewContextStore(),
+		},
+		Cache: cache.New[interface{}](),
+	}}
+	c.CacheEnabled = true
+
+	router := mux.NewRouter()
+	router.PathPrefix("/clusters/{clusterName}/{api:.*}").Handler(CacheMiddleWare(c)(clusterRequestHandler(c)))
+
+	return c, router
+}
+
+// reloadRequest sends an ordinary pods list request, optionally carrying marker headers.
+func reloadRequest(router http.Handler, kubeConfig, userID string, extra ...string) string {
+	headers := http.Header{}
+	for _, header := range extra {
+		headers.Set(header, "1")
+	}
+
+	return reloadRequestWith(router, http.MethodGet, "/api/v1/pods", kubeConfig, userID, headers)
+}
+
+func reloadRequestWith(router http.Handler, method, path, kubeConfig, userID string, headers http.Header) string {
+	req := httptest.NewRequestWithContext(context.Background(), method, "/clusters/"+reloadCluster+path, nil)
+	req.Header.Set("KUBECONFIG", kubeConfig)
+	req.Header.Set("X-HEADLAMP-USER-ID", userID)
+	req.Header.Set("Authorization", "Bearer user-token")
+
+	for name, values := range headers {
+		req.Header[name] = values
+	}
+
+	rec := httptest.NewRecorder()
+	router.ServeHTTP(rec, req)
+
+	return rec.Body.String()
+}
+
+// startWatcher ensures a watcher runs for key, as the cache middleware does after authorization.
+func startWatcher(t *testing.T, c *HeadlampConfig, key string) *kubeconfig.Context {
+	t.Helper()
+
+	stored, err := c.KubeConfigStore.GetContext(key)
+	require.NoError(t, err)
+	k8cache.CheckForChanges(k8sResponseCache, key, *stored)
+
+	return stored
+}
+
+func eventuallyOpen(t *testing.T, s *reloadServer, want int, msg string) {
+	t.Helper()
+
+	assert.Eventually(t, func() bool { return s.openWatches() == want }, 5*time.Second, 20*time.Millisecond, msg)
+}
+
+func TestReplacedRequestContextReloadsWatcherAndCaches(t *testing.T) {
+	c, router := reloadChain(t)
+	a, b, o := newReloadServer(t, "server-a"), newReloadServer(t, "server-b"), newReloadServer(t, "other-user")
+	key, otherKey := statelessContextKey(reloadCluster, "user-1"), statelessContextKey(reloadCluster, "user-2")
+
+	// Another user of the same cluster, whose state the replacement must leave alone.
+	reloadRequest(router, reloadKubeConfig(o.URL, tokenUser("t")), "user-2")
+
+	otherBuiltFor := *startWatcher(t, c, otherKey)
+	otherBuiltFor.ClusterID = "kubeconfig+" + otherKey
+	otherClientset, err := k8cache.GetClientSet(otherKey, &otherBuiltFor, "token")
+	require.NoError(t, err)
+
+	// Only a clientset that is cached can be shown to be kept.
+	otherCached, err := k8cache.GetClientSet(otherKey, &otherBuiltFor, "token")
+	require.NoError(t, err)
+
+	otherCacheKey := servedResponse(t, otherKey)
+
+	reloadRequest(router, reloadKubeConfig(a.URL, tokenUser("t")), "user-1")
+
+	builtFor := *startWatcher(t, c, key)
+	eventuallyOpen(t, a, 1, "a watcher must run against the first configuration")
+	eventuallyOpen(t, o, 1, "and against the other user's configuration")
+
+	builtFor.ClusterID = "kubeconfig+" + key
+	oldClientset, err := k8cache.GetClientSet(key, &builtFor, "token")
+	require.NoError(t, err)
+
+	cacheKey := servedResponse(t, key)
+	otherWatches := o.openedWatches()
+
+	reloadRequest(router, reloadKubeConfig(b.URL, tokenUser("t")), "user-1")
+
+	eventuallyOpen(t, a, 0, "the watcher for the old configuration must be stopped")
+	eventuallyOpen(t, b, 1, "a watcher must run against the new configuration")
+
+	_, err = k8sResponseCache.Get(context.Background(), cacheKey)
+	assert.Error(t, err, "responses cached for the old configuration must be evicted")
+
+	newClientset, err := k8cache.GetClientSet(key, &builtFor, "token")
+	require.NoError(t, err)
+	assert.NotSame(t, oldClientset, newClientset, "clientsets built for the old configuration must be evicted")
+
+	_, err = k8sResponseCache.Get(context.Background(), otherCacheKey)
+	assert.NoError(t, err, "another user's cached responses must be kept")
+
+	if otherCached == otherClientset {
+		keptClientset, err := k8cache.GetClientSet(otherKey, &otherBuiltFor, "token")
+		require.NoError(t, err)
+		assert.Same(t, otherClientset, keptClientset, "another user's clientsets must be kept")
+	}
+
+	assert.Equal(t, 1, o.openWatches(), "another user's watcher must keep running")
+	assert.Equal(t, otherWatches, o.openedWatches(), "and must not be restarted")
+}
+
+// servedResponse caches a response for key and returns the cache key it was stored under.
+func servedResponse(t *testing.T, key string) string {
+	t.Helper()
+
+	cacheKey, err := k8cache.GenerateKey(&url.URL{Path: "/clusters/" + reloadCluster + "/api/v1/services"}, key)
+	require.NoError(t, err)
+	require.NoError(t, k8sResponseCache.Set(context.Background(), cacheKey, "response for the old configuration"))
+
+	return cacheKey
+}
+
+// assertConfigurationReplaced supplies prev then next and checks that prev's context, watcher and caches are replaced.
+func assertConfigurationReplaced(t *testing.T, name, prev, next string, newServer bool,
+	check func(*kubeconfig.Context) bool,
+) {
+	t.Helper()
+
+	c, router := reloadChain(t)
+	a, b := newReloadServer(t, "server-a"), newReloadServer(t, "server-b")
+	key := statelessContextKey(reloadCluster, "user-1")
+
+	target := a
+	if newServer {
+		target = b
+	}
+
+	reloadRequest(router, reloadKubeConfig(a.URL, prev), "user-1")
+
+	old := startWatcher(t, c, key)
+	eventuallyOpen(t, a, 1, "a watcher must run against the first configuration")
+
+	builtFor := *old
+	builtFor.ClusterID = "kubeconfig+" + key
+	oldClientset, err := k8cache.GetClientSet(key, &builtFor, "token")
+	require.NoError(t, err)
+
+	cacheKey := servedResponse(t, key)
+	watchesBefore := target.openedWatches()
+
+	reloadRequest(router, reloadKubeConfig(target.URL, next), "user-1")
+
+	stored, err := c.KubeConfigStore.GetContext(key)
+	require.NoError(t, err)
+	assert.Equal(t, target.URL, stored.Cluster.Server)
+	assert.True(t, check(stored), "the cached context must reflect the request's new %s", name)
+	assert.True(t, stored.Internal, "a replaced context stays this user's own")
+
+	for _, listed := range c.getClusters() {
+		assert.NotEqual(t, key, listed.Name, "a per-user context must not be offered to every user")
+	}
+
+	// The old watcher is stopped and a new one opens its own watch, even on the same server.
+	assert.Eventually(t, func() bool {
+		return target.openedWatches() > watchesBefore && target.openWatches() == 1 &&
+			a.openWatches()+b.openWatches() == 1
+	}, 5*time.Second, 20*time.Millisecond, "the watcher must be replaced for the new %s", name)
+
+	_, err = k8sResponseCache.Get(context.Background(), cacheKey)
+	assert.Error(t, err, "responses cached for the old %s must be evicted", name)
+
+	newClientset, err := k8cache.GetClientSet(key, &builtFor, "token")
+	require.NoError(t, err)
+	assert.NotSame(t, oldClientset, newClientset, "clientsets built for the old %s must be evicted", name)
+}
+
+func TestRequestContextChangeIsDetectedForEveryConfigurationField(t *testing.T) {
+	const issuer, otherIssuer = "https://issuer.example", "https://other-issuer.example"
+
+	for name, tc := range map[string]struct {
+		prev, next string
+		newServer  bool
+		check      func(*kubeconfig.Context) bool
+	}{
+		"server": {
+			prev: tokenUser("t"), next: tokenUser("t"), newServer: true,
+			check: func(*kubeconfig.Context) bool { return true },
+		},
+		"credentials": {
+			prev: tokenUser("t"), next: tokenUser("rotated"),
+			check: func(k *kubeconfig.Context) bool { return k.AuthInfo.Token == "rotated" },
+		},
+		"oidc client": {
+			prev: oidcUser("client-1", issuer), next: oidcUser("client-2", issuer),
+			check: func(k *kubeconfig.Context) bool {
+				return k.AuthInfo.AuthProvider.Config["client-id"] == "client-2"
+			},
+		},
+		"oidc issuer": {
+			prev: oidcUser("client-1", issuer), next: oidcUser("client-1", otherIssuer),
+			check: func(k *kubeconfig.Context) bool {
+				return k.AuthInfo.AuthProvider.Config["idp-issuer-url"] == otherIssuer
+			},
+		},
+	} {
+		t.Run(name, func(t *testing.T) { assertConfigurationReplaced(t, name, tc.prev, tc.next, tc.newServer, tc.check) })
+	}
+}
