+#!/usr/bin/env bash
+# Runs the backend suites for this change.
+#   ./test.sh [--output_path <junit.xml>] base|new
+# base: the existing tests of ./cmd and ./pkg/k8cache.
+# new:  the tests that exist only under the "reconciliation" build tag.
+set -uo pipefail
+
+OUTPUT_PATH=""
+if [ "${1:-}" = "--output_path" ]; then
+  OUTPUT_PATH="$(realpath -m -- "$2")"
+  shift 2
+fi
+
+MODE="${1:-new}"
+cd "$(dirname "$0")/backend" || exit 1
+
+TEST_LOG="$(mktemp)"
+trap 'rm -f "$TEST_LOG"' EXIT
+STATUS=0
+
+run_tests() {
+  go test -count=1 -v "$@" 2>&1 | tee -a "$TEST_LOG"
+  local status=${PIPESTATUS[0]}
+  if [ "$status" -ne 0 ]; then
+    STATUS=$status
+  fi
+}
+
+list_tests() {
+  go test "$@" -list '^Test' ./cmd/... ./pkg/k8cache/... 2>>"$TEST_LOG" | grep -E '^Test' | sort -u
+}
+
+case "$MODE" in
+  base)
+    run_tests ./cmd/... ./pkg/k8cache/...
+    ;;
+  new)
+    new_only="$(comm -13 <(list_tests) <(list_tests -tags reconciliation))"
+    if [ -z "$new_only" ]; then
+      echo "no reconciliation-only tests found" >&2
+      cat "$TEST_LOG" >&2
+      STATUS=1
+    else
+      run_tests -tags reconciliation -run "^($(paste -sd '|' <<<"$new_only"))\$" ./cmd/... ./pkg/k8cache/...
+    fi
+    ;;
+  *)
+    echo "unknown mode: $MODE (expected base or new)" >&2
+    exit 2
+    ;;
+esac
+
+if [ -n "$OUTPUT_PATH" ]; then
+  # Without -set-exit-code, go-junit-report fails only when it cannot write the report.
+  if ! command -v go-junit-report >/dev/null 2>&1 || ! go-junit-report <"$TEST_LOG" >"$OUTPUT_PATH"; then
+    echo "failed to write JUnit report to $OUTPUT_PATH" >&2
+    exit 1
+  fi
+fi
+
+exit "$STATUS"
