+func TestStaleWatcherShutdownKeepsReplacementRegistered(t *testing.T) {
+	c, router := reloadChain(t)
+	a, b := newReloadServer(t, "server-a"), newReloadServer(t, "server-b")
+	key := statelessContextKey(reloadCluster, "user-1")
+
+	// The clientset janitor runs for the life of the process; start it outside the labelled region.
+	k8cache.EvictClientsetsForCluster(reloadCluster + "-unused")
+
+	// The first watcher is held in discovery, so it shuts down only after its replacement has registered.
+	a.mu.Lock()
+	a.holdDiscovery = true
+	a.mu.Unlock()
+
+	pprof.Do(context.Background(), pprof.Labels("reload", "stale"), func(context.Context) {
+		reloadRequest(router, reloadKubeConfig(a.URL, tokenUser("t")), "user-1")
+		startWatcher(t, c, key)
+	})
+	<-a.discoveryHeld
+
+	reloadRequest(router, reloadKubeConfig(b.URL, tokenUser("t")), "user-1")
+	eventuallyOpen(t, b, 1, "the replacement's watcher must be running")
+
+	close(a.discoveryRelease)
+	require.Eventually(t, func() bool { return labelledGoroutines(t, "stale", "/backend/pkg/k8cache.") == 0 },
+		5*time.Second, 10*time.Millisecond, "the stale watcher must shut down")
+
+	// Had that shutdown removed the replacement's registration, this would start a second watcher.
+	pprof.Do(context.Background(), pprof.Labels("reload", "probe"), func(context.Context) {
+		startWatcher(t, c, key)
+	})
+	assert.Zero(t, labelledGoroutines(t, "probe", ""),
+		"the stale watcher shutting down must not remove the registration of its replacement")
+	assert.Equal(t, 1, b.openWatches())
+}
+
+func TestInFlightRequestDoesNotCacheResponseForReplacedConfiguration(t *testing.T) {
+	c, router := reloadChain(t)
+	a, b := newReloadServer(t, "server-a"), newReloadServer(t, "server-b")
+	key := statelessContextKey(reloadCluster, "user-1")
+
+	done := make(chan struct{})
+
+	go func() {
+		defer close(done)
+
+		reloadRequest(router, reloadKubeConfig(a.URL, tokenUser("t")), "user-1", holdHeader)
+	}()
+
+	<-a.held
+
+	// The replacement completes while the first request is still waiting on its cluster.
+	reloadRequest(router, reloadKubeConfig(b.URL, tokenUser("t")), "user-1")
+	close(a.release)
+	<-done
+
+	cacheKey, err := k8cache.GenerateKey(&url.URL{Path: "/clusters/" + reloadCluster + "/api/v1/pods"}, key)
+	require.NoError(t, err)
+
+	cached, err := k8sResponseCache.Get(context.Background(), cacheKey)
+	require.NoError(t, err, "the replacement's own response must be cached")
+	assert.Contains(t, cached, "server-b")
+	assert.NotContains(t, cached, "server-a", "a response received for the replaced configuration must not be cached")
+
+	stored, err := c.KubeConfigStore.GetContext(key)
+	require.NoError(t, err)
+	assert.Equal(t, b.URL, stored.Cluster.Server)
+}
+
+// pausingStore gives each context a request stores a cluster ID, so authorization builds and caches
+// clientsets for it. Once armed, it holds the next request after that request has applied its
+// kubeconfig and read the stored context back, as a busy server may preempt it before authorization.
+type pausingStore struct {
+	kubeconfig.ContextStore
+	mu             sync.Mutex
+	armed, applied bool
+	paused, resume chan struct{}
+	resumeOnce     sync.Once
+}
+
+func (s *pausingStore) setArmed(armed bool) {
+	s.mu.Lock()
+	s.armed, s.applied = armed, false
+	s.mu.Unlock()
+}
+
+func (s *pausingStore) markApplied() {
+	s.mu.Lock()
+	s.applied = true
+	s.mu.Unlock()
+}
+
+func (s *pausingStore) UpdateTTL(key string, ttl time.Duration) error {
+	defer s.markApplied()
+
+	return s.ContextStore.UpdateTTL(key, ttl)
+}
+
+func (s *pausingStore) AddContextWithKeyAndTTL(context *kubeconfig.Context, key string, ttl time.Duration) error {
+	defer s.markApplied()
+
+	context.ClusterID = "request+" + key
+
+	return s.ContextStore.AddContextWithKeyAndTTL(context, key, ttl)
+}
+
+func (s *pausingStore) GetContext(key string) (*kubeconfig.Context, error) {
+	stored, err := s.ContextStore.GetContext(key)
+
+	s.mu.Lock()
+	pause := s.armed && s.applied
+	s.armed = s.armed && !pause
+	s.mu.Unlock()
+
+	if pause {
+		close(s.paused)
+		<-s.resume
+	}
+
+	return stored, err
+}
+
+func (s *pausingStore) release() { s.resumeOnce.Do(func() { close(s.resume) }) }
+
+func TestRequestResumingAfterReplacementLeavesNoClientsetForLaterRequests(t *testing.T) {
+	c, router := reloadChain(t)
+	store := &pausingStore{ContextStore: c.KubeConfigStore, paused: make(chan struct{}), resume: make(chan struct{})}
+	c.KubeConfigStore = store
+	a, b := newReloadServer(t, "server-a"), newReloadServer(t, "server-b")
+	earlier, later := reloadKubeConfig(a.URL, tokenUser("t")), reloadKubeConfig(b.URL, tokenUser("t"))
+
+	reloadRequest(router, earlier, "user-1")
+
+	store.setArmed(true)
+
+	done := make(chan struct{})
+
+	go func() {
+		defer close(done)
+
+		reloadRequest(router, earlier, "user-1")
+	}()
+
+	select {
+	case <-store.paused:
+	case <-done:
+	}
+
+	store.setArmed(false)
+
+	// A request the cache passes straight through replaces the configuration without authorizing.
+	replaced := make(chan struct{})
+
+	go func() {
+		defer close(replaced)
+
+		reloadRequestWith(router, http.MethodGet, "/version", later, "user-1", nil)
+	}()
+
+	select {
+	case <-replaced:
+	case <-time.After(5 * time.Second): // the replacement waits for the held request instead
+	}
+
+	store.release()
+	<-replaced
+	<-done
+
+	reviewsA, reviewsB := a.reviews(), b.reviews()
+
+	reloadRequest(router, later, "user-1")
+
+	assert.Equal(t, reviewsA, a.reviews(),
+		"a clientset built for the replaced configuration must not authorize requests for the new one")
+	assert.Equal(t, reviewsB+1, b.reviews(), "requests for the new configuration must be authorized by its cluster")
+}
+
+func TestExpiredContextReplacedByLaterRequest(t *testing.T) {
+	c, router := reloadChain(t)
+	a, b := newReloadServer(t, "server-a"), newReloadServer(t, "server-b")
+	key := statelessContextKey(reloadCluster, "user-1")
+
+	earlier := reloadKubeConfig(a.URL, tokenUser("t"))
+	contexts, _, err := kubeconfig.LoadContextsFromBase64String(earlier, kubeconfig.DynamicCluster)
+	require.NoError(t, err)
+
+	// Stored the way a request stores it, with a lifetime short enough to lapse within the test.
+	previous := contexts[0]
+	previous.Internal = true
+	require.NoError(t, c.KubeConfigStore.AddContextWithKeyAndTTL(&previous, key, 50*time.Millisecond))
+	k8cache.CheckForChanges(k8sResponseCache, key, previous)
+	eventuallyOpen(t, a, 1, "a watcher must run against the earlier configuration")
+
+	builtFor := previous
+	builtFor.ClusterID = "kubeconfig+" + key
+	oldClientset, err := k8cache.GetClientSet(key, &builtFor, "token")
+	require.NoError(t, err)
+
+	cacheKey, err := k8cache.GenerateKey(&url.URL{Path: "/clusters/" + reloadCluster + "/api/v1/services"}, key)
+	require.NoError(t, err)
+	require.NoError(t, k8sResponseCache.Set(context.Background(), cacheKey, "response for the earlier configuration"))
+
+	require.Eventually(t, func() bool {
+		_, err := c.KubeConfigStore.GetContext(key)
+		return err != nil
+	}, 5*time.Second, 10*time.Millisecond, "the earlier context must have expired")
+
+	reloadRequest(router, reloadKubeConfig(b.URL, tokenUser("t")), "user-1")
+
+	eventuallyOpen(t, a, 0, "the watcher left from the expired configuration must be stopped")
+	eventuallyOpen(t, b, 1, "a watcher must run against the new configuration")
+
+	_, err = k8sResponseCache.Get(context.Background(), cacheKey)
+	assert.Error(t, err, "responses cached for the expired configuration must be evicted")
+
+	newClientset, err := k8cache.GetClientSet(key, &builtFor, "token")
+	require.NoError(t, err)
+	assert.NotSame(t, oldClientset, newClientset, "clientsets built for the expired configuration must be evicted")
+}
+
+// paddedKubeConfig is reloadKubeConfig plus n unused contexts, which makes it far slower to parse.
+func paddedKubeConfig(t *testing.T, server string, n int) string {
+	t.Helper()
+
+	raw, err := base64.StdEncoding.DecodeString(reloadKubeConfig(server, tokenUser("t")))
+	require.NoError(t, err)
+
+	var unused strings.Builder
+	for i := range n {
+		fmt.Fprintf(&unused, "- context:\n    cluster: %[1]s\n    user: %[1]s\n  name: unused-%[2]d\n", reloadCluster, i)
+	}
+
+	padded := strings.Replace(string(raw), "contexts:\n", "contexts:\n"+unused.String(), 1)
+
+	return base64.StdEncoding.EncodeToString([]byte(padded))
+}
+
+// await waits for ch, failing the test if it stays open.
+func await(t *testing.T, ch <-chan struct{}, msg string) {
+	t.Helper()
+
+	select {
+	case <-ch:
+	case <-time.After(10 * time.Second):
+		t.Fatal(msg)
+	}
+}
+
+// TestLaterRequestThatFailsToParseDoesNotSuppressEarlierValidRequest guards against reserving an
+// ordering position before a kubeconfig is known to be valid: a later request that never supplies
+// a configuration must not be able to block an earlier request that does.
+func TestLaterRequestThatFailsToParseDoesNotSuppressEarlierValidRequest(t *testing.T) {
+	c, router := reloadChain(t)
+	a, seeded := newReloadServer(t, "server-a"), newReloadServer(t, "server-c")
+	key := statelessContextKey(reloadCluster, "user-1")
+
+	// Establishes a configuration for the earlier request below to replace.
+	reloadRequest(router, reloadKubeConfig(seeded.URL, tokenUser("t")), "user-1")
+
+	earlier := paddedKubeConfig(t, a.URL, 3000)
+	done := make(chan struct{})
+
+	pprof.Do(context.Background(), pprof.Labels("reload", "earlierValid"), func(context.Context) {
+		go func() {
+			defer close(done)
+
+			reloadRequest(router, earlier, "user-1")
+		}()
+	})
+
+	// The later request is sent once the earlier one has arrived and is parsing its kubeconfig.
+	require.Eventually(t, func() bool {
+		return labelledGoroutines(t, "earlierValid", "kubeconfig.LoadContextsFromBase64String") > 0
+	}, 5*time.Second, time.Millisecond, "the earlier request must be observed parsing its kubeconfig")
+
+	// This KUBECONFIG header fails to decode: the request arrives later but supplies no configuration.
+	reloadRequest(router, "not-a-valid-base64-kubeconfig!!", "user-1")
+	<-done
+
+	stored, err := c.KubeConfigStore.GetContext(key)
+	require.NoError(t, err)
+	assert.Equal(t, a.URL, stored.Cluster.Server,
+		"a later request that fails to parse must not suppress an earlier request's valid configuration")
+	eventuallyOpen(t, a, 1, "a watcher must run against the earlier request's configuration")
+	eventuallyOpen(t, seeded, 0, "the watcher for the replaced configuration must be stopped")
+}
