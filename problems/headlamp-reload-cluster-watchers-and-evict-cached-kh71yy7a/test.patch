+func TestEveryKindOfRequestReplacesConfiguration(t *testing.T) {
+	const review = "/apis/authorization.k8s.io/v1/selfsubjectaccessreviews"
+
+	websocket := http.Header{}
+	websocket.Set("Connection", "Upgrade")
+	websocket.Set("Upgrade", "websocket")
+	websocket.Set("Sec-Websocket-Protocol", "base64url.headlamp.authorization.k8s.io.user-1")
+
+	for name, route := range map[string]struct {
+		method, path string
+		headers      http.Header
+	}{
+		"POST request":               {method: http.MethodPost, path: "/api/v1/pods"},
+		"self subject access review": {method: http.MethodPost, path: review},
+		"non-API path":               {method: http.MethodGet, path: "/version"},
+		"websocket upgrade":          {method: http.MethodGet, path: "/api/v1/pods", headers: websocket},
+	} {
+		t.Run(name, func(t *testing.T) {
+			c, router := reloadChain(t)
+			a, b := newReloadServer(t, "server-a"), newReloadServer(t, "server-b")
+			key := statelessContextKey(reloadCluster, "user-1")
+
+			reloadRequest(router, reloadKubeConfig(a.URL, tokenUser("t")), "user-1")
+			startWatcher(t, c, key)
+			eventuallyOpen(t, a, 1, "a watcher must run against the first configuration")
+
+			cacheKey := servedResponse(t, key)
+
+			// The only request after the first, so nothing else can start the new watcher.
+			reloadRequestWith(router, route.method, route.path, reloadKubeConfig(b.URL, tokenUser("t")), "user-1", route.headers)
+
+			stored, err := c.KubeConfigStore.GetContext(key)
+			require.NoError(t, err)
+			assert.Equal(t, b.URL, stored.Cluster.Server, "the request must replace the context")
+			eventuallyOpen(t, a, 0, "and stop the old watcher")
+			eventuallyOpen(t, b, 1, "and start one for the new configuration")
+
+			_, err = k8sResponseCache.Get(context.Background(), cacheKey)
+			assert.Error(t, err, "and evict the responses cached for the old configuration")
+		})
+	}
+}
