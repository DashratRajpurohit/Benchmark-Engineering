+func TestChannelCreateOnExitingTopicRejected(t *testing.T) {
+	skipUnlessEnabled(t)
+	for _, shutdown := range []bool{false, true} {
+		name := "topic being deleted"
+		if shutdown {
+			name = "nsqd shutting down"
+		}
+		t.Run(name, func(t *testing.T) {
+			_, httpAddr, n := startDeferredExitNSQD(t)
+
+			topicName := "test_deferred_exit_topic_" + strconv.Itoa(int(time.Now().UnixNano()))
+			topic := n.GetTopic(topicName)
+			finish := stallTopicExit(t, n, httpAddr, topicName, shutdown)
+
+			// The topic's lock is free while it exits, so creating the channel
+			// is answered before the exit finishes.
+			if shutdown {
+				// nsqd's HTTP server has already stopped; create the channel
+				// the way a SUB still being handled would.
+				created := make(chan *Channel, 1)
+				go func() { created <- callGetChannel(topic, "never-existed") }()
+				select {
+				case c := <-created:
+					if c != nil {
+						t.Fatalf("expected creating a channel on a topic of a shutting down " +
+							"nsqd to fail, got a channel")
+					}
+				case <-time.After(5 * time.Second):
+					t.Fatalf("creating a channel on a topic of a shutting down nsqd never returned")
+				}
+			} else {
+				code := postStatus(api(httpAddr, "/channel/create", "topic", topicName, "channel", "never-existed"), nil)
+				if code < 400 || code > 599 {
+					t.Fatalf("expected channel/create on a topic being deleted to fail with an "+
+						"HTTP error status while it is deleted, got %d (-1: no answer)", code)
+				}
+			}
+			requireNoChannel(t, topic, "never-existed")
+
+			finish()
+			requireNoChannel(t, topic, "never-existed")
+		})
+	}
+}
