+const runDeferredExitTestsEnv = "NSQ_RUN_DEFERRED_EXIT_TESTS"
+
+// holdDeletion is how long the SUB tests keep a deletion in progress: longer
+// than any short fixed retry.
+const holdDeletion = 520 * time.Millisecond
+
+func skipUnlessEnabled(t *testing.T) {
+	t.Helper()
+	if os.Getenv(runDeferredExitTestsEnv) == "" {
+		t.Skipf("set %s=1 to run", runDeferredExitTestsEnv)
+	}
+}
