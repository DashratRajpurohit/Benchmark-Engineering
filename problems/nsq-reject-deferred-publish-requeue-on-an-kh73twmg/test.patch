+// closeHold is a logger that holds the goroutine logging line until release
+// is closed, and passes every line on to next.
+type closeHold struct {
+	next    Logger
+	line    string
+	reached chan struct{}
+	release chan struct{}
+	once    sync.Once
+}
+
+func (h *closeHold) Output(maxdepth int, s string) error {
+	if strings.Contains(s, h.line) {
+		h.once.Do(func() { close(h.reached) })
+		<-h.release
+	}
+	return h.next.Output(maxdepth+1, s)
+}
+
+// pumpHold is a logger that holds a consumer's pump as it starts writing its
+// first message, which it has already taken and put in flight, until release
+// is closed. moved is closed once the pump then writes another message or
+// stops.
+type pumpHold struct {
+	next    Logger
+	started chan struct{}
+	release chan struct{}
+	moved   chan struct{}
+	writes  int32
+	once    sync.Once
+}
+
+func (h *pumpHold) Output(maxdepth int, s string) error {
+	switch {
+	case strings.Contains(s, "PROTOCOL(V2): writing msg("):
+		if atomic.AddInt32(&h.writes, 1) == 1 {
+			close(h.started)
+			<-h.release
+		} else {
+			h.once.Do(func() { close(h.moved) })
+		}
+	case strings.Contains(s, "exiting messagePump"):
+		h.once.Do(func() { close(h.moved) })
+	}
+	return h.next.Output(maxdepth+1, s)
+}
+
+// A message that a consumer's pump takes from a channel after the channel has
+// started closing, and so before the pump has put it in flight, is written out
+// by the close, never dropped. A deferred publish arriving meanwhile is
+// rejected.
+//
+// Each round holds the pump while it writes one message, holds Close once the
+// channel is exiting but before it disconnects the consumer, and then lets the
+// pump go on with a second message queued. The pump may take that message or
+// stop for the close; the rounds go on until it has taken it.
+func TestChannelCloseKeepsDequeuedMessage(t *testing.T) {
+	skipUnlessEnabled(t)
+	const rounds = 40
+	for i := 0; i < rounds; i++ {
+		if takenWhileClosing(t) {
+			return
+		}
+	}
+	t.Fatalf("in %d rounds the consumer never took a message from its channel after "+
+		"the channel started closing, so the overlap this test checks was not reached", rounds)
+}
+
+// takenWhileClosing reports whether the pump took the queued message while
+// the channel was closing.
+func takenWhileClosing(t *testing.T) bool {
+	t.Helper()
+	const channelName = "taken-while-closing"
+	pump := &pumpHold{
+		next:    lg.NilLogger{},
+		started: make(chan struct{}),
+		release: make(chan struct{}),
+		moved:   make(chan struct{}),
+	}
+	exit := &closeHold{
+		next:    pump,
+		line:    "CHANNEL(" + channelName + "): closing",
+		reached: make(chan struct{}),
+		release: make(chan struct{}),
+	}
+	opts := NewOptions()
+	opts.Logger = exit
+	opts.LogLevel = lg.DEBUG
+	tcpAddr, _, n := mustStartNSQD(opts)
+	t.Cleanup(func() { _ = os.RemoveAll(opts.DataPath) })
+	t.Cleanup(n.Exit)
+	var releasePump, releaseExit sync.Once
+	t.Cleanup(func() {
+		releasePump.Do(func() { close(pump.release) })
+		releaseExit.Do(func() { close(exit.release) })
+	})
+
+	topicName := "test_close_dequeued_" + strconv.Itoa(int(time.Now().UnixNano()))
+	topic := n.GetTopic(topicName)
+	channel := callGetChannel(topic, channelName)
+	msgs := []*Message{
+		NewMessage(topic.GenerateID(), []byte("delivering when the close starts")),
+		NewMessage(topic.GenerateID(), []byte("taken while closing")),
+	}
+	for _, msg := range msgs {
+		test.Nil(t, channel.PutMessage(msg))
+	}
+
+	conn, err := mustConnectNSQD(tcpAddr)
+	test.Nil(t, err)
+	t.Cleanup(func() { _ = conn.Close() })
+	_ = conn.SetDeadline(time.Now().Add(5 * time.Second))
+	identify(t, conn, nil, frameTypeResponse)
+	_, err = nsq.Subscribe(topicName, channelName).WriteTo(conn)
+	test.Nil(t, err)
+	readValidate(t, conn, frameTypeResponse, "OK")
+	// enough RDY that the pump goes on to the second message after the first
+	_, err = nsq.Ready(len(msgs) + 1).WriteTo(conn)
+	test.Nil(t, err)
+	select {
+	case <-pump.started:
+	case <-time.After(5 * time.Second):
+		t.Fatalf("the consumer's pump never started writing a message")
+	}
+
+	closed := make(chan error, 1)
+	go func() { closed <- channel.Close() }()
+	select {
+	case <-exit.reached:
+	case <-time.After(200 * time.Millisecond):
+		// this Close waits for the pump before logging that line
+		for deadline := time.Now().Add(5 * time.Second); !channel.Exiting(); time.Sleep(time.Millisecond) {
+			if time.Now().After(deadline) {
+				t.Fatalf("the channel never started closing")
+			}
+		}
+	}
+	deferredErr := make(chan error, 1)
+	go func() {
+		deferred := NewMessage(topic.GenerateID(), []byte("deferred while closing"))
+		deferredErr <- callPutMessageDeferred(channel, deferred, time.Minute)
+	}()
+	releasePump.Do(func() { close(pump.release) })
+	select {
+	case <-pump.moved:
+	case <-time.After(500 * time.Millisecond):
+	}
+	releaseExit.Do(func() { close(exit.release) })
+	select {
+	case err = <-closed:
+		test.Nil(t, err)
+	case <-time.After(5 * time.Second):
+		t.Fatalf("channel close never finished")
+	}
+	select {
+	case err = <-deferredErr:
+	case <-time.After(5 * time.Second):
+		t.Fatalf("a deferred publish to the closing channel never returned")
+	}
+	if err == nil {
+		t.Fatalf("expected a deferred publish to a closing channel to be rejected, " +
+			"just like PutMessage is")
+	}
+
+	got := requireDeliveredAfterRestart(t, n, topicName, channelName, msgs[0].ID, msgs[1].ID)
+	taken := 0
+	for _, msg := range msgs {
+		test.Equal(t, msg.Body, got[msg.ID].Body)
+		// a pump counts an attempt as it takes a message, so one taken before
+		// the close is on its second attempt after the restart
+		if got[msg.ID].Attempts > 1 {
+			taken++
+		}
+	}
+	return taken == len(msgs)
+}
+
+// Deleting a channel disconnects its consumers and finishes even while one
+// of them has stopped reading and nsqd is blocked writing to it: the
+// deletion closes that client's connection. The deleted channel then rejects
+// a deferred publish.
+func TestChannelDeleteDisconnectsStalledConsumer(t *testing.T) {
+	skipUnlessEnabled(t)
+	const (
+		channelName = "stalled"
+		messages    = 32
+		bodySize    = 1000 * 1000
+	)
+	opts := NewOptions()
+	opts.Logger = lg.NilLogger{}
+	// room to buffer every message, so nsqd only writes them to the
+	// connection when it flushes that buffer
+	opts.MaxOutputBufferSize = 40 << 20
+	tcpAddr, httpAddr, n := mustStartNSQD(opts)
+	t.Cleanup(func() { _ = os.RemoveAll(opts.DataPath) })
+	t.Cleanup(n.Exit)
+
+	topicName := "test_delete_stalled_" + strconv.Itoa(int(time.Now().UnixNano()))
+	topic := n.GetTopic(topicName)
+	channel := callGetChannel(topic, channelName)
+	body := []byte(strings.Repeat("x", bodySize))
+	for i := 0; i < messages; i++ {
+		test.Nil(t, channel.PutMessage(NewMessage(topic.GenerateID(), body)))
+	}
+
+	conn, err := mustConnectNSQD(tcpAddr)
+	test.Nil(t, err)
+	// closing the connection unblocks nsqd if the deletion is stuck
+	t.Cleanup(func() { _ = conn.Close() })
+	if tc, ok := conn.(*net.TCPConn); ok {
+		_ = tc.SetReadBuffer(16 << 10)
+	}
+	_ = conn.SetDeadline(time.Now().Add(5 * time.Second))
+	// the longest heartbeat interval, which is also how long nsqd keeps
+	// trying to write to this client before giving up by itself
+	identify(t, conn, map[string]interface{}{
+		"heartbeat_interval": int(opts.MaxHeartbeatInterval / time.Millisecond),
+		"output_buffer_size": 40 << 20,
+	}, frameTypeResponse)
+	_, err = nsq.Subscribe(topicName, channelName).WriteTo(conn)
+	test.Nil(t, err)
+	readValidate(t, conn, frameTypeResponse, "OK")
+	_, err = nsq.Ready(messages + 1).WriteTo(conn)
+	test.Nil(t, err)
+
+	// The consumer's pump takes every message, then flushes them: far more
+	// than the connection holds while the consumer does not read, so that
+	// write blocks. The first byte to arrive shows it has started.
+	deadline := time.Now().Add(5 * time.Second)
+	for NewChannelStats(channel, nil, 0).InFlightCount != messages && time.Now().Before(deadline) {
+		time.Sleep(time.Millisecond)
+	}
+	test.Equal(t, messages, NewChannelStats(channel, nil, 0).InFlightCount)
+	_, err = io.ReadFull(conn, make([]byte, 1))
+	test.Nil(t, err)
+
+	deleted := make(chan int, 1)
+	go func() {
+		deleted <- postStatus(api(httpAddr, "/channel/delete", "topic", topicName, "channel", channelName), nil)
+	}()
+	select {
+	case code := <-deleted:
+		test.Equal(t, 200, code)
+	case <-time.After(5 * time.Second):
+		t.Fatalf("channel deletion never finished while a consumer had stopped reading")
+	}
+	_, err = topic.GetExistingChannel(channelName)
+	test.NotNil(t, err)
+	if callPutMessageDeferred(channel, NewMessage(topic.GenerateID(), []byte("late")), time.Minute) == nil {
+		t.Fatalf("expected a deferred publish to the deleted channel to be rejected, " +
+			"just like PutMessage is")
+	}
+}
