+// An ephemeral channel is deleted once its last consumer leaves, but only if
+// it is still unused when that deletion starts. Here the deletion is held, if
+// it logs the line below, while another consumer subscribes: that consumer
+// either joins the channel, which then stays, or waits and ends up on the
+// channel that replaces it. Either way it stays subscribed and is delivered to.
+func TestSubDuringEphemeralChannelCleanupStaysSubscribed(t *testing.T) {
+	skipUnlessEnabled(t)
+	topicName := "test_ephemeral_cleanup_" + strconv.Itoa(int(time.Now().UnixNano()))
+	const channelName = "consumers#ephemeral"
+	cleanup := &closeHold{
+		next:    lg.NilLogger{},
+		line:    "TOPIC(" + topicName + "): deleting channel " + channelName,
+		reached: make(chan struct{}),
+		release: make(chan struct{}),
+	}
+	opts := NewOptions()
+	opts.Logger = cleanup
+	tcpAddr, httpAddr, n := mustStartNSQD(opts)
+	t.Cleanup(func() { _ = os.RemoveAll(opts.DataPath) })
+	t.Cleanup(n.Exit)
+	var release sync.Once
+	releaseCleanup := func() { release.Do(func() { close(cleanup.release) }) }
+	t.Cleanup(releaseCleanup)
+
+	first := subscribeReady(t, tcpAddr, topicName, channelName)
+	test.Nil(t, first.Close())
+	select {
+	case <-cleanup.reached:
+	case <-time.After(5 * time.Second):
+		// a deletion that does not log this line is not held
+	}
+
+	second := startSubscribe(t, tcpAddr, topicName, channelName, true)
+	answered := make(chan error, 1)
+	go func() {
+		_ = second.SetReadDeadline(time.Now().Add(holdDeletion + 5*time.Second))
+		resp, err := nsq.ReadResponse(second)
+		if err == nil {
+			frameType, data, _ := nsq.UnpackResponse(resp)
+			if frameType != frameTypeResponse || string(data) != "OK" {
+				err = fmt.Errorf("got frame type %d data %q", frameType, data)
+			}
+		}
+		answered <- err
+	}()
+	var err error
+	select {
+	case err = <-answered:
+		releaseCleanup()
+	case <-time.After(holdDeletion):
+		// the SUB is waiting for the deletion to finish
+		releaseCleanup()
+		err = <-answered
+	}
+	if err != nil {
+		t.Fatalf("expected a SUB to an ephemeral channel whose last consumer just left "+
+			"to complete (%s)", err)
+	}
+
+	const failure = "a consumer that subscribed to an ephemeral channel as its last " +
+		"consumer left was disconnected by the channel's automatic deletion"
+	for _, body := range []string{"after-cleanup", "after-cleanup-again"} {
+		test.Equal(t, 200, postStatus(api(httpAddr, "/pub", "topic", topicName), strings.NewReader(body)))
+		receiveAndFinish(t, second, body, failure)
+	}
+}
+
+// An ephemeral topic is deleted once its last channel goes, but only if it
+// is still unused when that deletion starts. Each round deletes a topic's
+// only channel and at once creates another one: either the topic's deletion
+// has already started, and the new channel is refused, or the topic stays,
+// with the new channel and the message queued on it. A topic whose deletion
+// always starts first never has a channel to lose.
+func TestChannelCreatedDuringEphemeralTopicCleanupIsKept(t *testing.T) {
+	skipUnlessEnabled(t)
+	tcpAddr, _, n := startDeferredExitNSQD(t)
+	const rounds = 20
+	for i := 0; i < rounds; i++ {
+		topicName := "test_eph_cleanup_" + strconv.Itoa(int(time.Now().UnixNano())) + "#ephemeral"
+		topic := n.GetTopic(topicName)
+		test.NotNil(t, callGetChannel(topic, "first"))
+		test.Nil(t, topic.DeleteExistingChannel("first"))
+		channel := callGetChannel(topic, "second")
+		if channel == nil {
+			continue
+		}
+
+		const failure = "a channel created on an ephemeral topic as the topic lost its " +
+			"last channel was deleted by the topic's automatic deletion"
+		if err := channel.PutMessage(NewMessage(topic.GenerateID(), []byte("queued"))); err != nil {
+			t.Fatalf("%s: a message put on it was rejected (%s)", failure, err)
+		}
+		conn := subscribeReady(t, tcpAddr, topicName, "second")
+		receiveAndFinish(t, conn, "queued", failure)
+		return
+	}
+	t.Logf("in %d rounds the topic's deletion always started before the new channel "+
+		"was created, so no channel was created on a topic being deleted", rounds)
+}
