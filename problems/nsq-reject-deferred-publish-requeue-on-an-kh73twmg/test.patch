+func requireNoChannel(t *testing.T, topic *Topic, name string) {
+	t.Helper()
+	if _, err := topic.GetExistingChannel(name); err == nil {
+		t.Fatalf("channel %q was created on topic %s after it started exiting; "+
+			"nothing will ever close, flush or feed it", name, topic.name)
+	}
+}
