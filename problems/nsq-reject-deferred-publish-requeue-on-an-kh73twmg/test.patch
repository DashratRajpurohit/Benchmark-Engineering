+// deletionHolder is a consumer whose Close blocks until released. Deleting
+// or closing a channel closes each of its consumers first, so attaching one
+// holds that in progress for as long as the test needs.
+type deletionHolder struct {
+	closing     chan struct{}
+	release     chan struct{}
+	closingOnce sync.Once
+	releaseOnce sync.Once
+}
+
+func newDeletionHolder() *deletionHolder {
+	return &deletionHolder{closing: make(chan struct{}), release: make(chan struct{})}
+}
+
+func (h *deletionHolder) UnPause()                 {}
+func (h *deletionHolder) Pause()                   {}
+func (h *deletionHolder) TimedOutMessage()         {}
+func (h *deletionHolder) Empty()                   {}
+func (h *deletionHolder) Stats(string) ClientStats { return nil }
+func (h *deletionHolder) Close() error {
+	h.closingOnce.Do(func() { close(h.closing) })
+	<-h.release
+	return nil
+}
+func (h *deletionHolder) Release() { h.releaseOnce.Do(func() { close(h.release) }) }
+
+func (h *deletionHolder) awaitClosing(t *testing.T, what string) {
+	t.Helper()
+	select {
+	case <-h.closing:
+	case <-time.After(5 * time.Second):
+		t.Fatalf("%s never started", what)
+	}
+}
+
+// inBackground runs fn, which h may hold up, on its own goroutine. When the
+// test ends, before nsqd shuts down, h is released and fn is given up to two
+// seconds to return.
+func inBackground(t *testing.T, h *deletionHolder, fn func()) {
+	done := make(chan struct{})
+	go func() {
+		defer close(done)
+		fn()
+	}()
+	t.Cleanup(func() {
+		h.Release()
+		select {
+		case <-done:
+		case <-time.After(2 * time.Second):
+		}
+	})
+}
+
+func api(httpAddr net.Addr, path string, query ...string) string {
+	v := url.Values{}
+	for i := 0; i+1 < len(query); i += 2 {
+		v.Set(query[i], query[i+1])
+	}
+	return fmt.Sprintf("http://%s%s?%s", httpAddr, path, v.Encode())
+}
+
+var httpClient = &http.Client{Timeout: 10 * time.Second}
+
+func postStatus(url string, body io.Reader) int {
+	resp, err := httpClient.Post(url, "application/octet-stream", body)
+	if err != nil {
+		return -1
+	}
+	_ = resp.Body.Close()
+	return resp.StatusCode
+}
+
+func subscribeReady(t *testing.T, tcpAddr net.Addr, topicName, channelName string) net.Conn {
+	t.Helper()
+	conn, err := mustConnectNSQD(tcpAddr)
+	test.Nil(t, err)
+	t.Cleanup(func() { _ = conn.Close() })
+	_ = conn.SetDeadline(time.Now().Add(5 * time.Second))
+	identify(t, conn, nil, frameTypeResponse)
+	_, err = nsq.Subscribe(topicName, channelName).WriteTo(conn)
+	test.Nil(t, err)
+	resp, err := nsq.ReadResponse(conn)
+	if err != nil {
+		t.Fatalf("SUB to %s/%s did not complete (%s)", topicName, channelName, err)
+	}
+	frameType, data, _ := nsq.UnpackResponse(resp)
+	if frameType != frameTypeResponse || string(data) != "OK" {
+		t.Fatalf("SUB to %s/%s got frame type %d data %q", topicName, channelName, frameType, data)
+	}
+	_, err = nsq.Ready(1).WriteTo(conn)
+	test.Nil(t, err)
+	return conn
+}
+
+func startSubscribe(t *testing.T, tcpAddr net.Addr, topicName, channelName string, ready bool) net.Conn {
+	t.Helper()
+	conn, err := mustConnectNSQD(tcpAddr)
+	test.Nil(t, err)
+	t.Cleanup(func() { _ = conn.Close() })
+	identify(t, conn, nil, frameTypeResponse)
+	_, err = nsq.Subscribe(topicName, channelName).WriteTo(conn)
+	test.Nil(t, err)
+	if ready {
+		_, err = nsq.Ready(1).WriteTo(conn)
+		test.Nil(t, err)
+	}
+	return conn
+}
+
+func requireSubscribed(t *testing.T, conn net.Conn, what string) {
+	t.Helper()
+	_ = conn.SetReadDeadline(time.Now().Add(5 * time.Second))
+	resp, err := nsq.ReadResponse(conn)
+	if err != nil {
+		t.Fatalf("expected a SUB racing %s to end up subscribed to the replacement (%s)", what, err)
+	}
+	frameType, data, _ := nsq.UnpackResponse(resp)
+	if frameType != frameTypeResponse || string(data) != "OK" {
+		t.Fatalf("expected a SUB racing %s to end up subscribed to the replacement, "+
+			"got frame type %d data %q", what, frameType, data)
+	}
+}
+
+func receiveBody(t *testing.T, conn net.Conn, body string) {
+	t.Helper()
+	_ = conn.SetReadDeadline(time.Now().Add(5 * time.Second))
+	resp, err := nsq.ReadResponse(conn)
+	if err != nil {
+		t.Fatalf("message %q never arrived (%s)", body, err)
+	}
+	frameType, data, _ := nsq.UnpackResponse(resp)
+	test.Equal(t, frameTypeMessage, frameType)
+	msg, err := decodeMessage(data)
+	test.Nil(t, err)
+	test.Equal(t, []byte(body), msg.Body)
+}
+
+func TestSubRacingTopicDeletionLandsOnReplacement(t *testing.T) {
+	skipUnlessEnabled(t)
+	tcpAddr, httpAddr, n := startDeferredExitNSQD(t)
+
+	topicName := "test_deferred_exit_resub_" + strconv.Itoa(int(time.Now().UnixNano()))
+	holder := newDeletionHolder()
+	test.Nil(t, callGetChannel(n.GetTopic(topicName), "holder").AddClient(1000, holder))
+
+	deleted := make(chan int, 1)
+	inBackground(t, holder, func() {
+		deleted <- postStatus(api(httpAddr, "/topic/delete", "topic", topicName), nil)
+	})
+	holder.awaitClosing(t, "topic deletion")
+
+	conn := startSubscribe(t, tcpAddr, topicName, "late", false)
+
+	time.Sleep(holdDeletion)
+	holder.Release()
+	select {
+	case code := <-deleted:
+		test.Equal(t, 200, code)
+	case <-time.After(5 * time.Second):
+		t.Fatalf("topic deletion never finished")
+	}
+
+	requireSubscribed(t, conn, "a topic deletion")
+	_, err := nsq.Ready(1).WriteTo(conn)
+	test.Nil(t, err)
+
+	test.Equal(t, 200, postStatus(api(httpAddr, "/pub", "topic", topicName), strings.NewReader("after-delete")))
+	receiveBody(t, conn, "after-delete")
+}
+
+// stallTopicExit starts deleting topicName, or with shutdown shuts n down,
+// and holds that in progress, with the topic already exiting but its lock
+// free, until finish is called: the topic's message pump is stuck delivering
+// to a channel whose own deletion is blocked.
+func stallTopicExit(t *testing.T, n *NSQD, httpAddr net.Addr, topicName string, shutdown bool) (finish func()) {
+	t.Helper()
+	topic := n.GetTopic(topicName)
+	holder := newDeletionHolder()
+	test.Nil(t, callGetChannel(topic, "held").AddClient(1000, holder))
+
+	channelDeleted := make(chan int, 1)
+	inBackground(t, holder, func() {
+		channelDeleted <- postStatus(api(httpAddr, "/channel/delete", "topic", topicName, "channel", "held"), nil)
+	})
+	holder.awaitClosing(t, "channel deletion")
+
+	// Once the topic's pump has taken this message it cannot return to
+	// noticing the topic's exit until "held" accepts or rejects it.
+	test.Equal(t, 200, postStatus(api(httpAddr, "/pub", "topic", topicName), strings.NewReader("stuck")))
+	deadline := time.Now().Add(5 * time.Second)
+	for topic.Depth() != 0 {
+		if time.Now().After(deadline) {
+			t.Fatalf("topic pump never picked up the message")
+		}
+		time.Sleep(time.Millisecond)
+	}
+
+	topicExited := make(chan error, 1)
+	inBackground(t, holder, func() {
+		if shutdown {
+			n.Exit()
+			topicExited <- nil
+			return
+		}
+		if code := postStatus(api(httpAddr, "/topic/delete", "topic", topicName), nil); code != 200 {
+			topicExited <- fmt.Errorf("topic/delete returned %d", code)
+			return
+		}
+		topicExited <- nil
+	})
+	for !topic.Exiting() {
+		if time.Now().After(deadline) {
+			t.Fatalf("topic exit never started")
+		}
+		time.Sleep(time.Millisecond)
+	}
+
+	return func() {
+		holder.Release()
+		select {
+		case code := <-channelDeleted:
+			test.Equal(t, 200, code)
+		case <-time.After(5 * time.Second):
+			t.Fatalf("channel deletion never finished")
+		}
+		select {
+		case err := <-topicExited:
+			test.Nil(t, err)
+		case <-time.After(5 * time.Second):
+			t.Fatalf("topic deletion or nsqd shutdown never finished")
+		}
+	}
+}
