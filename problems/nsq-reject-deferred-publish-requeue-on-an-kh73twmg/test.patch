+// A client that subscribes to a channel whose deletion failed, leaving it in
+// place with nothing to replace it, gets an error instead of waiting, whether
+// the SUB arrives while that deletion is in progress or after it has failed.
+// The channel left in place is exiting, so it also rejects a deferred
+// publish.
+func TestSubToChannelWhoseDeletionFailedIsAnswered(t *testing.T) {
+	skipUnlessEnabled(t)
+	for _, during := range []bool{false, true} {
+		name := "after the deletion failed"
+		if during {
+			name = "while the deletion is failing"
+		}
+		t.Run(name, func(t *testing.T) {
+			opts := NewOptions()
+			opts.Logger = lg.NilLogger{}
+			tcpAddr, httpAddr, n := mustStartNSQD(opts)
+			// A SUB left waiting inside nsqd would also hold up its shutdown;
+			// give up on that after five seconds so only this test fails.
+			t.Cleanup(func() {
+				exited := make(chan struct{})
+				go func() {
+					n.Exit()
+					close(exited)
+				}()
+				select {
+				case <-exited:
+					_ = os.RemoveAll(opts.DataPath)
+				case <-time.After(5 * time.Second):
+				}
+			})
+			topicName := "test_deferred_exit_undeletable_" + strconv.Itoa(int(time.Now().UnixNano()))
+			const channelName = "undeletable"
+			channel := callGetChannel(n.GetTopic(topicName), channelName)
+			test.NotNil(t, channel)
+
+			// A non-empty directory stands where the channel's queue keeps its
+			// metadata file, so emptying the queue, and with it the deletion,
+			// fails.
+			meta := filepath.Join(n.getOpts().DataPath, getBackendName(topicName, channelName)+".diskqueue.meta.dat")
+			_ = os.Remove(meta)
+			test.Nil(t, os.MkdirAll(filepath.Join(meta, "keep"), 0o755))
+			t.Cleanup(func() { _ = os.RemoveAll(meta) })
+
+			holder := newDeletionHolder()
+			if during {
+				test.Nil(t, channel.AddClient(1000, holder))
+			}
+			deleted := make(chan int, 1)
+			inBackground(t, holder, func() {
+				deleted <- postStatus(api(httpAddr, "/channel/delete", "topic", topicName, "channel", channelName), nil)
+			})
+			var conn net.Conn
+			if during {
+				holder.awaitClosing(t, "channel deletion")
+				conn = startSubscribe(t, tcpAddr, topicName, channelName, false)
+				time.Sleep(holdDeletion)
+				holder.Release()
+			}
+			var code int
+			select {
+			case code = <-deleted:
+			case <-time.After(5 * time.Second):
+				t.Fatalf("channel deletion never finished")
+			}
+			if callPutMessageDeferred(channel, NewMessage(n.GetTopic(topicName).GenerateID(), []byte("late")), time.Minute) == nil {
+				t.Fatalf("expected a deferred publish to a channel whose deletion was "+
+					"attempted (status %d) to be rejected, just like PutMessage is", code)
+			}
+			if !during {
+				conn = startSubscribe(t, tcpAddr, topicName, channelName, false)
+			}
+
+			_ = conn.SetReadDeadline(time.Now().Add(5 * time.Second))
+			resp, err := nsq.ReadResponse(conn)
+			if err != nil {
+				t.Fatalf("a SUB to a channel whose deletion failed (status %d) got no answer: "+
+					"the client was left waiting for a replacement that never comes (%s)", code, err)
+			}
+			frameType, data, _ := nsq.UnpackResponse(resp)
+			if frameType == frameTypeError {
+				return
+			}
+			if code != 200 {
+				t.Fatalf("a SUB to a channel whose deletion failed (status %d) got frame type %d "+
+					"data %q instead of an error: nothing replaces that channel", code, frameType, data)
+			}
+			// the deletion did go through, so the SUB may be on a replacement,
+			// which must deliver
+			if frameType != frameTypeResponse || string(data) != "OK" {
+				t.Fatalf("a SUB to a channel whose deletion failed got frame type %d data %q", frameType, data)
+			}
+			_, err = nsq.Ready(1).WriteTo(conn)
+			test.Nil(t, err)
+			test.Equal(t, 200, postStatus(api(httpAddr, "/pub", "topic", topicName), strings.NewReader("after-failed-delete")))
+			receiveBody(t, conn, "after-failed-delete")
+		})
+	}
+}
