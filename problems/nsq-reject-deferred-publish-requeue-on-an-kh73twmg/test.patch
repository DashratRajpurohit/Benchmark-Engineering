+func mustSetupDeferredExitChannel(t *testing.T) (*NSQD, *Topic, *Channel) {
+	t.Helper()
+	opts := NewOptions()
+	opts.Logger = test.NewTestLogger(t)
+	_, _, n := mustStartNSQD(opts)
+	t.Cleanup(func() { _ = os.RemoveAll(opts.DataPath) })
+	t.Cleanup(n.Exit)
+
+	topicName := "test_deferred_exit_race_" + strconv.Itoa(int(time.Now().UnixNano()))
+	topic := n.GetTopic(topicName)
+	channel := callGetChannel(topic, "ch")
+	return n, topic, channel
+}
+
+func startDeferredExitNSQD(t *testing.T) (net.Addr, net.Addr, *NSQD) {
+	t.Helper()
+	opts := NewOptions()
+	// Client goroutines can log after the test returns; t.Log would panic.
+	opts.Logger = lg.NilLogger{}
+	tcpAddr, httpAddr, n := mustStartNSQD(opts)
+	t.Cleanup(func() { _ = os.RemoveAll(opts.DataPath) })
+	t.Cleanup(n.Exit)
+	return tcpAddr, httpAddr, n
+}
+
+// Topic.GetChannel may return the channel alone or with an error; a nil
+// channel means it could not be created.
+func callGetChannel(t *Topic, name string) *Channel {
+	results := reflect.ValueOf(t.GetChannel).Call([]reflect.Value{reflect.ValueOf(name)})
+	return results[0].Interface().(*Channel)
+}
+
+var deferDelays = []time.Duration{30 * time.Millisecond, 250 * time.Millisecond, 5 * time.Second}
+
+// Channel.PutMessageDeferred may or may not return an error; returning none
+// counts as accepting the message.
+func callPutMessageDeferred(c *Channel, msg *Message, timeout time.Duration) error {
+	results := reflect.ValueOf(c.PutMessageDeferred).Call([]reflect.Value{
+		reflect.ValueOf(msg), reflect.ValueOf(timeout),
+	})
+	if len(results) == 0 || results[0].IsNil() {
+		return nil
+	}
+	return results[0].Interface().(error)
+}
+
+func deferredCount(c *Channel) int {
+	return NewChannelStats(c, nil, 0).DeferredCount
+}
+
+func requireNothingDeferred(t *testing.T, c *Channel, call string) {
+	t.Helper()
+	if got := deferredCount(c); got != 0 {
+		t.Fatalf("%s was rejected but left %d message(s) deferred on the exiting "+
+			"channel, which are never flushed or delivered", call, got)
+	}
+}
+
+// Close writes every message a channel still holds to its backend, so an nsqd
+// restarted on the same data path delivers them.
+func requireDeliveredAfterRestart(t *testing.T, n *NSQD, topicName, channelName string, ids ...MessageID) map[MessageID]*Message {
+	t.Helper()
+	n.Exit()
+	opts := NewOptions()
+	opts.Logger = test.NewTestLogger(t)
+	opts.DataPath = n.getOpts().DataPath
+	tcpAddr, _, restarted := mustStartNSQD(opts)
+	t.Cleanup(restarted.Exit)
+
+	conn, err := mustConnectNSQD(tcpAddr)
+	test.Nil(t, err)
+	t.Cleanup(func() { _ = conn.Close() })
+	_ = conn.SetDeadline(time.Now().Add(5 * time.Second))
+	identify(t, conn, nil, frameTypeResponse)
+	_, err = nsq.Subscribe(topicName, channelName).WriteTo(conn)
+	test.Nil(t, err)
+	readValidate(t, conn, frameTypeResponse, "OK")
+	// finish each message as it arrives, so more can follow than one RDY
+	// count allows in flight
+	ready := len(ids)
+	if limit := int(opts.MaxRdyCount); ready > limit {
+		ready = limit
+	}
+	_, err = nsq.Ready(ready).WriteTo(conn)
+	test.Nil(t, err)
+
+	want := make(map[MessageID]bool, len(ids))
+	for _, id := range ids {
+		want[id] = true
+	}
+	got := make(map[MessageID]*Message, len(ids))
+	for range ids {
+		resp, err := nsq.ReadResponse(conn)
+		if err != nil {
+			t.Fatalf("after a restart, %s/%s delivered %d of the %d messages it held "+
+				"when it was closed; the rest were lost (%s)",
+				topicName, channelName, len(ids)-len(want), len(ids), err)
+		}
+		frameType, data, _ := nsq.UnpackResponse(resp)
+		test.Equal(t, frameTypeMessage, frameType)
+		msg, err := decodeMessage(data)
+		test.Nil(t, err)
+		if !want[msg.ID] {
+			t.Fatalf("after a restart, %s/%s delivered unexpected message %s", topicName, channelName, msg.ID)
+		}
+		delete(want, msg.ID)
+		got[msg.ID] = msg
+		_, err = nsq.Finish(nsq.MessageID(msg.ID)).WriteTo(conn)
+		test.Nil(t, err)
+	}
+	return got
+}
+
+// holdExit is how long the "while" cases below keep a channel's Close or
+// Delete in progress. It only bounds how long a correct call waits: a call
+// that is rejected, whether at once or once the exit finishes, passes either
+// way.
+const holdExit = 100 * time.Millisecond
+
+// channelExit is a way a channel stops taking messages, Close (as at
+// shutdown) or Delete, checked once it has returned or while it is still in
+// progress: the channel is already exiting but not yet flushed or emptied.
+type channelExit struct {
+	name   string
+	delete bool
+	during bool
+}
+
+var (
+	closeExits  = []channelExit{{"after close", false, false}, {"while closing", false, true}}
+	deleteExits = []channelExit{{"after delete", true, false}, {"while deleting", true, true}}
+	// inFlightExits leaves out "after delete": Delete has emptied the
+	// in-flight messages by then, so none is left to re-register.
+	inFlightExits = []channelExit{closeExits[0], closeExits[1], deleteExits[1]}
+)
+
+// start closes or deletes c. In an "after" case it returns once that has
+// finished. In a "while" case it returns as soon as c is exiting, with the
+// exit held by a consumer whose Close blocks for holdExit; finish then waits
+// for the exit to complete.
+func (e channelExit) start(t *testing.T, c *Channel) (finish func()) {
+	t.Helper()
+	exit := c.Close
+	if e.delete {
+		exit = c.Delete
+	}
+	if !e.during {
+		test.Nil(t, exit())
+		return func() {}
+	}
+	holder := newDeletionHolder()
+	test.Nil(t, c.AddClient(1000, holder))
+	exited := make(chan error, 1)
+	inBackground(t, holder, func() { exited <- exit() })
+	holder.awaitClosing(t, "channel exit")
+	time.AfterFunc(holdExit, holder.Release)
+	return func() {
+		t.Helper()
+		select {
+		case err := <-exited:
+			test.Nil(t, err)
+		case <-time.After(5 * time.Second):
+			t.Fatalf("channel exit never finished")
+		}
+	}
+}
+
+func TestPutMessageDeferredAfterCloseRejected(t *testing.T) {
+	skipUnlessEnabled(t)
+	testPutMessageDeferredRejected(t, closeExits)
+}
+
+func TestPutMessageDeferredAfterDeleteRejected(t *testing.T) {
+	skipUnlessEnabled(t)
+	testPutMessageDeferredRejected(t, deleteExits)
+}
+
+func testPutMessageDeferredRejected(t *testing.T, exits []channelExit) {
+	for _, e := range exits {
+		t.Run(e.name, func(t *testing.T) {
+			for _, d := range deferDelays {
+				_, topic, channel := mustSetupDeferredExitChannel(t)
+
+				finish := e.start(t, channel)
+				err := callPutMessageDeferred(channel, NewMessage(topic.GenerateID(), []byte("deferred")), d)
+				finish()
+
+				if err := channel.PutMessage(NewMessage(topic.GenerateID(), []byte("fresh"))); err == nil {
+					t.Fatalf("expected PutMessage to reject %s", e.name)
+				}
+				if err == nil {
+					t.Fatalf("expected PutMessageDeferred(%v) to reject %s, just like "+
+						"PutMessage does -- a message accepted here is never written to "+
+						"backend or delivered", d, e.name)
+				}
+				requireNothingDeferred(t, channel, "PutMessageDeferred")
+			}
+			if e.during && !e.delete {
+				raceDeferredPublishesWithClose(t)
+			}
+		})
+	}
+}
+
+// raceDeferredPublishesWithClose closes a channel while publishers keep
+// making deferred publishes to it, until one is rejected: each accepted
+// publish must be among the messages Close writes out.
+func raceDeferredPublishesWithClose(t *testing.T) {
+	t.Helper()
+	const (
+		publishers   = 32
+		perPublisher = 100
+	)
+	for round := 0; round < 20; round++ {
+		n, topic, channel := mustSetupDeferredExitChannel(t)
+
+		start := make(chan struct{})
+		accepted := make(chan MessageID, publishers*perPublisher)
+		publishing := make(chan struct{}, publishers*perPublisher)
+		var wg sync.WaitGroup
+		for i := 0; i < publishers; i++ {
+			wg.Add(1)
+			go func() {
+				defer wg.Done()
+				<-start
+				for j := 0; j < perPublisher; j++ {
+					msg := NewMessage(topic.GenerateID(), []byte("racing"))
+					if callPutMessageDeferred(channel, msg, time.Minute) != nil {
+						return
+					}
+					accepted <- msg.ID
+					publishing <- struct{}{}
+				}
+			}()
+		}
+		closed := make(chan error, 1)
+		go func() {
+			// close once every publisher is under way
+			for i := 0; i < publishers; i++ {
+				<-publishing
+			}
+			closed <- channel.Close()
+		}()
+		close(start)
+		wg.Wait()
+		select {
+		case err := <-closed:
+			test.Nil(t, err)
+		case <-time.After(5 * time.Second):
+			t.Fatalf("channel close never finished")
+		}
+		close(accepted)
+
+		var ids []MessageID
+		for id := range accepted {
+			ids = append(ids, id)
+		}
+		requireDeliveredAfterRestart(t, n, topic.name, "ch", ids...)
+	}
+}
+
+func TestRequeueMessageDeferredAfterCloseRejected(t *testing.T) {
+	skipUnlessEnabled(t)
+	for _, e := range inFlightExits {
+		t.Run(e.name, func(t *testing.T) {
+			for _, d := range deferDelays {
+				n, topic, channel := mustSetupDeferredExitChannel(t)
+
+				const clientID = int64(7)
+				deferred := NewMessage(topic.GenerateID(), []byte("deferred"))
+				test.Nil(t, channel.StartInFlightTimeout(deferred, clientID, time.Minute))
+				immediate := NewMessage(topic.GenerateID(), []byte("immediate"))
+				test.Nil(t, channel.StartInFlightTimeout(immediate, clientID, time.Minute))
+
+				finish := e.start(t, channel)
+				errDeferred := channel.RequeueMessage(clientID, deferred.ID, d)
+				errImmediate := channel.RequeueMessage(clientID, immediate.ID, 0)
+				finish()
+
+				if errImmediate == nil {
+					t.Fatalf("expected an immediate requeue to reject %s", e.name)
+				}
+				if errDeferred == nil {
+					t.Fatalf("expected a deferred requeue (%v) to reject %s, just like an "+
+						"immediate requeue does", d, e.name)
+				}
+				requireNothingDeferred(t, channel, "a deferred requeue")
+				if !e.delete {
+					// both messages were still in flight, so Close persisted them
+					requireDeliveredAfterRestart(t, n, topic.name, "ch", deferred.ID, immediate.ID)
+				}
+			}
+		})
+	}
+}
