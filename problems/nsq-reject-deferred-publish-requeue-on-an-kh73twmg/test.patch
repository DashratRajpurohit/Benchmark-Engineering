+// receiveAndFinish reads the next message on conn, which must have body, and
+// finishes it.
+func receiveAndFinish(t *testing.T, conn net.Conn, body, failure string) {
+	t.Helper()
+	_ = conn.SetReadDeadline(time.Now().Add(5 * time.Second))
+	resp, err := nsq.ReadResponse(conn)
+	if err != nil {
+		t.Fatalf("%s: message %q never arrived (%s)", failure, body, err)
+	}
+	frameType, data, _ := nsq.UnpackResponse(resp)
+	test.Equal(t, frameTypeMessage, frameType)
+	msg, err := decodeMessage(data)
+	test.Nil(t, err)
+	test.Equal(t, []byte(body), msg.Body)
+	_, err = nsq.Finish(nsq.MessageID(msg.ID)).WriteTo(conn)
+	test.Nil(t, err)
+}
