+	"a4": {"apple", "berry"}, "a5": {"apple", "berry"},
+	"a6": {"berry"}, "a7": {"berry"}, "a8": {"cherry"},
+}
+
+var termDocsB = map[string][]string{
+	"b1": {"cherry"}, "b2": {"cherry"},
+	"b3": {"cherry", "berry"}, "b4": {"cherry", "berry"}, "b5": {"cherry", "berry"},
+	"b6": {"berry"}, "b7": {"apple"},
+}
+
+var termDocsC = map[string][]string{
+	"c1": {"apple"}, "c2": {"apple"}, "c3": {"apple"}, "c4": {"date"},
+}
+
+func mergeDocs(sets ...map[string][]string) map[string][]string {
+	rv := map[string][]string{}
+	for _, set := range sets {
+		for id, tags := range set {
+			rv[id] = tags
+		}
+	}
+	return rv
+}
+
+func termFacet(size int) *bleve.FacetRequest {
+	return bleve.NewFacetRequest("tag", size)
+}
+
+// An alias gives the same term facets as one index holding all the documents.
+func TestTermFacetAliasSameAsOneIndexBv28fee(t *testing.T) {
+	a := termIdxNew(t, termDocsA)
+	b := termIdxNew(t, termDocsB)
+	one := termIdxNew(t, mergeDocs(termDocsA, termDocsB))
+	alias := bleve.NewIndexAlias(a, b)
+	defer alias.Close()
+	checkSameFacets(t, alias, one, []int{1, 2, 3}, termFacet)
+}
+
+// The same holds when an alias contains another alias.
+func TestTermFacetNestedAliasSameAsOneIndexBv28fee(t *testing.T) {
+	a := termIdxNew(t, termDocsA)
+	b := termIdxNew(t, termDocsB)
+	c := termIdxNew(t, termDocsC)
+	one := termIdxNew(t, mergeDocs(termDocsA, termDocsB, termDocsC))
+	inner := bleve.NewIndexAlias(a, b)
+	outer := bleve.NewIndexAlias(inner, c)
+	defer outer.Close()
+	checkSameFacets(t, outer, one, []int{1, 2, 4}, termFacet)
+}
+
+// An alias gives the same datetime range facets as one index holding all the documents.
+func TestDateTimeFacetAliasSameAsOneIndexBv28fee(t *testing.T) {
+	year := func(y int) time.Time { return time.Date(y, 6, 1, 0, 0, 0, 0, time.UTC) }
+	idxA, cleanupA := newIdxNew(t)
+	defer cleanupA()
+	idxB, cleanupB := newIdxNew(t)
+	defer cleanupB()
+	one, cleanupOne := newIdxNew(t)
+	defer cleanupOne()
+
+	// "early" spans both indexes with 3 + 3, "mid" and "late" sit inside one
+	// index each with 4
+	add := func(idx bleve.Index, prefix string, y, n int) {
+		bOne := one.NewBatch()
+		b := idx.NewBatch()
+		for i := 0; i < n; i++ {
+			id := fmt.Sprintf("%s%d", prefix, i)
+			b.Index(id, map[string]interface{}{"when": year(y)})
+			bOne.Index(id, map[string]interface{}{"when": year(y)})
+		}
+		if err := idx.Batch(b); err != nil {
+			t.Fatal(err)
+		}
+		if err := one.Batch(bOne); err != nil {
+			t.Fatal(err)
+		}
+	}
+	add(idxA, "a_", 2001, 3)
+	add(idxA, "m_", 2011, 4)
+	add(idxB, "l_", 2021, 4)
+	add(idxB, "e_", 2002, 3)
+
+	alias := bleve.NewIndexAlias(idxA, idxB)
+	defer alias.Close()
+	checkSameFacets(t, alias, one, []int{1, 2, 3}, func(size int) *bleve.FacetRequest {
+		fr := bleve.NewFacetRequest("when", size)
+		fr.AddDateTimeRange("early", year(2000), year(2010))
+		fr.AddDateTimeRange("mid", year(2010), year(2020))
+		fr.AddDateTimeRange("late", year(2020), year(2030))
+		return fr
+	})
+}
+
+// A document with one value inside a range and another outside every range is
+// in that range, so it is not counted in Other.
+func TestNumericFacetPartlyInRangeIsNotOtherBv28fee(t *testing.T) {
+	idx, cleanup := newIdxNew(t)
+	defer cleanup()
+
+	b := idx.NewBatch()
+	b.Index("mixed", map[string]interface{}{"score": []interface{}{1.0, 999.0}})
+	b.Index("in", map[string]interface{}{"score": 2.0})
+	b.Index("out", map[string]interface{}{"score": 888.0})
+	if err := idx.Batch(b); err != nil {
+		t.Fatal(err)
+	}
+
+	fr := numFacetNew(t, idx, 10, map[string][2]float64{"low": {0, 5}})
+	if got := numCountNew(t, fr, "low"); got != 2 {
+		t.Errorf("range low: got count %d, want 2", got)
+	}
+	if fr.Total != 3 {
+		t.Errorf("total: got %d, want 3", fr.Total)
+	}
+	if fr.Other != 1 {
+		t.Errorf("other: got %d, want 1 (only the document with no value in a range)", fr.Other)
+	}
+}
+
+// Same as above for dates.
+func TestDateTimeFacetPartlyInRangeIsNotOtherBv28fee(t *testing.T) {
+	year := func(y int) time.Time { return time.Date(y, 6, 1, 0, 0, 0, 0, time.UTC) }
+	idx, cleanup := newIdxNew(t)
+	defer cleanup()
+
+	b := idx.NewBatch()
+	b.Index("mixed", map[string]interface{}{"when": []interface{}{year(2001), year(2050)}})
+	b.Index("in", map[string]interface{}{"when": year(2002)})
+	b.Index("out", map[string]interface{}{"when": year(2060)})
+	if err := idx.Batch(b); err != nil {
+		t.Fatal(err)
+	}
+
+	fr := dateFacetNew(t, idx, 10, map[string][2]time.Time{"early": {year(2000), year(2010)}})
+	if got := dateCountNew(t, fr, "early"); got != 2 {
+		t.Errorf("range early: got count %d, want 2", got)
+	}
+	if fr.Total != 3 {
+		t.Errorf("total: got %d, want 3", fr.Total)
+	}
+	if fr.Other != 1 {
+		t.Errorf("other: got %d, want 1 (only the document with no date in a range)", fr.Other)
+	}
+}
+
+// newNestedIdxNew returns an index whose "items" are nested objects with a
+// keyword "tag", a numeric "price" and a datetime "when".
+func newNestedIdxNew(t *testing.T) bleve.Index {
+	t.Helper()
+	dir, err := os.MkdirTemp("", "bleve-facet-nested-*")
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { os.RemoveAll(dir) })
+	im := bleve.NewIndexMapping()
+	items := bleve.NewNestedDocumentMapping()
+	tag := bleve.NewTextFieldMapping()
+	tag.Analyzer = keyword.Name
+	items.AddFieldMappingsAt("tag", tag)
+	items.AddFieldMappingsAt("price", bleve.NewNumericFieldMapping())
+	items.AddFieldMappingsAt("when", bleve.NewDateTimeFieldMapping())
+	im.DefaultMapping.AddSubDocumentMapping("items", items)
+	idx, err := bleve.New(dir, im)
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { idx.Close() })
+	return idx
+}
+
+func indexNestedNew(t *testing.T, idx bleve.Index, docs map[string]interface{}) {
+	t.Helper()
+	b := idx.NewBatch()
+	for id, doc := range docs {
+		if err := b.Index(id, doc); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if err := idx.Batch(b); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func item(fields ...interface{}) map[string]interface{} {
+	rv := map[string]interface{}{}
+	for i := 0; i+1 < len(fields); i += 2 {
+		rv[fields[i].(string)] = fields[i+1]
+	}
+	return rv
+}
+
+// Every nested object is a document of its own: it counts once in each range
+// one of its values falls in, Total and Other count nested objects, and
+// Missing counts the hits without any usable value.
+func TestNumericFacetNestedObjectsAreDocumentsBv28fee(t *testing.T) {
+	idx := newNestedIdxNew(t)
+	indexNestedNew(t, idx, map[string]interface{}{
+		"r1": map[string]interface{}{"items": []interface{}{
+			item("price", []interface{}{1.0, 2.0}),
+			item("price", 3.0),
+			item("price", 500.0),
+		}},
+		"r2": map[string]interface{}{"items": []interface{}{item("price", 50.0)}},
+		"r3": map[string]interface{}{"name": "no items"},
+		"r4": map[string]interface{}{"items": []interface{}{item("tag", "x")}},
+	})
+
+	req := bleve.NewSearchRequest(bleve.NewMatchAllQuery())
+	fr := bleve.NewFacetRequest("items.price", 10)
+	for _, r := range []struct {
+		name   string
+		lo, hi float64
+	}{{"low", 0, 10}, {"high", 10, 100}, {"empty", 1000, 2000}} {
+		lo, hi := r.lo, r.hi
+		fr.AddNumericRange(r.name, &lo, &hi)
+	}
+	req.AddFacet("f", fr)
+	res, err := idx.Search(req)
+	if err != nil {
+		t.Fatal(err)
+	}
+	got := res.Facets["f"]
+	if got == nil {
+		t.Fatal("no facet result")
+	}
+	for name, want := range map[string]int{"low": 2, "high": 1, "empty": 0} {
+		if c := numCountNew(t, got, name); c != want {
+			t.Errorf("range %s: got count %d, want %d", name, c, want)
+		}
+	}
+	if got.Total != 4 {
+		t.Errorf("total: got %d, want 4 (four nested objects have a price)", got.Total)
+	}
+	if got.Other != 1 {
+		t.Errorf("other: got %d, want 1 (the nested object priced 500)", got.Other)
+	}
+	if got.Missing != 2 {
+		t.Errorf("missing: got %d, want 2 (two hits have no price at all)", got.Missing)
+	}
+}
+
+// Same as above for dates.
+func TestDateTimeFacetNestedObjectsAreDocumentsBv28fee(t *testing.T) {
+	year := func(y int) time.Time { return time.Date(y, 6, 1, 0, 0, 0, 0, time.UTC) }
+	idx := newNestedIdxNew(t)
+	indexNestedNew(t, idx, map[string]interface{}{
+		"r1": map[string]interface{}{"items": []interface{}{
+			item("when", []interface{}{year(2001), year(2002)}),
+			item("when", year(2003)),
+			item("when", year(2050)),
+		}},
+		"r2": map[string]interface{}{"items": []interface{}{item("when", year(2015))}},
+		"r3": map[string]interface{}{"name": "no items"},
+		"r4": map[string]interface{}{"items": []interface{}{item("tag", "x")}},
+	})
+
+	req := bleve.NewSearchRequest(bleve.NewMatchAllQuery())
+	fr := bleve.NewFacetRequest("items.when", 10)
+	fr.AddDateTimeRange("early", year(2000), year(2010))
+	fr.AddDateTimeRange("late", year(2010), year(2020))
+	fr.AddDateTimeRange("empty", year(2100), year(2110))
+	req.AddFacet("f", fr)
+	res, err := idx.Search(req)
+	if err != nil {
+		t.Fatal(err)
+	}
+	got := res.Facets["f"]
+	if got == nil {
+		t.Fatal("no facet result")
+	}
+	for name, want := range map[string]int{"early": 2, "late": 1, "empty": 0} {
+		if c := dateCountNew(t, got, name); c != want {
+			t.Errorf("range %s: got count %d, want %d", name, c, want)
+		}
+	}
+	if got.Total != 4 {
+		t.Errorf("total: got %d, want 4 (four nested objects have a date)", got.Total)
+	}
+	if got.Other != 1 {
+		t.Errorf("other: got %d, want 1 (the nested object dated 2050)", got.Other)
+	}
+	if got.Missing != 2 {
+		t.Errorf("missing: got %d, want 2 (two hits have no date at all)", got.Missing)
+	}
+}
