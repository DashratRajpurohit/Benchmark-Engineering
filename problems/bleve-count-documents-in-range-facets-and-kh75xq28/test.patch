+// facetLine renders everything a facet result reports, in result order.
+func facetLine(fr *search.FacetResult) string {
+	line := fmt.Sprintf("total=%d missing=%d other=%d", fr.Total, fr.Missing, fr.Other)
+	if fr.Terms != nil {
+		for _, tf := range fr.Terms.Terms() {
+			line += fmt.Sprintf(" %s:%d", tf.Term, tf.Count)
+		}
+	}
+	for _, r := range fr.NumericRanges {
+		line += fmt.Sprintf(" %s:%d", r.Name, r.Count)
+	}
+	for _, r := range fr.DateRanges {
+		line += fmt.Sprintf(" %s:%d", r.Name, r.Count)
+	}
+	return line
+}
