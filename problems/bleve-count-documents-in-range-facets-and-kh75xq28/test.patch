+//go:build Bv28feebas
+
+package facet_test
+
+import (
+	"fmt"
+	"os"
+	"testing"
+	"time"
+
+	"github.com/blevesearch/bleve/v2"
+	"github.com/blevesearch/bleve/v2/analysis/analyzer/keyword"
+	"github.com/blevesearch/bleve/v2/search"
+)
+
+func newTestIndex(t *testing.T) (bleve.Index, func()) {
+	t.Helper()
+	dir, err := os.MkdirTemp("", "bleve-facet-bas-*")
+	if err != nil {
+		t.Fatal(err)
+	}
+	idx, err := bleve.New(dir, bleve.NewIndexMapping())
+	if err != nil {
+		os.RemoveAll(dir)
+		t.Fatal(err)
+	}
+	return idx, func() { idx.Close(); os.RemoveAll(dir) }
+}
+
+func numericFacet(t *testing.T, idx bleve.Index, field string, size int,
+	ranges map[string][2]float64) *search.FacetResult {
+	t.Helper()
+	req := bleve.NewSearchRequest(bleve.NewMatchAllQuery())
+	fr := bleve.NewFacetRequest(field, size)
+	for name, b := range ranges {
+		lo, hi := b[0], b[1]
+		fr.AddNumericRange(name, &lo, &hi)
+	}
+	req.AddFacet("f", fr)
+	res, err := idx.Search(req)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if res.Facets["f"] == nil {
+		t.Fatal("no facet result")
+	}
+	return res.Facets["f"]
+}
+
+func dateFacet(t *testing.T, idx bleve.Index, field string, size int,
+	ranges map[string][2]time.Time) *search.FacetResult {
+	t.Helper()
+	req := bleve.NewSearchRequest(bleve.NewMatchAllQuery())
+	fr := bleve.NewFacetRequest(field, size)
+	for name, b := range ranges {
+		fr.AddDateTimeRange(name, b[0], b[1])
+	}
+	req.AddFacet("f", fr)
+	res, err := idx.Search(req)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if res.Facets["f"] == nil {
+		t.Fatal("no facet result")
+	}
+	return res.Facets["f"]
+}
+
+func numericCount(fr *search.FacetResult, name string) (int, bool) {
+	for _, r := range fr.NumericRanges {
+		if r.Name == name {
+			return r.Count, true
+		}
+	}
+	return 0, false
+}
+
+func dateCount(fr *search.FacetResult, name string) (int, bool) {
+	for _, r := range fr.DateRanges {
+		if r.Name == name {
+			return r.Count, true
+		}
+	}
+	return 0, false
+}
+
+// A document with a single value inside a range contributes one to that range.
+func TestNumericFacetSingleValueInRangeBv28fee(t *testing.T) {
+	idx, cleanup := newTestIndex(t)
+	defer cleanup()
+
+	b := idx.NewBatch()
+	b.Index("a", map[string]interface{}{"score": 1.0})
+	b.Index("b", map[string]interface{}{"score": 3.0})
+	if err := idx.Batch(b); err != nil {
+		t.Fatal(err)
+	}
+
+	fr := numericFacet(t, idx, "score", 10, map[string][2]float64{"low": {0, 5}})
+	if got, ok := numericCount(fr, "low"); !ok || got != 2 {
+		t.Errorf("range low: got count %d (present=%v), want 2", got, ok)
+	}
+}
+
+// Values in two different ranges raise each of those ranges by one.
+func TestNumericFacetMultiValueDifferentRangesBv28fee(t *testing.T) {
+	idx, cleanup := newTestIndex(t)
+	defer cleanup()
+
+	b := idx.NewBatch()
+	b.Index("spread", map[string]interface{}{"score": []interface{}{1.0, 7.0}})
+	if err := idx.Batch(b); err != nil {
+		t.Fatal(err)
+	}
+
+	fr := numericFacet(t, idx, "score", 10,
+		map[string][2]float64{"low": {0, 5}, "high": {5, 10}})
+	for _, name := range []string{"low", "high"} {
+		if got, ok := numericCount(fr, name); !ok || got != 1 {
+			t.Errorf("range %s: got count %d (present=%v), want 1", name, got, ok)
+		}
+	}
+}
+
+// A document without the faceted field is reported as missing.
+func TestNumericFacetAbsentFieldIsMissingBv28fee(t *testing.T) {
+	idx, cleanup := newTestIndex(t)
+	defer cleanup()
+
+	b := idx.NewBatch()
+	b.Index("has", map[string]interface{}{"score": 1.0})
+	b.Index("hasnt", map[string]interface{}{"other": 1.0})
+	if err := idx.Batch(b); err != nil {
+		t.Fatal(err)
+	}
+
+	fr := numericFacet(t, idx, "score", 10, map[string][2]float64{"low": {0, 5}})
+	if fr.Missing != 1 {
+		t.Errorf("missing: got %d, want 1", fr.Missing)
+	}
+}
+
+// Ranges are ordered by descending count, ties broken by name.
+func TestNumericFacetOrderingBv28fee(t *testing.T) {
+	idx, cleanup := newTestIndex(t)
+	defer cleanup()
+
+	b := idx.NewBatch()
+	for _, id := range []string{"p", "q", "r"} {
+		b.Index(id, map[string]interface{}{"score": 1.0})
+	}
+	b.Index("s", map[string]interface{}{"score": 7.0})
+	if err := idx.Batch(b); err != nil {
+		t.Fatal(err)
+	}
+
+	fr := numericFacet(t, idx, "score", 10,
+		map[string][2]float64{"low": {0, 5}, "high": {5, 10}})
+	if len(fr.NumericRanges) < 2 {
+		t.Fatalf("got %d ranges, want at least 2", len(fr.NumericRanges))
+	}
+	if fr.NumericRanges[0].Name != "low" {
+		t.Errorf("first range: got %q, want %q", fr.NumericRanges[0].Name, "low")
+	}
+}
+
+// A document with a single date inside a range contributes one to that range.
+func TestDateTimeFacetSingleValueInRangeBv28fee(t *testing.T) {
+	idx, cleanup := newTestIndex(t)
+	defer cleanup()
+
+	b := idx.NewBatch()
+	b.Index("a", map[string]interface{}{"when": time.Date(2020, 5, 1, 0, 0, 0, 0, time.UTC)})
+	if err := idx.Batch(b); err != nil {
+		t.Fatal(err)
+	}
+
+	fr := dateFacet(t, idx, "when", 10, map[string][2]time.Time{
+		"y2020": {time.Date(2020, 1, 1, 0, 0, 0, 0, time.UTC), time.Date(2021, 1, 1, 0, 0, 0, 0, time.UTC)},
+	})
+	if got, ok := dateCount(fr, "y2020"); !ok || got != 1 {
+		t.Errorf("range y2020: got count %d (present=%v), want 1", got, ok)
+	}
+}
+
+// Dates in two different ranges raise each of those ranges by one.
+func TestDateTimeFacetMultiValueDifferentRangesBv28fee(t *testing.T) {
+	idx, cleanup := newTestIndex(t)
+	defer cleanup()
+
+	b := idx.NewBatch()
+	b.Index("spread", map[string]interface{}{"when": []interface{}{
+		time.Date(2020, 5, 1, 0, 0, 0, 0, time.UTC),
+		time.Date(2022, 5, 1, 0, 0, 0, 0, time.UTC),
+	}})
+	if err := idx.Batch(b); err != nil {
+		t.Fatal(err)
+	}
+
+	fr := dateFacet(t, idx, "when", 10, map[string][2]time.Time{
+		"y2020": {time.Date(2020, 1, 1, 0, 0, 0, 0, time.UTC), time.Date(2021, 1, 1, 0, 0, 0, 0, time.UTC)},
+		"y2022": {time.Date(2022, 1, 1, 0, 0, 0, 0, time.UTC), time.Date(2023, 1, 1, 0, 0, 0, 0, time.UTC)},
+	})
+	for _, name := range []string{"y2020", "y2022"} {
+		if got, ok := dateCount(fr, name); !ok || got != 1 {
+			t.Errorf("range %s: got count %d (present=%v), want 1", name, got, ok)
+		}
+	}
+}
+
+// The start of a date range is inside it and the end is outside it.
+func TestDateTimeFacetBoundariesBv28fee(t *testing.T) {
+	idx, cleanup := newTestIndex(t)
+	defer cleanup()
+
+	start := time.Date(2021, 1, 1, 0, 0, 0, 0, time.UTC)
+	end := time.Date(2022, 1, 1, 0, 0, 0, 0, time.UTC)
+
+	b := idx.NewBatch()
+	b.Index("atstart", map[string]interface{}{"when": start})
+	b.Index("atend", map[string]interface{}{"when": end})
+	if err := idx.Batch(b); err != nil {
+		t.Fatal(err)
+	}
+
+	fr := dateFacet(t, idx, "when", 10, map[string][2]time.Time{"y2021": {start, end}})
+	if got, ok := dateCount(fr, "y2021"); !ok || got != 1 {
+		t.Errorf("range y2021: got count %d (present=%v), want 1 (start inside, end outside)", got, ok)
+	}
+}
+
+// A numeric range counts a value at its lower bound and leaves one at its upper bound out.
+func TestNumericFacetBoundariesBv28fee(t *testing.T) {
+	idx, cleanup := newTestIndex(t)
+	defer cleanup()
+
+	b := idx.NewBatch()
+	b.Index("atlow", map[string]interface{}{"score": 10.0})
+	b.Index("athigh", map[string]interface{}{"score": 20.0})
+	if err := idx.Batch(b); err != nil {
+		t.Fatal(err)
+	}
+
+	fr := numericFacet(t, idx, "score", 10,
+		map[string][2]float64{"r": {10, 20}, "s": {20, 30}})
+	if got, ok := numericCount(fr, "r"); !ok || got != 1 {
+		t.Errorf("range r [10,20): got count %d (present=%v), want 1", got, ok)
+	}
+	if got, ok := numericCount(fr, "s"); !ok || got != 1 {
+		t.Errorf("range s [20,30): got count %d (present=%v), want 1", got, ok)
+	}
+}
+
+// Trimming a datetime facet keeps the range with the highest count.
+func TestDateTimeFacetTrimKeepsTopRangeBv28fee(t *testing.T) {
+	idx, cleanup := newTestIndex(t)
+	defer cleanup()
+
+	b := idx.NewBatch()
+	for i, year := range []int{2020, 2021, 2021, 2022, 2022, 2022} {
+		b.Index(fmt.Sprintf("d%d", i), map[string]interface{}{
+			"when": time.Date(year, 6, 1, 0, 0, 0, 0, time.UTC)})
+	}
+	if err := idx.Batch(b); err != nil {
+		t.Fatal(err)
+	}
+
+	year := func(y int) [2]time.Time {
+		return [2]time.Time{
+			time.Date(y, 1, 1, 0, 0, 0, 0, time.UTC),
+			time.Date(y+1, 1, 1, 0, 0, 0, 0, time.UTC),
+		}
+	}
+	fr := dateFacet(t, idx, "when", 1, map[string][2]time.Time{
+		"y2020": year(2020), "y2021": year(2021), "y2022": year(2022),
+	})
+	if len(fr.DateRanges) != 1 {
+		t.Fatalf("got %d ranges, want 1", len(fr.DateRanges))
+	}
+	if fr.DateRanges[0].Name != "y2022" || fr.DateRanges[0].Count != 3 {
+		t.Errorf("kept %q with count %d, want \"y2022\" with count 3",
+			fr.DateRanges[0].Name, fr.DateRanges[0].Count)
+	}
+}
+
+// On a single index a term facet lists its top terms and puts the rest in Other.
+func TestTermFacetSingleIndexBv28fee(t *testing.T) {
+	idx, cleanup := newTestIndex(t)
+	defer cleanup()
+
+	b := idx.NewBatch()
+	for id, tags := range map[string][]string{
+		"d1": {"apple"}, "d2": {"apple"}, "d3": {"apple", "berry"}, "d4": {"cherry"},
+	} {
+		b.Index(id, map[string]interface{}{"tag": tags})
+	}
+	if err := idx.Batch(b); err != nil {
+		t.Fatal(err)
+	}
+
+	req := bleve.NewSearchRequest(bleve.NewMatchAllQuery())
+	req.AddFacet("t", bleve.NewFacetRequest("tag", 1))
+	res, err := idx.Search(req)
+	if err != nil {
+		t.Fatal(err)
+	}
+	g := res.Facets["t"]
+	if g == nil || len(g.Terms.Terms()) != 1 {
+		t.Fatalf("want one listed term, got %+v", g)
+	}
+	top := g.Terms.Terms()[0]
+	if top.Term != "apple" || top.Count != 3 {
+		t.Errorf("top term %s=%d, want apple=3", top.Term, top.Count)
+	}
+	if g.Total != 5 || g.Other != 2 {
+		t.Errorf("total %d other %d, want 5 and 2", g.Total, g.Other)
+	}
+}
+
+// Term facets count every nested object as a document of its own, and Missing
+// counts the hits that have no value at all.
+func TestTermFacetNestedObjectsAreDocumentsBv28fee(t *testing.T) {
+	dir, err := os.MkdirTemp("", "bleve-facet-nested-bas-*")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer os.RemoveAll(dir)
+	im := bleve.NewIndexMapping()
+	items := bleve.NewNestedDocumentMapping()
+	tag := bleve.NewTextFieldMapping()
+	tag.Analyzer = keyword.Name
+	items.AddFieldMappingsAt("tag", tag)
+	items.AddFieldMappingsAt("price", bleve.NewNumericFieldMapping())
+	im.DefaultMapping.AddSubDocumentMapping("items", items)
+	idx, err := bleve.New(dir, im)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer idx.Close()
+
+	b := idx.NewBatch()
+	docs := map[string]interface{}{
+		"r1": map[string]interface{}{"items": []interface{}{
+			map[string]interface{}{"tag": []interface{}{"apple", "apple"}},
+			map[string]interface{}{"tag": "apple"},
+			map[string]interface{}{"tag": "berry"},
+		}},
+		"r2": map[string]interface{}{"items": []interface{}{
+			map[string]interface{}{"tag": "apple"},
+		}},
+		"r3": map[string]interface{}{"name": "no items"},
+		"r4": map[string]interface{}{"items": []interface{}{
+			map[string]interface{}{"price": 1.0},
+		}},
+	}
+	for id, doc := range docs {
+		if err := b.Index(id, doc); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if err := idx.Batch(b); err != nil {
+		t.Fatal(err)
+	}
+
+	req := bleve.NewSearchRequest(bleve.NewMatchAllQuery())
+	req.AddFacet("f", bleve.NewFacetRequest("items.tag", 10))
+	res, err := idx.Search(req)
+	if err != nil {
+		t.Fatal(err)
+	}
+	got := res.Facets["f"]
+	if got == nil {
+		t.Fatal("no facet result")
+	}
+	counts := map[string]int{}
+	for _, tf := range got.Terms.Terms() {
+		counts[tf.Term] = tf.Count
+	}
+	if counts["apple"] != 3 || counts["berry"] != 1 || len(counts) != 2 {
+		t.Errorf("terms: got %v, want apple:3 berry:1", counts)
+	}
+	if got.Missing != 2 {
+		t.Errorf("missing: got %d, want 2 (two hits have no tag at all)", got.Missing)
+	}
+}
