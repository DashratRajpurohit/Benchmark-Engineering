@@ -0,0 +1,190 @@
+//go:build Bv28feenew
+
+package facet_test
+
+import (
+	"os"
+	"testing"
+	"time"
+
+	"github.com/blevesearch/bleve/v2"
+	"github.com/blevesearch/bleve/v2/mapping"
+)
+
+// valueIdx returns an index whose mapping declares "price" as a number and
+// "day" as a date, plus nested "items" with a number "price" and a date "day".
+func valueIdx(t *testing.T, docs map[string]interface{}) bleve.Index {
+	t.Helper()
+	dir, err := os.MkdirTemp("", "bleve-facet-values-*")
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { os.RemoveAll(dir) })
+	im := bleve.NewIndexMapping()
+	im.DefaultMapping.AddFieldMappingsAt("price", bleve.NewNumericFieldMapping())
+	im.DefaultMapping.AddFieldMappingsAt("day", bleve.NewDateTimeFieldMapping())
+	items := bleve.NewNestedDocumentMapping()
+	items.AddFieldMappingsAt("price", bleve.NewNumericFieldMapping())
+	items.AddFieldMappingsAt("day", bleve.NewDateTimeFieldMapping())
+	im.DefaultMapping.AddSubDocumentMapping("items", items)
+	idx, err := bleve.New(dir, im)
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { idx.Close() })
+	indexNestedNew(t, idx, docs)
+	return idx
+}
+
+func valueFacet(field string) func(size int) *bleve.FacetRequest {
+	return func(size int) *bleve.FacetRequest {
+		return bleve.NewFacetRequest(field, size)
+	}
+}
+
+func valueLine(t *testing.T, idx bleve.Index, fr *bleve.FacetRequest) string {
+	t.Helper()
+	req := bleve.NewSearchRequest(bleve.NewMatchAllQuery())
+	req.AddFacet("f", fr)
+	res, err := idx.Search(req)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if res.Facets["f"] == nil {
+		t.Fatal("no facet result")
+	}
+	return facetLine(res.Facets["f"])
+}
+
+func day(y, m, d int) time.Time { return time.Date(y, time.Month(m), d, 0, 0, 0, 0, time.UTC) }
+
+// A term facet on a number field lists each number once, written out.
+func TestTermFacetOnNumberFieldBv28fee(t *testing.T) {
+	idx := valueIdx(t, map[string]interface{}{
+		"a": map[string]interface{}{"price": []interface{}{1.0, 2.5}},
+		"b": map[string]interface{}{"price": 1.0},
+		"c": map[string]interface{}{"price": -3.0},
+		"e": map[string]interface{}{"name": "no price"},
+	})
+	got := valueLine(t, idx, bleve.NewFacetRequest("price", 10))
+	want := "total=4 missing=1 other=0 1:2 -3:1 2.5:1"
+	if got != want {
+		t.Errorf("got  %s\nwant %s", got, want)
+	}
+}
+
+// A term facet on a date field lists each date once, as RFC 3339 in UTC.
+func TestTermFacetOnDateFieldBv28fee(t *testing.T) {
+	idx := valueIdx(t, map[string]interface{}{
+		"a": map[string]interface{}{"day": []interface{}{day(2001, 6, 1), day(2002, 1, 15)}},
+		"b": map[string]interface{}{"day": day(2001, 6, 1)},
+		"c": map[string]interface{}{"name": "no day"},
+		// the same instant as 2002-01-15 00:00 UTC, and one more given with an offset
+		"d": map[string]interface{}{"day": []interface{}{
+			time.Date(2002, 1, 15, 5, 30, 0, 0, time.FixedZone("IST", 5*3600+1800)),
+			time.Date(2003, 7, 4, 10, 0, 0, 0, time.FixedZone("PDT", -7*3600)),
+		}},
+	})
+	got := valueLine(t, idx, bleve.NewFacetRequest("day", 10))
+	want := "total=5 missing=1 other=0 2001-06-01T00:00:00Z:2 2002-01-15T00:00:00Z:2 2003-07-04T17:00:00Z:1"
+	if got != want {
+		t.Errorf("got  %s\nwant %s", got, want)
+	}
+}
+
+// Trimming the terms of a number field moves the rest into Other.
+func TestTermFacetOnNumberFieldTrimBv28fee(t *testing.T) {
+	idx := valueIdx(t, map[string]interface{}{
+		"a": map[string]interface{}{"price": []interface{}{7.0, 8.0}},
+		"b": map[string]interface{}{"price": 7.0},
+		"c": map[string]interface{}{"price": []interface{}{7.0, 9.0}},
+	})
+	got := valueLine(t, idx, bleve.NewFacetRequest("price", 1))
+	want := "total=5 missing=0 other=2 7:3"
+	if got != want {
+		t.Errorf("got  %s\nwant %s", got, want)
+	}
+}
+
+// Nested objects count on their own for number and date terms too.
+func TestTermFacetOnNestedValuesBv28fee(t *testing.T) {
+	idx := valueIdx(t, map[string]interface{}{
+		"r1": map[string]interface{}{"items": []interface{}{
+			item("price", 4.0, "day", day(2003, 3, 3)),
+			item("price", 4.0, "day", day(2003, 3, 3)),
+			item("price", 0.5),
+		}},
+		"r2": map[string]interface{}{"items": []interface{}{item("price", 4.0)}},
+		"r3": map[string]interface{}{"name": "no items"},
+	})
+	if got, want := valueLine(t, idx, bleve.NewFacetRequest("items.price", 10)),
+		"total=4 missing=1 other=0 4:3 0.5:1"; got != want {
+		t.Errorf("items.price:\n got  %s\n want %s", got, want)
+	}
+	if got, want := valueLine(t, idx, bleve.NewFacetRequest("items.day", 10)),
+		"total=2 missing=2 other=0 2003-03-03T00:00:00Z:2"; got != want {
+		t.Errorf("items.day:\n got  %s\n want %s", got, want)
+	}
+}
+
+// A field declared in a document type's mapping is read as a number too.
+func TestTermFacetOnTypedNumberFieldBv28fee(t *testing.T) {
+	dir := t.TempDir()
+	im := mapping.NewIndexMapping()
+	product := bleve.NewDocumentMapping()
+	product.AddFieldMappingsAt("weight", bleve.NewNumericFieldMapping())
+	im.AddDocumentMapping("product", product)
+	idx, err := bleve.New(dir+"/idx", im)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer idx.Close()
+	b := idx.NewBatch()
+	b.Index("p1", map[string]interface{}{"type": "product", "weight": []interface{}{12.0, 30.0}})
+	b.Index("p2", map[string]interface{}{"type": "product", "weight": 12.0})
+	if err := idx.Batch(b); err != nil {
+		t.Fatal(err)
+	}
+	if got, want := valueLine(t, idx, bleve.NewFacetRequest("weight", 10)),
+		"total=3 missing=0 other=0 12:2 30:1"; got != want {
+		t.Errorf("got  %s\nwant %s", got, want)
+	}
+}
+
+// An alias gives the same number and date terms as one index.
+func TestTermFacetOnValuesAliasSameAsOneIndexBv28fee(t *testing.T) {
+	a := map[string]interface{}{
+		"a1": map[string]interface{}{"price": []interface{}{1.0, 2.5}, "day": day(2001, 6, 1)},
+		"a2": map[string]interface{}{"price": 1.0, "day": day(2001, 6, 1)},
+		"a3": map[string]interface{}{"price": 6.0},
+	}
+	b := map[string]interface{}{
+		"b1": map[string]interface{}{"price": 2.5, "day": []interface{}{day(2002, 2, 2), day(2001, 6, 1)}},
+		"b2": map[string]interface{}{"price": []interface{}{6.0, 2.5}},
+		"b3": map[string]interface{}{"day": day(2002, 2, 2)},
+	}
+	alias := bleve.NewIndexAlias(valueIdx(t, a), valueIdx(t, b))
+	defer alias.Close()
+	one := valueIdx(t, mergeValues(a, b))
+	checkSameFacets(t, alias, one, []int{1, 2, 3}, valueFacet("price"))
+	checkSameFacets(t, alias, one, []int{1, 2}, valueFacet("day"))
+
+	if got, want := valueLine(t, alias, bleve.NewFacetRequest("price", 10)),
+		"total=7 missing=1 other=0 2.5:3 1:2 6:2"; got != want {
+		t.Errorf("price:\n got  %s\n want %s", got, want)
+	}
+	if got, want := valueLine(t, alias, bleve.NewFacetRequest("day", 10)),
+		"total=5 missing=2 other=0 2001-06-01T00:00:00Z:3 2002-02-02T00:00:00Z:2"; got != want {
+		t.Errorf("day:\n got  %s\n want %s", got, want)
+	}
+}
+
+func mergeValues(sets ...map[string]interface{}) map[string]interface{} {
+	rv := map[string]interface{}{}
+	for _, s := range sets {
+		for k, v := range s {
+			rv[k] = v
+		}
+	}
+	return rv
+}
