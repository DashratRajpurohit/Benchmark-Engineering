+// checkSameFacets runs the same facet request against target and against one
+// index holding all of the documents, and wants the same answer each time.
+func checkSameFacets(t *testing.T, target, one bleve.Index, sizes []int,
+	newFacet func(size int) *bleve.FacetRequest) {
+	t.Helper()
+	run := func(idx bleve.Index, size int) string {
+		req := bleve.NewSearchRequest(bleve.NewMatchAllQuery())
+		req.AddFacet("f", newFacet(size))
+		res, err := idx.Search(req)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if res.Facets["f"] == nil {
+			t.Fatal("no facet result")
+		}
+		return facetLine(res.Facets["f"])
+	}
+	for _, size := range sizes {
+		want := run(one, size)
+		for i := 0; i < 5; i++ {
+			if got := run(target, size); got != want {
+				t.Errorf("size %d, search %d:\n got  %s\n want %s (one index)", size, i, got, want)
+			}
+		}
+	}
+}
