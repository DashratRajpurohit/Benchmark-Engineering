+
+// readableTerm turns the full precision term of a number or a date into its
+// text, the other precision steps and NaN are not values of their own
+func (fb *TermsFacetBuilder) readableTerm(term []byte) ([]byte, bool) {
+	valid, shift := numeric.ValidPrefixCodedTermBytes(term)
+	if !valid || shift != 0 {
+		return nil, false
