@@ -0,0 +1,96 @@
+//go:build newtest
+
+package system
+
+import (
+	"encoding/json"
+	"io"
+	"net/http"
+	"net/url"
+	"strings"
+	"testing"
+	"time"
+)
+
+func raftIndexPost(t *testing.T, n *Node, path, body string) (results []json.RawMessage, raftIndex uint64) {
+	t.Helper()
+	resp, err := http.Post("http://"+n.APIAddr+path+"?raft_index", "application/json", strings.NewReader(body))
+	if err != nil {
+		t.Fatalf("request failed: %v", err)
+	}
+	defer resp.Body.Close()
+	b, _ := io.ReadAll(resp.Body)
+	var r struct {
+		Results   []json.RawMessage `json:"results"`
+		RaftIndex uint64            `json:"raft_index"`
+		Error     string            `json:"error"`
+	}
+	if err := json.Unmarshal(b, &r); err != nil || resp.StatusCode != http.StatusOK || r.Error != "" {
+		t.Fatalf("bad response (status %d, err %v): %s", resp.StatusCode, err, b)
+	}
+	return r.Results, r.RaftIndex
+}
+
+func raftIndexStored(t *testing.T, n *Node, query string) string {
+	t.Helper()
+	resp, err := http.Get("http://" + n.APIAddr + "/db/query?level=none&q=" + url.QueryEscape(query))
+	if err != nil {
+		t.Fatalf("query failed: %v", err)
+	}
+	defer resp.Body.Close()
+	b, _ := io.ReadAll(resp.Body)
+	return string(b)
+}
+
+func Test_RaftIndex_Cluster(t *testing.T) {
+	leader := mustNewLeaderNode("leader")
+	defer leader.Deprovision()
+	follower := mustNewNode("follower", false)
+	defer follower.Deprovision()
+	if err := follower.Join(leader); err != nil {
+		t.Fatalf("follower failed to join leader: %v", err)
+	}
+	if _, err := follower.WaitForLeader(); err != nil {
+		t.Fatalf("follower never saw a leader: %v", err)
+	}
+
+	raftIndexPost(t, leader, "/db/execute", `["CREATE TABLE t (id INTEGER PRIMARY KEY, idx INTEGER)"]`)
+	_, n1 := raftIndexPost(t, leader, "/db/execute", `["INSERT INTO t(id, idx) VALUES (1, rqlite_raft_index())"]`)
+	_, n2 := raftIndexPost(t, leader, "/db/request",
+		`["INSERT INTO t(id, idx) VALUES (2, rqlite_raft_index())", "INSERT INTO t(id, idx) VALUES (3, rqlite_raft_index())"]`)
+	if n1 == 0 || n2 <= n1 {
+		t.Fatalf("unexpected Raft indexes %d, %d", n1, n2)
+	}
+
+	want := func(a, b uint64) string {
+		out, _ := json.Marshal([]uint64{a, b, b})
+		return string(out)
+	}(n1, n2)
+
+	// Each node applies the log entries itself, so both must have stored the same values.
+	for _, n := range []*Node{leader, follower} {
+		deadline := time.Now().Add(15 * time.Second)
+		for {
+			body := raftIndexStored(t, n, `SELECT idx FROM t ORDER BY id`)
+			var r struct {
+				Results []struct {
+					Values [][]uint64 `json:"values"`
+				} `json:"results"`
+			}
+			var got []uint64
+			if json.Unmarshal([]byte(body), &r) == nil && len(r.Results) == 1 {
+				for _, v := range r.Results[0].Values {
+					got = append(got, v[0])
+				}
+			}
+			gotJSON, _ := json.Marshal(got)
+			if string(gotJSON) == want {
+				break
+			}
+			if time.Now().After(deadline) {
+				t.Fatalf("node %s stored %s, want %s", n.APIAddr, gotJSON, want)
+			}
+			time.Sleep(200 * time.Millisecond)
+		}
+	}
+}
