+#!/usr/bin/env bash
+# Test runner for the rqlite_raft_index() SQL function.
+#
+# Usage:
+#   ./test.sh [--output_path <junit.xml>] <base|new>
+#
+# base  runs the pre-existing db, command, and http suites plus the single-node store recovery tests.
+#       The new tests are excluded by the "newtest" build tag. Must pass both
+#       before and after the solution.
+# new   runs the new tests, which cover writes, triggers, reads at every
+#       consistency level, node isolation, log replay during recovery, and a
+#       two-node cluster.
+set -uo pipefail
+
+cd /app
+
+OUTPUT_PATH=""
+if [ "${1:-}" = "--output_path" ]; then
+  OUTPUT_PATH="$2"
+  shift 2
+fi
+
+MODE="${1:-new}"
+
+TEST_LOG="$(mktemp)"
+STATUS=0
+
+run_tests() {
+  go test -count=1 -v "$@" 2>&1 | tee -a "$TEST_LOG"
+  status=${PIPESTATUS[0]}
+  if [ "$status" -ne 0 ]; then
+    STATUS=$status
+  fi
+}
+
+case "$MODE" in
+  base)
+    run_tests -timeout 600s ./db/... ./command/... ./http/...
+    run_tests -timeout 600s -run '^Test_SingleNodeRecover' ./store/
+    ;;
+  new)
+    run_tests -timeout 300s -tags newtest -run '^Test_RaftIndex_' ./store/ ./system_test/
+    ;;
+  *)
+    echo "unknown mode: $MODE (expected base or new)" >&2
+    exit 2
+    ;;
+esac
+
+if [ -n "$OUTPUT_PATH" ]; then
+  go-junit-report -set-exit-code < "$TEST_LOG" > "$OUTPUT_PATH"
+  junit_status=$?
+  if [ "$junit_status" -ne 0 ] && [ "$STATUS" -eq 0 ]; then
+    echo "go-junit-report failed to convert the test log (exit $junit_status)" >&2
+    STATUS=$junit_status
+  fi
+fi
+
+exit "$STATUS"
