diff --git a/db/raft_index.go b/db/raft_index.go
new file mode 100644
index 00000000..771191de
--- /dev/null
+++ b/db/raft_index.go
@@ -0,0 +1,44 @@
+package db
+
+import (
+	"context"
+	"database/sql"
+	"fmt"
+
+	"github.com/mattn/go-sqlite3"
+)
+
+// raftIndexFuncName is the name of the SQL function that returns the index of
+// the Raft log entry being applied.
+const raftIndexFuncName = "rqlite_raft_index"
+
+type raftIndexKey struct{}
+
+// ContextWithRaftIndex returns a copy of ctx which carries the index of the
+// Raft log entry that is being applied. Statements executed with the returned
+// context can call the rqlite_raft_index() SQL function.
+func ContextWithRaftIndex(ctx context.Context, index uint64) context.Context {
+	return context.WithValue(ctx, raftIndexKey{}, index)
+}
+
+func raftIndexFromContext(ctx context.Context) (uint64, bool) {
+	index, ok := ctx.Value(raftIndexKey{}).(uint64)
+	return index, ok
+}
+
+// registerRaftIndexFunc makes rqlite_raft_index() available on conn, if ctx
+// carries a Raft index. The function is registered per connection, and per
+// request, so its value can never leak between databases sharing a process.
+func registerRaftIndexFunc(ctx context.Context, conn *sql.Conn) error {
+	index, ok := raftIndexFromContext(ctx)
+	if !ok {
+		return nil
+	}
+	return conn.Raw(func(driverConn any) error {
+		c, ok := driverConn.(*sqlite3.SQLiteConn)
+		if !ok {
+			return fmt.Errorf("unexpected driver connection type %T", driverConn)
+		}
+		return c.RegisterFunc(raftIndexFuncName, func() int64 { return int64(index) }, false)
+	})
+}
